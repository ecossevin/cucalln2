(  416)     ISIZE = SIZE_SPHYS_HIST_TYPE (YD%GPHIST (J1), CLPATH//'%GPHIST', .FALSE.)
(  417)     JSIZE = JSIZE + ISIZE
(  418)     KSIZE = KSIZE + ISIZE
(  419)   ENDDO
(  420)   IF (LLPRINT) THEN
(  421)     WRITE (*, '(I10," ")', ADVANCE='NO') JSIZE
(  422)     WRITE (*, *) TRIM (CLPATH)//'%GPHIST'
(  423)   ENDIF
(  424) ENDIF
(  425) END FUNCTION
(  426) # 427 "./util_model_physics_simplinear_type_mod.F90"
(  427) END MODULE
