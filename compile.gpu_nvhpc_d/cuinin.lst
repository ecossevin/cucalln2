(  194) # 195 "./cuinin.F90"
(  195) !*    2.0          INITIALIZE VALUES FOR UPDRAFTS AND DOWNDRAFTS
(  196) !*                 ---------------------------------------------
(  197) # 198 "./cuinin.F90"
(  198) DO JK=1,KLEV
(  199)   IK=JK-1
(  200)   IF(JK == 1) IK=1
(  201)   DO JL=KIDIA,KFDIA
(  202)     PTU(JL,JK)=PTENH(JL,JK)
(  203)     PTD(JL,JK)=PTENH(JL,JK)
(  204)     PQU(JL,JK)=PQENH(JL,JK)
(  205)     PQD(JL,JK)=PQENH(JL,JK)
(  206)     PLU(JL,JK)=0.0_JPRB
(  207)     PUU(JL,JK)=PUEN(JL,IK)
(  208)     PUD(JL,JK)=PUEN(JL,IK)
(  209)     PVU(JL,JK)=PVEN(JL,IK)
(  210)     PVD(JL,JK)=PVEN(JL,IK)
(  211)     KLAB(JL,JK)=0
(  212)   ENDDO
(  213) ENDDO
(  214) # 215 "./cuinin.F90"
(  215) END ASSOCIATE
(  216) IF (LHOOK) CALL DR_HOOK('CUININ',1,ZHOOK_HANDLE)
(  217) END SUBROUTINE CUININ
