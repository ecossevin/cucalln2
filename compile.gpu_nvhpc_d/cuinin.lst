(    2) SUBROUTINE CUADJTQS &
(    3) &(YDTHF, YDCST, KIDIA,    KFDIA,    KLON,    KLEV,&
(    4) & KK,&
(    5) & PSP,      PT,       PQ,       LDFLAG,   KCALL)
