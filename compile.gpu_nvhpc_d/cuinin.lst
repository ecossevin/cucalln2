(   15) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA
(   16) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA
(   17) INTEGER(KIND=JPIM),INTENT(IN)    :: KK
(   18) REAL(KIND=JPRB)   ,INTENT(IN)    :: PSP(KLON)
(   19) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PT(KLON,KLEV)
(   20) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PQ(KLON,KLEV)
