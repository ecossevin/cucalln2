(    3) SUBROUTINE CUADJTQ &
(    4) & (YDTHF, YDCST, YDEPHLI,KIDIA,    KFDIA,    KLON,    KLEV,     KK,&
(    5) &  PSP,      PT,       PQ,      LDFLAG,   KCALL,   LDOFLAG)
(    6) USE PARKIND1 , ONLY : JPIM     ,JPRB
(    7) USE YOMHOOK  , ONLY : LHOOK,   DR_HOOK, JPHOOK
(    8) USE YOMCST   , ONLY : TCST
