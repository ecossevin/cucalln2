(  133) !----------------------------------------------------------------------
(  134) # 135 "./cuinin.F90"
(  135) !*    1.           SPECIFY LARGE SCALE PARAMETERS AT HALF LEVELS
(  136) !*                 ADJUST TEMPERATURE FIELDS IF STATICLY UNSTABLE
(  137) !*                 FIND LEVEL OF MAXIMUM VERTICAL VELOCITY
(  138) !                  ----------------------------------------------
(  139) # 140 "./cuinin.F90"
(  140) IF (LHOOK) CALL DR_HOOK('CUININ',0,ZHOOK_HANDLE)
(  141) ASSOCIATE(NJKT2=>YDECUMF%NJKT2, &
(  142)  & RCPD=>YDCST%RCPD, &
(  143)  & LPHYLIN=>YDEPHLI%LPHYLIN)
(  144) ZORCPD=1._JPRB/RCPD
(  145) DO JK=2,KLEV
(  146)   DO JL=KIDIA,KFDIA
(  147)     PTENH(JL,JK)=(MAX(RCPD*PTEN(JL,JK-1)+PGEO(JL,JK-1),&
(  148)      & RCPD*PTEN(JL,JK)+PGEO(JL,JK))-PGEOH(JL,JK))*ZORCPD  
(  149)     PQENH(JL,JK)=PQEN(JL,JK-1)
(  150)     PQSENH(JL,JK)=PQSEN(JL,JK-1)
(  151)     ZPH(JL)=PAPH(JL,JK)
(  152)     LLFLAG(JL)=.TRUE.
(  153)   ENDDO
(  154) # 155 "./cuinin.F90"
(  155) !orig   IF(JK.GE.KLEV-1) GO TO 130
(  156)   IF(JK >= KLEV-1 .OR. JK<NJKT2) CYCLE
(  157)   IK=JK
(  158)   IF(LPHYLIN)THEN
(  159)     !$loki inline
(  160)     CALL CUADJTQS &
(  161)      & ( YDTHF, YDCST, KIDIA,    KFDIA,    KLON,    KLEV,     IK,&
(  162)      &   ZPH,      PTENH,    PQSENH,  LLFLAG,   0)  
(  163)   ELSE
(  164)     !$loki inline
(  165)     CALL CUADJTQ &
(  166)      & ( YDTHF, YDCST, YDEPHLI,  KIDIA,    KFDIA,    KLON,    KLEV,     IK,&
(  167)      &   ZPH,      PTENH,    PQSENH,  LLFLAG,   3)  
(  168)   ENDIF
(  169) # 170 "./cuinin.F90"
(  170)   DO JL=KIDIA,KFDIA
(  171)     PQENH(JL,JK)=MIN(PQEN(JL,JK-1),PQSEN(JL,JK-1))&
(  172)      & +(PQSENH(JL,JK)-PQSEN(JL,JK-1))  
(  173)     PQENH(JL,JK)=MAX(PQENH(JL,JK),0.0_JPRB)
(  174)   ENDDO
(  175) !orig  130   continue






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 9

(  176) ENDDO
(  177) # 178 "./cuinin.F90"
(  178) DO JL=KIDIA,KFDIA
(  179)   PTENH(JL,KLEV)=(RCPD*PTEN(JL,KLEV)+PGEO(JL,KLEV)-PGEOH(JL,KLEV))*ZORCPD
(  180)   PQENH(JL,KLEV)=PQEN(JL,KLEV)
(  181)   PTENH(JL,1)=PTEN(JL,1)
(  182)   PQENH(JL,1)=PQEN(JL,1)
(  183) ENDDO
(  184) # 185 "./cuinin.F90"
(  185) !DO JK=KLEV-1,2,-1
