(  399)       
(  400)       ! Fill bi-diagonal Matrix vectors A=k-1, B=k, C=k+1;
(  401)       ! reuse ZMFUS=A
(  402)       ! ZDTDT and ZDQDT correspond to the RHS ("constants") of the equation
(  403)       ! The solution is in ZR1 and ZR2
(  404)       
(  405)       LLCUMBAS(:, :) = .false.
(  406)       ZB(:, :) = 1.0_JPRB
(  407)       ZMFUS(:, :) = 0.0_JPRB
(  408)       
(  409)       ! Fill vectors A, B and RHS
(  410)       
(  411)       
(  412) !$acc loop vector
(  413)       DO JL=KIDIA,KFDIA
(  414) !$acc loop seq
(  415)         DO JK=KTOPM2,KLEV
(  416)           IK = JK + 1
(  417)           IM = JK - 1
(  418)           LLCUMBAS(JL, JK) = LDCUM(JL) .and. JK >= KCTOP(JL) - 1
(  419)           IF (LLCUMBAS(JL, JK)) THEN
(  420)             ZZP = YDECUMF%RMFSOLTQ*ZDP(JL, JK)*PTSPHY
(  421)             ZMFUS(JL, JK) = -ZZP*(PMFU(JL, JK) + PMFD(JL, JK))
(  422)             IF (JK < KLEV) THEN
(  423)               ZB(JL, JK) = 1.0_JPRB + ZZP*(PMFU(JL, IK) + PMFD(JL, IK))
(  424)             ELSE
(  425)               ZB(JL, JK) = 1.0_JPRB
(  426)             END IF
(  427)             IF (LDTDKMF) THEN
(  428)               ZDTDT(JL, JK) = ZDTDT(JL, JK)*PTSPHY + PTEN(JL, JK)
(  429)               ZDQDT(JL, JK) = ZDQDT(JL, JK)*PTSPHY + PQEN(JL, JK)
(  430)             ELSE
(  431)               ZZP = YDCST%RG*(PMFU(JL, JK) + YDECUMF%RMFADVWDD*PMFD(JL, JK)) / (PAP(JL, JK) - PAP(JL, IM))*PTSPHY*ZADVW(JL)
(  432)               ZS = ZZP*(PTEN(JL, IM) - PTEN(JL, JK) + ZORCPD*(PGEO(JL, IM) - PGEO(JL, JK)))
(  433)               ZQ = ZZP*(PQEN(JL, IM) - PQEN(JL, JK))
(  434)               ZDTDT(JL, JK) = (ZDTDT(JL, JK) + PTENT(JL, JK)*YDECUMF%RMFSOLRHS)*PTSPHY + PTEN(JL, JK) - ZS
