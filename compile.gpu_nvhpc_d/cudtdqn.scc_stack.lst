(  317)         ZINT = ZINT + YDCST%RLMLT*(PLGLAC(JL, JK) - PDPMEL(JL, JK)) + ZALV(JL, JK)*PMFUL(JL, JK) + ZALV2(JL, JK)*PDMFUP(JL, 
