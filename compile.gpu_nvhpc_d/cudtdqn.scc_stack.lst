(  210) !$acc data present( KTYPE, KCTOP, KCBOT, KDTOP, LDCUM, LDDRAF, LSCVFLAG, PAPH, PAP, PGEOH, PGEO, PTEN, PTENH, PQEN, PQENH,  
(  211) !$acc & PQSEN, PLGLAC, PLUDE, PLUDELI, PSNDE, PMFU, PMFD, PMFUS, PMFDS, PMFUQ, PMFDQ, PMFUL, PDMFUP, PDPMEL, PMFLXR, PMFLXS,
(  212) !$acc & PTENT, PTENQ, PENTH, YDTHF, YDCST, YDEPHLI, YDPHNC, YDECUMF, YDEPHY )
(  213)     
(  214)     !----------------------------------------------------------------------
(  215)     
(  216)     !*    1.0          SETUP AND INITIALIZATIONS
(  217)     !                  -------------------------
(  218)     
(  219)     ZIMP = 1.0_JPRB - YDECUMF%RMFSOLTQ
(  220)     ZTSPHY = 1.0_JPRB / PTSPHY
(  221)     ZORCPD = 1.0_JPRB / YDCST%RCPD
(  222)     
(  223) !$acc loop vector
(  224)     DO JL=KIDIA,KFDIA






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 5

(  225)       ZADVW(JL) = 0.0_JPRB
(  226)       IF (KTYPE(JL) == 1) ZADVW(JL) = YDECUMF%RMFADVW
(  227)       
(  228) !$acc loop seq
(  229)       DO JK=1,KLEV
(  230)         PENTH(JL, JK) = 0.0_JPRB
(  231)       END DO
(  232)       
(  233)       !         MASS-FLUX APPROACH SWITCHED ON FOR DEEP CONVECTION ONLY
(  234)       !         IN THE TANGENT-LINEAR AND ADJOINT VERSIONS
(  235)       
(  236)       IF (KTYPE(JL) /= 1 .and. YDEPHLI%LPHYLIN) LDCUM(JL) = .false.
(  237)       
(  238)       ! zero detrained liquid water if diagnostic cloud scheme to be used
(  239)       
(  240)       ! this means that detrained liquid water will be evaporated in the
(  241)       ! cloud environment and not fed directly into a cloud liquid water
(  242)       ! variable
(  243)       
(  244)       LLTEST = .not.YDEPHY%LEPCLD .and. .not.YDPHNC%LENCLD2 .and. .not.YDPHNC%LEPCLD2 .or. YDEPHLI%LPHYLIN .and.  &
(  245)       & .not.YDPHNC%LENCLD2 .and. .not.YDPHNC%LEPCLD2
(  246)       
(  247)       IF (LLTEST) THEN
(  248) !$acc loop seq
(  249)         DO JK=1,KLEV
(  250)           PLUDE(JL, JK) = 0.0_JPRB
(  251)           PLUDELI(JL, JK, 1) = 0.0_JPRB
(  252)           PLUDELI(JL, JK, 2) = 0.0_JPRB
(  253)         END DO
(  254)       END IF
(  255)       
(  256) !$acc loop seq
(  257)       DO JK=1,KLEV
(  258)         IF (LDCUM(JL)) THEN
(  259)           ZDP(JL, JK) = YDCST%RG / (PAPH(JL, JK + 1) - PAPH(JL, JK))
(  260)           ZMFUS(JL, JK) = PMFUS(JL, JK)
(  261)           ZMFDS(JL, JK) = PMFDS(JL, JK)
(  262)           ZMFUQ(JL, JK) = PMFUQ(JL, JK)
(  263)           ZMFDQ(JL, JK) = PMFDQ(JL, JK)
(  264)         END IF
(  265)       END DO
(  266)       
(  267)       !------------------------------------------------------------------------------
(  268)       
(  269)       IF (YDECUMF%RMFSOLTQ > 0.0_JPRB) THEN
(  270)         
(  271)         !*    2.0          RECOMPUTE CONVECTIVE FLUXES IF IMPLICIT
(  272)         
(  273) !$acc loop seq
(  274)         DO JK=KTOPM2,KLEV
(  275)           IK = JK - 1
(  276)           !DIR$ IVDEP
(  277)           !OCL NOVREC
(  278)           IF (LDCUM(JL) .and. JK >= -1 + KCTOP(JL)) THEN
(  279)             ! compute interpolating coefficients ZGS and ZGQ for half-level values
(  280)             ZGQ = (PQENH(JL, JK) - PQEN(JL, IK)) / PQSEN(JL, JK)
(  281)             ZGH = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK)
(  282)             ZGS = (YDCST%RCPD*(PTENH(JL, JK) - PTEN(JL, IK)) + PGEOH(JL, JK) - PGEO(JL, IK)) / ZGH






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 6

(  283)             
(  284)             !half-level environmental values for S and Q
(  285)             ZS = YDCST%RCPD*(ZIMP*PTEN(JL, IK) + ZGS*PTEN(JL, JK)) + PGEO(JL, IK) + ZGS*PGEO(JL, JK)
(  286)             ZQ = ZIMP*PQEN(JL, IK) + ZGQ*PQSEN(JL, JK)
(  287)             ZMFUS(JL, JK) = PMFUS(JL, JK) - PMFU(JL, JK)*ZS
(  288)             ZMFUQ(JL, JK) = PMFUQ(JL, JK) - PMFU(JL, JK)*ZQ
(  289)             IF (LDDRAF(JL) .and. JK >= KDTOP(JL)) THEN
(  290)               ZMFDS(JL, JK) = PMFDS(JL, JK) - PMFD(JL, JK)*ZS
(  291)               ZMFDQ(JL, JK) = PMFDQ(JL, JK) - PMFD(JL, JK)*ZQ
(  292)             END IF
(  293)           END IF
(  294)         END DO
(  295)         
(  296)       END IF
(  297)       
(  298)       !*    3.0          COMPUTE TENDENCIES
(  299)       !                  ------------------
(  300)       
(  301)       ZINT = 0._JPRB
(  302) !$acc loop seq
(  303)       DO JK=KTOPM2,KLEV
(  304)         ZALV(JL, JK) = FOELHMCU(PTEN(JL, JK))
(  305)         ZALV2(JL, JK) = ZALV(JL, JK)
(  306)       END DO
(  307)       IF (YDECUMF%LMFENTHCONS) THEN
(  308)         ! Integrals for conservation correction ice-phase
(  309) !$acc loop seq
(  310)         DO JK=KTOPM2,KLEV - 1
(  311)           IF (LSCVFLAG(JL)) ZALV(JL, JK) = YDCST%RLVTT
(  312)           ZINT = ZINT + YDCST%RLMLT*(PLGLAC(JL, JK) - PDPMEL(JL, JK)) - ZALV(JL, JK)*(PMFUL(JL, JK + 1) - PMFUL(JL, JK)) +  
(  313)           & ZALV2(JL, JK)*PDMFUP(JL, JK)
(  314)         END DO
(  315)         JK = KLEV
