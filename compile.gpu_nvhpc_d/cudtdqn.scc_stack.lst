(   15)     
(   16)     !     PARAMETER     DESCRIPTION                                   UNITS
(   17)     !     ---------     -----------                                   -----
(   18)     !     INPUT PARAMETERS (INTEGER):
(   19)     
(   20)     !    *KIDIA*        START POINT
(   21)     !    *KFDIA*        END POINT
(   22)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   23)     !    *KLEV*         NUMBER OF LEVELS
