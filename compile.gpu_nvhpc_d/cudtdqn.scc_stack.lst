(   53)     !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(   54)     !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
(   55)     !    *PMFUS*        FLUX OF DRY STATIC ENERGY IN UPDRAFTS          J/(M2*S)
(   56)     !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS        J/(M2*S)
(   57)     !    *PMFUQ*        FLUX OF SPEC. HUMIDITY IN UPDRAFTS            KG/(M2*S)
(   58)     !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS          KG/(M2*S)
(   59)     !    *PMFUL*        FLUX OF LIQUID WATER IN UPDRAFTS              KG/(M2*S)
(   60)     !    *PDMFUP*       FLUX DIFFERENCE OF PRECIP.                    KG/(M2*S)
(   61)     !    *PDPMEL*       CHANGE IN PRECIP.-FLUXES DUE TO MELTING       KG/(M2*S)
(   62)     
(   63)     !    UPDATED PARAMETERS (REAL):
(   64)     
(   65)     !    *PTENT*        TEMPERATURE TENDENCY                           K/S
(   66)     !    *PTENQ*        MOISTURE TENDENCY                             KG/(KG S)
(   67)     
(   68)     !    OUTPUT PARAMETERS (REAL):
(   69)     
(   70)     !    *PENTH*        INCREMENT OF DRY STATIC ENERGY                 J/(KG*S)
