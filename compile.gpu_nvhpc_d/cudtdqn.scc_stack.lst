(   50)     !    *PLUDE*        DETRAINED CONDENSATE                          KG/(M2*S)
(   51)     !    *PLUDELI*      DETRAINED LIQUID, ICE                         KG/(M2*S)
(   52)     !    *PSNDE*        DETRAINED SNOW/RAIN                           KG/(M2*S)
(   53)     !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(   54)     !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
