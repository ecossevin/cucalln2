(  459)               PTENQ(JL, JK) = PTENQ(JL, JK)*(1.0_JPRB - YDECUMF%RMFSOLRHS) + (ZR2(JL, JK) - PQEN(JL, JK))*ZTSPHY
(  460)             END IF
(  461)             PENTH(JL, JK) = (ZR1(JL, JK) - PTEN(JL, JK))*ZTSPHY
