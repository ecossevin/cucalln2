(  211) !$acc & PQSEN, PLGLAC, PLUDE, PLUDELI, PSNDE, PMFU, PMFD, PMFUS, PMFDS, PMFUQ, PMFDQ, PMFUL, PDMFUP, PDPMEL, PMFLXR, PMFLXS,  &
(  212) !$acc & PTENT, PTENQ, PENTH, YDTHF, YDCST, YDEPHLI, YDPHNC, YDECUMF, YDEPHY )
(  213)     
(  214)     !----------------------------------------------------------------------
(  215)     
(  216)     !*    1.0          SETUP AND INITIALIZATIONS
(  217)     !                  -------------------------
(  218)     
(  219)     ZIMP = 1.0_JPRB - YDECUMF%RMFSOLTQ
(  220)     ZTSPHY = 1.0_JPRB / PTSPHY
(  221)     ZORCPD = 1.0_JPRB / YDCST%RCPD
(  222)     
(  223) !$acc loop vector






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 17

(  224)     DO JL=KIDIA,KFDIA
(  225)       ZADVW(JL) = 0.0_JPRB
(  226)       IF (KTYPE(JL) == 1) ZADVW(JL) = YDECUMF%RMFADVW
(  227)       
(  228) !$acc loop seq
(  229)       DO JK=1,KLEV
(  230)         PENTH(JL, JK) = 0.0_JPRB
(  231)       END DO
(  232)       
(  233)       !         MASS-FLUX APPROACH SWITCHED ON FOR DEEP CONVECTION ONLY
(  234)       !         IN THE TANGENT-LINEAR AND ADJOINT VERSIONS
(  235)       
(  236)       IF (KTYPE(JL) /= 1 .and. YDEPHLI%LPHYLIN) LDCUM(JL) = .false.
(  237)       
(  238)       ! zero detrained liquid water if diagnostic cloud scheme to be used
(  239)       
(  240)       ! this means that detrained liquid water will be evaporated in the
(  241)       ! cloud environment and not fed directly into a cloud liquid water
(  242)       ! variable
(  243)       
(  244)       LLTEST = .not.YDEPHY%LEPCLD .and. .not.YDPHNC%LENCLD2 .and. .not.YDPHNC%LEPCLD2 .or. YDEPHLI%LPHYLIN .and.  &
(  245)       & .not.YDPHNC%LENCLD2 .and. .not.YDPHNC%LEPCLD2
(  246)       
(  247)       IF (LLTEST) THEN
(  248) !$acc loop seq
(  249)         DO JK=1,KLEV
(  250)           PLUDE(JL, JK) = 0.0_JPRB
(  251)           PLUDELI(JL, JK, 1) = 0.0_JPRB
(  252)           PLUDELI(JL, JK, 2) = 0.0_JPRB
(  253)         END DO
(  254)       END IF
(  255)       
(  256) !$acc loop seq
(  257)       DO JK=1,KLEV
(  258)         IF (LDCUM(JL)) THEN
(  259)           ZDP(JL, JK) = YDCST%RG / (PAPH(JL, JK + 1) - PAPH(JL, JK))
(  260)           ZMFUS(JL, JK) = PMFUS(JL, JK)
(  261)           ZMFDS(JL, JK) = PMFDS(JL, JK)
(  262)           ZMFUQ(JL, JK) = PMFUQ(JL, JK)
(  263)           ZMFDQ(JL, JK) = PMFDQ(JL, JK)
(  264)         END IF
(  265)       END DO
(  266)       
(  267)       !------------------------------------------------------------------------------
(  268)       
(  269)       IF (YDECUMF%RMFSOLTQ > 0.0_JPRB) THEN
(  270)         
(  271)         !*    2.0          RECOMPUTE CONVECTIVE FLUXES IF IMPLICIT
(  272)         
(  273) !$acc loop seq
(  274)         DO JK=KTOPM2,KLEV
(  275)           IK = JK - 1
(  276)           !DIR$ IVDEP
(  277)           !OCL NOVREC
(  278)           IF (LDCUM(JL) .and. JK >= -1 + KCTOP(JL)) THEN
(  279)             ! compute interpolating coefficients ZGS and ZGQ for half-level values
(  280)             ZGQ = (PQENH(JL, JK) - PQEN(JL, IK)) / PQSEN(JL, JK)
(  281)             ZGH = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 18

(  282)             ZGS = (YDCST%RCPD*(PTENH(JL, JK) - PTEN(JL, IK)) + PGEOH(JL, JK) - PGEO(JL, IK)) / ZGH
(  283)             
(  284)             !half-level environmental values for S and Q
(  285)             ZS = YDCST%RCPD*(ZIMP*PTEN(JL, IK) + ZGS*PTEN(JL, JK)) + PGEO(JL, IK) + ZGS*PGEO(JL, JK)
(  286)             ZQ = ZIMP*PQEN(JL, IK) + ZGQ*PQSEN(JL, JK)
(  287)             ZMFUS(JL, JK) = PMFUS(JL, JK) - PMFU(JL, JK)*ZS
(  288)             ZMFUQ(JL, JK) = PMFUQ(JL, JK) - PMFU(JL, JK)*ZQ
(  289)             IF (LDDRAF(JL) .and. JK >= KDTOP(JL)) THEN
(  290)               ZMFDS(JL, JK) = PMFDS(JL, JK) - PMFD(JL, JK)*ZS
(  291)               ZMFDQ(JL, JK) = PMFDQ(JL, JK) - PMFD(JL, JK)*ZQ
(  292)             END IF
(  293)           END IF
(  294)         END DO
(  295)         
(  296)       END IF
(  297)       
(  298)       !*    3.0          COMPUTE TENDENCIES
(  299)       !                  ------------------
(  300)       
(  301)       ZINT = 0._JPRB
(  302) !$acc loop seq
(  303)       DO JK=KTOPM2,KLEV
(  304)         ZALV(JL, JK) = FOELHMCU(PTEN(JL, JK))
(  305)         ZALV2(JL, JK) = ZALV(JL, JK)
(  306)       END DO
(  307)       IF (YDECUMF%LMFENTHCONS) THEN
(  308)         ! Integrals for conservation correction ice-phase
(  309) !$acc loop seq
(  310)         DO JK=KTOPM2,KLEV - 1
(  311)           IF (LSCVFLAG(JL)) ZALV(JL, JK) = YDCST%RLVTT
(  312)           ZINT = ZINT + YDCST%RLMLT*(PLGLAC(JL, JK) - PDPMEL(JL, JK)) - ZALV(JL, JK)*(PMFUL(JL, JK + 1) - PMFUL(JL, JK)) +  &
(  313)           & ZALV2(JL, JK)*PDMFUP(JL, JK)
(  314)         END DO
(  315)         JK = KLEV
(  316)         IF (LSCVFLAG(JL)) ZALV(JL, JK) = YDCST%RLVTT
(  317)         ZINT = ZINT + YDCST%RLMLT*(PLGLAC(JL, JK) - PDPMEL(JL, JK)) + ZALV(JL, JK)*PMFUL(JL, JK) + ZALV2(JL, JK)*PDMFUP(JL, JK)
(  318)         ZINT2 = ZINT - YDCST%RLVTT*PMFLXR(JL, KLEV + 1) - YDCST%RLSTT*PMFLXS(JL, KLEV + 1)
(  319)         IF (ABS(ZINT) > 0.1_JPRB) THEN
(  320)           ZINT = ZINT2 / (ZINT + 1.E-3_JPRB)
(  321)         ELSE
(  322)           ZINT = 0.0_JPRB
(  323)         END IF
(  324)         IF (ABS(ZINT) > 2.0_JPRB) ZINT = 0.0_JPRB
(  325)       END IF
(  326)       
(  327) !$acc loop seq
(  328)       DO JK=KTOPM2,KLEV
(  329)         
(  330)         IF (JK < KLEV) THEN
(  331)           IF (LDCUM(JL)) THEN
(  332)             IF (YDEPHLI%LPHYLIN) THEN
(  333)               ZTARG = PTEN(JL, JK)
(  334)               ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  335)               ZALV(JL, JK) = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT
(  336)               ZALV2(JL, JK) = ZALV(JL, JK)
(  337)             END IF
(  338)             IF (LDTDKMF) THEN
(  339)               ZDTDT(JL, JK) = ZDP(JL, JK)*ZORCPD*(ZMFUS(JL, JK + 1) - ZMFUS(JL, JK) + ZMFDS(JL, JK + 1) - ZMFDS(JL, JK) +  &






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 19

(  340)               & YDCST%RLMLT*PLGLAC(JL, JK) - YDCST%RLMLT*PDPMEL(JL, JK) - ZALV(JL, JK)*(PMFUL(JL, JK + 1) - PMFUL(JL, JK) -  &
(  341)               & PLUDE(JL, JK) - PDMFUP(JL, JK)))
(  342)               
(  343)               ZDQDT(JL, JK) = ZDP(JL, JK)*(ZMFUQ(JL, JK + 1) - ZMFUQ(JL, JK) + ZMFDQ(JL, JK + 1) - ZMFDQ(JL, JK) + PMFUL(JL, JK + &
(  344)               &  1) - PMFUL(JL, JK) - PLUDE(JL, JK) - PDMFUP(JL, JK))
(  345)             ELSE
(  346)               ZDTDT(JL, JK) = ZDP(JL, JK)*ZORCPD*(ZMFUS(JL, JK + 1) - ZMFUS(JL, JK) + ZMFDS(JL, JK + 1) - ZMFDS(JL, JK) +  &
(  347)               & (YDCST%RLMLT*(PLGLAC(JL, JK) - PDPMEL(JL, JK)) - ZALV(JL, JK)*(PMFUL(JL, JK + 1) - PMFUL(JL, JK)) + ZALV2(JL, JK) &
(  348)               & *PDMFUP(JL, JK))*(1.0_JPRB - ZINT) + YDCST%RLVTT*(PLUDELI(JL, JK, 1) + PSNDE(JL, JK, 1)) +  &
(  349)               & YDCST%RLSTT*(PLUDELI(JL, JK, 2) + PSNDE(JL, JK, 2)))
(  350)               
(  351)               ZDQDT(JL, JK) = ZDP(JL, JK)*(ZMFUQ(JL, JK + 1) - ZMFUQ(JL, JK) + ZMFDQ(JL, JK + 1) - ZMFDQ(JL, JK) + PMFUL(JL, JK + &
(  352)               &  1) - PMFUL(JL, JK) - PLUDE(JL, JK) - PDMFUP(JL, JK) - PSNDE(JL, JK, 1) - PSNDE(JL, JK, 2))
(  353)             END IF
(  354)           END IF
(  355)           
(  356)         ELSE
(  357)           IF (LDCUM(JL)) THEN
(  358)             IF (YDEPHLI%LPHYLIN) THEN
(  359)               ZTARG = PTEN(JL, JK)
(  360)               ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  361)               ZALV(JL, JK) = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT
(  362)               ZALV2(JL, JK) = ZALV(JL, JK)
(  363)             END IF
(  364)             ZDTDT(JL, JK) = -ZDP(JL, JK)*ZORCPD*(ZMFUS(JL, JK) + ZMFDS(JL, JK) + (YDCST%RLMLT*(PDPMEL(JL, JK) - PLGLAC(JL, JK)) - &
(  365)             &  ZALV(JL, JK)*PMFUL(JL, JK) - ZALV2(JL, JK)*PDMFUP(JL, JK))*(1.0_JPRB - ZINT))
(  366)             
(  367)             ZDQDT(JL, JK) = -ZDP(JL, JK)*(ZMFUQ(JL, JK) + ZMFDQ(JL, JK) + (PMFUL(JL, JK) + PDMFUP(JL, JK)))
(  368)           END IF
(  369)         END IF
(  370)         
(  371)       END DO
(  372)     END DO
(  373)     
(  374)     
(  375)     IF (YDECUMF%RMFSOLTQ == 0.0_JPRB) THEN
(  376)       
(  377)       !*    3.1          UPDATE TENDENCIES
(  378)       !                  -----------------
(  379)       
(  380)       
(  381) !$acc loop vector
(  382)       DO JL=KIDIA,KFDIA
(  383) !$acc loop seq
(  384)         DO JK=KTOPM2,KLEV
(  385)           IF (LDCUM(JL)) THEN
(  386)             PTENT(JL, JK) = PTENT(JL, JK) + ZDTDT(JL, JK)
(  387)             PTENQ(JL, JK) = PTENQ(JL, JK) + ZDQDT(JL, JK)
(  388)             PENTH(JL, JK) = ZDTDT(JL, JK)*YDCST%RCPD
(  389)           END IF
(  390)         END DO
(  391)       END DO
(  392)       
(  393)       
(  394)     ELSE
(  395)       !----------------------------------------------------------------------
(  396)       
(  397)       !*    3.2          IMPLICIT SOLUTION






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 20

(  398)       !                  -----------------
(  399)       
(  400)       ! Fill bi-diagonal Matrix vectors A=k-1, B=k, C=k+1;
(  401)       ! reuse ZMFUS=A
(  402)       ! ZDTDT and ZDQDT correspond to the RHS ("constants") of the equation
(  403)       ! The solution is in ZR1 and ZR2
(  404)       
(  405)       LLCUMBAS(:, :) = .false.
(  406)       ZB(:, :) = 1.0_JPRB
(  407)       ZMFUS(:, :) = 0.0_JPRB
(  408)       
(  409)       ! Fill vectors A, B and RHS
(  410)       
(  411)       
(  412) !$acc loop vector
(  413)       DO JL=KIDIA,KFDIA
(  414) !$acc loop seq
(  415)         DO JK=KTOPM2,KLEV
(  416)           IK = JK + 1
(  417)           IM = JK - 1
(  418)           LLCUMBAS(JL, JK) = LDCUM(JL) .and. JK >= KCTOP(JL) - 1
(  419)           IF (LLCUMBAS(JL, JK)) THEN
(  420)             ZZP = YDECUMF%RMFSOLTQ*ZDP(JL, JK)*PTSPHY
(  421)             ZMFUS(JL, JK) = -ZZP*(PMFU(JL, JK) + PMFD(JL, JK))
(  422)             IF (JK < KLEV) THEN
(  423)               ZB(JL, JK) = 1.0_JPRB + ZZP*(PMFU(JL, IK) + PMFD(JL, IK))
(  424)             ELSE
(  425)               ZB(JL, JK) = 1.0_JPRB
(  426)             END IF
(  427)             IF (LDTDKMF) THEN
(  428)               ZDTDT(JL, JK) = ZDTDT(JL, JK)*PTSPHY + PTEN(JL, JK)
(  429)               ZDQDT(JL, JK) = ZDQDT(JL, JK)*PTSPHY + PQEN(JL, JK)
(  430)             ELSE
(  431)               ZZP = YDCST%RG*(PMFU(JL, JK) + YDECUMF%RMFADVWDD*PMFD(JL, JK)) / (PAP(JL, JK) - PAP(JL, IM))*PTSPHY*ZADVW(JL)
(  432)               ZS = ZZP*(PTEN(JL, IM) - PTEN(JL, JK) + ZORCPD*(PGEO(JL, IM) - PGEO(JL, JK)))
(  433)               ZQ = ZZP*(PQEN(JL, IM) - PQEN(JL, JK))
(  434)               ZDTDT(JL, JK) = (ZDTDT(JL, JK) + PTENT(JL, JK)*YDECUMF%RMFSOLRHS)*PTSPHY + PTEN(JL, JK) - ZS
(  435)               ZDQDT(JL, JK) = (ZDQDT(JL, JK) + PTENQ(JL, JK)*YDECUMF%RMFSOLRHS)*PTSPHY + PQEN(JL, JK) - ZQ
(  436)             END IF
(  437)           END IF
(  438)         END DO
(  439)       END DO
(  440)       
(  441)       
(  442)       CALL CUBIDIAG_LOKI(KIDIA, KFDIA, KLON, KLEV, KCTOP, LLCUMBAS, ZMFUS, ZB, ZDTDT, ZR1, YDSTACK_L=YLSTACK_L)
(  443)       
(  444)       CALL CUBIDIAG_LOKI(KIDIA, KFDIA, KLON, KLEV, KCTOP, LLCUMBAS, ZMFUS, ZB, ZDQDT, ZR2, YDSTACK_L=YLSTACK_L)
(  445)       
(  446)       ! Compute tendencies
(  447)       
(  448)       
(  449) !$acc loop vector
(  450)       DO JL=KIDIA,KFDIA
(  451) !$acc loop seq
(  452)         DO JK=KTOPM2,KLEV
(  453)           IF (LLCUMBAS(JL, JK)) THEN
(  454)             IF (LDTDKMF) THEN
(  455)               PTENT(JL, JK) = PTENT(JL, JK) + (ZR1(JL, JK) - PTEN(JL, JK))*ZTSPHY






NVFORTRAN (Version     24.5)          03/24/2025  13:20:26      page 21

(  456)               PTENQ(JL, JK) = PTENQ(JL, JK) + (ZR2(JL, JK) - PQEN(JL, JK))*ZTSPHY
(  457)             ELSE
(  458)               PTENT(JL, JK) = PTENT(JL, JK)*(1.0_JPRB - YDECUMF%RMFSOLRHS) + (ZR1(JL, JK) - PTEN(JL, JK))*ZTSPHY
(  459)               PTENQ(JL, JK) = PTENQ(JL, JK)*(1.0_JPRB - YDECUMF%RMFSOLRHS) + (ZR2(JL, JK) - PQEN(JL, JK))*ZTSPHY
(  460)             END IF
(  461)             PENTH(JL, JK) = (ZR1(JL, JK) - PTEN(JL, JK))*ZTSPHY
(  462)           END IF
(  463)         END DO
(  464)       END DO
(  465)       
(  466)       
(  467)       !----------------------------------------------------------------------
(  468)     END IF
