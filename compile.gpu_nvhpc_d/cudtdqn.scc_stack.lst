(   25)     !                       1 = PENETRATIVE CONVECTION
(   26)     !                       2 = SHALLOW CONVECTION
(   27)     !                       3 = MIDLEVEL CONVECTION
(   28)     !    *KCTOP*        CLOUD TOP LEVEL
(   29)     !    *KCBOT*        CLOUD BASE LEVEL
(   30)     !    *KDTOP*        TOP LEVEL OF DOWNDRAFTS
(   31)     
(   32)     !    INPUT PARAMETERS (LOGICAL):
(   33)     
(   34)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   35)     !    *LDDRAF*       FLAG: .TRUE. FOR DOWNDRAFT LEVEL
(   36)     
(   37)     !    INPUT PARAMETERS (REAL):
(   38)     
(   39)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                       S
(   40)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS            PA
(   41)     !    *PAP *         PROVISIONAL PRESSURE ON FULL LEVELS            PA
(   42)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   43)     !    *PGEO*         GEOPOTENTIAL ON FULL LEVELS                   M2/S2
(   44)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   45)     !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   46)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS           K
(   47)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS      KG/KG
(   48)     !    *PQSEN*        SATURATION ENV. SPEC. HUMIDITY (T+1)          KG/KG
(   49)     !    *PLGLAC*       FLUX OF FROZEN CLOUDWATER IN UPDRAFTS         KG/(M2*S)
(   50)     !    *PLUDE*        DETRAINED CONDENSATE                          KG/(M2*S)






