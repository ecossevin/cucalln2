(   83) ELEMENTAL SUBROUTINE XRD_LOWER_CASE(OUS,INS)
(   84) IMPLICIT NONE
(   85) ! CONVERT A WORD TO LOWER CASE
(   86) CHARACTER (LEN=*) , INTENT(OUT) :: OUS
(   87) CHARACTER (LEN=*) , INTENT(IN) :: INS
(   88) INTEGER :: I,IC,NLEN
(   89) NLEN = LEN(INS)
(   90) OUS = ''
(   91) DO I=1,NLEN
(   92)    IC = ICHAR(INS(I:I))
