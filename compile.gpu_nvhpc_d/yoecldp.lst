(   71) !     *NCLDDIAG*INTEGER   CONTROLS CLOUDSC DIAGNOSTICS IN PEXTRA
(   72) !     *NCLV*     INTEGER   NUMBER OF PROGNOSTIC EQUATIONS IN CLOUDSC 
(   73) !                         (INCLUDES WATER VAPOUR AS DUMMY VARIABLE) 
(   74) !      NAERCLD         INT  INDEX TO CONTROL SWITCHES FOR 
(   75) !                           AEROSOL-MICROPHYSICS INTERACTION, LAER*
(   76) !      NAECLxx         INT  INDEX OF GEMS AEROSOLS USED IN AEROSOL-CLOUD INTERACTIONS
(   77) !      RCCN            REAL DEFAULT CCN (CM-3)
(   78) !      RNICE           REAL DEFAULT ICE NUMBER CONCENTRATION (CM-3)
(   79) !      LAERLIQAUTOLSP  LOG  AEROSOLS AFFECT RAIN AUTOCONVERSION IN LSP
(   80) !      LAERLIQAUTOCP   LOG  AEROSOLS AFFECT RAIN AUTOCONVERSION IN CP
(   81) !      LAERLIQCOLL     LOG  AEROSOLS AFFECT RAIN COLLECTION 
(   82) !      LAERICESED      LOG  AEROSOLS AFFECT ICE SEDIMENTATION
(   83) !      LAERICEAUTO     LOG  AEROSOLS AFFECT ICE AUTOCONVERSION
(   84) !      RCCNOM          REAL CONSTANT IN MENON PARAM FOR ORGANIC MATTER -> CCN
(   85) !      RCCNSS          REAL CONSTANT IN MENON PARAM SEA SALT -> CCN
(   86) !      RCCNSU          REAL CONSTANT IN MENON PARAM FOR SULPHATE -> CCN
(   87) !      RCLDTOPCF       REAL Cloud fraction threshold that defines cloud top 
(   88) !      RDEPLIQREFRATE  REAL Fraction of deposition rate in cloud top layer
(   89) !      RDEPLIQREFDEPTH REAL Depth of supercooled liquid water layer (m)
(   90) !      RCL_OVERLAPLIQICE REAL overlap of liquid and ice cloud fractions
(   91) !      RCL_EFFRIME       REAL riming efficiency coefficient
(   92) !      RVRFACTOR       REAL KESSLER FACTOR=5.09E-3 FOR EVAPORATION OF CLEAR-SKY RAIN  (KESSLER,1969)
(   93) !      RCL_INHOMOGAUT  REAL Constant for autoconversion inhomogeneity factor
(   94) !      RCL_INHOMOGACC  REAL Constant for accretion inhomogeneity factor
(   95) !      LCLOUD_INHOMOG  LOG  switch on regime-dependent FSD use for calculation of ZEaut and ZEacc
(   96) !      RTAU_CLD_TLAD   REAL Relaxation factor of semi-prognostic cloud towards
(   97) !                           its non-linear trajecotry (TL/AD)
(   98) 
(   99) INTEGER(KIND=JPIM),PARAMETER :: NCLV=5      ! number of microphysics variables
(  100) INTEGER(KIND=JPIM),PARAMETER :: NCLDQL=1    ! liquid cloud water
(  101) INTEGER(KIND=JPIM),PARAMETER :: NCLDQI=2    ! ice cloud water
(  102) INTEGER(KIND=JPIM),PARAMETER :: NCLDQR=3    ! rain water
(  103) INTEGER(KIND=JPIM),PARAMETER :: NCLDQS=4    ! snow
(  104) INTEGER(KIND=JPIM),PARAMETER :: NCLDQV=5    ! vapour
(  105) 
(  106) ! Number of precipitation types in WMO Code Table 4.201
(  107) INTEGER(KIND=JPIM),PARAMETER :: NPRECTYPES=12
