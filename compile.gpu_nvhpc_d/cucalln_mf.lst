(  307) !*    0.1          STORE T,Q,X,Y TENDENCIES FOR FLUX COMPUTATIONS
(  308) !*                 ----------------------------------------------
(  309) 
(  310) IF (LHOOK) CALL DR_HOOK('CUCALLN_MF',0,ZHOOK_HANDLE)
(  311) ASSOCIATE(NJKT2=>YDML_PHY_EC%YRECUMF%NJKT2, &
(  312)  & LPHYLIN=>YDML_PHY_SLIN%YREPHLI%LPHYLIN, RLPTRC=>YDML_PHY_SLIN%YREPHLI%RLPTRC, &
(  313)  & LEPCLD=>YDML_PHY_EC%YREPHY%LEPCLD, LMFTRAC=>YDML_PHY_EC%YREPHY%LMFTRAC, &
(  314)  & RCPD=>YDCST%RCPD, RG=>YDCST%RG, RLSTT=>YDCST%RLSTT, RLVTT=>YDCST%RLVTT, &
(  315)  & RVTMP2=>YDTHF%RVTMP2, &
(  316)  & LENCLD2=>YDML_PHY_SLIN%YRPHNC%LENCLD2)
(  317) 
(  318) ! Setup of tendencies
(  319) DO JK=1,KLEV
(  320)   DO JL=KIDIA,KFDIA
(  321)     ZQEA(JL,JK)=PTENQ(JL,JK)
(  322)     ZTEA(JL,JK)=PTENT(JL,JK)
(  323)     ZVEA(JL,JK)=PTENV(JL,JK)
(  324)     ZUEA(JL,JK)=PTENU(JL,JK)
(  325)     ZENTHD(JL,JK)=0.0_JPRB
(  326)     ZENTHS(JL,JK)=0.0_JPRB
(  327)   ENDDO
(  328) ENDDO
(  329) 
(  330) DO JK=1,KLEV+1
(  331)   DO JL=KIDIA,KFDIA
(  332)     PFPLCL(JL,JK)=0.0_JPRB
(  333)     PFPLCN(JL,JK)=0.0_JPRB
(  334)   ENDDO
(  335) ENDDO
(  336) 
(  337) !-----------------------------------------------------------------------
(  338) 
(  339) !*    1.           UPDATE PROGN. VALUES DEPENDING ON 
(  340) !                  TIME INTEGRATION AND CALCULATE QS






NVFORTRAN (Version     24.5)          03/19/2025  06:56:02      page 7

(  341) !*                 ---------------------------------
(  342) !-------------------------------------------------
(  343) ! Protection in division. ZEPS is choosen as 1000 times lower
(  344) ! than the actual values of qv (1.e-7 kg/kg) met in the high atmosphere.
(  345) ! This ZEPS value, used in multiplication only, is relevant for both simple and
(  346) ! double precision purpose.
(  347) !-------------------------------------------------
(  348) ZEPS=1.0E-10_JPRB
(  349) DO JK=1,KLEV
(  350)   DO JL=KIDIA,KFDIA
(  351)     ZUP1(JL,JK)=PUM1(JL,JK)+PTENU(JL,JK)*PTSPHY
(  352)     ZVP1(JL,JK)=PVM1(JL,JK)+PTENV(JL,JK)*PTSPHY
(  353)     ZTP1(JL,JK)=PTM1(JL,JK)+PTENT(JL,JK)*PTSPHY
(  354)     ZQP1(JL,JK)=PQM1(JL,JK)+PTENQ(JL,JK)*PTSPHY
(  355)     ZQSAT(JL,JK)=ZQP1(JL,JK)
(  356)     IF(ZQSAT(JL,JK)<=0.0_JPRB) ZQSAT(JL,JK)=ZEPS
(  357)   ENDDO
(  358) ENDDO
(  359) 
(  360) IF ( LDSLPHY ) THEN
(  361)   IF(KTRAC>0 .AND. LMFTRAC) THEN
(  362)     DO JN=1,KTRAC
(  363)       DO JK=1,KLEV
(  364)         DO JL=KIDIA,KFDIA
(  365)    ! attention: transport is for positive definit quantities only
(  366)         ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN))
(  367)           ZCP1(JL,JK,JN)=PCM1(JL,JK,JN)
(  368)         ENDDO
(  369)       ENDDO
(  370)     ENDDO
(  371)   ENDIF
(  372) ELSE
(  373)   IF(KTRAC>0 .AND. LMFTRAC) THEN
(  374)     DO JN=1,KTRAC
(  375)       DO JK=1,KLEV
(  376)         DO JL=KIDIA,KFDIA
(  377)    ! attention: transport is for positive definit quantities only
(  378)         ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN)+PTENC(JL,JK,JN)*PTSPHY)
(  379)           ZCP1(JL,JK,JN)=PCM1(JL,JK,JN)+PTENC(JL,JK,JN)*PTSPHY
(  380)         ENDDO
(  381)       ENDDO
(  382)     ENDDO
(  383)   ENDIF
(  384) ENDIF
(  385) 
(  386) IFLAG=1
(  387) CALL SATUR (YDTHF, YDCST, KIDIA , KFDIA , KLON  , NJKT2 , KLEV,&
(  388)  & YDML_PHY_SLIN%YREPHLI%LPHYLIN, &
(  389)  & PAP   , ZTP1  , ZQSAT , IFLAG  )  
(  390) 
(  391) DO JL=KIDIA,KFDIA
(  392)   ZRAIN(JL)=0.0_JPRB
(  393) ENDDO
(  394) 
(  395) !-----------------------------------------------------------------------
(  396) 
(  397) !*    2.     CALL 'CUMASTR'(MASTER-ROUTINE FOR CUMULUS PARAMETERIZATION) 
(  398) !*           ----------------------------------------------------------- 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:02      page 8

(  399) 
(  400) LLTDKMF = .TRUE.
(  401) CALL CUMASTRN &
(  402)  & (PPLDARE, PPLRG,    YDTHF,   YDCST,    YDML_PHY_SLIN,   YDML_PHY_EC,   YGFL, &
(  403)  & YDCHEM,   YDSPP_CONFIG,      YDPERTPAR, &
(  404)  & KIDIA,    KFDIA,    KLON,    KLEV, PDX, LLTDKMF, &
(  405)  & LDMCAPEA, LDLAND,   PTSPHY,&
(  406)  & ZTP1,     ZQP1,     ZUP1,     ZVP1,     PLITOT,&
(  407)  & PVERVEL,  ZQSAT,    PQHFL,    PAHFS,&
(  408)  & PAP,      PAPH,     PGEO,     PGEOH, PGAW,&
(  409)  & PCUCONVCA,PGP2DSPP, &
(  410)  & PTENT,    PTENQ,    PTENU,    PTENV, PTENTA, PTENQA,&
(  411)  & LDCUM,    KTYPE,    KCBOT,    KCTOP,&
(  412)  & LDCUM_LIG, KCBOT_LIG, KCTOP_LIG,&
(  413)  & KBOTSC,   LDSC,&
(  414)  & LDSHCV,&
(  415)  & PLCRIT_AER,&
(  416)  & ZTU,      ZQU,      PLU,      PLUDE,  PLUDELI,   PSNDE,&
(  417)  & ZENTHD,   PFPLCL,   PFPLCN,   ZRAIN,  PLRAIN,    PRSUD,&
(  418)  & PMFU,     PMFD,     PLGLAC, &
(  419)  & PMFUDE_RATE,        PMFDDE_RATE,    PCAPE,  PWU, PWMEAN,  PVDISCU, PDISS,&
(  420)  & KTRAC,    ZCP1,     PTENC,    PSCAV, PSCAV0)  
(  421) !----------------------------------------------------------------------
(  422) 
(  423) !*    3.0       CALL 'CUCCDIA' TO UPDATE CLOUD PARAMETERS FOR RADIATION
(  424) !               -------------------------------------------------------
(  425) 
(  426) CALL CUCCDIA &
(  427)  & (YDERAD,  YDML_PHY_SLIN%YREPHLI,  YDML_PHY_EC%YREPHY,&
(  428)  & KIDIA,    KFDIA,    KLON,   KLEV,&
(  429)  & KSTEP,    KCBOT,    KCTOP,&
(  430)  & LDCUM,    ZQU,      PLU,      PMFU,    ZRAIN,&
(  431)  & PARPRC,   KTOPC,    KBASEC                   )  
(  432) 
(  433) 
(  434) !---------------------------------------------------------------------
(  435) 
(  436) !*    5.           FLUX COMPUTATIONS
(  437) !                  -----------------
(  438) 
(  439) DO JL=KIDIA,KFDIA
(  440)   PDIFCQ(JL,1)=0.0_JPRB
(  441)   PDIFCS(JL,1)=0.0_JPRB
(  442)   PSTRCU(JL,1)=0.0_JPRB
(  443)   PSTRCV(JL,1)=0.0_JPRB
(  444)   PFCQLF(JL,1)=0.0_JPRB
(  445)   PFCQIF(JL,1)=0.0_JPRB
(  446)   PFHPCL(JL,1)=0.0_JPRB
(  447)   PFHPCN(JL,1)=0.0_JPRB
(  448)   PDIFCS(JL,1)=0.0_JPRB
(  449)   PDIFCQ(JL,1)=0.0_JPRB
(  450)   ZCONDFLL(JL)=0.0_JPRB
(  451)   ZCONDFLN(JL)=0.0_JPRB
(  452) ENDDO
(  453) 
(  454) DO JK=1,KLEV
(  455)   DO JL=KIDIA,KFDIA
(  456) 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:02      page 9

(  457)     ZGDPH   = -RG/(      PAPHM1(JL,JK+1)-PAPHM1(JL,JK) )
(  458) !...increment in dry static energy is converted to flux of d.s.e.
(  459)     ZCP=RCPD*(1+RVTMP2*ZQP1(JL,JK))
(  460)     PDIFCS(JL,JK+1)=(PTENT(JL,JK)-ZTEA(JL,JK))/ZGDPH*ZCP+ PDIFCS(JL,JK)
(  461) !...increments in U,V
(  462)     PSTRCU(JL,JK+1)=(PTENU(JL,JK)-ZUEA(JL,JK))/ZGDPH + PSTRCU(JL,JK)
(  463)     PSTRCV(JL,JK+1)=(PTENV(JL,JK)-ZVEA(JL,JK))/ZGDPH + PSTRCV(JL,JK)
(  464) 
(  465) !...increment in Q
(  466)     PDIFCQ(JL,JK+1)=(PTENQ(JL,JK)-ZQEA(JL,JK))/ZGDPH + PDIFCQ(JL,JK)
(  467) 
(  468)   ENDDO
(  469) ENDDO
(  470) 
(  471) DO JK=1,KLEV
(  472) !DEC$ IVDEP
(  473)   DO JL=KIDIA,KFDIA
(  474) !... enthalpy flux due to precipitations
(  475) 
(  476)     PFHPCL(JL,JK+1)=-PFPLCL(JL,JK+1)*RLVTT
(  477)     PFHPCN(JL,JK+1)=-PFPLCN(JL,JK+1)*RLSTT
(  478)     ZCONDFLL(JL)=ZCONDFLL(JL) + PLUDELI(JL,JK,1)
(  479)     ZCONDFLN(JL)=ZCONDFLN(JL) + PLUDELI(JL,JK,2)
(  480)     PDIFCS(JL,JK+1)=PDIFCS(JL,JK+1)-PFHPCL(JL,JK+1)-PFHPCN(JL,JK+&
(  481)      & 1)&
(  482)      & + RLVTT * ZCONDFLL(JL) + RLSTT * ZCONDFLN(JL)  
(  483)     PDIFCQ(JL,JK+1)=PDIFCQ(JL,JK+1)-PFPLCL(JL,JK+1)-PFPLCN(JL,JK+&
(  484)      & 1)&
(  485)      & - ZCONDFLL(JL) - ZCONDFLN(JL)  
(  486)     PFCQLF(JL,JK+1)=ZCONDFLL(JL)
(  487)     PFCQIF(JL,JK+1)=ZCONDFLN(JL)
(  488)   ENDDO
(  489) ENDDO
(  490) !---------------------------------------------------------------------
(  491) 
(  492) END ASSOCIATE
(  493) IF (LHOOK) CALL DR_HOOK('CUCALLN_MF',1,ZHOOK_HANDLE)
(  494) END SUBROUTINE CUCALLN_MF


























