(   23)  & KTRAC,    PCM1,     PTENC,    PSCAV, PSCAV0 )  
(   24) 
(   25) !          *CUCALL* - MASTER ROUTINE - PROVIDES INTERFACE FOR:
(   26) !                     *CUMASTR* (CUMULUS PARAMETERIZATION)
(   27) !                     *CUCCDIA* (CUMULUS CLOUDS FOR RADIATION)
(   28) !                     *CUSTRAT* (PBL_STRATOCUMULUS)
(   29) 
(   30) !**   PURPOSE.
(   31) !     --------
(   32) 
(   33) !          *CUCALL* - INTERFACE FOR *CUMASTR*,*CUCCDIA* AND *CUSTRAT*:
(   34) !                     PROVIDES INPUT FOR CUMASTR, CUCCDIA AND CUSTRAT.
(   35) !                     RECEIVES UPDATED TENDENCIES, PRECIPITATION
(   36) !                     AND CONVECTIVE CLOUD PARAMETERS FOR RADIATION.
(   37) 
(   38) !**   INTERFACE.
(   39) !     ----------
(   40) 
(   41) !          *CUCALL* IS CALLED FROM *CALLPAR*
(   42) 
(   43) !     PARAMETER     DESCRIPTION                                   UNITS
(   44) !     ---------     -----------                                   -----
(   45) !     INPUT PARAMETERS (INTEGER):
(   46) 
(   47) !    *KIDIA*        START POINT
(   48) !    *KFDIA*        END POINT
(   49) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   50) !    *KSMAX*        HORIZONTAL SPECTRAL TRUNCATION






NVFORTRAN (Version     24.5)          03/19/2025  06:56:02      page 2

(   51) !    *KLEV*         NUMBER OF LEVELS
(   52) !    *KSPPN2D*      Number of 2D patterns in SPP scheme
(   53) !    *KTRAC*        NUMBER OF CHEMICAL TRACERS
(   54) 
(   55) !     INPUT PARAMETERS (LOGICAL)
(   56) 
(   57) !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   58) 
(   59) !     INPUT PARAMETERS (REAL)
(   60) 
(   61) !    *PTSPHY*       TIME STEP FOR THE PHYSICS                     S
(   62) !    *PTM1*         TEMPERATURE (T-1)                             K
(   63) !    *PQM1*         SPECIFIC HUMIDITY (T-1)                       KG/KG
(   64) !    *PUM1*         X-VELOCITY COMPONENT (T-1)                    M/S
(   65) !    *PVM1*         Y-VELOCITY COMPONENT (T-1)                    M/S
(   66) !    *PCM1*         CHEMICAL TRACERS (T-1)                        KG/KG
(   67) !    *PLITOT*       GRID MEAN LIQUID WATER + ICE CONTENT          KG/KG
(   68) !    *PVERVEL*      VERTICAL VELOCITY                             PA/S
(   69) !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)     KG/(SM2)
(   70) !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   71) !    *PAPHM1*       PRESSURE ON HALF LEVELS                       PA
(   72) !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS           PA 
(   73) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   74) !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   75) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   76) !    *PGAW*       NORMALISED GAUSSIAN QUADRATURE WEIGHT / NUMBER OF LONGITUDE POINTS
(   77) !                           LOCAL SUB-AREA == 4*RPI*RA**2 * PGAW
(   78) !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(   79) !    *PCUCONVCA*    COUPLING TO CELL AUTOMATON OR 2D ADVECT FIELD ( )
(   80) !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   81) 
(   82) !    UPDATED PARAMETERS (REAL):
(   83) 
(   84) !     tendency_cml    cumulative tendency used for final output
(   85) !     tendency_tmp    cumulative tendency used as input
(   86) !     tendency_loc    local tendency from convection
(   87) 
(   88) !    *PTENC*        TENDENCY OF CHEMICAL TRACERS                 1/S
(   89) !    *PARPRC*       ACCUMULATED PRECIPITATION AMMOUNT           KG/(M2*S)
(   90) !                   FOR RADIATION CALCULATION
(   91) 
(   92) !    UPDATED PARAMETERS (INTEGER):
(   93) 
(   94) !    *KTOPC*        UPDATED CONVECTIVE CLOUD TOP LEVEL FOR RADIATION
(   95) !    *KBASEC*       UPDATED CONVECTIVE CLOUD BASE LEVEL FOR RADIATION
(   96) 
(   97) !    OUTPUT PARAMETERS (INTEGER):
(   98) 
(   99) !    *KTYPE*        TYPE OF CONVECTION
(  100) !                       1 = PENETRATIVE CONVECTION
(  101) !                       2 = SHALLOW CONVECTION
(  102) !                       3 = MIDLEVEL CONVECTION 
(  103) !    *KCBOT*        CLOUD BASE LEVEL
(  104) !    *KCTOP*        CLOUD TOP LEVEL
(  105) !    *KBOTSC*       CLOUD BASE LEVEL FOR SC-CLOUDS
(  106) !    *KCBOT_LIG*    CLOUD BASE LEVEL (FOR LIGHTNING PARAM)
(  107) !    *KCTOP_LIG*    CLOUD TOP LEVEL (FOR LIGHTNING PARAM)
(  108) 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:02      page 3

(  109) !    OUTPUT PARAMETERS (LOGICAL):
(  110) 
(  111) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS 
(  112) !    *LDCUM_LIG*    FLAG: .TRUE. FOR CONVECTIVE POINTS (FOR LIGHTNING PARAM)
(  113) !    *LDSC*         FLAG: .TRUE. FOR SC-POINTS
(  114) 
(  115) !    OUTPUT PARAMETERS (REAL):
(  116) 
(  117) !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS            KG/KG
(  118) !    *PLUDE*        DETRAINED TOTAL CONDENSATE                  KG/(M2*S)
(  119) !    *PLUDELI*      DETRAINED LIQUID, ICE                       KG/(M2*S)
(  120) !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT             KG/KG
(  121) !    *PSNDE*        DETRAINED SNOW/RAIN                         KG/(M2*S)
(  122) !    *PMFU*         MASSFLUX UPDRAFTS                           KG/(M2*S)
(  123) !    *PMFD*         MASSFLUX DOWNDRAFTS                         KG/(M2*S)
(  124) !    *PDIFCQ*       CONVECTIVE FLUX OF SPECIFIC HUMIDITY        KG/(M2*S)
(  125) !    *PDIFCS*       CONVECTIVE FLUX OF HEAT                      J/(M2*S)
(  126) !    *PFHPCL*       ENTHALPY FLUX DUE TO CONVECTIVE RAIN         J/(M2*S)
(  127) !    *PFHPCN*       ENTHALPY FLUX DUE TO CONVECTIVE SNOW         J/(M2*S)
(  128) !    *PFPLCL*       CONVECTIVE RAIN FLUX                        KG/(M2*S)
(  129) !    *PFPLCN*       CONVECTIVE SNOW FLUX                        KG/(M2*S)
(  130) !    *PLRAIN*       RAIN+SNOW CONTENT IN UPDRAFTS                 KG/KG
(  131) !    *PRSUD*        CONVECT MEAN RAIN AND SNOW CONTENT IN COLUMN  KG/KG
(  132) !    *PSTRTU*       CONVECTIVE FLUX OF U-MOMEMTUM         (M/S)*KG/(M2*S)
(  133) !    *PSTRTV*       CONVECTIVE FLUX OF V-MOMEMTUM         (M/S)*KG/(M2*S)
(  134) !    *PFCQLF*       CONVECTIVE CONDENSATION FLUX LIQUID         KG/(M2*S)
(  135) !    *PFCQIF*       CONVECTIVE CONDENSATION FLUX ICE            KG/(M2*S)
(  136) 
(  137) !               Diagnostics:
(  138) !    *PMFUDE_RATE* UPDRAFT DETRAINMENT RATE                     KG/(M3*S)
(  139) !    *PMFDDE_RATE* DOWNDRAFT DETRAINMENT RATE                   KG/(M3*S)
(  140) !    *PCAPE*       MAXIMUM pseudoadiabat CAPE                   (J/KG) 
(  141) !    *PWMEAN*      VERTICALLY AVERAGED UPDRAUGHT VELOCITY        M/S
(  142) !    *PVDISCU*     VERT INTEGRATED CONVECTIVE DISSIPATION RATE   W/m2
(  143) !    *PDISS*       ESTIMATE FOR DISSIPATION BT DEEP CONVCTION    J/m2
(  144) 
(  145) !     EXTERNALS.
(  146) !     ----------
(  147) 
(  148) !          CUMASTR
(  149) !          CUCCDIA
(  150) !          CUSTRAT
