(  127)     REAL(KIND=JPRB), INTENT(INOUT) :: PMFD(KLON, KLEV)
(  128)     REAL(KIND=JPRB), INTENT(OUT) :: PMFDS(KLON, KLEV)
(  129)     REAL(KIND=JPRB), INTENT(OUT) :: PMFDQ(KLON, KLEV)
(  130)     REAL(KIND=JPRB), INTENT(OUT) :: PDMFDP(KLON, KLEV)
