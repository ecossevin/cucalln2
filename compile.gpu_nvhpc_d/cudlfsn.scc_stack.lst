(  327)                 
(  328)                 ZTENWB(JL, IK) =  &
(  329)                 & ZTENWB(JL, IK) + (CUADJTQ_ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - CUADJTQ_ZOEALFA)*YDTHF%RALSDCP)*CUADJTQ_ZCOND
(  330)                 ZQENWB(JL, IK) = ZQENWB(JL, IK) - CUADJTQ_ZCOND
