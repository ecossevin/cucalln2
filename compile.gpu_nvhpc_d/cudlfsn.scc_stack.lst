(  152)     INTEGER(KIND=8), INTENT(INOUT) :: YDSTACK_L
(  153)     POINTER(IP_ZTENWB, ZTENWB)
(  154)     POINTER(IP_ZQENWB, ZQENWB)
(  155)     YLSTACK_L = YDSTACK_L
(  156)     IP_ZTENWB = YLSTACK_L
(  157)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  158)     IP_ZQENWB = YLSTACK_L
(  159)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  160) !$acc data present( KCBOT, KCTOP, LDCUM, PTENH, PQENH, PTEN, PQSEN, PGEO, PGEOH, PAPH, PTU, PQU, PMFUB, PRFL, PTD, PQD, PMFD
(  161) !$acc & PMFDS, PMFDQ, PDMFDP, KDTOP, LDDRAF, YDTHF, YDCST, YDEPHLI, YDECUMF )
(  162)     !----------------------------------------------------------------------
(  163)     
(  164)     !     1.           SET DEFAULT VALUES FOR DOWNDRAFTS
(  165)     !                  ---------------------------------
(  166)     






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 4

(  167)     
(  168) !$acc loop vector
(  169)     DO JL=KIDIA,KFDIA
(  170)       LDDRAF(JL) = .false.
(  171)       KDTOP(JL) = KLEV + 1
(  172)       IKHSMIN = KLEV + 1
(  173)       ZHSMIN = 1.E8_JPRB
(  174)       
(  175)       !orig IF(.NOT.LMFDD) GO TO 300
(  176)       IF (YDECUMF%LMFDD) THEN
(  177)         
(  178)         !----------------------------------------------------------------------
(  179)         
(  180)         !     2.           DETERMINE LEVEL OF FREE SINKING:
(  181)         !                  DOWNDRAFTS SHALL START AT MODEL LEVEL OF MINIMUM
(  182)         !                  OF SATURATION MOIST STATIC ENERGY OR BELOW
(  183)         !                  RESPECTIVELY
(  184)         
(  185)         !                  FOR EVERY POINT AND PROCEED AS FOLLOWS:
(  186)         
(  187)         !                    (1) DETERMINE LEVEL OF MINIMUM OF HS
(  188)         !                    (2) DETERMINE WET BULB ENVIRONMENTAL T AND Q
(  189)         !                    (3) DO MIXING WITH CUMULUS CLOUD AIR
(  190)         !                    (4) CHECK FOR NEGATIVE BUOYANCY
(  191)         !                    (5) IF BUOYANCY>0 REPEAT (2) TO (4) FOR NEXT
(  192)         !                        LEVEL BELOW
(  193)         
(  194)         !                  THE ASSUMPTION IS THAT AIR OF DOWNDRAFTS IS MIXTURE
(  195)         !                  OF 50% CLOUD AIR + 50% ENVIRONMENTAL AIR AT WET BULB
(  196)         !                  TEMPERATURE (I.E. WHICH BECAME SATURATED DUE TO
(  197)         !                  EVAPORATION OF RAIN AND CLOUD WATER)
(  198)         !                  ----------------------------------------------------
(  199)         
(  200) !$acc loop seq
(  201)         DO JK=3,KLEV - 2
(  202)           
(  203)           IF (YDEPHLI%LPHYLIN) THEN
(  204)             
(  205)             ZTARG = PTEN(JL, JK)
(  206)             ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  207)             ZOELHM = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT
(  208)             ZHSK = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK) + ZOELHM*PQSEN(JL, JK)
(  209)             IF (ZHSK < ZHSMIN) THEN
(  210)               ZHSMIN = ZHSK
(  211)               IKHSMIN = JK
(  212)             END IF
(  213)             
(  214)           ELSE
(  215)             
(  216)             ZHSK = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK) + FOELHMCU(PTEN(JL, JK))*PQSEN(JL, JK)
(  217)             IF (ZHSK < ZHSMIN) THEN
(  218)               ZHSMIN = ZHSK
(  219)               IKHSMIN = JK
(  220)             END IF
(  221)             
(  222)           END IF
(  223)           
(  224)         END DO






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 5

(  225)         IKE = KLEV - 3
(  226) !$acc loop seq
(  227)         DO JK=3,IKE
(  228)           
(  229)           !     2.1          CALCULATE WET-BULB TEMPERATURE AND MOISTURE
(  230)           !                  FOR ENVIRONMENTAL AIR IN *CUADJTQ*
(  231)           !                  -------------------------------------------
(  232)           
(  233)           IS = 0
(  234)           ZTENWB(JL, JK) = PTENH(JL, JK)
(  235)           ZQENWB(JL, JK) = PQENH(JL, JK)
(  236)           ZPH = PAPH(JL, JK)
(  237)           LLO2 = LDCUM(JL) .and. PRFL(JL) > 0.0_JPRB .and. .not.LDDRAF(JL) .and. JK < KCBOT(JL) .and. JK > KCTOP(JL) .and. J
(  238)           & IKHSMIN
(  239)           IF (LLO2) THEN
(  240)             IS = IS + 1
(  241)           END IF
(  242)           !orig   IF(IS.EQ.0) GO TO 290
(  243)           IF (IS == 0) CYCLE
(  244)           
(  245)           IK = JK
(  246)           ! [Loki] inlined child subroutine: CUADJTQ
(  247)           ! =========================================
(  248)           
(  249)           !----------------------------------------------------------------------
(  250)           
(  251)           !     1.           DEFINE CONSTANTS
(  252)           !                  ----------------
(  253)           
(  254)           
(  255)           !IF (LHOOK) CALL DR_HOOK('CUADJTQ',0,ZHOOK_HANDLE)
(  256)           
(  257)           
(  258)           ZQMAX = 0.5_JPRB
(  259)           
(  260)           !*********************************************
(  261)           IF (.not.YDEPHLI%LPHYLIN) THEN
(  262)             !*********************************************
(  263)             
(  264)             !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  265)             !                  -----------------------------------------------------
(  266)             
(  267)             
(  268)             
(  269)             !DIR$    IVDEP
(  270)             !OCL NOVREC
(  271)             IF (LLO2) THEN
(  272)               ZQP = 1.0_JPRB / ZPH
(  273)               ZQSAT = FOEEWMCU(ZTENWB(JL, IK))*ZQP
(  274)               ZQSAT = MIN(0.5_JPRB, ZQSAT)
(  275)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  276)               ZQSAT = ZQSAT*ZCOR
(  277)               CUADJTQ_ZCOND = (ZQENWB(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*FOEDEMCU(ZTENWB(JL, IK)))
(  278)               CUADJTQ_ZCOND = MIN(CUADJTQ_ZCOND, 0.0_JPRB)
(  279)               ZTENWB(JL, IK) = ZTENWB(JL, IK) + FOELDCPMCU(ZTENWB(JL, IK))*CUADJTQ_ZCOND
(  280)               ZQENWB(JL, IK) = ZQENWB(JL, IK) - CUADJTQ_ZCOND
(  281)               ZQSAT = FOEEWMCU(ZTENWB(JL, IK))*ZQP
(  282)               ZQSAT = MIN(0.5_JPRB, ZQSAT)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 6

(  283)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  284)               ZQSAT = ZQSAT*ZCOR
(  285)               ZCOND1 = (ZQENWB(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*FOEDEMCU(ZTENWB(JL, IK)))
(  286)               IF (CUADJTQ_ZCOND == 0.0_JPRB) ZCOND1 = MIN(ZCOND1, 0.0_JPRB)
(  287)               ZTENWB(JL, IK) = ZTENWB(JL, IK) + FOELDCPMCU(ZTENWB(JL, IK))*ZCOND1
(  288)               ZQENWB(JL, IK) = ZQENWB(JL, IK) - ZCOND1
(  289)             END IF
(  290)             
(  291)             
(  292)             
(  293)             
(  294)             
(  295)             !*********************************************
(  296)           ELSE
(  297)             !*********************************************
(  298)             
(  299)             !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  300)             !                  -----------------------------------------------------
(  301)             
(  302)             
(  303)             
(  304)             !DIR$    IVDEP
(  305)             !OCL NOVREC
(  306)             IF (LLO2) THEN
(  307)               ZQP = 1.0_JPRB / ZPH
(  308)               
(  309)               CUADJTQ_ZTARG = ZTENWB(JL, IK)
(  310)               CUADJTQ_ZOEALFA = 0.5_JPRB*(TANH(YDEPHLI%RLPAL1*(CUADJTQ_ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB)
(  311)               ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(CUADJTQ_ZTARG - YDCST%RTT) / (CUADJTQ_ZTARG - YDTHF%R4LES))
(  312)               ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(CUADJTQ_ZTARG - YDCST%RTT) / (CUADJTQ_ZTARG - YDTHF%R4IES))
(  313)               ZQSAT = ZQP*(CUADJTQ_ZOEALFA*ZFOEEWL + (1.0_JPRB - CUADJTQ_ZOEALFA)*ZFOEEWI)
(  314)               Z1S = TANH(YDEPHLI%RLPAL2*(ZQSAT - ZQMAX))
(  315)               ZQSAT = 0.5_JPRB*((1.0_JPRB - Z1S)*ZQSAT + (1.0_JPRB + Z1S)*ZQMAX)
(  316)               
(  317)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  318)               ZQSAT = ZQSAT*ZCOR
(  319)               
(  320)               Z2S = CUADJTQ_ZOEALFA*YDTHF%R5ALVCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4LES)**2) + (1.0_JPRB - CUADJTQ_ZOEALF
(  321)               & *YDTHF%R5ALSCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4IES)**2)
(  322)               CUADJTQ_ZCOND = (ZQENWB(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  323)               
(  324)               CUADJTQ_ZCOND = MIN(CUADJTQ_ZCOND, 0.0_JPRB)
(  325)               
(  326)               IF (CUADJTQ_ZCOND /= 0.0_JPRB) THEN
(  327)                 
(  328)                 ZTENWB(JL, IK) =  &
(  329)                 & ZTENWB(JL, IK) + (CUADJTQ_ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - CUADJTQ_ZOEALFA)*YDTHF%RALSDCP)*CUADJTQ_ZCON
(  330)                 ZQENWB(JL, IK) = ZQENWB(JL, IK) - CUADJTQ_ZCOND
(  331)                 CUADJTQ_ZTARG = ZTENWB(JL, IK)
(  332)                 CUADJTQ_ZOEALFA = 0.5_JPRB*(TANH(YDEPHLI%RLPAL1*(CUADJTQ_ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB)
(  333)                 ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(CUADJTQ_ZTARG - YDCST%RTT) / (CUADJTQ_ZTARG - YDTHF%R4LES))
(  334)                 ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(CUADJTQ_ZTARG - YDCST%RTT) / (CUADJTQ_ZTARG - YDTHF%R4IES))
(  335)                 ZQSAT = ZQP*(CUADJTQ_ZOEALFA*ZFOEEWL + (1.0_JPRB - CUADJTQ_ZOEALFA)*ZFOEEWI)
(  336)                 Z1S = TANH(YDEPHLI%RLPAL2*(ZQSAT - ZQMAX))
(  337)                 ZQSAT = 0.5_JPRB*((1.0_JPRB - Z1S)*ZQSAT + (1.0_JPRB + Z1S)*ZQMAX)
(  338)                 
(  339)                 ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  340)                 ZQSAT = ZQSAT*ZCOR






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 7

(  341)                 
(  342)                 Z2S = CUADJTQ_ZOEALFA*YDTHF%R5ALVCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4LES)**2) + (1.0_JPRB - CUADJTQ_ZOEA
(  343)                 & *YDTHF%R5ALSCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4IES)**2)
(  344)                 ZCOND1 = (ZQENWB(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  345)                 
(  346)                 ZTENWB(JL, IK) =  &
(  347)                 & ZTENWB(JL, IK) + (CUADJTQ_ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - CUADJTQ_ZOEALFA)*YDTHF%RALSDCP)*ZCOND1
(  348)                 
(  349)                 ZQENWB(JL, IK) = ZQENWB(JL, IK) - ZCOND1
(  350)               END IF
(  351)             END IF
(  352)             
(  353)             
(  354)             
(  355)             
(  356)             !*********************************************
(  357)           END IF
(  358)           !*********************************************
(  359)           
(  360)           
(  361)           !IF (LHOOK) CALL DR_HOOK('CUADJTQ',1,ZHOOK_HANDLE)
(  362)           
(  363)           ! =========================================
(  364)           
(  365)           !     2.2          DO MIXING OF CUMULUS AND ENVIRONMENTAL AIR
(  366)           !                  AND CHECK FOR NEGATIVE BUOYANCY.
(  367)           !                  THEN SET VALUES FOR DOWNDRAFT AT LFS.
(  368)           !                  ----------------------------------------
(  369)           
(  370)           !DIR$ IVDEP
(  371)           !OCL NOVREC
(  372)           IF (LLO2) THEN
(  373)             ZTTEST = 0.5_JPRB*(PTU(JL, JK) + ZTENWB(JL, JK))
(  374)             ZQTEST = 0.5_JPRB*(PQU(JL, JK) + ZQENWB(JL, JK))
(  375)             ZBUO = ZTTEST*(1.0_JPRB + YDCST%RETV*ZQTEST) - PTENH(JL, JK)*(1.0_JPRB + YDCST%RETV*PQENH(JL, JK))
(  376)             ZCOND = PQENH(JL, JK) - ZQENWB(JL, JK)
(  377)             ZMFTOP = -YDECUMF%RMFDEPS*PMFUB(JL)
(  378)             IF (ZBUO < 0.0_JPRB .and. PRFL(JL) > 10._JPRB*ZMFTOP*ZCOND) THEN
(  379)               KDTOP(JL) = JK
(  380)               LDDRAF(JL) = .true.
(  381)               PTD(JL, JK) = ZTTEST
(  382)               PQD(JL, JK) = ZQTEST
(  383)               PMFD(JL, JK) = ZMFTOP
(  384)               PMFDS(JL, JK) = PMFD(JL, JK)*(YDCST%RCPD*PTD(JL, JK) + PGEOH(JL, JK))
(  385)               PMFDQ(JL, JK) = PMFD(JL, JK)*PQD(JL, JK)
(  386)               PDMFDP(JL, JK - 1) = -0.5_JPRB*PMFD(JL, JK)*ZCOND
(  387)               PRFL(JL) = PRFL(JL) + PDMFDP(JL, JK - 1)
(  388)             END IF
(  389)           END IF
(  390)           
(  391)           ! 290   continue
(  392)         END DO
(  393)         
(  394)         !300  CONTINUE
(  395)       END IF
(  396)     END DO
(  397)     
(  398)     






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 8

(  399)     
(  400) !$acc end data
(  401)   END SUBROUTINE CUDLFSN_LOKI
(  402) END MODULE CUDLFSN_LOKI_MOD




























































