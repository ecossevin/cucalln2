(    1) MODULE CUDLFSN_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUDLFSN_LOKI (YDTHF, YDCST, YDEPHLI, YDECUMF, KIDIA, KFDIA, KLON, KLEV, KCBOT, KCTOP, LDCUM, PTENH, PQENH, PTEN,  &
(    4)   & PQSEN, PGEO, PGEOH, PAPH, PTU, PQU, PMFUB, PRFL, PTD, PQD, PMFD, PMFDS, PMFDQ, PDMFDP, KDTOP, LDDRAF, YDSTACK_L)
(    5)     
(    6)     !          THIS ROUTINE CALCULATES LEVEL OF FREE SINKING FOR
(    7)     !          CUMULUS DOWNDRAFTS AND SPECIFIES T,Q,U AND V VALUES
(    8)     
(    9)     !          PURPOSE.
(   10)     !          --------
(   11)     !          TO PRODUCE LFS-VALUES FOR CUMULUS DOWNDRAFTS
(   12)     !          FOR MASSFLUX CUMULUS PARAMETERIZATION
(   13)     
(   14)     !          INTERFACE
(   15)     !          ---------
(   16)     !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   17)     !          INPUT ARE ENVIRONMENTAL VALUES OF T,Q,U,V,P,PHI
(   18)     !          AND UPDRAFT VALUES T,Q,U AND V AND ALSO
(   19)     !          CLOUD BASE MASSFLUX AND CU-PRECIPITATION RATE.
(   20)     !          IT RETURNS T,Q,U AND V VALUES AND MASSFLUX AT LFS.
(   21)     
(   22)     !          METHOD.
(   23)     
(   24)     !          CHECK FOR NEGATIVE BUOYANCY OF AIR OF EQUAL PARTS OF
(   25)     !          MOIST ENVIRONMENTAL AIR AND CLOUD AIR.
(   26)     
(   27)     !     PARAMETER     DESCRIPTION                                   UNITS
(   28)     !     ---------     -----------                                   -----
(   29)     !     INPUT PARAMETERS (INTEGER):
(   30)     
(   31)     !    *KIDIA*        START POINT
(   32)     !    *KFDIA*        END POINT
(   33)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   34)     !    *KLEV*         NUMBER OF LEVELS
(   35)     !    *KCBOT*        CLOUD BASE LEVEL
(   36)     !    *KCTOP*        CLOUD TOP LEVEL
(   37)     
(   38)     !    INPUT PARAMETERS (LOGICAL):
(   39)     
(   40)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   41)     
(   42)     !    INPUT PARAMETERS (REAL):
(   43)     
(   44)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS          K
(   45)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS     KG/KG
(   46)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   47)     !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   48)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   49)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                  M2/S2
(   50)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   51)     !    *PTU*          TEMPERATURE IN UPDRAFTS                        K
(   52)     !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                   KG/KG
(   53)     !    *PMFUB*        MASSFLUX IN UPDRAFTS AT CLOUD BASE           KG/(M2*S)
(   54)     
(   55)     !    UPDATED PARAMETERS (REAL):
(   56)     
(   57)     !    *PRFL*         PRECIPITATION RATE                           KG/(M2*S)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:28      page 10

(   58)     
(   59)     !    OUTPUT PARAMETERS (REAL):
(   60)     
(   61)     !    *PTD*          TEMPERATURE IN DOWNDRAFTS                      K
(   62)     !    *PQD*          SPEC. HUMIDITY IN DOWNDRAFTS                 KG/KG
(   63)     !    *PMFD*         MASSFLUX IN DOWNDRAFTS                       KG/(M2*S)
(   64)     !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS       J/(M2*S)
(   65)     !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS         KG/(M2*S)
(   66)     !    *PDMFDP*       FLUX DIFFERENCE OF PRECIP. IN DOWNDRAFTS     KG/(M2*S)
(   67)     
(   68)     !    OUTPUT PARAMETERS (INTEGER):
(   69)     
(   70)     !    *KDTOP*        TOP LEVEL OF DOWNDRAFTS
(   71)     
(   72)     !    OUTPUT PARAMETERS (LOGICAL):
(   73)     
(   74)     !    *LDDRAF*       .TRUE. IF DOWNDRAFTS EXIST
(   75)     
(   76)     !          EXTERNALS
(   77)     !          ---------
(   78)     !          *CUADJTQ* FOR CALCULATING WET BULB T AND Q AT LFS
