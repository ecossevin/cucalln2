(  208)             ZHSK = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK) + ZOELHM*PQSEN(JL, JK)
(  209)             IF (ZHSK < ZHSMIN) THEN
(  210)               ZHSMIN = ZHSK
(  211)               IKHSMIN = JK
(  212)             END IF
(  213)             
(  214)           ELSE
(  215)             
(  216)             ZHSK = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK) + FOELHMCU(PTEN(JL, JK))*PQSEN(JL, JK)
(  217)             IF (ZHSK < ZHSMIN) THEN
(  218)               ZHSMIN = ZHSK
(  219)               IKHSMIN = JK
(  220)             END IF
(  221)             
(  222)           END IF
(  223)           
(  224)         END DO
(  225)         IKE = KLEV - 3
(  226) !$acc loop seq
(  227)         DO JK=3,IKE
