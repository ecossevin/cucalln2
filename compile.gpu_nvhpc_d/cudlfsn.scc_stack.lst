(  177)         
(  178)         !----------------------------------------------------------------------
(  179)         
(  180)         !     2.           DETERMINE LEVEL OF FREE SINKING:
(  181)         !                  DOWNDRAFTS SHALL START AT MODEL LEVEL OF MINIMUM
(  182)         !                  OF SATURATION MOIST STATIC ENERGY OR BELOW
(  183)         !                  RESPECTIVELY
(  184)         
(  185)         !                  FOR EVERY POINT AND PROCEED AS FOLLOWS:
(  186)         
(  187)         !                    (1) DETERMINE LEVEL OF MINIMUM OF HS
(  188)         !                    (2) DETERMINE WET BULB ENVIRONMENTAL T AND Q
(  189)         !                    (3) DO MIXING WITH CUMULUS CLOUD AIR
(  190)         !                    (4) CHECK FOR NEGATIVE BUOYANCY
(  191)         !                    (5) IF BUOYANCY>0 REPEAT (2) TO (4) FOR NEXT
(  192)         !                        LEVEL BELOW
(  193)         
(  194)         !                  THE ASSUMPTION IS THAT AIR OF DOWNDRAFTS IS MIXTURE
(  195)         !                  OF 50% CLOUD AIR + 50% ENVIRONMENTAL AIR AT WET BULB
(  196)         !                  TEMPERATURE (I.E. WHICH BECAME SATURATED DUE TO
(  197)         !                  EVAPORATION OF RAIN AND CLOUD WATER)
(  198)         !                  ----------------------------------------------------
(  199)         
(  200) !$acc loop seq
(  201)         DO JK=3,KLEV - 2
(  202)           
(  203)           IF (YDEPHLI%LPHYLIN) THEN
(  204)             
(  205)             ZTARG = PTEN(JL, JK)
(  206)             ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  207)             ZOELHM = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT






