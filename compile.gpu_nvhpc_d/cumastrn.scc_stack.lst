(  599)       DO JK=YDML_PHY_EC%YRECUMF%NJKT2,KLEV
(  600)         !DIR$ LOOP_INFO EST_TRIPS(16)
(  601)         IF (LDCUM(JL) .and. JK >= KCBOT(JL)) THEN
(  602)           ZDZ = (PAPH(JL, JK + 1) - PAPH(JL, JK))
(  603)           ZDHPBL(JL) = ZDHPBL(JL) + (YDCST%RLVTT*PTENQ(JL, JK) + YDCST%RCPD*PTENT(JL, JK))*ZDZ
(  604)           ZCAPPBL(JL) = ZCAPPBL(JL) + (PTENT(JL, JK) + YDCST%RETV*PTEN(JL, JK)*PTENQ(JL, JK))*ZDZ
