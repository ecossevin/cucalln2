(  576)     & IDPL, PCAPE, YDSTACK_L=YLSTACK_L)
(  577)     
(  578)     
(  579)     !*             (B) DETERMINE TOTAL MOISTURE CONVERGENCE AND
(  580)     !*                 DECIDE ON TYPE OF CUMULUS CONVECTION
(  581)     !*                 ONE THE BASIS OF THE DEPTH OF THE CONVECTION
(  582)     !*                 DEEP IF CLOUD DEPTH > 200MB
(  583)     !*                 SHALLOW IF CLOUD DEPTH <200MB
(  584)     !                  -----------------------------------------
(  585)     
(  586)     ! CALCULATE COLUMN AND SUB CLOUD LAYER MOISTURE CONVERGENCE
(  587)     ! AND SUB CLOUD LAYER MOIST STATIC ENERGY CONVERGENCE
(  588)     
(  589)     !DIR$ LOOP_INFO EST_TRIPS(16)
(  590)     
(  591) !$acc loop vector
(  592)     DO JL=KIDIA,KFDIA
(  593)       ZDHPBL(JL) = 0.0_JPRB
(  594)       IDTOP(JL) = 0
(  595)       ZCAPPBL(JL) = 0.
(  596)       ZKHVFL(JL) = (-PAHFS(JL, KLEV + 1)*ZORCPD - YDCST%RETV*PTEN(JL, KLEV)*PQHFL(JL, KLEV + 1)) / (PPLRG*PPLDARE)
(  597)       ZKHFL(JL) = (-PAHFS(JL, KLEV + 1) - YDCST%RLVTT*PQHFL(JL, KLEV + 1)) / (PPLRG*PPLDARE)
