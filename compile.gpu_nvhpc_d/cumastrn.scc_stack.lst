(    6)   & KCTOP, LDCUM_LIG, KCBOT_LIG, KCTOP_LIG, KBOTSC, LDSC, LDSHCV, PLCRIT_AER, PTU, PQU, PLU, PLUDE, PLUDELI, PSNDE, PENTH,  
(    7)   & PMFLXR, PMFLXS, PRAIN, PLRAIN, PRSUD, PMFU, PMFD, PLGLAC, PMFUDE_RATE, PMFDDE_RATE, PCAPE, PWU, PWMEAN, PVDISCU, PDISS, 
(    8)   & KTRAC, PCEN, PTENC, PSCAV, PSCAV0, YDSTACK_L)
(    9)     
(   10)     !**** *CUMASTR*  MASTER ROUTINE FOR CUMULUS MASSFLUX-SCHEME
(   11)     
(   12)     !     PURPOSE
(   13)     !     -------
(   14)     !          THIS ROUTINE COMPUTES THE PHYSICAL TENDENCIES OF THE
(   15)     !     PROGNOSTIC VARIABLES T,Q,U, V AND TRACERS DUE TO CONVECTIVE PROCESSES.
(   16)     !     PROCESSES CONSIDERED ARE: CONVECTIVE FLUXES, FORMATION OF
(   17)     !     PRECIPITATION, EVAPORATION OF FALLING RAIN BELOW CLOUD BASE,
(   18)     !     SATURATED CUMULUS DOWNDRAFTS.
(   19)     
(   20)     !**   INTERFACE.
(   21)     !     ----------
(   22)     
(   23)     !          *CUMASTR* IS CALLED FROM *CUCALL*
(   24)     !     THE ROUTINE TAKES ITS INPUT FROM THE LONG-TERM STORAGE
(   25)     !     T,Q,U,V,PHI AND P AND MOISTURE TENDENCIES.
(   26)     !     IT RETURNS ITS OUTPUT TO THE SAME SPACE
(   27)     !      1.MODIFIED TENDENCIES OF MODEL VARIABLES
(   28)     !      2.RATES OF CONVECTIVE PRECIPITATION
(   29)     !        (USED IN SUBROUTINE SURF)
(   30)     !      3.CLOUD BASE, CLOUD TOP AND PRECIP FOR RADIATION
(   31)     !        (USED IN SUBROUTINE CLOUD)
(   32)     
(   33)     !     METHOD
(   34)     !     -------
(   35)     
(   36)     !     PARAMETERIZATION IS DONE USING A MASSFLUX-SCHEME.
(   37)     !        (1) DEFINE CONSTANTS AND PARAMETERS
(   38)     !        (2) SPECIFY VALUES (T,Q,QS...) AT HALF LEVELS AND
(   39)     !            INITIALIZE UPDRAFT- AND DOWNDRAFT-VALUES IN 'CUINI'
(   40)     !        (3) CALCULATE CLOUD BASE IN 'CUBASE'
(   41)     !            AND SPECIFY CLOUD BASE MASSFLUX FROM PBL MOISTURE BUDGET
(   42)     !        (4) DO CLOUD ASCENT IN 'CUASC' IN ABSENCE OF DOWNDRAFTS
(   43)     !        (5) DO DOWNDRAFT CALCULATIONS:
(   44)     !              (A) DETERMINE VALUES AT LFS IN 'CUDLFS'
(   45)     !              (B) DETERMINE MOIST DESCENT IN 'CUDDRAF'
(   46)     !              (C) RECALCULATE CLOUD BASE MASSFLUX CONSIDERING THE
(   47)     !                  EFFECT OF CU-DOWNDRAFTS
(   48)     !        (6) DO FINAL CLOUD ASCENT IN 'CUASC'
(   49)     !        (7) DO FINAL ADJUSMENTS TO CONVECTIVE FLUXES IN 'CUFLX',
(   50)     !            DO EVAPORATION IN SUBCLOUD LAYER






NVFORTRAN (Version     24.5)          03/19/2025  06:55:37      page 2

(   51)     !        (8) CALCULATE INCREMENTS OF T AND Q IN 'CUDTDQ'
(   52)     !        (9) CALCULATE INCREMENTS OF U AND V IN 'CUDUDV'
(   53)     
(   54)     !     PARAMETER     DESCRIPTION                                   UNITS
(   55)     !     ---------     -----------                                   -----
(   56)     !     INPUT PARAMETERS (INTEGER):
(   57)     
(   58)     !    *KIDIA*        START POINT
(   59)     !    *KFDIA*        END POINT
(   60)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   61)     !    *KLEV*         NUMBER OF LEVELS
(   62)     !    *KTRAC*        NUMBER OF CHEMICAL TRACERS
(   63)     
(   64)     !     INPUT PARAMETERS (LOGICAL)
(   65)     
(   66)     !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   67)     !    *LDTDKMF*      Arpege tuning (if TRUE)
(   68)     
(   69)     !     INPUT PARAMETERS (REAL)
(   70)     
(   71)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                       S
(   72)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   73)     !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   74)     !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)       M/S
(   75)     !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)       M/S
(   76)     !    *PCEN*         PROVISIONAL ENVIRONMENT TRACER CONCENTRATIONS KG/KG
(   77)     !    *PLITOT*       GRID MEAN LIQUID WATER+ICE CONTENT            KG/KG
(   78)     !    *PVERVEL*      VERTICAL VELOCITY                             PA/S
(   79)     !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   80)     !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   81)     !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   82)     !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS             PA
(   83)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS             PA
(   84)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   85)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   86)     !    *PGAW*       NORMALISED GAUSSIAN QUADRATURE WEIGHT / NUMBER OF LONGITUDE POINTS
(   87)     !                           LOCAL SUB-AREA == 4*RPI*RA**2 * PGAW
(   88)     !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(   89)     !    *PCUCONVCA*    COUPLING TO CELL AUTOMATON OR 2D ADV FIELD     ( )
(   90)     !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   91)     !    *PSCAV*        SCAVENGING COEFFICIENTS FOR CHEM TRANSPORT    UNITLESS
(   92)     
(   93)     !    UPDATED PARAMETERS (REAL):
(   94)     
(   95)     !    *PTENT*        TEMPERATURE TENDENCY                           K/S
(   96)     !    *PTENQ*        MOISTURE TENDENCY                             KG/(KG S)
(   97)     !    *PTENU*        TENDENCY OF U-COMP. OF WIND                    M/S2
(   98)     !    *PTENV*        TENDENCY OF V-COMP. OF WIND                    M/S2
(   99)     !    *PTENC*        TENDENCY OF CHEMICAL TRACERS                   1/S
(  100)     !    *PTENTA*       TEMPERATURE TENDENCY DYNAMICS=TOT ADVECTION    K/S
(  101)     !    *PTENQA*       MOISTURE    TENDENCY DYNAMICS=TOT ADVECTION    1/S
(  102)     
(  103)     !    OUTPUT PARAMETERS (LOGICAL):
(  104)     
(  105)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(  106)     !    *LDCUM_LIG*    FLAG: .TRUE. FOR CONVECTIVE POINTS (FOR LIGHTNING PARAM)
(  107)     !    *LDSC*         FLAG: .TRUE. FOR SC-POINTS
(  108)     






NVFORTRAN (Version     24.5)          03/19/2025  06:55:37      page 3

(  109)     !    OUTPUT PARAMETERS (INTEGER):
(  110)     
(  111)     !    *KTYPE*        TYPE OF CONVECTION
(  112)     !                       1 = PENETRATIVE CONVECTION
(  113)     !                       2 = SHALLOW CONVECTION
(  114)     !                       3 = MIDLEVEL CONVECTION
(  115)     !    *KCBOT*        CLOUD BASE LEVEL
(  116)     !    *KCTOP*        CLOUD TOP LEVEL
(  117)     !    *KCBOT_LIG*    CLOUD BASE LEVEL (FOR LIGHTNING PARAM)
(  118)     !    *KCTOP_LIG*    CLOUD TOP LEVEL (FOR LIGHTNING PARAM)
(  119)     !    *KBOTSC*       CLOUD BASE LEVEL FOR SC-CLOUDS
(  120)     
(  121)     !    OUTPUT PARAMETERS (REAL):
(  122)     
(  123)     !    *PTU*          TEMPERATURE IN UPDRAFTS                         K
(  124)     !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                    KG/KG
(  125)     !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS              KG/KG
(  126)     !    *PLUDE*        DETRAINED TOTAL CONDENSATE                    KG/(M2*S)
(  127)     !    *PLUDELI*      DETRAINED LIQUID, ICE, VAPOR, T               KG/(M2*S)
(  128)     !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT              KG/KG
(  129)     !    *PSNDE*        DETRAINED SNOW/RAIN                           KG/(M2*S)
(  130)     !    *PENTH*        INCREMENT OF DRY STATIC ENERGY                 J/(KG*S)
(  131)     !    *PMFLXR*       CONVECTIVE RAIN FLUX                          KG/(M2*S)
(  132)     !    *PMFLXS*       CONVECTIVE SNOW FLUX                          KG/(M2*S)
(  133)     !    *PRAIN*        TOTAL PRECIP. PRODUCED IN CONV. UPDRAFTS      KG/(M2*S)
(  134)     !                   (NO EVAPORATION IN DOWNDRAFTS)
(  135)     !    *PLRAIN*       RAIN+SNOW CONTENT IN UPDRAFTS                 KG/KG
(  136)     !    *PRSUD*        CONVECT MEAN RAIN AND SNOW CONTENT IN COLUMN  KG/KG
(  137)     !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(  138)     !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
(  139)     !    *PMFUDE_RATE*  UPDRAFT DETRAINMENT RATE                      KG/(M3*S)
(  140)     !    *PMFDDE_RATE*  DOWNDRAFT DETRAINMENT RATE                    KG/(M3*S)
(  141)     !    *PCAPE*        CONVECTVE AVAILABLE POTENTIAL ENERGY           J/KG
(  142)     !    *PWMEAN*       VERTICALLY AVERAGED UPDRAUGHT VELOCITY         M/S
(  143)     !    *PVDISCU*      VERT INTEGRATED CONVECTIVE DISSIPATION RATE    W/m2
(  144)     !    *PDISS*        DISSIPATION BY DEEP CONVECTION ESTIMATE       m2/s3^(1/3)
(  145)     
(  146)     !     EXTERNALS.
(  147)     !     ----------
(  148)     
(  149)     !       CUINI:  INITIALIZES VALUES AT VERTICAL GRID USED IN CU-PARAMETR.
(  150)     !       CUBASE: CLOUD BASE CALCULATION FOR PENETR.AND SHALLOW CONVECTION
(  151)     !       CUASC:  CLOUD ASCENT FOR ENTRAINING PLUME
(  152)     !       CUDLFS: DETERMINES VALUES AT LFS FOR DOWNDRAFTS
(  153)     !       CUDDRAF:DOES MOIST DESCENT FOR CUMULUS DOWNDRAFTS
(  154)     !       CUFLX:  FINAL ADJUSTMENTS TO CONVECTIVE FLUXES (ALSO IN PBL)
(  155)     !       CUDQDT: UPDATES TENDENCIES FOR T AND Q
(  156)     !       CUDUDV: UPDATES TENDENCIES FOR U AND V
(  157)     !       CUCTRACER: TRACER TRANSPORT
(  158)     
(  159)     !     SWITCHES.
(  160)     !     --------
(  161)     
(  162)     !          LMFPEN=.TRUE.   PENETRATIVE CONVECTION IS SWITCHED ON
(  163)     !          LMFSCV=.TRUE.   SHALLOW CONVECTION IS SWITCHED ON
(  164)     !          LMFMID=.TRUE.   MIDLEVEL CONVECTION IS SWITCHED ON
(  165)     !          LMFDD=.TRUE.    CUMULUS DOWNDRAFTS SWITCHED ON
(  166)     !          LMFDUDV=.TRUE.  CUMULUS FRICTION SWITCHED ON






NVFORTRAN (Version     24.5)          03/19/2025  06:55:37      page 4

(  167)     !          LMFTRAC=.false. TRACER TRANSPORT
(  168)     
