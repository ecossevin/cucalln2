( 1570)     END IF
( 1571)     
( 1572)     !----------------------------------------------------------------------
( 1573)     
( 1574)     !*   12.           PUT DETRAINMENT RATES FROM MFLX UNITS IN UNITS MFLX/M
( 1575)     !                  FOR ERA40, ESTIMATE VOLUME MEAN RAIN AND SNOW CONTENT
( 1576)     !                  ---------------------------------------------------
( 1577)     
( 1578)     PDISS(:, 1) = 0.0_JPRB
( 1579)     ZAR = 1.0_JPRB / 20.89_JPRB
( 1580)     ZAS = 1.0_JPRB / 29.51_JPRB
( 1581)     ZBR = 1.0_JPRB / 1.15_JPRB
( 1582)     ZBS = 1.0_JPRB / 1.10_JPRB
( 1583)     ZAK = 1.0_JPRB / 5.09E-3_JPRB
( 1584)     
( 1585) !$acc loop vector
( 1586)     DO JL=KIDIA,KFDIA
( 1587) !$acc loop seq
( 1588)       DO JK=1,KLEV
( 1589)         !DIR$ LOOP_INFO EST_TRIPS(16)
( 1590)         IK = MIN(JK + 1, KLEV)
( 1591)         IKD = MAX(JK - 1, 1)
( 1592)         PDISS(JL, JK) = 0.0_JPRB
( 1593)         PRSUD(JL, JK, 1) = 0.0_JPRB
( 1594)         PRSUD(JL, JK, 2) = 0.0_JPRB
( 1595)         IF (LDCUM(JL) .and. JK >= -1 + KCTOP(JL)) THEN
( 1596)           PLUDELI(JL, JK, 3) =  &
( 1597)           & PMFUDE_RATE(JL, JK)*(PQU(JL, IK) - ZQENH(JL, IK)) + PMFDDE_RATE(JL, JK)*(ZQD(JL, IKD) - ZQENH(JL, IKD))
( 1598)           PLUDELI(JL, JK, 4) =  &
( 1599)           & PMFUDE_RATE(JL, JK)*(PTU(JL, IK) - ZTENH(JL, IK)) + PMFDDE_RATE(JL, JK)*(ZTD(JL, IKD) - ZTENH(JL, IKD))
( 1600)           ! Change units for detrainment as for ERA
( 1601)           ZRO = YDCST%RG / (PGEOH(JL, JK) - PGEOH(JL, JK + 1))            ! 1/dz
( 1602)           PMFUDE_RATE(JL, JK) = PMFUDE_RATE(JL, JK)*ZRO
( 1603)           PMFDDE_RATE(JL, JK) = PMFDDE_RATE(JL, JK)*ZRO
( 1604)           ZRO = YDCST%RD*PTEN(JL, JK)*(1.0_JPRB + YDCST%RETV*PQEN(JL, JK)) / PAP(JL, JK)
( 1605)           ! Dissipation definition used in stoch Backscatter
( 1606)           ! PDISS(JL,JK)=MIN(PWMEAN(JL),17._JPRB)**2*PMFUDE_RATE(JL,JK)*ZRO*ZTAU(JL)
( 1607)           ZDUTEN = PTENU(JL, JK) - ZTENU(JL, JK)
( 1608)           ZDVTEN = PTENV(JL, JK) - ZTENV(JL, JK)
( 1609)           ! Dissipation used in eddy dissipation(EDR) turbulence diagnostic
( 1610)           PDISS(JL, JK) = ABS(PUEN(JL, JK)*ZDUTEN + PVEN(JL, JK)*ZDVTEN)**0.3333
( 1611)           
( 1612)           ! grid-mean convective rain/snow parametrization (Geer et al. 2009) with factor 0.5 for snow
( 1613)           PRSUD(JL, JK, 1) = 1.E-3_JPRB*ZRO*(PMFLXR(JL, JK)*3600._JPRB*ZAR)**ZBR
( 1614)           PRSUD(JL, JK, 2) = 0.5*1.E-3_JPRB*ZRO*(10.0_JPRB*PMFLXS(JL, JK)*3600._JPRB*ZAS)**ZBS
( 1615)           ! possible updraught fraction for incloud values
( 1616)           ! ZFAC=PAPH(JL,NJKT5)/MIN(PAPH(JL,NJKT5),MAX(200.E2_JPRB,PAPH(JL,JK)))






NVFORTRAN (Version     24.5)          03/19/2025  06:55:37      page 29

( 1617)           ! ZFAC=RCUCOV*ZFAC**2
( 1618)           ! grid-mean convective rain/snow parametrization similar to that used in evaporation
( 1619)           ! i.e. Kessler but without pressure factor and factor for snow
( 1620)           ! PRSUD(JL,JK,1)=1.E-3_JPRB*ZRO*(PMFLXR(JL,JK)*ZAK)**0.888_JPRB
( 1621)           ! PRSUD(JL,JK,2)=1.E-3_JPRB*ZRO*(PMFLXS(JL,JK)*2.5*ZAK)**0.888_JPRB
( 1622)         ELSE
( 1623)           PMFU(JL, JK) = 0.0_JPRB
( 1624)           PMFD(JL, JK) = 0.0_JPRB
( 1625)           PLUDE(JL, JK) = 0.0_JPRB
( 1626)           PLUDELI(JL, JK, 1) = 0.0_JPRB
( 1627)           PLUDELI(JL, JK, 2) = 0.0_JPRB
( 1628)           PLUDELI(JL, JK, 3) = 0.0_JPRB
( 1629)           PLUDELI(JL, JK, 4) = 0.0_JPRB
( 1630)           PSNDE(JL, JK, 1) = 0.0_JPRB
( 1631)           PSNDE(JL, JK, 2) = 0.0_JPRB
( 1632)           PTU(JL, JK) = PTEN(JL, JK)
( 1633)           PQU(JL, JK) = PQEN(JL, JK)
( 1634)           PLU(JL, JK) = 0.0_JPRB
( 1635)           PENTH(JL, JK) = 0.0_JPRB
( 1636)           PMFUDE_RATE(JL, JK) = 0.0_JPRB
( 1637)           PMFDDE_RATE(JL, JK) = 0.0_JPRB
( 1638)         END IF
( 1639)       END DO
( 1640)     END DO
( 1641)     
( 1642)     
( 1643)     !----------------------------------------------------------------------
( 1644)     
( 1645)     
( 1646) !$acc end data
( 1647)   END SUBROUTINE CUMASTRN_LOKI
( 1648) END MODULE CUMASTRN_LOKI_MOD
































