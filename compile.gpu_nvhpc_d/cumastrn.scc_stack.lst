(  869)         END IF
(  870)         IF (ZDX > 125.E3_JPRB) ZTAURES = MIN(3.0_JPRB, ZTAURES)
(  871)         
(  872)         IKD = IDPL(JL)
(  873)         IKB = KCBOT(JL)
(  874)         IK = KCTOP(JL)
