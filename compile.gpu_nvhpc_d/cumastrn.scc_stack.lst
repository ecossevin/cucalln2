(  607)       
(  608)       !*                 ESTIMATE CLOUD HEIGHT FOR ENTRAINMENT/DETRAINMENT
(  609)       !*                 CALCULATIONS IN CUASC AND INITIAL DETERMINATION OF
(  610)       !*                 CLOUD TYPE
(  611)       !*                 (MAX.POSSIBLE CLOUD HEIGHT
(  612)       !*                 FOR NON-ENTRAINING PLUME, FOLLOWING A.-S.,1974)
(  613)       !                  -------------------------------------------------
(  614)       
(  615)       
(  616)       !*                 SPECIFY INITIAL CLOUD TYPE
(  617)       !*
(  618)       
(  619)       !DIR$ LOOP_INFO EST_TRIPS(16)
(  620)       IF (LDCUM(JL)) THEN
(  621)         IKB = KCBOT(JL)
(  622)         ITOPM2 = ICTOP0(JL)
(  623)         ZPBMPT = PAPH(JL, IKB) - PAPH(JL, ITOPM2)
(  624)         IF (ZPBMPT >= YDML_PHY_EC%YRECUMF%RDEPTHS) THEN
(  625)           KTYPE(JL) = 1
(  626)         ELSE
(  627)           KTYPE(JL) = 2
(  628)         END IF
(  629)       ELSE
(  630)         KTYPE(JL) = 0






