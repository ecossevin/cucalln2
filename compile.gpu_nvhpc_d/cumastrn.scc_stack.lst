(  632)       
(  633)       !*             (C) calculate initial updraught mass flux
(  634)       !*                 and set lateral mixing rates
(  635)       !*
(  636)       !*                 for deep convection assume it is 10% of
(  637)       !*                 maximum value which is determined by the
(  638)       !*                 thickness of the layer and timestep
(  639)       !*
(  640)       !*                 for shallow convection calculated assuming
(  641)       !*                 a balance of moist static energy in the
(  642)       !*                 sub-cloud layer (ignores present of downdraughts)
(  643)       !                  ------------------------------------------
(  644)       
(  645)       IF (YDML_PHY_EC%YRECUMF%LMFWSTAR) THEN
(  646)         !DIR$ IVDEP
(  647)         !OCL NOVREC
(  648)         !DIR$ LOOP_INFO EST_TRIPS(16)
(  649)         IF (LDCUM(JL)) THEN
(  650)           IKB = KCBOT(JL)
(  651)           ZDZ = MAX(0.0_JPRB, MIN(1.5E3_JPRB, (PGEOH(JL, IKB) - PGEOH(JL, KLEV + 1)) / YDCST%RG))
(  652)           ZMF_SHAL(JL) = 0.07_JPRB*(YDCST%RG / PTEN(JL, KLEV)*ZDZ*MAX(0.0_JPRB, ZKHVFL(JL)))**.3333
(  653)           ZMFMAX = (PAPH(JL, IKB) - PAPH(JL, IKB - 1))*ZCONS2
(  654)           ZMF_SHAL(JL) = MIN(ZMF_SHAL(JL), ZMFMAX)
(  655)         END IF
(  656)       END IF
(  657)       
(  658)       !DIR$ LOOP_INFO EST_TRIPS(16)
(  659)       IF (LDCUM(JL)) THEN
(  660)         IKB = KCBOT(JL)
(  661)         ZMFMAX = (PAPH(JL, IKB) - PAPH(JL, IKB - 1))*ZCONS2
(  662)         
(  663)         ! deep convection
(  664)         
(  665)         IF (KTYPE(JL) == 1) THEN
(  666)           ZMFUB(JL) = ZMFMAX*0.1_JPRB
(  667)           
(  668)         ELSE IF (KTYPE(JL) == 2) THEN
(  669)           
(  670)           ! shallow convection
(  671)           
(  672)           ZQUMQE = PQU(JL, IKB) + PLU(JL, IKB) - ZQENH(JL, IKB)
