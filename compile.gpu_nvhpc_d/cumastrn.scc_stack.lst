(  621)         IKB = KCBOT(JL)
(  622)         ITOPM2 = ICTOP0(JL)
(  623)         ZPBMPT = PAPH(JL, IKB) - PAPH(JL, ITOPM2)
(  624)         IF (ZPBMPT >= YDML_PHY_EC%YRECUMF%RDEPTHS) THEN
