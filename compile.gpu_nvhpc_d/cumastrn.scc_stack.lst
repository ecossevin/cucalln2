(  677)             ZMFUB(JL) = ZDHPBL(JL) / ZDH
(  678)             ZMFUB(JL) = MIN(ZMFUB(JL), ZMFMAX)
(  679)           ELSE
(  680)             ZMFUB(JL) = ZMFMAX*0.1_JPRB
(  681)             LDCUM(JL) = .false.
(  682)           END IF
(  683)           IF (YDML_PHY_EC%YRECUMF%LMFWSTAR) ZMFUB(JL) = ZMF_SHAL(JL)
(  684)         END IF
(  685)         
(  686)       ELSE
(  687)         
(  688)         ! no buoyancy cloud base from surface






