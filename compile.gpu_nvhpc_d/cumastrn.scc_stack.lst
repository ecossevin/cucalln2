(    1) MODULE CUMASTRN_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUMASTRN_LOKI (PPLDARE, PPLRG, YDTHF, YDCST, YDML_PHY_SLIN, YDML_PHY_EC, YGFL, YDCHEM, YDSPP_CONFIG, YDPERTPAR,
