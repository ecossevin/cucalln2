(  408) SUBROUTINE FINDARGINDEX( KEY, I, N )
(  409)  CHARACTER(LEN=*),      INTENT(IN)  :: KEY
(  410)  INTEGER(KIND=JPIM), INTENT(OUT) :: I, N
(  411)  CHARACTER(LEN=ARGSIZEMAX) :: ARG
