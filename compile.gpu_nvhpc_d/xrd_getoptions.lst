(  551) SUBROUTINE READASLFROMSTRING( VAL, SVAL )
(  552)  CHARACTER(LEN=*), INTENT(OUT) :: VAL(:)
(  553)  CHARACTER(LEN=*), INTENT(IN) :: SVAL
(  554) !
(  555)  INTEGER(KIND=JPIM) :: I, J, K, N
