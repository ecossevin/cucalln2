(   52) SUBROUTINE ADDGROUP( USE )
(   53) CHARACTER(LEN=*), INTENT(IN) :: USE
(   54) 
(   55) CALL INIT_OPT_SEEN()
(   56) NOPT_SEEN = NOPT_SEEN + 1
(   57) CALL GROW_OPT_SEEN()
(   58) 
(   59) OPT_SEEN(NOPT_SEEN)%GROUP = .TRUE.
(   60) OPT_SEEN(NOPT_SEEN)%USE = USE
(   61) 
(   62) 
