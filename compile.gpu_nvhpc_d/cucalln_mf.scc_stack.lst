(   99)     !    *LDSC*         FLAG: .TRUE. FOR SC-POINTS
(  100)     
(  101)     !    OUTPUT PARAMETERS (REAL):
(  102)     
(  103)     !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS            KG/KG
(  104)     !    *PLUDE*        DETRAINED TOTAL CONDENSATE                  KG/(M2*S)
(  105)     !    *PLUDELI*      DETRAINED LIQUID, ICE                       KG/(M2*S)
(  106)     !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT             KG/KG
(  107)     !    *PSNDE*        DETRAINED SNOW/RAIN                         KG/(M2*S)
(  108)     !    *PMFU*         MASSFLUX UPDRAFTS                           KG/(M2*S)
(  109)     !    *PMFD*         MASSFLUX DOWNDRAFTS                         KG/(M2*S)
(  110)     !    *PDIFCQ*       CONVECTIVE FLUX OF SPECIFIC HUMIDITY        KG/(M2*S)
(  111)     !    *PDIFCS*       CONVECTIVE FLUX OF HEAT                      J/(M2*S)
(  112)     !    *PFHPCL*       ENTHALPY FLUX DUE TO CONVECTIVE RAIN         J/(M2*S)
(  113)     !    *PFHPCN*       ENTHALPY FLUX DUE TO CONVECTIVE SNOW         J/(M2*S)
(  114)     !    *PFPLCL*       CONVECTIVE RAIN FLUX                        KG/(M2*S)
(  115)     !    *PFPLCN*       CONVECTIVE SNOW FLUX                        KG/(M2*S)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 12

(  116)     !    *PLRAIN*       RAIN+SNOW CONTENT IN UPDRAFTS                 KG/KG
(  117)     !    *PRSUD*        CONVECT MEAN RAIN AND SNOW CONTENT IN COLUMN  KG/KG
(  118)     !    *PSTRTU*       CONVECTIVE FLUX OF U-MOMEMTUM         (M/S)*KG/(M2*S)
