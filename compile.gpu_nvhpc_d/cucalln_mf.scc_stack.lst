(  343)     !-----------------------------------------------------------------------
(  344)     
(  345)     !*    0.1          STORE T,Q,X,Y TENDENCIES FOR FLUX COMPUTATIONS
(  346)     !*                 ----------------------------------------------
(  347)     
(  348)     
(  349)     ! Setup of tendencies
(  350)     
(  351) !$acc loop vector
(  352)     DO JL=KIDIA,KFDIA
(  353) !$acc loop seq
(  354)       DO JK=1,KLEV
(  355)         ZQEA(JL, JK) = PTENQ(JL, JK)
(  356)         ZTEA(JL, JK) = PTENT(JL, JK)
(  357)         ZVEA(JL, JK) = PTENV(JL, JK)
(  358)         ZUEA(JL, JK) = PTENU(JL, JK)
(  359)         ZENTHD(JL, JK) = 0.0_JPRB
(  360)         ZENTHS(JL, JK) = 0.0_JPRB
(  361)       END DO
(  362)       
(  363) !$acc loop seq
(  364)       DO JK=1,KLEV + 1
(  365)         PFPLCL(JL, JK) = 0.0_JPRB
(  366)         PFPLCN(JL, JK) = 0.0_JPRB
(  367)       END DO
(  368)       
(  369)       !-----------------------------------------------------------------------
(  370)       
(  371)       !*    1.           UPDATE PROGN. VALUES DEPENDING ON
(  372)       !                  TIME INTEGRATION AND CALCULATE QS
(  373)       !*                 ---------------------------------
(  374)       !-------------------------------------------------
(  375)       ! Protection in division. ZEPS is choosen as 1000 times lower
(  376)       ! than the actual values of qv (1.e-7 kg/kg) met in the high atmosphere.
(  377)       ! This ZEPS value, used in multiplication only, is relevant for both simple and
(  378)       ! double precision purpose.
(  379)       !-------------------------------------------------
(  380)       ZEPS = 1.0E-10_JPRB
(  381) !$acc loop seq
(  382)       DO JK=1,KLEV
(  383)         ZUP1(JL, JK) = PUM1(JL, JK) + PTENU(JL, JK)*PTSPHY
(  384)         ZVP1(JL, JK) = PVM1(JL, JK) + PTENV(JL, JK)*PTSPHY
(  385)         ZTP1(JL, JK) = PTM1(JL, JK) + PTENT(JL, JK)*PTSPHY
(  386)         ZQP1(JL, JK) = PQM1(JL, JK) + PTENQ(JL, JK)*PTSPHY
(  387)         ZQSAT(JL, JK) = ZQP1(JL, JK)
(  388)         IF (ZQSAT(JL, JK) <= 0.0_JPRB) ZQSAT(JL, JK) = ZEPS
(  389)       END DO
(  390)       
(  391)       IF (LDSLPHY) THEN
(  392)         IF (KTRAC > 0 .and. YDML_PHY_EC%YREPHY%LMFTRAC) THEN
(  393) !$acc loop seq
(  394)           DO JN=1,KTRAC
(  395) !$acc loop seq
(  396)             DO JK=1,KLEV
(  397)               ! attention: transport is for positive definit quantities only
(  398)               ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN))






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 8

(  399)               ZCP1(JL, JK, JN) = PCM1(JL, JK, JN)
(  400)             END DO
(  401)           END DO
(  402)         END IF
(  403)       ELSE
(  404)         IF (KTRAC > 0 .and. YDML_PHY_EC%YREPHY%LMFTRAC) THEN
(  405) !$acc loop seq
(  406)           DO JN=1,KTRAC
(  407) !$acc loop seq
(  408)             DO JK=1,KLEV
(  409)               ! attention: transport is for positive definit quantities only
(  410)               ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN)+PTENC(JL,JK,JN)*PTSPHY)
(  411)               ZCP1(JL, JK, JN) = PCM1(JL, JK, JN) + PTENC(JL, JK, JN)*PTSPHY
(  412)             END DO
(  413)           END DO
(  414)         END IF
(  415)       END IF
(  416)     END DO
(  417)     
(  418)     
(  419)     IFLAG = 1
(  420)     CALL SATUR_LOKI(YDTHF, YDCST, KIDIA, KFDIA, KLON, YDML_PHY_EC%YRECUMF%NJKT2, KLEV, YDML_PHY_SLIN%YREPHLI%LPHYLIN, PAP, Z
(  421)     & ZQSAT, IFLAG, YDSTACK_L=YLSTACK_L)
(  422)     
(  423)     
(  424) !$acc loop vector
(  425)     DO JL=KIDIA,KFDIA
(  426)       ZRAIN(JL) = 0.0_JPRB
(  427)     END DO
(  428)     
(  429)     
(  430)     !-----------------------------------------------------------------------
(  431)     
(  432)     !*    2.     CALL 'CUMASTR'(MASTER-ROUTINE FOR CUMULUS PARAMETERIZATION)
(  433)     !*           -----------------------------------------------------------
(  434)     
(  435)     LLTDKMF = .true.
(  436)     CALL CUMASTRN_LOKI(PPLDARE, PPLRG, YDTHF, YDCST, YDML_PHY_SLIN, YDML_PHY_EC, YGFL, YDCHEM, YDSPP_CONFIG, YDPERTPAR, KIDI
(  437)     & KFDIA, KLON, KLEV, PDX, LLTDKMF, LDMCAPEA, LDLAND, PTSPHY, ZTP1, ZQP1, ZUP1, ZVP1, PLITOT, PVERVEL, ZQSAT, PQHFL, PAHF
(  438)     & PAP, PAPH, PGEO, PGEOH, PGAW, PCUCONVCA, PGP2DSPP, PTENT, PTENQ, PTENU, PTENV, PTENTA, PTENQA, LDCUM, KTYPE, KCBOT, KC
(  439)     & LDCUM_LIG, KCBOT_LIG, KCTOP_LIG, KBOTSC, LDSC, LDSHCV, PLCRIT_AER, ZTU, ZQU, PLU, PLUDE, PLUDELI, PSNDE, ZENTHD, PFPLC
(  440)     & PFPLCN, ZRAIN, PLRAIN, PRSUD, PMFU, PMFD, PLGLAC, PMFUDE_RATE, PMFDDE_RATE, PCAPE, PWU, PWMEAN, PVDISCU, PDISS, KTRAC,
(  441)     & ZCP1, PTENC, PSCAV, PSCAV0, YDSTACK_L=YLSTACK_L)
(  442)     !----------------------------------------------------------------------
(  443)     
(  444)     !*    3.0       CALL 'CUCCDIA' TO UPDATE CLOUD PARAMETERS FOR RADIATION
(  445)     !               -------------------------------------------------------
(  446)     
(  447)     CALL CUCCDIA_LOKI(YDERAD, YDML_PHY_SLIN%YREPHLI, YDML_PHY_EC%YREPHY, KIDIA, KFDIA, KLON, KLEV, KSTEP, KCBOT, KCTOP, LDCU
(  448)     & ZQU, PLU, PMFU, ZRAIN, PARPRC, KTOPC, KBASEC, YDSTACK_L=YLSTACK_L)
(  449)     
(  450)     
(  451)     !---------------------------------------------------------------------
(  452)     
(  453)     !*    5.           FLUX COMPUTATIONS
(  454)     !                  -----------------
(  455)     
(  456)     






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 9

(  457) !$acc loop vector
(  458)     DO JL=KIDIA,KFDIA
(  459)       PDIFCQ(JL, 1) = 0.0_JPRB
(  460)       PDIFCS(JL, 1) = 0.0_JPRB
(  461)       PSTRCU(JL, 1) = 0.0_JPRB
(  462)       PSTRCV(JL, 1) = 0.0_JPRB
(  463)       PFCQLF(JL, 1) = 0.0_JPRB
(  464)       PFCQIF(JL, 1) = 0.0_JPRB
(  465)       PFHPCL(JL, 1) = 0.0_JPRB
(  466)       PFHPCN(JL, 1) = 0.0_JPRB
(  467)       PDIFCS(JL, 1) = 0.0_JPRB
(  468)       PDIFCQ(JL, 1) = 0.0_JPRB
(  469)       ZCONDFLL = 0.0_JPRB
(  470)       ZCONDFLN = 0.0_JPRB
(  471)       
(  472) !$acc loop seq
(  473)       DO JK=1,KLEV
(  474)         
(  475)         ZGDPH = -YDCST%RG / (PAPHM1(JL, JK + 1) - PAPHM1(JL, JK))
(  476)         !...increment in dry static energy is converted to flux of d.s.e.
(  477)         ZCP = YDCST%RCPD*(1 + YDTHF%RVTMP2*ZQP1(JL, JK))
(  478)         PDIFCS(JL, JK + 1) = (PTENT(JL, JK) - ZTEA(JL, JK)) / ZGDPH*ZCP + PDIFCS(JL, JK)
(  479)         !...increments in U,V
(  480)         PSTRCU(JL, JK + 1) = (PTENU(JL, JK) - ZUEA(JL, JK)) / ZGDPH + PSTRCU(JL, JK)
(  481)         PSTRCV(JL, JK + 1) = (PTENV(JL, JK) - ZVEA(JL, JK)) / ZGDPH + PSTRCV(JL, JK)
(  482)         
(  483)         !...increment in Q
(  484)         PDIFCQ(JL, JK + 1) = (PTENQ(JL, JK) - ZQEA(JL, JK)) / ZGDPH + PDIFCQ(JL, JK)
(  485)         
(  486)       END DO
(  487)       
(  488) !$acc loop seq
(  489)       DO JK=1,KLEV
(  490)         !DEC$ IVDEP
(  491)         !... enthalpy flux due to precipitations
(  492)         
(  493)         PFHPCL(JL, JK + 1) = -PFPLCL(JL, JK + 1)*YDCST%RLVTT
(  494)         PFHPCN(JL, JK + 1) = -PFPLCN(JL, JK + 1)*YDCST%RLSTT
(  495)         ZCONDFLL = ZCONDFLL + PLUDELI(JL, JK, 1)
(  496)         ZCONDFLN = ZCONDFLN + PLUDELI(JL, JK, 2)
(  497)         PDIFCS(JL, JK + 1) =  &
(  498)         & PDIFCS(JL, JK + 1) - PFHPCL(JL, JK + 1) - PFHPCN(JL, JK + 1) + YDCST%RLVTT*ZCONDFLL + YDCST%RLSTT*ZCONDFLN
(  499)         PDIFCQ(JL, JK + 1) = PDIFCQ(JL, JK + 1) - PFPLCL(JL, JK + 1) - PFPLCN(JL, JK + 1) - ZCONDFLL - ZCONDFLN
(  500)         PFCQLF(JL, JK + 1) = ZCONDFLL
(  501)         PFCQIF(JL, JK + 1) = ZCONDFLN
(  502)       END DO
(  503)     END DO
(  504)     
(  505)     !---------------------------------------------------------------------
(  506)     
(  507)     
(  508) !$acc end data
(  509)   END SUBROUTINE CUCALLN_MF_LOKI
(  510) END MODULE CUCALLN_MF_LOKI_MOD










