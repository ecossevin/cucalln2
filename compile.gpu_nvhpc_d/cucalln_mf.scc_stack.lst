(  286) # 1 "./fcttrm.func.h"
(    1) !*
(    2) !     ------------------------------------------------------------------
(    3) # 4 "./fcttrm.func.h"
(    4) !     CE COMDECK CONTIENT DEUX GROUPES DE FONCTIONS THERMODYNAMIQUES :
(    5) # 6 "./fcttrm.func.h"
(    6) !        * LE PREMIER (RLV,RLS,RLF,ESW,ESS,ES) CORRESPOND A DES
(    7) !     FONCTIONS ABSOLUES (OU INTRINSEQUES) QUI DOIVENT ETRE UTILISEES
(    8) !     POUR TOUT CE QUI CONCERNE LE MONDE REEL (DONNEES OBSERVEES ET
(    9) !     SORTIES DESTINEES A ETRE COMPAREES A DE TELLES DONNEES).
(   10) # 11 "./fcttrm.func.h"
(   11) !        * LE SECOND (FOEW,FODLEW,FOQS,FODQS,FOLH) CORRESPOND AU MONDE
(   12) !     DE LA PHYSIQUE DU MODELE (ET PAR CONSEQUENT DE TOUTE LES PARTIES
(   13) !     DU CODE QUI DOIVENT ETRE COMPATIBLES AVEC CETTE PHYSIQUE :
(   14) !     ANALYSE/DYNAMIQUE/POST-PROCESSING ... ). LES DIFFERENCES ENTRE LES
(   15) !     DEUX GROUPES VIENNENT, DANS LA CONFIGURATION ACTUELLE DE LA
(   16) !     PHYSIQUE, DES POINTS SUIVANTS :
(   17) !         - CALCULS RELATIFS A LA VARIABLE Q DU MODELE
(   18) !         - CALCULS DE DERIVATION PAR RAPPORT A LA TEMPERATURE
(   19) !         - ABSENCE D'ETATS HORS-EQUILIBRE = UNE SEULE CHALEUR LATENTE
(   20) !           DE FUSION
(   21) !         - POSSIBILITE DE TRAVAILLER SANS LA PHASE GLACE = INDICE DE
(   22) !           TEST BINAIRE.
(   23) # 24 "./fcttrm.func.h"
(   24) !     ------------------------------------------------------------------
(   25) !     ABSOLUTE THERMODYNAMICAL FUNCTIONS .
(   26) # 28 "./fcttrm.func.h"
(   28) !     RLV : LATENT HEAT OF VAPOURISATION
(   29) !     RLS : LATENT HEAT OF SUBLIMATION
(   30) !     RLF : LATENT HEAT OF FUSION
(   31) !     ESW : SATURATION IN PRESENCE OF WATER
(   32) !     ESS : SATURATION IN PRESENCE OF ICE
(   33) !     ES  : SATURATION (IF T>YDCST%RTT THEN WATER ; IF T<YDCST%RTT THEN ICE)
(   34) !        INPUT (FOR ALL SIX FUNCTIONS) : PTARG = TEMPERATURE .
(   35) REAL(KIND=JPRB) :: RLV,RLS,RLF,ESW,ESS,ES
(   36) REAL(KIND=JPRB) :: PTARG
(   37) # 38 "./fcttrm.func.h"
(   38) RLV(PTARG)=YDCST%RLVTT+(YDCST%RCPV-YDCST%RCW)*(PTARG-YDCST%RTT)
(   39) RLS(PTARG)=YDCST%RLSTT+(YDCST%RCPV-YDCST%RCS)*(PTARG-YDCST%RTT)
(   40) RLF(PTARG)=RLS(PTARG)-RLV(PTARG)
(   41) ESW(PTARG)=EXP(YDCST%RALPW-YDCST%RBETW/PTARG-YDCST%RGAMW*LOG(PTARG))
(   42) ESS(PTARG)=EXP(YDCST%RALPS-YDCST%RBETS/PTARG-YDCST%RGAMS*LOG(PTARG))
(   43) ES (PTARG)=EXP(&
(   44)           &(YDCST%RALPW+YDCST%RALPD*MAX(0.0_JPRB,SIGN(1.0_JPRB,YDCST%RTT-PTARG)))&
(   45)          &-(YDCST%RBETW+YDCST%RBETD*MAX(0.0_JPRB,SIGN(1.0_JPRB,YDCST%RTT-PTARG)))/PTARG &
(   46)          &-(YDCST%RGAMW+YDCST%RGAMD*MAX(0.0_JPRB,SIGN(1.0_JPRB,YDCST%RTT-PTARG)))*LOG(PTARG))
(   47) # 48 "./fcttrm.func.h"
(   48) !     ------------------------------------------------------------------
(   49) !     FONCTIONS THERMODYNAMIQUES : FONCTIONS DEFINIES DE LA PHYSIQUE .
(   50) # 52 "./fcttrm.func.h"
(   52) !     FONCTION DE LA TENSION DE VAPEUR SATURANTE .
(   53) !        INPUT : PTARG = TEMPERATURE
(   54) !                PDELARG = 0 SI EAU (QUELQUE SOIT PTARG)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 19

(   55) !                          1 SI GLACE (QUELQUE SOIT PTARG).
(   56) REAL(KIND=JPRB) :: FOEW
(   57) REAL(KIND=JPRB) :: PDELARG
(   58) FOEW ( PTARG,PDELARG ) = EXP (&
(   59)     &( YDCST%RALPW+PDELARG*YDCST%RALPD )&
(   60)   &- ( YDCST%RBETW+PDELARG*YDCST%RBETD ) / PTARG &
(   61)   &- ( YDCST%RGAMW+PDELARG*YDCST%RGAMD ) * LOG(PTARG) )
(   62) # 63 "./fcttrm.func.h"
(   63) !     FONCTION DERIVEE DU LOGARITHME NEPERIEN DE LA PRECEDENTE (FOEW) .
(   64) !        INPUT : PTARG = TEMPERATURE
(   65) !                PDELARG = 0 SI EAU (QUELQUE SOIT PTARG)
(   66) !                          1 SI GLACE (QUELQUE SOIT PTARG).
(   67) REAL(KIND=JPRB) :: FODLEW
(   68) FODLEW ( PTARG,PDELARG ) = (&
(   69)       &( YDCST%RBETW+PDELARG*YDCST%RBETD )&
(   70)     &- ( YDCST%RGAMW+PDELARG*YDCST%RGAMD ) * PTARG )&
(   71)     &/ ( PTARG*PTARG )
(   72) # 73 "./fcttrm.func.h"
(   73) !     FONCTION HUMIDITE SPECIFIQUE SATURANTE .
(   74) !        INPUT : PESPFAR = RAPPORT FOEW SUR PRESSION.
(   75) REAL(KIND=JPRB) :: FOQS
(   76) REAL(KIND=JPRB) :: PESPFAR
(   77) FOQS ( PESPFAR ) = PESPFAR / ( 1.0_JPRB+YDCST%RETV*MAX(0.0_JPRB,&
(   78)     &(1.0_JPRB-PESPFAR)) )
(   79) # 80 "./fcttrm.func.h"
(   80) !     FONCTION HUMIDITE SPECIFIQUE SATURANTE, COMME FONCTION DIRECTE DE T ET P.
(   81) !        INPUT : PTARG  = TEMPERATURE.
(   82) !                PPRESS = PRESSION.
(   83) REAL(KIND=JPRB) :: FOQSTP
(   84) REAL(KIND=JPRB) :: PPRESS
(   85) FOQSTP(PTARG,PPRESS)=FOQS(FOEW(PTARG,MAX(0.0_JPRB,SIGN(1.0_JPRB,YDCST%RTT-PTARG)))/PPRESS)
(   86) # 87 "./fcttrm.func.h"
(   87) !     FONCTION DERIVEE EN TEMPERATURE DE LA PRECEDENTE (FOQS) .
(   88) !        INPUT : PQSFARG = FOQS
(   89) !                PESPFAR = RAPPORT FOEW SUR PRESSION
(   90) !                PDLEFAR = FODLEW.
(   91) REAL(KIND=JPRB) :: FODQS 
(   92) REAL(KIND=JPRB) :: PQSFARG,PDLEFAR 
(   93) FODQS ( PQSFARG,PESPFAR,PDLEFAR ) = ( PQSFARG &
(   94)    &* (1.0_JPRB-PQSFARG)*PDLEFAR ) / (1.0_JPRB-PESPFAR)
(   95) # 96 "./fcttrm.func.h"
(   96) !     FONCTION COMPOSE DE FODQS ET FOQS AVEC SIMPLIFICATION DU TERME (1-PESPFAR) POUR EVITER LES OVERFLOWS
(   97) !     FDQW (PESPFAR, PDLEFAR) = FODQS (FOQS (PESPFAR), PESPFAR, PDLEFAR)
(   98) !        INPUT : PESPFAR = RAPPORT FOEW SUR PRESSION
(   99) !                PDLEFAR = FODLEW
(  100) REAL(KIND=JPRB) :: FDQW
(  101) FDQW (PESPFAR, PDLEFAR) = PDLEFAR * PESPFAR * (1.0_JPRB+YDCST%RETV) / ( 1.0_JPRB+YDCST%RETV*MAX(0.0_JPRB,(1.0_JPRB-PESPFAR)) ) ** 2._JPRB
(  102) !     FONCTION CHALEUR LATENTE .
(  103) !        INPUT : PTARG = TEMPERATURE
(  104) !                PDELARG = 0 SI EAU (QUELQUE SOIT PTARG)
(  105) !                          1 SI GLACE (QUELQUE SOIT PTARG).
(  106) REAL(KIND=JPRB) :: FOLH
(  107) FOLH ( PTARG,PDELARG ) =  YDCST%RV * (&
(  108)     &( YDCST%RBETW+PDELARG*YDCST%RBETD )&
(  109)   &- ( YDCST%RGAMW+PDELARG*YDCST%RGAMD ) * PTARG )
(  110) !     ------------------------------------------------------------------
