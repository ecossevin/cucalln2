(   44)     
(   45)     !     INPUT PARAMETERS (REAL)
(   46)     
(   47)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                     S
(   48)     !    *PTM1*         TEMPERATURE (T-1)                             K
(   49)     !    *PQM1*         SPECIFIC HUMIDITY (T-1)                       KG/KG
(   50)     !    *PUM1*         X-VELOCITY COMPONENT (T-1)                    M/S
(   51)     !    *PVM1*         Y-VELOCITY COMPONENT (T-1)                    M/S
(   52)     !    *PCM1*         CHEMICAL TRACERS (T-1)                        KG/KG
(   53)     !    *PLITOT*       GRID MEAN LIQUID WATER + ICE CONTENT          KG/KG
(   54)     !    *PVERVEL*      VERTICAL VELOCITY                             PA/S
(   55)     !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)     KG/(SM2)
(   56)     !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   57)     !    *PAPHM1*       PRESSURE ON HALF LEVELS                       PA






