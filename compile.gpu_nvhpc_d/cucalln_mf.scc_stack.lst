(  349)     ! Setup of tendencies
(  350)     
(  351) !$acc loop vector
(  352)     DO JL=KIDIA,KFDIA
(  353) !$acc loop seq
(  354)       DO JK=1,KLEV
(  355)         ZQEA(JL, JK) = PTENQ(JL, JK)
(  356)         ZTEA(JL, JK) = PTENT(JL, JK)
(  357)         ZVEA(JL, JK) = PTENV(JL, JK)
(  358)         ZUEA(JL, JK) = PTENU(JL, JK)
(  359)         ZENTHD(JL, JK) = 0.0_JPRB
(  360)         ZENTHS(JL, JK) = 0.0_JPRB
(  361)       END DO
(  362)       
(  363) !$acc loop seq
(  364)       DO JK=1,KLEV + 1
(  365)         PFPLCL(JL, JK) = 0.0_JPRB
(  366)         PFPLCN(JL, JK) = 0.0_JPRB
(  367)       END DO
(  368)       
(  369)       !-----------------------------------------------------------------------
(  370)       
(  371)       !*    1.           UPDATE PROGN. VALUES DEPENDING ON
(  372)       !                  TIME INTEGRATION AND CALCULATE QS
(  373)       !*                 ---------------------------------
(  374)       !-------------------------------------------------
(  375)       ! Protection in division. ZEPS is choosen as 1000 times lower
(  376)       ! than the actual values of qv (1.e-7 kg/kg) met in the high atmosphere.
(  377)       ! This ZEPS value, used in multiplication only, is relevant for both simple and
(  378)       ! double precision purpose.
(  379)       !-------------------------------------------------
(  380)       ZEPS = 1.0E-10_JPRB
(  381) !$acc loop seq
(  382)       DO JK=1,KLEV
(  383)         ZUP1(JL, JK) = PUM1(JL, JK) + PTENU(JL, JK)*PTSPHY
(  384)         ZVP1(JL, JK) = PVM1(JL, JK) + PTENV(JL, JK)*PTSPHY
(  385)         ZTP1(JL, JK) = PTM1(JL, JK) + PTENT(JL, JK)*PTSPHY
(  386)         ZQP1(JL, JK) = PQM1(JL, JK) + PTENQ(JL, JK)*PTSPHY
(  387)         ZQSAT(JL, JK) = ZQP1(JL, JK)
(  388)         IF (ZQSAT(JL, JK) <= 0.0_JPRB) ZQSAT(JL, JK) = ZEPS
(  389)       END DO
(  390)       
(  391)       IF (LDSLPHY) THEN
(  392)         IF (KTRAC > 0 .and. YDML_PHY_EC%YREPHY%LMFTRAC) THEN
(  393) !$acc loop seq
(  394)           DO JN=1,KTRAC
(  395) !$acc loop seq
(  396)             DO JK=1,KLEV
(  397)               ! attention: transport is for positive definit quantities only
(  398)               ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN))
(  399)               ZCP1(JL, JK, JN) = PCM1(JL, JK, JN)
(  400)             END DO
(  401)           END DO
(  402)         END IF
(  403)       ELSE






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 22

(  404)         IF (KTRAC > 0 .and. YDML_PHY_EC%YREPHY%LMFTRAC) THEN
(  405) !$acc loop seq
(  406)           DO JN=1,KTRAC
(  407) !$acc loop seq
(  408)             DO JK=1,KLEV
(  409)               ! attention: transport is for positive definit quantities only
(  410)               ! ZCP1(JL,JK,JN)=MAX(0._JPRB,PCM1(JL,JK,JN)+PTENC(JL,JK,JN)*PTSPHY)
(  411)               ZCP1(JL, JK, JN) = PCM1(JL, JK, JN) + PTENC(JL, JK, JN)*PTSPHY
(  412)             END DO
(  413)           END DO
(  414)         END IF
(  415)       END IF
