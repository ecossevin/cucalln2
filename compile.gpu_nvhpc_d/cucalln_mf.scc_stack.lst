(   11)     !          *CUCALL* - MASTER ROUTINE - PROVIDES INTERFACE FOR:
(   12)     !                     *CUMASTR* (CUMULUS PARAMETERIZATION)
(   13)     !                     *CUCCDIA* (CUMULUS CLOUDS FOR RADIATION)
(   14)     !                     *CUSTRAT* (PBL_STRATOCUMULUS)
(   15)     
(   16)     !**   PURPOSE.
(   17)     !     --------
(   18)     
(   19)     !          *CUCALL* - INTERFACE FOR *CUMASTR*,*CUCCDIA* AND *CUSTRAT*:
(   20)     !                     PROVIDES INPUT FOR CUMASTR, CUCCDIA AND CUSTRAT.
(   21)     !                     RECEIVES UPDATED TENDENCIES, PRECIPITATION
(   22)     !                     AND CONVECTIVE CLOUD PARAMETERS FOR RADIATION.
(   23)     
(   24)     !**   INTERFACE.
(   25)     !     ----------
(   26)     
(   27)     !          *CUCALL* IS CALLED FROM *CALLPAR*
(   28)     
(   29)     !     PARAMETER     DESCRIPTION                                   UNITS
(   30)     !     ---------     -----------                                   -----
(   31)     !     INPUT PARAMETERS (INTEGER):
(   32)     
(   33)     !    *KIDIA*        START POINT
(   34)     !    *KFDIA*        END POINT
(   35)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   36)     !    *KSMAX*        HORIZONTAL SPECTRAL TRUNCATION
(   37)     !    *KLEV*         NUMBER OF LEVELS
(   38)     !    *KSPPN2D*      Number of 2D patterns in SPP scheme
(   39)     !    *KTRAC*        NUMBER OF CHEMICAL TRACERS
(   40)     
(   41)     !     INPUT PARAMETERS (LOGICAL)
(   42)     
(   43)     !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   44)     
(   45)     !     INPUT PARAMETERS (REAL)
(   46)     
(   47)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                     S
(   48)     !    *PTM1*         TEMPERATURE (T-1)                             K
(   49)     !    *PQM1*         SPECIFIC HUMIDITY (T-1)                       KG/KG
(   50)     !    *PUM1*         X-VELOCITY COMPONENT (T-1)                    M/S






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 2

(   51)     !    *PVM1*         Y-VELOCITY COMPONENT (T-1)                    M/S
(   52)     !    *PCM1*         CHEMICAL TRACERS (T-1)                        KG/KG
(   53)     !    *PLITOT*       GRID MEAN LIQUID WATER + ICE CONTENT          KG/KG
(   54)     !    *PVERVEL*      VERTICAL VELOCITY                             PA/S
(   55)     !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)     KG/(SM2)
(   56)     !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   57)     !    *PAPHM1*       PRESSURE ON HALF LEVELS                       PA
(   58)     !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS           PA
(   59)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   60)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   61)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   62)     !    *PGAW*       NORMALISED GAUSSIAN QUADRATURE WEIGHT / NUMBER OF LONGITUDE POINTS
(   63)     !                           LOCAL SUB-AREA == 4*RPI*RA**2 * PGAW
(   64)     !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(   65)     !    *PCUCONVCA*    COUPLING TO CELL AUTOMATON OR 2D ADVECT FIELD ( )
(   66)     !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   67)     
(   68)     !    UPDATED PARAMETERS (REAL):
(   69)     
(   70)     !     tendency_cml    cumulative tendency used for final output
(   71)     !     tendency_tmp    cumulative tendency used as input
(   72)     !     tendency_loc    local tendency from convection
(   73)     
(   74)     !    *PTENC*        TENDENCY OF CHEMICAL TRACERS                 1/S
(   75)     !    *PARPRC*       ACCUMULATED PRECIPITATION AMMOUNT           KG/(M2*S)
(   76)     !                   FOR RADIATION CALCULATION
(   77)     
(   78)     !    UPDATED PARAMETERS (INTEGER):
(   79)     
(   80)     !    *KTOPC*        UPDATED CONVECTIVE CLOUD TOP LEVEL FOR RADIATION
(   81)     !    *KBASEC*       UPDATED CONVECTIVE CLOUD BASE LEVEL FOR RADIATION
(   82)     
(   83)     !    OUTPUT PARAMETERS (INTEGER):
(   84)     
(   85)     !    *KTYPE*        TYPE OF CONVECTION
(   86)     !                       1 = PENETRATIVE CONVECTION
(   87)     !                       2 = SHALLOW CONVECTION
(   88)     !                       3 = MIDLEVEL CONVECTION
(   89)     !    *KCBOT*        CLOUD BASE LEVEL
(   90)     !    *KCTOP*        CLOUD TOP LEVEL
(   91)     !    *KBOTSC*       CLOUD BASE LEVEL FOR SC-CLOUDS
(   92)     !    *KCBOT_LIG*    CLOUD BASE LEVEL (FOR LIGHTNING PARAM)
(   93)     !    *KCTOP_LIG*    CLOUD TOP LEVEL (FOR LIGHTNING PARAM)
(   94)     
(   95)     !    OUTPUT PARAMETERS (LOGICAL):
(   96)     
(   97)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   98)     !    *LDCUM_LIG*    FLAG: .TRUE. FOR CONVECTIVE POINTS (FOR LIGHTNING PARAM)
(   99)     !    *LDSC*         FLAG: .TRUE. FOR SC-POINTS
(  100)     
(  101)     !    OUTPUT PARAMETERS (REAL):
(  102)     
(  103)     !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS            KG/KG
(  104)     !    *PLUDE*        DETRAINED TOTAL CONDENSATE                  KG/(M2*S)
(  105)     !    *PLUDELI*      DETRAINED LIQUID, ICE                       KG/(M2*S)
(  106)     !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT             KG/KG
(  107)     !    *PSNDE*        DETRAINED SNOW/RAIN                         KG/(M2*S)
(  108)     !    *PMFU*         MASSFLUX UPDRAFTS                           KG/(M2*S)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:58      page 3

(  109)     !    *PMFD*         MASSFLUX DOWNDRAFTS                         KG/(M2*S)
(  110)     !    *PDIFCQ*       CONVECTIVE FLUX OF SPECIFIC HUMIDITY        KG/(M2*S)
(  111)     !    *PDIFCS*       CONVECTIVE FLUX OF HEAT                      J/(M2*S)
(  112)     !    *PFHPCL*       ENTHALPY FLUX DUE TO CONVECTIVE RAIN         J/(M2*S)
(  113)     !    *PFHPCN*       ENTHALPY FLUX DUE TO CONVECTIVE SNOW         J/(M2*S)
(  114)     !    *PFPLCL*       CONVECTIVE RAIN FLUX                        KG/(M2*S)
(  115)     !    *PFPLCN*       CONVECTIVE SNOW FLUX                        KG/(M2*S)
(  116)     !    *PLRAIN*       RAIN+SNOW CONTENT IN UPDRAFTS                 KG/KG
(  117)     !    *PRSUD*        CONVECT MEAN RAIN AND SNOW CONTENT IN COLUMN  KG/KG
(  118)     !    *PSTRTU*       CONVECTIVE FLUX OF U-MOMEMTUM         (M/S)*KG/(M2*S)
(  119)     !    *PSTRTV*       CONVECTIVE FLUX OF V-MOMEMTUM         (M/S)*KG/(M2*S)
(  120)     !    *PFCQLF*       CONVECTIVE CONDENSATION FLUX LIQUID         KG/(M2*S)
(  121)     !    *PFCQIF*       CONVECTIVE CONDENSATION FLUX ICE            KG/(M2*S)
(  122)     
(  123)     !               Diagnostics:
(  124)     !    *PMFUDE_RATE* UPDRAFT DETRAINMENT RATE                     KG/(M3*S)
(  125)     !    *PMFDDE_RATE* DOWNDRAFT DETRAINMENT RATE                   KG/(M3*S)
(  126)     !    *PCAPE*       MAXIMUM pseudoadiabat CAPE                   (J/KG)
(  127)     !    *PWMEAN*      VERTICALLY AVERAGED UPDRAUGHT VELOCITY        M/S
(  128)     !    *PVDISCU*     VERT INTEGRATED CONVECTIVE DISSIPATION RATE   W/m2
(  129)     !    *PDISS*       ESTIMATE FOR DISSIPATION BT DEEP CONVCTION    J/m2
(  130)     
(  131)     !     EXTERNALS.
(  132)     !     ----------
