(   31)     !     INPUT PARAMETERS (INTEGER):
(   32)     
(   33)     !    *KIDIA*        START POINT
(   34)     !    *KFDIA*        END POINT
(   35)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   36)     !    *KSMAX*        HORIZONTAL SPECTRAL TRUNCATION
(   37)     !    *KLEV*         NUMBER OF LEVELS
