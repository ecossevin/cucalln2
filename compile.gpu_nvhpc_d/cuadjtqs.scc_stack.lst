(  196)           ZCOND1 = (PQ(JL, KK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  197)           IF (ZCOND == 0.0_JPRB) ZCOND1 = 0.0_JPRB
(  198)           PT(JL, KK) = PT(JL, KK) + ZALDCP*ZCOND1
(  199)           PQ(JL, KK) = PQ(JL, KK) - ZCOND1
(  200)           !     ENDIF
(  201)         END IF
(  202)         
(  203)       END IF
(  204)       
(  205)       IF (KCALL == 0) THEN
(  206)         
(  207)         !DIR$    IVDEP
