(  181)           Z2S = Z5ALCP / (ZTARG - Z4ES)**2
(  182)           ZCOND = (PQ(JL, KK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  183)           ZCOND = MIN(ZCOND, 0.0_JPRB)
(  184)           !     IF(ZCOND /= _ZERO_) THEN
(  185)           PT(JL, KK) = PT(JL, KK) + ZALDCP*ZCOND
(  186)           PQ(JL, KK) = PQ(JL, KK) - ZCOND
(  187)           ZTARG = PT(JL, KK)
(  188)           ZFOEEW = YDTHF%R2ES*EXP(Z3ES*(ZTARG - YDCST%RTT) / (ZTARG - Z4ES))
(  189)           ZQSAT = ZQP*ZFOEEW
(  190)           IF (ZQSAT > ZQMAX) THEN
(  191)             ZQSAT = ZQMAX
(  192)           END IF
(  193)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
