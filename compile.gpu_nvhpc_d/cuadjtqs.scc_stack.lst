(    1) MODULE CUADJTQS_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUADJTQS_LOKI (YDTHF, YDCST, KIDIA, KFDIA, KLON, KLEV, KK, PSP, PT, PQ, LDFLAG, KCALL, YDSTACK_L)
(    4)     
(    5)     !**   *CUADJTQS* - SIMPLIFIED VERSION OF MOIST ADJUSTMENT
(    6)     
(    7)     !     PURPOSE.
(    8)     !     --------
(    9)     !     TO PRODUCE T,Q AND L VALUES FOR CLOUD ASCENT
(   10)     
(   11)     !     INTERFACE
(   12)     !     ---------
(   13)     !     THIS ROUTINE IS CALLED FROM SUBROUTINES:
(   14)     
(   15)     !       *COND*
(   16)     !       *CUBMADJ*
(   17)     !       *CUBMD*
(   18)     !       *CONDAD*
(   19)     !       *CUBMADJAD*
(   20)     !       *CUBMDAD*
(   21)     
(   22)     !     INPUT ARE UNADJUSTED T AND Q VALUES,
(   23)     !     IT RETURNS ADJUSTED VALUES OF T AND Q
(   24)     
(   25)     !     PARAMETER     DESCRIPTION                                   UNITS
(   26)     !     ---------     -----------                                   -----
(   27)     !     INPUT PARAMETERS (INTEGER):
(   28)     
(   29)     !    *KIDIA*        START POINT
(   30)     !    *KFDIA*        END POINT
(   31)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   32)     !    *KLEV*         NUMBER OF LEVELS
(   33)     !    *KK*           LEVEL
(   34)     !    *KCALL*        DEFINES CALCULATION AS
(   35)     !                      KCALL=0  ENV. T AND QS IN*CUINI*
(   36)     !                      KCALL=1  CONDENSATION IN UPDRAFTS  (E.G. CUBASE, CUASC)
(   37)     !                      KCALL=2  EVAPORATION IN DOWNDRAFTS (E.G. CUDLFS,CUDDRAF)
(   38)     
(   39)     !     INPUT PARAMETERS (LOGICAL):
(   40)     
(   41)     !    *LDLAND*       LAND-SEA MASK (.TRUE. FOR LAND POINTS)
(   42)     
(   43)     !     INPUT PARAMETERS (REAL):
(   44)     
(   45)     !    *PSP*          PRESSURE                                        PA
(   46)     
(   47)     !     UPDATED PARAMETERS (REAL):
(   48)     
(   49)     !    *PT*           TEMPERATURE                                     K
(   50)     !    *PQ*           SPECIFIC HUMIDITY                             KG/KG






