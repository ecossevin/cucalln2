(  107)     ZQMAX = 0.5_JPRB
(  108)     
(  109)     !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  110)     !                  -----------------------------------------------------
(  111)     
(  112)     !*    ICE-WATER THERMODYNAMICAL FUNCTIONS
(  113)     
(  114)     
(  115) !$acc loop vector
(  116)     DO JL=KIDIA,KFDIA
(  117)       IF (PT(JL, KK) > YDCST%RTT) THEN
(  118)         Z3ES = YDTHF%R3LES
(  119)         Z4ES = YDTHF%R4LES
(  120)         Z5ALCP = YDTHF%R5ALVCP
(  121)         ZALDCP = YDTHF%RALVDCP
(  122)       ELSE
(  123)         Z3ES = YDTHF%R3IES
(  124)         Z4ES = YDTHF%R4IES
(  125)         Z5ALCP = YDTHF%R5ALSCP
(  126)         ZALDCP = YDTHF%RALSDCP
(  127)       END IF
(  128)       
(  129)       IF (KCALL == 1) THEN
(  130)         
(  131)         !DIR$    IVDEP
(  132)         !OCL NOVREC
(  133)         IF (LDFLAG(JL)) THEN
(  134)           ZQP = 1.0_JPRB / PSP(JL)
(  135)           ZTARG = PT(JL, KK)
(  136)           ZFOEEW = YDTHF%R2ES*EXP(Z3ES*(ZTARG - YDCST%RTT) / (ZTARG - Z4ES))
(  137)           ZQSAT = ZQP*ZFOEEW
(  138)           IF (ZQSAT > ZQMAX) THEN
(  139)             ZQSAT = ZQMAX
(  140)           END IF
(  141)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  142)           ZQSAT = ZQSAT*ZCOR
(  143)           Z2S = Z5ALCP / (ZTARG - Z4ES)**2
(  144)           ZCOND = (PQ(JL, KK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  145)           ZCOND = MAX(ZCOND, 0.0_JPRB)
(  146)           !     IF(ZCOND /= _ZERO_) THEN
(  147)           PT(JL, KK) = PT(JL, KK) + ZALDCP*ZCOND
(  148)           PQ(JL, KK) = PQ(JL, KK) - ZCOND
(  149)           ZTARG = PT(JL, KK)
(  150)           ZFOEEW = YDTHF%R2ES*EXP(Z3ES*(ZTARG - YDCST%RTT) / (ZTARG - Z4ES))
(  151)           ZQSAT = ZQP*ZFOEEW
(  152)           IF (ZQSAT > ZQMAX) THEN
(  153)             ZQSAT = ZQMAX
(  154)           END IF
(  155)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  156)           ZQSAT = ZQSAT*ZCOR
(  157)           Z2S = Z5ALCP / (ZTARG - Z4ES)**2
(  158)           ZCOND1 = (PQ(JL, KK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  159)           IF (ZCOND == 0.0_JPRB) ZCOND1 = 0.0_JPRB
(  160)           PT(JL, KK) = PT(JL, KK) + ZALDCP*ZCOND1
(  161)           PQ(JL, KK) = PQ(JL, KK) - ZCOND1
(  162)           !     ENDIF
(  163)         END IF
(  164)         






