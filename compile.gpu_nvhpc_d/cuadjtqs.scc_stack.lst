(   66)     USE, intrinsic :: ISO_C_BINDING, ONLY: C_SIZEOF
(   67)     USE PARKIND1, ONLY: JPIM, JPRB
(   68)     USE YOMHOOK, ONLY: LHOOK, JPHOOK
(   69)     
