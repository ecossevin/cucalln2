Filename: ./cudtdqn.F90

(    1) SUBROUTINE CUDTDQN &
(    2)  & (YDTHF, YDCST, YDEPHLI, YDPHNC,   YDECUMF,  YDEPHY,&
(    3)  & KIDIA,    KFDIA,    KLON,     KLEV,&
(    4)  & KTOPM2,   KTYPE,    KCTOP,    KCBOT,    KDTOP,  LDTDKMF,  LDCUM,    LDDRAF,   LSCVFLAG, PTSPHY,&
(    5)  & PAPH,     PAP  ,    PGEOH,    PGEO,&
(    6)  & PTEN,     PTENH,    PQEN,     PQENH,    PQSEN,&
(    7)  & PLGLAC,   PLUDE,    PLUDELI,  PSNDE,    PMFU,     PMFD,&
(    8)  & PMFUS,    PMFDS,    PMFUQ,    PMFDQ,&
(    9)  & PMFUL,    PDMFUP,   PDPMEL,   PMFLXR,   PMFLXS,&
(   10)  & PTENT,    PTENQ,    PENTH )
(   11) 
(   12) !**** *CUDTDQ* - UPDATES T AND Q TENDENCIES, PRECIPITATION RATES
(   13) !                DOES GLOBAL DIAGNOSTICS
(   14) 
(   15) !**   INTERFACE.
(   16) !     ----------
(   17) 
(   18) !          *CUDTDQ* IS CALLED FROM *CUMASTR*
(   19) 
(   20) !     PARAMETER     DESCRIPTION                                   UNITS
(   21) !     ---------     -----------                                   -----
(   22) !     INPUT PARAMETERS (INTEGER):
(   23) 
(   24) !    *KIDIA*        START POINT
(   25) !    *KFDIA*        END POINT
(   26) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   27) !    *KLEV*         NUMBER OF LEVELS
(   28) !    *KTYPE*        TYPE OF CONVECTION
(   29) !                       1 = PENETRATIVE CONVECTION
(   30) !                       2 = SHALLOW CONVECTION
(   31) !                       3 = MIDLEVEL CONVECTION
(   32) !    *KCTOP*        CLOUD TOP LEVEL
(   33) !    *KCBOT*        CLOUD BASE LEVEL
(   34) !    *KDTOP*        TOP LEVEL OF DOWNDRAFTS
(   35) 
(   36) !    INPUT PARAMETERS (LOGICAL): 
(   37) 
(   38) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS 
(   39) !    *LDDRAF*       FLAG: .TRUE. FOR DOWNDRAFT LEVEL
(   40) 
(   41) !    INPUT PARAMETERS (REAL):
(   42) 
(   43) !    *PTSPHY*       TIME STEP FOR THE PHYSICS                       S
(   44) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS            PA
(   45) !    *PAP *         PROVISIONAL PRESSURE ON FULL LEVELS            PA
(   46) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   47) !    *PGEO*         GEOPOTENTIAL ON FULL LEVELS                   M2/S2
(   48) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   49) !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   50) !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS           K






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 2

(   51) !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS      KG/KG
(   52) !    *PQSEN*        SATURATION ENV. SPEC. HUMIDITY (T+1)          KG/KG
(   53) !    *PLGLAC*       FLUX OF FROZEN CLOUDWATER IN UPDRAFTS         KG/(M2*S) 
(   54) !    *PLUDE*        DETRAINED CONDENSATE                          KG/(M2*S)
(   55) !    *PLUDELI*      DETRAINED LIQUID, ICE                         KG/(M2*S)
(   56) !    *PSNDE*        DETRAINED SNOW/RAIN                           KG/(M2*S)
(   57) !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(   58) !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
(   59) !    *PMFUS*        FLUX OF DRY STATIC ENERGY IN UPDRAFTS          J/(M2*S)
(   60) !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS        J/(M2*S)
(   61) !    *PMFUQ*        FLUX OF SPEC. HUMIDITY IN UPDRAFTS            KG/(M2*S)
(   62) !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS          KG/(M2*S)
(   63) !    *PMFUL*        FLUX OF LIQUID WATER IN UPDRAFTS              KG/(M2*S)
(   64) !    *PDMFUP*       FLUX DIFFERENCE OF PRECIP.                    KG/(M2*S)
(   65) !    *PDPMEL*       CHANGE IN PRECIP.-FLUXES DUE TO MELTING       KG/(M2*S)
(   66) 
(   67) !    UPDATED PARAMETERS (REAL):
(   68) 
(   69) !    *PTENT*        TEMPERATURE TENDENCY                           K/S
(   70) !    *PTENQ*        MOISTURE TENDENCY                             KG/(KG S)
(   71) 
(   72) !    OUTPUT PARAMETERS (REAL):
(   73) 
(   74) !    *PENTH*        INCREMENT OF DRY STATIC ENERGY                 J/(KG*S) 
(   75) 
(   76) !----------------------------------------------------------------------
(   77) 
(   78) !     AUTHOR.
(   79) !     -------
(   80) !      M.TIEDTKE         E.C.M.W.F.     7/86 MODIF. 12/89
(   81) 
(   82) !     MODIFICATIONS.
(   83) !     --------------
(   84) !      M.Hamrud      01-Oct-2003 CY28 Cleaning
(   85) !      03-08-28       : Clean up LINPHYS  P.BECHTOLD
(   86) !      05-10-13       : implicit solution P.BECHTOLD
(   87) !      10-11-17       : allow to substract subbsidence (dyn) P. Bechtold
(   88) !      28-12-21       : correction for enthalpy conservation ice phase P. Bechtold
(   89) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   90) !---------------------------------------------------------------------------------
(   91) 
(   92) USE PARKIND1 , ONLY : JPIM     ,JPRB
(   93) USE YOMHOOK  , ONLY : LHOOK,   DR_HOOK, JPHOOK
(   94) 
(   95) USE YOMCST   , ONLY : TCST
(   96) USE YOETHF   , ONLY : TTHF  
(   97) USE YOECUMF  , ONLY : TECUMF
(   98) USE YOEPHY   , ONLY : TEPHY
(   99) USE YOEPHLI  , ONLY : TEPHLI
(  100) USE YOPHNC   , ONLY : TPHNC
(  101) 
(  102) IMPLICIT NONE
(  103) 
(  104) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(  105) TYPE(TCST)        ,INTENT(IN)    :: YDCST
(  106) TYPE(TECUMF)      ,INTENT(IN)    :: YDECUMF
(  107) TYPE(TEPHLI)      ,INTENT(IN)    :: YDEPHLI
(  108) TYPE(TEPHY)       ,INTENT(IN)    :: YDEPHY






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 3

(  109) TYPE(TPHNC)       ,INTENT(IN)    :: YDPHNC
(  110) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(  111) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(  112) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(  113) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(  114) INTEGER(KIND=JPIM),INTENT(IN)    :: KTOPM2 
(  115) INTEGER(KIND=JPIM),INTENT(IN)    :: KTYPE(KLON) 
(  116) INTEGER(KIND=JPIM),INTENT(IN)    :: KCTOP(KLON) 
(  117) INTEGER(KIND=JPIM),INTENT(IN)    :: KCBOT(KLON) 
(  118) INTEGER(KIND=JPIM),INTENT(IN)    :: KDTOP(KLON) 
(  119) LOGICAL           ,INTENT(INOUT) :: LDCUM(KLON)
(  120) LOGICAL           ,INTENT(IN)    :: LDDRAF(KLON) 
(  121) LOGICAL           ,INTENT(IN)    :: LDTDKMF
(  122) LOGICAL           ,INTENT(IN)    :: LSCVFLAG(KLON) 
(  123) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTSPHY 
(  124) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAPH(KLON,KLEV+1) 
(  125) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAP(KLON,KLEV) 
(  126) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEO(KLON,KLEV)
(  127) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEOH(KLON,KLEV+1)
(  128) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTEN(KLON,KLEV)
(  129) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQEN(KLON,KLEV)
(  130) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTENH(KLON,KLEV)
(  131) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQENH(KLON,KLEV)
(  132) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQSEN(KLON,KLEV)
(  133) REAL(KIND=JPRB)   ,INTENT(IN)    :: PLGLAC(KLON,KLEV) 
(  134) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PLUDE(KLON,KLEV)
(  135) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PLUDELI(KLON,KLEV,2)
(  136) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PSNDE(KLON,KLEV,2)
(  137) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFU(KLON,KLEV) 
(  138) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFD(KLON,KLEV) 
(  139) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFUS(KLON,KLEV) 
(  140) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFDS(KLON,KLEV) 
(  141) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFUQ(KLON,KLEV) 
(  142) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFDQ(KLON,KLEV) 
(  143) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFUL(KLON,KLEV) 
(  144) REAL(KIND=JPRB)   ,INTENT(IN)    :: PDMFUP(KLON,KLEV) 
(  145) REAL(KIND=JPRB)   ,INTENT(IN)    :: PDPMEL(KLON,KLEV) 
(  146) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFLXR(KLON,KLEV+1) 
(  147) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFLXS(KLON,KLEV+1) 
(  148) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PTENT(KLON,KLEV) 
(  149) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PTENQ(KLON,KLEV) 
(  150) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PENTH(KLON,KLEV) 
(  151) 
(  152) LOGICAL :: LLTEST
(  153) INTEGER(KIND=JPIM) :: JK, IK, IM, JL
(  154) REAL(KIND=JPRB)    :: ZTSPHY, ZIMP, ZORCPD, ZOEALFA, ZTARG,&
(  155)                      &ZZP, ZGQ, ZGS, ZGH, ZS, ZQ
(  156) REAL(KIND=JPRB)    :: ZALV(KLON,KLEV), ZALV2(KLON,KLEV), ZINT(KLON), ZINT2(KLON)
(  157) 
(  158) REAL(KIND=JPRB) :: ZMFUS(KLON,KLEV), ZMFUQ(KLON,KLEV),&
(  159)                   &ZMFDS(KLON,KLEV), ZMFDQ(KLON,KLEV), ZADVW(KLON)
(  160) 
(  161) REAL(KIND=JPRB),   DIMENSION(KLON,KLEV) :: ZDTDT, ZDQDT, ZDP
(  162) REAL(KIND=JPRB),   DIMENSION(KLON,KLEV) :: ZB,    ZR1,   ZR2
(  163) LOGICAL,           DIMENSION(KLON,KLEV) :: LLCUMBAS
(  164) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(  165) 
(  166) #include "cubidiag.intfb.h"






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 4

(  167) #include "fcttre.func.h"
(  168) 
(  169) !----------------------------------------------------------------------
(  170) IF (LHOOK) CALL DR_HOOK('CUDTDQN',0,ZHOOK_HANDLE)
(  171) ASSOCIATE(RMFSOLTQ=>YDECUMF%RMFSOLTQ, RMFSOLRHS=>YDECUMF%RMFSOLRHS, &
(  172)  & LPHYLIN=>YDEPHLI%LPHYLIN, RLPTRC=>YDEPHLI%RLPTRC, &
(  173)  & RCPD=>YDCST%RCPD, RG=>YDCST%RG, RLMLT=>YDCST%RLMLT, RLSTT=>YDCST%RLSTT, &
(  174)  & RLVTT=>YDCST%RLVTT, &
(  175)  & LEPCLD=>YDEPHY%LEPCLD, LENCLD2=>YDPHNC%LENCLD2, RMFADVW=>YDECUMF%RMFADVW, &
(  176)  & LEPCLD2=>YDPHNC%LEPCLD2, RMFADVWDD=>YDECUMF%RMFADVWDD, &
(  177)  & LMFENTHCONS=>YDECUMF%LMFENTHCONS)
(  178) 
(  179) !*    1.0          SETUP AND INITIALIZATIONS
(  180) !                  -------------------------
(  181) 
(  182) ZIMP=1.0_JPRB-RMFSOLTQ
(  183) ZTSPHY=1.0_JPRB/PTSPHY
(  184) ZORCPD=1.0_JPRB/RCPD
(  185) DO JL=KIDIA,KFDIA
(  186)   ZADVW(JL)=0.0_JPRB
(  187)   IF(KTYPE(JL)==1) ZADVW(JL)=RMFADVW
(  188) ENDDO
(  189) 
(  190) DO JK=1,KLEV
(  191)   DO JL=KIDIA,KFDIA
(  192)     PENTH(JL,JK)=0.0_JPRB
(  193)   ENDDO
(  194) ENDDO
(  195) 
(  196) !         MASS-FLUX APPROACH SWITCHED ON FOR DEEP CONVECTION ONLY
(  197) !         IN THE TANGENT-LINEAR AND ADJOINT VERSIONS
(  198) 
(  199) DO JL=KIDIA,KFDIA
(  200)   IF (KTYPE(JL) /= 1.AND.LPHYLIN) LDCUM(JL)=.FALSE.
(  201) ENDDO
(  202) 
(  203) ! zero detrained liquid water if diagnostic cloud scheme to be used
(  204) 
(  205) ! this means that detrained liquid water will be evaporated in the 
(  206) ! cloud environment and not fed directly into a cloud liquid water 
(  207) ! variable
(  208) 
(  209) LLTEST = (.NOT.LEPCLD.AND..NOT.LENCLD2.AND..NOT.LEPCLD2).OR. &
(  210)  &       (LPHYLIN.AND..NOT.LENCLD2.AND..NOT.LEPCLD2)
(  211) 
(  212) IF (LLTEST) THEN
(  213)   DO JK=1,KLEV
(  214)     DO JL=KIDIA,KFDIA
(  215)       PLUDE(JL,JK)=0.0_JPRB
(  216)       PLUDELI(JL,JK,1)=0.0_JPRB
(  217)       PLUDELI(JL,JK,2)=0.0_JPRB
(  218)     ENDDO
(  219)   ENDDO
(  220) ENDIF
(  221) 
(  222) DO JK=1,KLEV
(  223)   DO JL=KIDIA,KFDIA
(  224)     IF(LDCUM(JL)) THEN






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 5

(  225)       ZDP(JL,JK)=RG/(PAPH(JL,JK+1)-PAPH(JL,JK))
(  226)       ZMFUS(JL,JK)=PMFUS(JL,JK)
(  227)       ZMFDS(JL,JK)=PMFDS(JL,JK)
(  228)       ZMFUQ(JL,JK)=PMFUQ(JL,JK)
(  229)       ZMFDQ(JL,JK)=PMFDQ(JL,JK)
(  230)     ENDIF
(  231)   ENDDO
(  232) ENDDO
(  233) 
(  234) !------------------------------------------------------------------------------
(  235) 
(  236) IF ( RMFSOLTQ>0.0_JPRB ) THEN
(  237) 
(  238) !*    2.0          RECOMPUTE CONVECTIVE FLUXES IF IMPLICIT
(  239) 
(  240)     DO JK=KTOPM2,KLEV
(  241)       IK=JK-1
(  242)     !DIR$ IVDEP
(  243)     !OCL NOVREC
(  244)       DO JL=KIDIA,KFDIA
(  245)         IF(LDCUM(JL).AND.JK>=KCTOP(JL)-1) THEN
(  246)         ! compute interpolating coefficients ZGS and ZGQ for half-level values
(  247)           ZGQ=(PQENH(JL,JK)-PQEN(JL,IK))/PQSEN(JL,JK)
(  248)           ZGH =RCPD*PTEN(JL,JK)+PGEO(JL,JK)
(  249)           ZGS=(RCPD*(PTENH(JL,JK)-PTEN(JL,IK))+PGEOH(JL,JK)-PGEO(JL,IK))/ZGH
(  250) 
(  251)         !half-level environmental values for S and Q
(  252)           ZS =RCPD*(ZIMP*PTEN(JL,IK)+ZGS*PTEN(JL,JK))+PGEO(JL,IK)+ZGS*PGEO(JL,JK)
(  253)           ZQ =ZIMP*PQEN(JL,IK)+ZGQ*PQSEN(JL,JK)
(  254)           ZMFUS(JL,JK)=PMFUS(JL,JK)-PMFU(JL,JK)*ZS
(  255)           ZMFUQ(JL,JK)=PMFUQ(JL,JK)-PMFU(JL,JK)*ZQ
(  256)           IF(LDDRAF(JL).AND.JK >= KDTOP(JL)) THEN
(  257)             ZMFDS(JL,JK)=PMFDS(JL,JK)-PMFD(JL,JK)*ZS
(  258)             ZMFDQ(JL,JK)=PMFDQ(JL,JK)-PMFD(JL,JK)*ZQ
(  259)           ENDIF
(  260)         ENDIF
(  261)       ENDDO
(  262)     ENDDO
(  263) 
(  264) ENDIF
(  265) 
(  266) !*    3.0          COMPUTE TENDENCIES
(  267) !                  ------------------
(  268) 
(  269) ZINT=0._JPRB
(  270) DO JK=KTOPM2,KLEV
(  271)  DO JL=KIDIA,KFDIA
(  272)    ZALV(JL,JK)=FOELHMCU(PTEN(JL,JK))
(  273)    ZALV2(JL,JK)=ZALV(JL,JK)
(  274)  ENDDO
(  275) ENDDO
(  276) IF(LMFENTHCONS) THEN
(  277) ! Integrals for conservation correction ice-phase
(  278)   DO JK=KTOPM2,KLEV-1
(  279)    DO JL=KIDIA,KFDIA
(  280)      IF(LSCVFLAG(JL)) ZALV(JL,JK)=RLVTT
(  281)      ZINT(JL)=ZINT(JL)+RLMLT*(PLGLAC(JL,JK)-PDPMEL(JL,JK))-ZALV(JL,JK)*&
(  282)              &(PMFUL(JL,JK+1)-PMFUL(JL,JK))+ZALV2(JL,JK)*PDMFUP(JL,JK)






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 6

(  283)    ENDDO
(  284)   ENDDO
(  285)   JK=KLEV
(  286)   DO JL=KIDIA,KFDIA
(  287)    IF(LSCVFLAG(JL)) ZALV(JL,JK)=RLVTT
(  288)    ZINT(JL)=ZINT(JL)+RLMLT*(PLGLAC(JL,JK)-PDPMEL(JL,JK))+&
(  289)            ZALV(JL,JK)*PMFUL(JL,JK)+ZALV2(JL,JK)*PDMFUP(JL,JK)
(  290)    ZINT2(JL)=ZINT(JL)-RLVTT*PMFLXR(JL,KLEV+1)-RLSTT*PMFLXS(JL,KLEV+1)
(  291)    IF(ABS(ZINT(JL))>0.1_JPRB) THEN
(  292)      ZINT(JL)=ZINT2(JL)/(ZINT(JL)+1.E-3_JPRB)
(  293)    ELSE
(  294)      ZINT(JL)=0.0_JPRB
(  295)    ENDIF
(  296)    IF(ABS(ZINT(JL))>2.0_JPRB) ZINT(JL)=0.0_JPRB
(  297)   ENDDO
(  298) ENDIF
(  299) 
(  300) DO JK=KTOPM2,KLEV
(  301) 
(  302)   IF(JK < KLEV) THEN
(  303)     DO JL=KIDIA,KFDIA
(  304)       IF(LDCUM(JL)) THEN
(  305)         IF (LPHYLIN) THEN
(  306)           ZTARG=PTEN(JL,JK)
(  307)           ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  308)           ZALV(JL,JK)=ZOEALFA*RLVTT+(1.0_JPRB-ZOEALFA)*RLSTT
(  309)           ZALV2(JL,JK)=ZALV(JL,JK)
(  310)         ENDIF
(  311)         IF (LDTDKMF) THEN
(  312)           ZDTDT(JL,JK)=ZDP(JL,JK)*ZORCPD*&
(  313)            & (ZMFUS(JL,JK+1)-ZMFUS(JL,JK)+&
(  314)            & ZMFDS(JL,JK+1)-ZMFDS(JL,JK)&
(  315)            & +RLMLT*PLGLAC(JL,JK)&
(  316)            & -RLMLT*PDPMEL(JL,JK)&
(  317)            & -ZALV(JL,JK)*(PMFUL(JL,JK+1)-PMFUL(JL,JK)-&
(  318)            & PLUDE(JL,JK)-PDMFUP(JL,JK)))
(  319) 
(  320)           ZDQDT(JL,JK)=ZDP(JL,JK)*&
(  321)            & (ZMFUQ(JL,JK+1)-ZMFUQ(JL,JK)+&
(  322)            & ZMFDQ(JL,JK+1)-ZMFDQ(JL,JK)+&
(  323)            & PMFUL(JL,JK+1)-PMFUL(JL,JK)-&
(  324)            & PLUDE(JL,JK)-PDMFUP(JL,JK))  
(  325)         ELSE
(  326)           ZDTDT(JL,JK)=ZDP(JL,JK)*ZORCPD*&
(  327)            & (ZMFUS(JL,JK+1)-ZMFUS(JL,JK)+&
(  328)            & ZMFDS(JL,JK+1)-ZMFDS(JL,JK)&
(  329)            & +(RLMLT*(PLGLAC(JL,JK)-PDPMEL(JL,JK))&
(  330)            & -ZALV(JL,JK)*(PMFUL(JL,JK+1)-PMFUL(JL,JK))+ZALV2(JL,JK)*PDMFUP(JL,JK))*(1.0_JPRB-ZINT(JL))&
(  331)            & +RLVTT*(PLUDELI(JL,JK,1)+PSNDE(JL,JK,1)) &
(  332)            & +RLSTT*(PLUDELI(JL,JK,2)+PSNDE(JL,JK,2)) )
(  333) 
(  334)           ZDQDT(JL,JK)=ZDP(JL,JK)*&
(  335)            & (ZMFUQ(JL,JK+1)-ZMFUQ(JL,JK)+&
(  336)            & ZMFDQ(JL,JK+1)-ZMFDQ(JL,JK)+&
(  337)            & PMFUL(JL,JK+1)-PMFUL(JL,JK)-&
(  338)            & PLUDE(JL,JK)-PDMFUP(JL,JK)-PSNDE(JL,JK,1)-PSNDE(JL,JK,2))  
(  339)         ENDIF
(  340)       ENDIF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 7

(  341)     ENDDO
(  342) 
(  343)   ELSE
(  344)     DO JL=KIDIA,KFDIA
(  345)       IF(LDCUM(JL)) THEN
(  346)         IF (LPHYLIN) THEN
(  347)           ZTARG=PTEN(JL,JK)
(  348)           ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  349)           ZALV(JL,JK)=ZOEALFA*RLVTT+(1.0_JPRB-ZOEALFA)*RLSTT
(  350)           ZALV2(JL,JK)=ZALV(JL,JK)
(  351)         ENDIF
(  352)         ZDTDT(JL,JK)=-ZDP(JL,JK)*ZORCPD*&
(  353)          & (ZMFUS(JL,JK)+ZMFDS(JL,JK)+(RLMLT*(PDPMEL(JL,JK)-PLGLAC(JL,JK))&
(  354)          &-ZALV(JL,JK)*PMFUL(JL,JK)-ZALV2(JL,JK)*PDMFUP(JL,JK))*(1.0_JPRB-ZINT(JL)) )
(  355) 
(  356)         ZDQDT(JL,JK)=-ZDP(JL,JK)*&
(  357)          & (ZMFUQ(JL,JK)+ZMFDQ(JL,JK)+&
(  358)          & (PMFUL(JL,JK)+PDMFUP(JL,JK)))  
(  359)       ENDIF
(  360)     ENDDO
(  361)   ENDIF
(  362) 
(  363) ENDDO
(  364) 
(  365) IF ( RMFSOLTQ==0.0_JPRB ) THEN
(  366) 
(  367) !*    3.1          UPDATE TENDENCIES
(  368) !                  -----------------
(  369) 
(  370)     DO JK=KTOPM2,KLEV
(  371)       DO JL=KIDIA,KFDIA
(  372)         IF(LDCUM(JL)) THEN
(  373)           PTENT(JL,JK)=PTENT(JL,JK)+ZDTDT(JL,JK)
(  374)           PTENQ(JL,JK)=PTENQ(JL,JK)+ZDQDT(JL,JK)
(  375)           PENTH(JL,JK)=ZDTDT(JL,JK)*RCPD
(  376)         ENDIF
(  377)       ENDDO
(  378)     ENDDO
(  379) 
(  380) ELSE
(  381) !----------------------------------------------------------------------
(  382) 
(  383) !*    3.2          IMPLICIT SOLUTION
(  384) !                  -----------------
(  385) 
(  386)      ! Fill bi-diagonal Matrix vectors A=k-1, B=k, C=k+1;
(  387)      ! reuse ZMFUS=A
(  388)      ! ZDTDT and ZDQDT correspond to the RHS ("constants") of the equation
(  389)      ! The solution is in ZR1 and ZR2
(  390) 
(  391)       LLCUMBAS(:,:)=.FALSE.
(  392)       ZB(:,:)=1.0_JPRB
(  393)       ZMFUS(:,:)=0.0_JPRB
(  394) 
(  395)      ! Fill vectors A, B and RHS
(  396) 
(  397)       DO JK=KTOPM2,KLEV
(  398)          IK=JK+1






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 8

(  399)          IM=JK-1
(  400)          DO JL=KIDIA,KFDIA
(  401)            LLCUMBAS(JL,JK)=LDCUM(JL).AND.JK>=KCTOP(JL)-1
(  402)            IF(LLCUMBAS(JL,JK)) THEN
(  403)              ZZP=RMFSOLTQ*ZDP(JL,JK)*PTSPHY
(  404)              ZMFUS(JL,JK)=-ZZP*(PMFU(JL,JK)+PMFD(JL,JK))
(  405)              IF(JK<KLEV) THEN
(  406)                ZB(JL,JK)=1.0_JPRB+ZZP*(PMFU(JL,IK)+PMFD(JL,IK))
(  407)              ELSE
(  408)                ZB(JL,JK)=1.0_JPRB
(  409)              ENDIF
(  410)              IF (LDTDKMF) THEN
(  411)                ZDTDT(JL,JK) = ZDTDT(JL,JK)*PTSPHY+PTEN(JL,JK)
(  412)                ZDQDT(JL,JK) = ZDQDT(JL,JK)*PTSPHY+PQEN(JL,JK)
(  413)              ELSE
(  414)                ZZP=RG*(PMFU(JL,JK)+RMFADVWDD*PMFD(JL,JK))/(PAP(JL,JK)-PAP(JL,IM))*PTSPHY*ZADVW(JL)
(  415)                ZS=ZZP*(PTEN(JL,IM)-PTEN(JL,JK)+ZORCPD*(PGEO(JL,IM)-PGEO(JL,JK)) )
(  416)                ZQ=ZZP*(PQEN(JL,IM)-PQEN(JL,JK))
(  417)                ZDTDT(JL,JK) = (ZDTDT(JL,JK)+PTENT(JL,JK)*RMFSOLRHS)*PTSPHY+PTEN(JL,JK)-ZS
(  418)                ZDQDT(JL,JK) = (ZDQDT(JL,JK)+PTENQ(JL,JK)*RMFSOLRHS)*PTSPHY+PQEN(JL,JK)-ZQ
(  419)              ENDIF  
(  420)            ENDIF
(  421)          ENDDO
(  422)       ENDDO
(  423) 
(  424)       CALL CUBIDIAG&
(  425)          &( KIDIA,    KFDIA,   KLON,   KLEV, &
(  426)          &  KCTOP,    LLCUMBAS, &
(  427)          &  ZMFUS,    ZB,     ZDTDT,   ZR1 )
(  428) 
(  429)       CALL CUBIDIAG&
(  430)          &( KIDIA,    KFDIA,   KLON,   KLEV, &
(  431)          &  KCTOP,    LLCUMBAS, &
(  432)          &  ZMFUS,    ZB,     ZDQDT,   ZR2 )
(  433) 
(  434)      ! Compute tendencies
(  435) 
(  436)       DO JK=KTOPM2,KLEV
(  437)          DO JL=KIDIA,KFDIA
(  438)            IF(LLCUMBAS(JL,JK)) THEN
(  439)              IF (LDTDKMF) THEN
(  440)                PTENT(JL,JK)=PTENT(JL,JK)+(ZR1(JL,JK)-PTEN(JL,JK))*ZTSPHY
(  441)                PTENQ(JL,JK)=PTENQ(JL,JK)+(ZR2(JL,JK)-PQEN(JL,JK))*ZTSPHY
(  442)              ELSE
(  443)                PTENT(JL,JK)=PTENT(JL,JK)*(1.0_JPRB-RMFSOLRHS)+(ZR1(JL,JK)-PTEN(JL,JK))*ZTSPHY
(  444)                PTENQ(JL,JK)=PTENQ(JL,JK)*(1.0_JPRB-RMFSOLRHS)+(ZR2(JL,JK)-PQEN(JL,JK))*ZTSPHY
(  445)              ENDIF
(  446)              PENTH(JL,JK)=(ZR1(JL,JK)-PTEN(JL,JK))*ZTSPHY
(  447)            ENDIF
(  448)          ENDDO
(  449)       ENDDO
(  450) 
(  451) !----------------------------------------------------------------------
(  452) ENDIF
(  453) 
(  454) END ASSOCIATE
(  455) IF (LHOOK) CALL DR_HOOK('CUDTDQN',1,ZHOOK_HANDLE)
(  456) END SUBROUTINE CUDTDQN






