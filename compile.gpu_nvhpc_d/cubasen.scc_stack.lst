(  794)           DO JK=KLEV,1,-1
(  795)             JKT = ICTOP
(  796)             IF (JK >= JKT .or. KINDEX >= -1 + KLEV .and. JKK == KLEV) THEN
(  797)               KLAB(JL, JK) = ILAB(JL, JK)
(  798)               PTU(JL, JK) = ZTU(JL, JK)
(  799)               PQU(JL, JK) = ZQU(JL, JK)
(  800)               PLU(JL, JK) = ZLU(JL, JK)
