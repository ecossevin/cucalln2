(  299)           IPENTRORG = PN1%MP
(  300)         END IF
(  301)         
(  302)         IPN = YDSPP_CONFIG%PPTR%ENTSTPC1
(  303)         LLPERT_ENTSTPC1 = IPN > 0
(  304)         IF (LLPERT_ENTSTPC1) THEN
