(  750)               ELSE
(  751)                 ILAB(JL, JK) = 1
(  752)               END IF
(  753)             END IF
(  754)           END IF
(  755)           
(  756)           !     IF (IS == 0) EXIT
(  757)         END DO
(  758)         
(  759)         IF (JKK == KLEV .or. JKK == -1 + KLEV .and. KINDEX == -1 + KLEV) THEN
(  760)           
(  761)           ! set values for departure level for PBL clouds = first model level
(  762)           LDSC(JL) = LLDSC
(  763)           IF (LDSC(JL)) THEN
(  764)             KBOTSC(JL) = IBOTSC
(  765)           ELSE
(  766)             KBOTSC(JL) = -1
