(  837)           END IF
(  838)           
(  839)           IF (LLDEEP .and. LLFIRST) THEN
(  840)             KDPL(JL) = IDPL
(  841)             KCTOP(JL) = ICTOP
(  842)             KCBOT(JL) = ICBOT
