(  651)             ! add condensation to water
(  652)             
(  653)             ZDQ = MAX(ZQOLD - ZQU(JL, JK), 0.0_JPRB)
(  654)             ZLU(JL, JK) = ZLU(JL, JK + 1) + ZDQ
(  655)             
(  656)             ! freezing
(  657)             
(  658)             ZLGLAC = ZDQ*((1.0_JPRB - FOEALFCU(ZTU(JL, JK))) - (1.0_JPRB - FOEALFCU(ZTU(JL, JK + 1))))
(  659)             
(  660)             
(  661)             ! pseudo-microphysics
(  662)             
(  663)             ZLU(JL, JK) = 0.5_JPRB*ZLU(JL, JK)
(  664)             
(  665)             ! update dry static energy after condensation + freezing
(  666)             
(  667)             ZTU(JL, JK) = ZTU(JL, JK) + YDTHF%RALFDCP*ZLGLAC
(  668)             ZSUH(JL, JK) = YDCST%RCPD*ZTU(JL, JK) + PGEOH(JL, JK)
(  669)             
(  670)             ! Buoyancy on half and full levels
(  671)             
(  672)             ZTVUH = (1.0_JPRB + YDCST%RETV*ZQU(JL, JK) - ZLU(JL, JK))*ZTU(JL, JK) + YDTHF%RALFDCP*ZLGLAC
(  673)             ZTVENH = (1.0_JPRB + YDCST%RETV*ZQENH(JL, JK))*(ZSENH(JL, JK) - PGEOH(JL, JK))*ZRCPD
(  674)             ZBUOH(JL, JK) = (ZTVUH - ZTVENH)*YDCST%RG / ZTVENH
(  675)             
(  676)             ZBUOF = (ZBUOH(JL, JK) + ZBUOH(JL, JK + 1))*0.5_JPRB
(  677)             
(  678)             ! solve kinetic energy equation
(  679)             
(  680)             ZTMP = 1.0_JPRB / (1.0_JPRB + 2.0_JPRB*ZBW*ZMIX)
(  681)             ZWU2H(JL, JK) = (ZWU2H(JL, JK + 1)*(1.0_JPRB - 2.0_JPRB*ZBW*ZMIX) + 2.0_JPRB*ZAW*ZBUOF*ZDZ)*ZTMP
(  682)             
(  683)             IF (JKK == KLEV) THEN
(  684)               PWU2H(JL, JK) = ZWU2H(JL, JK)                !save surface parcel KE
(  685)             END IF
(  686)             
(  687)             ! compute CAPE for diagnostics
(  688)             






NVFORTRAN (Version     24.5)          03/24/2025  13:20:32      page 13

(  689)             ZCAPE(JL, JKK) = ZCAPE(JL, JKK) + MAX(0.0_JPRB, ZBUOF*ZDZ)
(  690)             
(  691)             ! first layer with liquid water - find exact cloud base
(  692)             
(  693)             IF (ZLU(JL, JK) > 0.0_JPRB .and. ILAB(JL, 1 + JK) == 1) THEN
(  694)               
(  695)               IK = JK + 1
(  696)               ZQSU = FOEEWM(ZTU(JL, IK)) / PAPH(JL, IK)
(  697)               ZESDP = ZQSU
(  698)               ZQSU = MIN(0.5_JPRB, ZQSU)
(  699)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSU)
(  700)               ZQSU = ZQSU*ZCOR
(  701)               ZDQ = MIN(0._JPRB, ZQU(JL, IK) - ZQSU)
(  702)               ZALFAW = FOEALFA(ZTU(JL, IK))
(  703)               ZFACW = YDTHF%R5LES / ((ZTU(JL, IK) - YDTHF%R4LES)**2)
(  704)               ZFACI = YDTHF%R5IES / ((ZTU(JL, IK) - YDTHF%R4IES)**2)
(  705)               ZFAC = ZALFAW*ZFACW + (1. - ZALFAW)*ZFACI
(  706)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZESDP)
(  707)               ZDQSDT = ZFAC*ZCOR*ZQSU
(  708)               ZDTDP = YDCST%RD*ZTU(JL, IK) / (YDCST%RCPD*PAPH(JL, IK))
(  709)               ZDP = ZDQ / (ZDQSDT*ZDTDP)
(  710)               ZCBASE = PAPH(JL, IK) + ZDP
(  711)               
(  712)               ! chose nearest half level as cloud base
(  713)               
(  714)               ZPDIFFTOP = ZCBASE - PAPH(JL, JK)
(  715)               ZPDIFFBOT = PAPH(JL, JK + 1) - ZCBASE
(  716)               
(  717)               IF (ZPDIFFTOP > ZPDIFFBOT .and. ZWU2H(JL, 1 + JK) > 0.0_JPRB) THEN
(  718)                 JKB = MIN(KLEV - 1, JK + 1)
(  719)                 ILAB(JL, JKB) = 2
(  720)                 ILAB(JL, JK) = 2
(  721)                 LL_LDBASE = .true.
(  722)                 LLDSC = .true.
(  723)                 IBOTSC = JKB
(  724)                 ICBOT = JKB
(  725)                 ZLU(JL, JK + 1) = YDECLDP%RLMIN
(  726)               ELSE IF (ZPDIFFTOP <= ZPDIFFBOT .and. ZWU2H(JL, JK) > 0.0_JPRB) THEN
(  727)                 ILAB(JL, JK) = 2
(  728)                 LL_LDBASE = .true.
(  729)                 LLDSC = .true.
(  730)                 IBOTSC = JK
(  731)                 ICBOT = JK
(  732)               END IF
(  733)               
(  734)             END IF
(  735)             
(  736)             ! decide on presence of convection, cloud base and cloud top based on
(  737)             ! kinetic energy
(  738)             
(  739)             IF (ZWU2H(JL, JK) < 0.0_JPRB) THEN
(  740)               LLGO_ON = .false.
(  741)               IF (ZLU(JL, 1 + JK) > 0.0_JPRB) THEN
(  742)                 ICTOP = JK
(  743)                 LLDCUM = .true.
(  744)               ELSE
(  745)                 LLDCUM = .false.
(  746)               END IF






NVFORTRAN (Version     24.5)          03/24/2025  13:20:32      page 14

(  747)             ELSE
(  748)               IF (ZLU(JL, JK) > 0.0_JPRB) THEN
(  749)                 ILAB(JL, JK) = 2
(  750)               ELSE
(  751)                 ILAB(JL, JK) = 1
(  752)               END IF
(  753)             END IF
(  754)           END IF
(  755)           
(  756)           !     IF (IS == 0) EXIT
(  757)         END DO
(  758)         
(  759)         IF (JKK == KLEV .or. JKK == -1 + KLEV .and. KINDEX == -1 + KLEV) THEN
(  760)           
(  761)           ! set values for departure level for PBL clouds = first model level
(  762)           LDSC(JL) = LLDSC
(  763)           IF (LDSC(JL)) THEN
(  764)             KBOTSC(JL) = IBOTSC
(  765)           ELSE
(  766)             KBOTSC(JL) = -1
(  767)           END IF
(  768)           
(  769)           JKT = ICTOP
(  770)           JKB = ICBOT
(  771)           LLDEEP = PAPH(JL, JKB) - PAPH(JL, JKT) > YDECUMF%RDEPTHS
(  772)           IF (LLDEEP .and. KINDEX < -1 + KLEV) LLDCUM = .false.
(  773)           ! no deep allowed for KLEV
(  774)           LLDEEP = .false.            ! for deep convection start only at level KLEV-1
(  775)           ! and form mixed layer, so go on
(  776)           ! test further for deep convective columns as not yet found
(  777)           ! IF ( LLDEEP(JL) ) LLFIRST(JL)=.FALSE.
(  778)           LLGO_ON = .not.LLDEEP
(  779)           IF (KINDEX == -1 + KLEV) LLGO_ON = .not.LLDCUM
(  780)           IF (LLDCUM) THEN
(  781)             KCBOT(JL) = ICBOT
(  782)             KCTOP(JL) = ICTOP
(  783)             KDPL(JL) = IDPL
(  784)             LDCUM(JL) = LLDCUM
(  785)             PWUBASE(JL) = SQRT(MAX(ZWU2H(JL, JKB), 0.0_JPRB))
(  786)           ELSE
(  787)             KCTOP(JL) = -1
(  788)             KCBOT(JL) = -1
(  789)             KDPL(JL) = KLEV - 1
(  790)             LDCUM(JL) = .false.
(  791)             PWUBASE(JL) = 0.0_JPRB
(  792)           END IF
(  793) !$acc loop seq
(  794)           DO JK=KLEV,1,-1
(  795)             JKT = ICTOP
(  796)             IF (JK >= JKT .or. KINDEX >= -1 + KLEV .and. JKK == KLEV) THEN
(  797)               KLAB(JL, JK) = ILAB(JL, JK)
(  798)               PTU(JL, JK) = ZTU(JL, JK)
(  799)               PQU(JL, JK) = ZQU(JL, JK)
(  800)               PLU(JL, JK) = ZLU(JL, JK)
(  801)             END IF
(  802)           END DO
(  803)         END IF
(  804)         






NVFORTRAN (Version     24.5)          03/24/2025  13:20:32      page 15

(  805)         IF (JKK < KLEV) THEN
(  806)           LLRESET = .false.
(  807)           IF (.not.LLDEEP) THEN
(  808)             JKT = ICTOP
(  809)             JKB = ICBOT
(  810)             ! test on cloud thickness and buoyancy
(  811)             LLDEEP = PAPH(JL, JKB) - PAPH(JL, JKT) >= YDECUMF%RDEPTHS
(  812)           END IF
(  813)           LLRESETJL = LLDEEP .and. LLFIRST
(  814)           LLRESET = LLRESET .or. LLRESETJL
(  815)           
(  816)           
(  817)           IF (LLRESET) THEN
(  818) !$acc loop seq
(  819)             DO JK=KLEV,1,-1
(  820)               IF (LLRESETJL) THEN
(  821)                 JKT = ICTOP
(  822)                 JKB = IDPL
(  823)                 IF (JK <= JKB .and. JK >= JKT) THEN
(  824)                   KLAB(JL, JK) = ILAB(JL, JK)
(  825)                   PTU(JL, JK) = ZTU(JL, JK)
(  826)                   PQU(JL, JK) = ZQU(JL, JK)
(  827)                   PLU(JL, JK) = ZLU(JL, JK)
(  828)                 ELSE
(  829)                   KLAB(JL, JK) = 1
(  830)                   PTU(JL, JK) = PTENH(JL, JK)
(  831)                   PQU(JL, JK) = PQENH(JL, JK)
(  832)                   PLU(JL, JK) = 0.0_JPRB
(  833)                 END IF
(  834)                 IF (JK < JKT) KLAB(JL, JK) = 0
(  835)               END IF
(  836)             END DO
(  837)           END IF
(  838)           
(  839)           IF (LLDEEP .and. LLFIRST) THEN
(  840)             KDPL(JL) = IDPL
(  841)             KCTOP(JL) = ICTOP
(  842)             KCBOT(JL) = ICBOT
(  843)             LDCUM(JL) = LLDCUM
(  844)             LDSC(JL) = .false.
(  845)             KBOTSC(JL) = -1
(  846)             JKB = KCBOT(JL)
(  847)             PWUBASE(JL) = SQRT(MAX(ZWU2H(JL, JKB), 0.0_JPRB))
(  848)             !  no initialization of wind for deep here, this is done in
(  849)             !  CUINI and CUASCN
(  850)             LLFIRST = .false.
(  851)           END IF
(  852)           LLGO_ON = .not.LLDEEP
(  853)         END IF
(  854)         
(  855)       END DO
(  856)       ! end of big loop for search of departure level
(  857)       
(  858)       ! chose maximum CAPE value
(  859)       PCAPE(JL) = ZCAPE(JL, 1)
(  860) !$acc loop seq
(  861)       DO JK=2,KLEV
(  862)         PCAPE(JL) = MAX(PCAPE(JL), ZCAPE(JL, JK))






NVFORTRAN (Version     24.5)          03/24/2025  13:20:32      page 16

(  863)       END DO
(  864)     END DO
(  865)     
(  866)     
(  867)     
(  868) !$acc end data
(  869)   END SUBROUTINE CUBASEN_LOKI
