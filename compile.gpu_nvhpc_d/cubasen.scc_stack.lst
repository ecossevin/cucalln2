(  472)               END IF
(  473)               ZMIX = 0.5_JPRB*ZDZ*PPLRG*ZEPS
(  474)               IF (.not.LDTDKMF) ZMIX = MIN(1.0_JPRB, ZMIX)
(  475)               ZQF = (PQENH(JL, JK + 1) + PQENH(JL, JK))*0.5_JPRB
(  476)               ZSF = (ZSENH(JL, JK + 1) + ZSENH(JL, JK))*0.5_JPRB
(  477)               ZTMP = 1.0_JPRB / (1.0_JPRB + ZMIX)
