(  479)               ZSUH(JL, JK) = (ZSUH(JL, JK + 1)*(1.0_JPRB - ZMIX) + 2.0_JPRB*ZMIX*ZSF)*ZTMP
(  480)               ZQOLD = ZQU(JL, JK)
(  481)               ZTU(JL, JK) = (ZSUH(JL, JK) - PGEOH(JL, JK))*ZRCPD
(  482)               ZPH = PAPH(JL, JK)
(  483)             END IF
(  484)             
(  485)           ELSE
(  486)             
