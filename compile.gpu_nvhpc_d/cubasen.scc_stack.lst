(  655)             
(  656)             ! freezing
(  657)             
(  658)             ZLGLAC = ZDQ*((1.0_JPRB - FOEALFCU(ZTU(JL, JK))) - (1.0_JPRB - FOEALFCU(ZTU(JL, JK + 1))))
