(  292)       
(  293)       ! prepare SPP perturbations
(  294)       IF (YDSPP_CONFIG%LSPP) THEN
(  295)         IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  296)         LLPERT_ENTRORG = IPN > 0
(  297)         IF (LLPERT_ENTRORG) THEN
