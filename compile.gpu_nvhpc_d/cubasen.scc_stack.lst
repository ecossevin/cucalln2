(    2)   CONTAINS
(    3)   SUBROUTINE CUBASEN_LOKI (PPLDARE, PPLRG, YDTHF, YDCST, YDEPHLI, YDECLDP, YDECUMF, YDSPP_CONFIG, KIDIA, KFDIA, KLON, KLEV,  &
(    4)   & KINDEX, LDMIXS, LDTDKMF, PTENH, PQENH, PGEOH, PAPH, PQHFL, PAHFS, PGP2DSPP, PKMFL, PTEN, PQEN, PQSEN, PGEO, PTU, PQU, PLU,  &
(    5)   & PWU2H, PWUBASE, KLAB, LDCUM, LDSC, KCBOT, KBOTSC, KCTOP, KDPL, PCAPE, YDSTACK_L)
(    6)     
(    7)     !          THIS ROUTINE CALCULATES CLOUD BASE FIELDS
(    8)     !          CLOUD BASE HEIGHT AND CLOUD TOP HEIGHT
(    9)     
(   10)     !          PURPOSE.
(   11)     !          --------
(   12)     !          TO PRODUCE CLOUD BASE AND CLOUD TOP VALUES FOR CU-PARAMETRIZATION
(   13)     
(   14)     !          INTERFACE
(   15)     !          ---------
(   16)     !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   17)     !          INPUT ARE ENVIRONM. VALUES OF T,Q,P,PHI AT HALF LEVELS.
(   18)     !          IT RETURNS CLOUD FIELDS VALUES AND FLAGS AS FOLLOWS;
(   19)     !                 KLAB=0 FOR STABLE LAYERS
(   20)     !                 KLAB=1 FOR SUBCLOUD LEVELS
(   21)     !                 KLAB=2 FOR CLOUD LEVELS LEVEL
(   22)     
(   23)     !          METHOD.
(   24)     !          --------
(   25)     !          LIFT SURFACE AIR DRY-ADIABATICALLY TO CLOUD TOP
(   26)     !          (ENTRAINING PLUME, WITH ENTRAINMENT PROPORTIONAL TO (1/Z))
(   27)     
(   28)     !     PARAMETER     DESCRIPTION                                   UNITS
(   29)     !     ---------     -----------                                   -----
(   30)     !     INPUT PARAMETERS (INTEGER):
(   31)     
(   32)     !    *KIDIA*        START POINT
(   33)     !    *KFDIA*        END POINT
(   34)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   35)     !    *KLEV*         NUMBER OF LEVELS
(   36)     !    *KINDEX*       TOP INDEX FOR OUTER VERTICAL LOOP
(   37)     
(   38)     !    INPUT PARAMETERS (LOGICAL):
(   39)     !    *LDMIXS*        WEAK (FALSE) OR STRONG (TRUE) CLOUD MIXING FOR SURFACE PARCEL ONLY
(   40)     !    *LDTDKMF*      Arpege tuning (if TRUE)
(   41)     
(   42)     !    INPUT PARAMETERS (REAL):
(   43)     
(   44)     ! not used at the moment because we want to use linear intepolation
(   45)     ! for fields on the half levels.
(   46)     
(   47)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS           K
(   48)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS      KG/KG
(   49)     
(   50)     !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   51)     !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   52)     !    *PKMFL*        SURFACE KINEMATIC MOMENTUM FLUX              M2/S2
(   53)     
(   54)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   55)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS             PA
(   56)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   57)     !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG






NVFORTRAN (Version     24.5)          03/24/2025  13:20:32      page 18

(   58)     !    *PQSEN*        PROVISIONAL ENVIRONMENT SATU. HUMIDITY (T+1)  KG/KG
(   59)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   60)     !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   61)     !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   62)     !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   63)     
(   64)     !    UPDATED PARAMETERS (REAL):
(   65)     
(   66)     !    *PTU*          TEMPERATURE IN UPDRAFTS                         K
(   67)     !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                    KG/KG
(   68)     !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS              KG/KG
(   69)     !    *PWU2H*        KINETIC ENERGY IN UPDRAFTS  SURFACE PARCEL    M2/S2
(   70)     
(   71)     !    UPDATED PARAMETERS (INTEGER):
(   72)     
(   73)     !    *KLAB*         FLAG KLAB=1 FOR SUBCLOUD LEVELS
(   74)     !                        KLAB=2 FOR CLOUD LEVELS
(   75)     
(   76)     !    OUTPUT PARAMETERS (LOGICAL):
(   77)     
(   78)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   79)     !    *LDSC*         FLAG: .TRUE. IF BL-CLOUDS EXIST
(   80)     
(   81)     !    OUTPUT PARAMETERS (INTEGER):
