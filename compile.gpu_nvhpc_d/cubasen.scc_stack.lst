(  263)     !----------------------------------------------------------------------
(  264)     !     0.           INITIALIZE CONSTANTS AND FIELDS
(  265)     !                  -------------------------------
(  266)     !----------------------------------------------------------------------
(  267)     
(  268)     ZAW = 1.0_JPRB
(  269)     ZBW = 1.0_JPRB
(  270)     
(  271)     
(  272) !$acc loop vector
(  273)     DO JL=KIDIA,KFDIA
(  274)       PWUBASE(JL) = 0.0_JPRB
(  275)       LLGO_ON = .true.
(  276)       LLFIRST = .true.
(  277)       KDPL(JL) = KLEV
(  278)       
(  279)       JKT1 = KINDEX
(  280)       JKT2 = YDECUMF%NJKT2
