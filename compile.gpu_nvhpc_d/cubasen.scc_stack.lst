(  622)                 
(  623)                 Z2S = CUADJTQ_ZOEALFA*YDTHF%R5ALVCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4LES)**2) + (1.0_JPRB - CUADJTQ_ZOEALFA) &
(  624)                 & *YDTHF%R5ALSCP*(1.0_JPRB / (CUADJTQ_ZTARG - YDTHF%R4IES)**2)
(  625)                 ZCOND1 = (ZQU(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*CUADJTQ_ZCOR*Z2S)
(  626)                 
(  627)                 ZTU(JL, IK) = ZTU(JL, IK) + (CUADJTQ_ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - CUADJTQ_ZOEALFA)*YDTHF%RALSDCP)*ZCOND1
