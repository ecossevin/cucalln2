(  283)       
(  284) !$acc loop seq
(  285)       DO JK=1,KLEV
(  286)         ZTU(JL, JK) = PTU(JL, JK)
(  287)         ZQU(JL, JK) = PQU(JL, JK)
(  288)         ZLU(JL, JK) = PLU(JL, JK)
(  289)         ILAB(JL, JK) = KLAB(JL, JK)
(  290)         ZCAPE(JL, JK) = 0.0_JPRB
