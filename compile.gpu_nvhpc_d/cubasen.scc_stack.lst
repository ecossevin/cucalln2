(  779)           IF (KINDEX == -1 + KLEV) LLGO_ON = .not.LLDCUM
(  780)           IF (LLDCUM) THEN
(  781)             KCBOT(JL) = ICBOT
(  782)             KCTOP(JL) = ICTOP
(  783)             KDPL(JL) = IDPL
(  784)             LDCUM(JL) = LLDCUM
(  785)             PWUBASE(JL) = SQRT(MAX(ZWU2H(JL, JKB), 0.0_JPRB))
(  786)           ELSE
(  787)             KCTOP(JL) = -1






