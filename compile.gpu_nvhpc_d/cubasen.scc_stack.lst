(  314)       !----------------------------------------------------------------------
(  315)       !       -----------------------------------------------------------
(  316)       !       1.1  PREPARE FIELDS ON HALF LEVELS BY LINEAR INTERPOLATION
(  317)       !             OF SPECIFIC HUMIDITY AND STATIC ENERGY
(  318)       !       -----------------------------------------------------------
(  319)       
(  320) !$acc loop seq
(  321)       DO JK=1,KLEV
(  322)         PWU2H(JL, JK) = 0.0_JPRB
(  323)         ZWU2H(JL, JK) = 0.0_JPRB
(  324)         ZS(JL, JK) = YDCST%RCPD*PTEN(JL, JK) + PGEO(JL, JK)
(  325)         ZQENH(JL, JK) = PQENH(JL, JK)
(  326)         ZSENH(JL, JK) = YDCST%RCPD*PTENH(JL, JK) + PGEOH(JL, JK)
(  327)       END DO
(  328)       
(  329) !$acc loop seq
(  330)       DO JKK=KLEV,JKT1,-1
(  331)         ! Big external loop for level testing:
(  332)         ! find first departure level that produces deepest cloud top
