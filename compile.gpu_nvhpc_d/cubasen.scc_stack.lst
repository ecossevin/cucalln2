(  719)                 ILAB(JL, JKB) = 2
(  720)                 ILAB(JL, JK) = 2
(  721)                 LL_LDBASE = .true.
(  722)                 LLDSC = .true.
(  723)                 IBOTSC = JKB
(  724)                 ICBOT = JKB
(  725)                 ZLU(JL, JK + 1) = YDECLDP%RLMIN
(  726)               ELSE IF (ZPDIFFTOP <= ZPDIFFBOT .and. ZWU2H(JL, JK) > 0.0_JPRB) THEN
(  727)                 ILAB(JL, JK) = 2
(  728)                 LL_LDBASE = .true.
(  729)                 LLDSC = .true.






