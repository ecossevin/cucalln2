(   67) SUBROUTINE LOAD_SPP_PERT (KLUN, YD)
(   68) USE PARKIND1, ONLY : JPRD
(   69) 
(   70) IMPLICIT NONE
(   71) INTEGER, INTENT (IN) :: KLUN
(   72) TYPE (SPP_PERT), INTENT (OUT), TARGET :: YD
(   73) REAL(KIND=JPRD) :: ZTMP0
(   74) REAL(KIND=JPRD), ALLOCATABLE :: ZTMP1 (:)
(   75) READ (KLUN) YD%LABEL
(   76) READ (KLUN) YD%ON
(   77) READ (KLUN) YD%IDISTR
(   78) ALLOCATE (ZTMP1(LBOUND(YD%XMAG,1):UBOUND(YD%XMAG,1)))
(   79) READ (KLUN) ZTMP1
(   80) YD%XMAG = ZTMP1
(   81) DEALLOCATE (ZTMP1)
(   82) ALLOCATE (ZTMP1(LBOUND(YD%MU,1):UBOUND(YD%MU,1)))
(   83) READ (KLUN) ZTMP1
(   84) YD%MU = ZTMP1
(   85) DEALLOCATE (ZTMP1)
(   86) READ (KLUN) ZTMP0
(   87) YD%XCLIPMIN = ZTMP0
(   88) READ (KLUN) ZTMP0
(   89) YD%XCLIPMAX = ZTMP0
(   90) READ (KLUN) ZTMP0
(   91) YD%XUNIFORM_OFFSET = ZTMP0
(   92) READ (KLUN) YD%NMAG
(   93) READ (KLUN) YD%LN1
(   94) READ (KLUN) YD%NSEED_OFF
(   95) READ (KLUN) YD%NOFF
(   96) READ (KLUN) YD%NRF
(   97) READ (KLUN) YD%NRF_RADGRID
(   98) READ (KLUN) YD%RADGRID
(   99) READ (KLUN) YD%RF_PERT_LABEL
(  100) READ (KLUN) YD%IC
(  101) READ (KLUN) YD%MP
(  102) READ (KLUN) YD%MP_RADGRID
(  103) READ (KLUN) ZTMP0
(  104) YD%TAU = ZTMP0
(  105) READ (KLUN) ZTMP0
(  106) YD%SDEV = ZTMP0
(  107) READ (KLUN) ZTMP0
(  108) YD%XLCOR = ZTMP0






