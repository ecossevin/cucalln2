(  399)           PMFLXR(JL, JK + 1) = PMFLXR(JL, JK) + ZALFAW*(PDMFUP(JL, JK) + PDMFDP(JL, JK)) + PDPMEL(JL, JK) - PSNDE(JL, JK, 1)
