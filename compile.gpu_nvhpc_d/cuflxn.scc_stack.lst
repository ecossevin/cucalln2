(  388)           END IF
(  389)           IF (YDECUMF%LMFDSNOW .and. JK <= KCBOT(JL)) THEN
(  390)             PSNDE(JL, JK, 2) = PLRAIN(JL, JK + 1)*PMFUDE_RATE(JL, JK)
(  391)             PSNDE(JL, JK, 1) = PSNDE(JL, JK, 2)*ZALFAW
(  392)             PSNDE(JL, JK, 2) = PSNDE(JL, JK, 2)*(1.0_JPRB - ZALFAW)
(  393)             PSNDE(JL, JK, 1) = MIN(PSNDE(JL, JK, 1), ZALFAW*(PDMFUP(JL, JK) + PDMFDP(JL, JK)))
(  394)             PSNDE(JL, JK, 2) = MIN(PSNDE(JL, JK, 2), (1.0_JPRB - ZALFAW)*(PDMFUP(JL, JK) + PDMFDP(JL, JK)) - PDPMEL(JL, JK))
(  395)             !PSNDE(JL,JK,1)=0.0_JPRB
