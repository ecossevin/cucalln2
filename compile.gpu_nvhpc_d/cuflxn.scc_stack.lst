(  363)             ZCONS1 = ZCONS1A*(1.0_JPRB + 0.5_JPRB*(ZTEN - YDCST%RTT))
(  364)             ZFAC = ZCONS1*(PAPH(JL, JK + 1) - PAPH(JL, JK))
(  365)             ZSNMLT = MIN(PMFLXS(JL, JK), ZFAC*(ZTEN - YDCST%RTT))
(  366)             PDPMEL(JL, JK) = ZSNMLT
(  367)             IF (YDEPHLI%LPHYLIN) THEN
(  368)               ZTARG = ZTEN - ZSNMLT / ZFAC
(  369)               ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  370)               ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4LES))
(  371)               ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4IES))
(  372)               ZOEEWM = ZOEALFA*ZFOEEWL + (1.0_JPRB - ZOEALFA)*ZFOEEWI
