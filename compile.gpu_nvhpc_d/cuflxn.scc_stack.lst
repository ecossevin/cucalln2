(  282)         IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP
(  283)         PMFU(JL, IK) = PMFU(JL, IKB)*ZZP
(  284)         IF (YDEPHLI%LPHYLIN) THEN
(  285)           ZTARG = PTENH(JL, IKB)
(  286)           ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  287)           ZOELHM = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT
(  288)           PMFUS(JL, IK) = (PMFUS(JL, IKB) - ZOELHM*PMFUL(JL, IKB))*ZZP
(  289)         ELSE
(  290)           PMFUS(JL, IK) = (PMFUS(JL, IKB) - FOELHMCU(PTENH(JL, IKB))*PMFUL(JL, IKB))*ZZP
(  291)         END IF
(  292)         PMFUQ(JL, IK) = (PMFUQ(JL, IKB) + PMFUL(JL, IKB))*ZZP
(  293)         PMFUL(JL, IK) = 0.0_JPRB
(  294)       END IF
(  295) !$acc loop seq
(  296)       DO JK=KTOPM2,KLEV
(  297)         !DIR$ IVDEP
(  298)         !OCL NOVREC
(  299)         IF (LDCUM(JL) .and. JK > 1 + KCBOT(JL)) THEN
(  300)           IKB = KCBOT(JL) + 1
(  301)           ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, JK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IKB)))
(  302)           IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP
(  303)           PMFU(JL, JK) = PMFU(JL, IKB)*ZZP
(  304)           PMFUS(JL, JK) = PMFUS(JL, IKB)*ZZP
(  305)           PMFUQ(JL, JK) = PMFUQ(JL, IKB)*ZZP
(  306)           PMFUL(JL, JK) = 0.0_JPRB
(  307)         END IF
(  308)         IK = IDBAS
(  309)         LLDDRAF = LDDRAF(JL) .and. JK > IK .and. IK < KLEV
(  310)         IF (LLDDRAF .and. IK == 1 + KCBOT(JL)) THEN
(  311)           ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, JK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IK)))
(  312)           IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP
(  313)           PMFD(JL, JK) = PMFD(JL, IK)*ZZP
(  314)           PMFDS(JL, JK) = PMFDS(JL, IK)*ZZP
(  315)           PMFDQ(JL, JK) = PMFDQ(JL, IK)*ZZP
(  316)           PMFDDE_RATE(JL, JK) = -(PMFD(JL, JK - 1) - PMFD(JL, JK))
(  317)         ELSE IF (LLDDRAF .and. IK /= 1 + KCBOT(JL) .and. JK == 1 + IK) THEN
(  318)           PMFDDE_RATE(JL, JK) = -(PMFD(JL, JK - 1) - PMFD(JL, JK))
(  319)         END IF
