(  416)       
(  417)       ! Increase area fraction for evaporation depending on average RH in cloud-layer
(  418)       IF (.not.LDTDKMF) THEN
(  419)         IF (KTYPE(JL) >= 2) THEN
(  420)           IKB = KCBOT(JL)
(  421)           IK = KCTOP(JL)
(  422)           ZRHM = 0.5*(PQEN(JL, IKB) / PQSEN(JL, IKB) + PQEN(JL, IK) / PQSEN(JL, IK))
(  423)           ZRCUCOV = YDECUMF%RCUCOV*(1.0_JPRB + (MAX(0.8_JPRB, ZRHM) - 0.8_JPRB) / 0.025_JPRB)
(  424)         ELSE
(  425)           ZRCUCOV = YDECUMF%RCUCOV*0.6
(  426)         END IF
(  427)       ELSE
(  428)         ZRCUCOV = YDECUMF%RCUCOV
(  429)       END IF
(  430)       
(  431) !$acc loop seq
(  432)       DO JK=KTOPM2,KLEV
(  433)         IF (LDCUM(JL) .and. JK >= KCBOT(JL)) THEN
