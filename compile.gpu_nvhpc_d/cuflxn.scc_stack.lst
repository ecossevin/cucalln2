(  377)           END IF
(  378)           IF (YDEPHLI%LPHYLIN) THEN
(  379)             ZALFAW = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTEN - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  380)           ELSE
(  381)             ZALFAW = FOEALFCU(ZTEN)
(  382)           END IF
(  383)           !no liquid precipitation above melting level
(  384)           !     add heat not yet liberated in updraught precip
(  385)           IF (PTEN(JL, JK) <= YDCST%RTT .and. ZALFAW > 0.0_JPRB) THEN
(  386)             PLGLAC(JL, JK) = PLGLAC(JL, JK) + ZGLAC*ZALFAW*PDMFUP(JL, JK) + ZALFAW*PDMFDP(JL, JK)
