(  407)           ELSE IF (PMFLXR(JL, 1 + JK) < 0.0_JPRB) THEN
(  408)             PMFLXS(JL, JK + 1) = PMFLXS(JL, JK + 1) + PMFLXR(JL, JK + 1)
(  409)             PMFLXR(JL, JK + 1) = 0.0_JPRB
(  410)           ELSE IF (PMFLXS(JL, 1 + JK) < 0.0_JPRB) THEN
(  411)             PMFLXR(JL, JK + 1) = PMFLXR(JL, JK + 1) + PMFLXS(JL, JK + 1)
(  412)             PMFLXS(JL, JK + 1) = 0.0_JPRB
(  413)           END IF
(  414)         END IF
