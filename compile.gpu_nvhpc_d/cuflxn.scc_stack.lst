(  321)       
(  322)       !- rescale DD fluxes if total mass flux becomes negative
(  323)       ZMFS = 1.0_JPRB
(  324)       !DO JK=2,KLEV-1
(  325) !$acc loop seq
(  326)       DO JK=2,KLEV
(  327)         ! change for stability
(  328)         !DIR$ LOOP_INFO EST_TRIPS(16)
(  329)         IF (LDDRAF(JL) .and. JK >= -1 + KDTOP(JL)) THEN
(  330)           ZMFMAX = ABS(PMFU(JL, JK))*0.98_JPRB
(  331)           IF (PMFD(JL, JK) + ZMFMAX + 1.E-15_JPRB < 0.0_JPRB) THEN
(  332)             ZMFS = MIN(ZMFS, -ZMFMAX / PMFD(JL, JK))
(  333)           END IF
(  334)         END IF
(  335)       END DO
(  336)       
(  337) !$acc loop seq
(  338)       DO JK=2,KLEV
(  339)         !DIR$ LOOP_INFO EST_TRIPS(16)






