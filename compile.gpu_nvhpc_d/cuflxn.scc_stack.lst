(  331)           IF (PMFD(JL, JK) + ZMFMAX + 1.E-15_JPRB < 0.0_JPRB) THEN
(  332)             ZMFS = MIN(ZMFS, -ZMFMAX / PMFD(JL, JK))
(  333)           END IF
(  334)         END IF
(  335)       END DO
(  336)       
(  337) !$acc loop seq
(  338)       DO JK=2,KLEV
