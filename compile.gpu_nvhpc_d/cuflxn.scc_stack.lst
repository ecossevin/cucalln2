(  184)     
(  185)     !--------------------------------------------------------------------
(  186)     !*             SPECIFY CONSTANTS
(  187)     
(  188)     ZTMST = PTSPHY
(  189)     ZCONS1A = YDCST%RCPD / (YDCST%RLMLT*YDCST%RG*YDECUMF%RTAUMEL)
(  190)     !ZCONS2=1.0_JPRB/(RG*ZTMST)
(  191)     ZCONS2 = YDECUMF%RMFCFL / (YDCST%RG*ZTMST)
(  192)     IF (YDECUMF%LMFWETB) THEN
(  193)       ZWETB = 1.0_JPRB
(  194)     ELSE
(  195)       ZWETB = 0.0_JPRB
(  196)     END IF
(  197)     IF (YDECUMF%LMFGLAC) THEN
(  198)       ZGLAC = 0.0_JPRB
(  199)     ELSE
(  200)       ZGLAC = 1.0_JPRB
(  201)     END IF
(  202)     
(  203)     !*    1.0          DETERMINE FINAL CONVECTIVE FLUXES
(  204)     !                  ---------------------------------
(  205)     
(  206)     
(  207) !$acc loop vector
(  208)     DO JL=KIDIA,KFDIA
(  209)       PRAIN(JL) = 0.0_JPRB
(  210)       IF (.not.LDCUM(JL) .or. KDTOP(JL) < KCTOP(JL)) LDDRAF(JL) = .false.
(  211)       IF (.not.LDCUM(JL)) KTYPE(JL) = 0
(  212)       IDBAS = KLEV
(  213)       IF (LDLAND(JL)) THEN
(  214)         ZRHEBC = 0.75_JPRB
(  215)         IF (KTYPE(JL) == 1) ZRHEBC = 0.70_JPRB
(  216)       ELSE
(  217)         ZRHEBC = YDECUMF%RHEBC
(  218)         IF (KTYPE(JL) == 1) ZRHEBC = 0.85_JPRB
(  219)       END IF
(  220)       ! TO GET IDENTICAL RESULTS FOR DIFFERENT NPROMA FORCE KTOPM2 TO 2
(  221)       KTOPM2 = 2
(  222) !$acc loop seq
(  223)       DO JK=KTOPM2,KLEV
(  224)         IKB = MIN(JK + 1, KLEV)






NVFORTRAN (Version     24.5)          03/19/2025  06:55:20      page 5

(  225)         !DIR$ IVDEP
(  226)         !OCL NOVREC
(  227)         PMFLXR(JL, JK) = 0.0_JPRB
(  228)         PMFLXS(JL, JK) = 0.0_JPRB
(  229)         PDPMEL(JL, JK) = 0.0_JPRB
(  230)         PSNDE(JL, JK, 1) = 0.0_JPRB
(  231)         PSNDE(JL, JK, 2) = 0.0_JPRB
(  232)         IF (LDCUM(JL) .and. JK >= KCTOP(JL)) THEN
(  233)           PMFUS(JL, JK) = PMFUS(JL, JK) - PMFU(JL, JK)*(YDCST%RCPD*PTENH(JL, JK) + PGEOH(JL, JK))
(  234)           PMFUQ(JL, JK) = PMFUQ(JL, JK) - PMFU(JL, JK)*PQENH(JL, JK)
(  235)           PLGLAC(JL, JK) = PMFU(JL, JK)*PLGLAC(JL, JK)
(  236)           LLDDRAF = LDDRAF(JL) .and. JK >= KDTOP(JL)
(  237)           IF (LLDDRAF) THEN
(  238)             PMFDS(JL, JK) = PMFDS(JL, JK) - PMFD(JL, JK)*(YDCST%RCPD*PTENH(JL, JK) + PGEOH(JL, JK))
(  239)             PMFDQ(JL, JK) = PMFDQ(JL, JK) - PMFD(JL, JK)*PQENH(JL, JK)
(  240)           ELSE
(  241)             PMFD(JL, JK) = 0.0_JPRB
(  242)             PMFDS(JL, JK) = 0.0_JPRB
(  243)             PMFDQ(JL, JK) = 0.0_JPRB
(  244)             PDMFDP(JL, JK - 1) = 0.0_JPRB
(  245)           END IF
(  246)           IF (LLDDRAF .and. PMFD(JL, JK) < 0._JPRB .and. PMFD(JL, IKB) == 0._JPRB) THEN
(  247)             IDBAS = JK
(  248)           END IF
(  249)         ELSE
(  250)           PMFU(JL, JK) = 0.0_JPRB
(  251)           PMFD(JL, JK) = 0.0_JPRB
(  252)           PMFUS(JL, JK) = 0.0_JPRB
(  253)           PMFDS(JL, JK) = 0.0_JPRB
(  254)           PMFUQ(JL, JK) = 0.0_JPRB
(  255)           PMFDQ(JL, JK) = 0.0_JPRB
(  256)           PMFUL(JL, JK) = 0.0_JPRB
(  257)           PLGLAC(JL, JK) = 0.0_JPRB
(  258)           PDMFUP(JL, JK - 1) = 0.0_JPRB
(  259)           PDMFDP(JL, JK - 1) = 0.0_JPRB
(  260)           PLUDE(JL, JK - 1) = 0.0_JPRB
(  261)           PLUDELI(JL, JK - 1, 1) = 0.0_JPRB
(  262)           PLUDELI(JL, JK - 1, 2) = 0.0_JPRB
(  263)         END IF
(  264)       END DO
(  265)       PMFLXR(:, KLEV + 1) = 0.0_JPRB
(  266)       PMFLXS(:, KLEV + 1) = 0.0_JPRB
(  267)       PMFLXR(:, 1) = 0.0_JPRB
(  268)       PMFLXS(:, 1) = 0.0_JPRB
(  269)       PSNDE(:, 1, 1) = 0.0_JPRB
(  270)       PSNDE(:, 1, 2) = 0.0_JPRB
(  271)       
(  272)       !*    1.5          SCALE FLUXES BELOW CLOUD BASE
(  273)       !                  LINEAR DCREASE
(  274)       !                  -----------------------------
(  275)       
(  276)       !DIR$ IVDEP
(  277)       !OCL NOVREC
(  278)       IF (LDCUM(JL)) THEN
(  279)         IKB = KCBOT(JL)
(  280)         IK = IKB + 1
(  281)         ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, IK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IKB)))
(  282)         IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP






NVFORTRAN (Version     24.5)          03/19/2025  06:55:20      page 6

(  283)         PMFU(JL, IK) = PMFU(JL, IKB)*ZZP
(  284)         IF (YDEPHLI%LPHYLIN) THEN
(  285)           ZTARG = PTENH(JL, IKB)
(  286)           ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  287)           ZOELHM = ZOEALFA*YDCST%RLVTT + (1.0_JPRB - ZOEALFA)*YDCST%RLSTT
(  288)           PMFUS(JL, IK) = (PMFUS(JL, IKB) - ZOELHM*PMFUL(JL, IKB))*ZZP
(  289)         ELSE
(  290)           PMFUS(JL, IK) = (PMFUS(JL, IKB) - FOELHMCU(PTENH(JL, IKB))*PMFUL(JL, IKB))*ZZP
(  291)         END IF
(  292)         PMFUQ(JL, IK) = (PMFUQ(JL, IKB) + PMFUL(JL, IKB))*ZZP
(  293)         PMFUL(JL, IK) = 0.0_JPRB
(  294)       END IF
(  295) !$acc loop seq
(  296)       DO JK=KTOPM2,KLEV
(  297)         !DIR$ IVDEP
(  298)         !OCL NOVREC
(  299)         IF (LDCUM(JL) .and. JK > 1 + KCBOT(JL)) THEN
(  300)           IKB = KCBOT(JL) + 1
(  301)           ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, JK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IKB)))
(  302)           IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP
(  303)           PMFU(JL, JK) = PMFU(JL, IKB)*ZZP
(  304)           PMFUS(JL, JK) = PMFUS(JL, IKB)*ZZP
(  305)           PMFUQ(JL, JK) = PMFUQ(JL, IKB)*ZZP
(  306)           PMFUL(JL, JK) = 0.0_JPRB
(  307)         END IF
(  308)         IK = IDBAS
(  309)         LLDDRAF = LDDRAF(JL) .and. JK > IK .and. IK < KLEV
(  310)         IF (LLDDRAF .and. IK == 1 + KCBOT(JL)) THEN
(  311)           ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, JK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IK)))
(  312)           IF (KTYPE(JL) == 3) ZZP = ZZP*ZZP
(  313)           PMFD(JL, JK) = PMFD(JL, IK)*ZZP
(  314)           PMFDS(JL, JK) = PMFDS(JL, IK)*ZZP
(  315)           PMFDQ(JL, JK) = PMFDQ(JL, IK)*ZZP
(  316)           PMFDDE_RATE(JL, JK) = -(PMFD(JL, JK - 1) - PMFD(JL, JK))
(  317)         ELSE IF (LLDDRAF .and. IK /= 1 + KCBOT(JL) .and. JK == 1 + IK) THEN
(  318)           PMFDDE_RATE(JL, JK) = -(PMFD(JL, JK - 1) - PMFD(JL, JK))
(  319)         END IF
(  320)       END DO
(  321)       
(  322)       !- rescale DD fluxes if total mass flux becomes negative
(  323)       ZMFS = 1.0_JPRB
(  324)       !DO JK=2,KLEV-1
(  325) !$acc loop seq
(  326)       DO JK=2,KLEV
(  327)         ! change for stability
(  328)         !DIR$ LOOP_INFO EST_TRIPS(16)
(  329)         IF (LDDRAF(JL) .and. JK >= -1 + KDTOP(JL)) THEN
