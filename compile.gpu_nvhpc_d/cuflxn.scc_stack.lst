(  453)             PMFLXS(JL, JK + 1) = PMFLXS(JL, JK) + ZPDS - PDPMEL(JL, JK) + ZDRFL*PMFLXS(JL, JK)*ZDENOM
(  454)             PDMFUP(JL, JK) = PDMFUP(JL, JK) + ZDRFL
