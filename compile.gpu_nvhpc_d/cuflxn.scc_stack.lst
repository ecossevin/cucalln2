(  340)         IF (ZMFS < 1.0_JPRB .and. JK >= -1 + KDTOP(JL)) THEN
(  341)           PMFD(JL, JK) = PMFD(JL, JK)*ZMFS
(  342)           PMFDS(JL, JK) = PMFDS(JL, JK)*ZMFS
(  343)           PMFDQ(JL, JK) = PMFDQ(JL, JK)*ZMFS
(  344)           PMFDDE_RATE(JL, JK) = PMFDDE_RATE(JL, JK)*ZMFS
(  345)           PDMFDP(JL, JK) = PDMFDP(JL, JK)*ZMFS
(  346)         END IF
(  347)       END DO
(  348)       
(  349)       
(  350)       !*    2.            CALCULATE RAIN/SNOW FALL RATES
(  351)       !*                  CALCULATE MELTING OF SNOW
(  352)       !*                  CALCULATE EVAPORATION OF PRECIP
(  353)       !                   -------------------------------
(  354)       
(  355) !$acc loop seq
(  356)       DO JK=KTOPM2,KLEV
(  357)         IF (LDCUM(JL) .and. JK >= -1 + KCTOP(JL)) THEN
(  358)           PRAIN(JL) = PRAIN(JL) + PDMFUP(JL, JK)
(  359)           ZTWETB = PTEN(JL, JK) - MAX(0.0_JPRB, PQSEN(JL, JK) - PQEN(JL, JK))*(ZTW1 + ZTW2*(PAP(JL, JK) - ZTW3) - ZTW4*(PTEN(JL,  &
(  360)           & JK) - ZTW5))
(  361)           ZTEN = ZTWETB*ZWETB + (1.0_JPRB - ZWETB)*PTEN(JL, JK)
(  362)           IF (PMFLXS(JL, JK) > 0.0_JPRB .and. ZTEN > YDCST%RTT) THEN
(  363)             ZCONS1 = ZCONS1A*(1.0_JPRB + 0.5_JPRB*(ZTEN - YDCST%RTT))
(  364)             ZFAC = ZCONS1*(PAPH(JL, JK + 1) - PAPH(JL, JK))
(  365)             ZSNMLT = MIN(PMFLXS(JL, JK), ZFAC*(ZTEN - YDCST%RTT))
(  366)             PDPMEL(JL, JK) = ZSNMLT
(  367)             IF (YDEPHLI%LPHYLIN) THEN
(  368)               ZTARG = ZTEN - ZSNMLT / ZFAC
(  369)               ZOEALFA = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB))
(  370)               ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4LES))
(  371)               ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4IES))
(  372)               ZOEEWM = ZOEALFA*ZFOEEWL + (1.0_JPRB - ZOEALFA)*ZFOEEWI
(  373)               PQSEN(JL, JK) = ZOEEWM / PAP(JL, JK)
(  374)             ELSE
(  375)               PQSEN(JL, JK) = FOEEWMCU(ZTEN - ZSNMLT / ZFAC) / PAP(JL, JK)
