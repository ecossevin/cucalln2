(  440)             ZRNEW = MAX(ZRNEW, ZRMIN)
(  441)             ZRFLN = MAX(ZRNEW, 0.0_JPRB)
(  442)             ZDRFL = MIN(0.0_JPRB, ZRFLN - ZRFL)
