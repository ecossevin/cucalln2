(    1) !OPTIONS XOPT(HSFUN)
(    2) 
(    3) SUBROUTINE CUASCN &
(    4)  & (YDTHF, YDCST, YDEPHLI, YDECLDP,  YDECUMF, YDSPP_CONFIG, YGFL,&
(    5)  & KIDIA,    KFDIA,    KLON,    KLEV, LDTDKMF, &
(    6)  & PTSPHY,&
(    7)  & PTENH,    PQENH,    PUEN,     PVEN,&
(    8)  & PTEN,     PQEN,     PQSEN,    PLITOT,&
(    9)  & PGEO,     PGEOH,    PAP,      PAPH,&
(   10)  & PVERVEL,  PWUBASE,  PGP2DSPP,  &
(   11)  & LDLAND,   LDCUM,    KTYPE,    KLAB,     LSCVFLAG,&
(   12)  & PTU,      PQU,      PLU,      PLRAIN,&
(   13)  & PMFU,     PMFUB,    PLGLAC,&
(   14)  & PMFUS,    PMFUQ,    PMFUL,    PLUDE,    PLUDELI,        PDMFUP,&
(   15)  & PLCRIT_AER,&
(   16)  & PDMFEN,&
(   17)  & KCBOT,    KCTOP,    KCTOP0,   KDPL,     PMFUDE_RATE,    PKINEU,  PWU, PWMEAN )  
(   18) 
(   19) !          THIS ROUTINE DOES THE CALCULATIONS FOR CLOUD ASCENTS
(   20) !          FOR CUMULUS PARAMETERIZATION
(   21) 
(   22) !          PURPOSE.
(   23) !          --------
(   24) !          TO PRODUCE CLOUD ASCENTS FOR CU-PARAMETRIZATION
(   25) !          (VERTICAL PROFILES OF T,Q,L,U AND V AND CORRESPONDING
(   26) !           FLUXES AS WELL AS PRECIPITATION RATES)
(   27) 
(   28) !          INTERFACE
(   29) !          ---------
(   30) 
(   31) !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   32) 
(   33) !          METHOD.
(   34) !          --------
(   35) !          LIFT SURFACE AIR DRY-ADIABATICALLY TO CLOUD BASE
(   36) !          AND THEN CALCULATE MOIST ASCENT FOR
(   37) !          ENTRAINING/DETRAINING PLUME.
(   38) !          ENTRAINMENT AND DETRAINMENT RATES DIFFER FOR
(   39) !          SHALLOW AND DEEP CUMULUS CONVECTION.
(   40) !          IN CASE THERE IS NO PENETRATIVE OR SHALLOW CONVECTION
(   41) !          CHECK FOR POSSIBILITY OF MID LEVEL CONVECTION
(   42) !          (CLOUD BASE VALUES CALCULATED IN *CUBASMC*)
(   43) 
(   44) !     PARAMETER     DESCRIPTION                                   UNITS
(   45) !     ---------     -----------                                   -----
(   46) !     INPUT PARAMETERS (INTEGER):
(   47) 
(   48) !    *KIDIA*        START POINT
(   49) !    *KFDIA*        END POINT
(   50) !    *KLON*         NUMBER OF GRID POINTS PER PACKET






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 2

(   51) !    *KLEV*         NUMBER OF LEVELS
(   52) !    *KTYPE*        TYPE OF CONVECTION
(   53) !                       1 = PENETRATIVE CONVECTION
(   54) !                       2 = SHALLOW CONVECTION
(   55) !                       3 = MIDLEVEL CONVECTION
(   56) !    *KCBOT*        CLOUD BASE LEVEL
(   57) !    *KDPL*         DEPARTURE LEVEL FOR CONVECTION
(   58) 
(   59) !    INPUT PARAMETERS (REAL):
(   60) 
(   61) !    *PTSPHY*       TIME STEP FOR THE PHYSICS                      S
(   62) !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS          K
(   63) !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS     KG/KG
(   64) !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)      M/S
(   65) !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)      M/S
(   66) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)      K
(   67) !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1) KG/KG
(   68) !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)  KG/KG
(   69) !    *PGEO*         GEOPOTENTIAL                                 M2/S2
(   70) !    *PLITOT*       GRID MEAN LIQUID WATER+ICE CONTENT           KG/KG
(   71) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                  M2/S2
(   72) !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS           PA
(   73) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   74) !    *PVERVEL*      VERTICAL VELOCITY                            PA/S
(   75) !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   76) !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(   77) 
(   78) !    INPUT PARAMETERS (LOGICAL):
(   79) 
(   80) !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   81) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS 
(   82) !    *LDTDKMF*      Arpege tuning (if TRUE)
(   83) 
(   84) !    UPDATED PARAMETERS (INTEGER):
(   85) 
(   86) !    *KLAB*         FLAG KLAB=1 FOR SUBCLOUD LEVELS
(   87) !                        KLAB=2 FOR CLOUD LEVELS
(   88) 
(   89) !    UPDATED PARAMETERS (REAL):
(   90) 
(   91) !    *PTU*          TEMPERATURE IN UPDRAFTS                        K
(   92) !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                   KG/KG
(   93) !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS             KG/KG
(   94) !    *PLRAIN*       RAIN   WATER CONTENT IN UPDRAFTS             KG/KG
(   95) 
(   96) !    OUTPUT PARAMETERS (INTEGER):
(   97) 
(   98) !    *KCTOP*        CLOUD TOP LEVEL
(   99) !    *KCTOP0*       FIRST GUESS OF CLOUD TOP LEVEL 
(  100) !    *LSCVFLAG*     MASK FOR LIQUID ONLY SHALLOW
(  101) 
(  102) !    OUTPUT PARAMETERS (REAL):
(  103) 
(  104) !    *PMFU*         MASSFLUX IN UPDRAFTS                         KG/(M2*S)
(  105) !    *PMFUB*        MASSFLUX IN UPDRAFTS AT CLOUD BASE           KG/(M2*S)
(  106) !    *PMFUS*        FLUX OF DRY STATIC ENERGY IN UPDRAFTS         J/(M2*S)
(  107) !    *PMFUQ*        FLUX OF SPEC. HUMIDITY IN UPDRAFTS           KG/(M2*S)
(  108) !    *PMFUL*        FLUX OF LIQUID WATER IN UPDRAFTS             KG/(M2*S)






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 3

(  109) !    *PLUDE*        DETRAINED TOTAL CONDENSATE                   KG/(M2*S)
(  110) !    *PLUDELI*      DETRAINED LIQUID, ICE                        KG/(M2*S)
(  111) !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT              KG/KG
(  112) !    *PDMFUP*       FLUX DIFFERENCE OF PRECIP. IN UPDRAFTS       KG/(M2*S)
(  113) !    *PMFUDE_RATE*  UPDRAFT DETRAINMENT RATE                     KG/(M2*S)
(  114) !    *PKINEU*       UPDRAFT KINETIC ENERGY                       M2/S2
(  115) !    *PWMEAN*       MEAN UPDRAUGHT VELOCITY                      M/S
(  116) 
(  117) !          EXTERNALS
(  118) !          ---------
(  119) !          *CUADJTQ* ADJUST T AND Q DUE TO CONDENSATION IN ASCENT
(  120) !          *CUENTR*  CALCULATE ENTRAINMENT/DETRAINMENT RATES
(  121) !          *CUBASMC* CALCULATE CLOUD BASE VALUES FOR MIDLEVEL CONVECTION
(  122) 
(  123) !          REFERENCE
(  124) !          ---------
(  125) !          (TIEDTKE,1989)
(  126) 
