(  660) # 661 "./cuascn.F90"
(  661)             IF(ZDMFEN(JL) > 0.0_JPRB)THEN
(  662)               ZDKEN=MIN(1.0_JPRB,(1 + Z_CWDRAG)*&
(  663)                & ZDMFEN(JL)/MAX(RMFCMIN,PMFU(JL,JK+1)))  
