(  863) 
(  864)   ENDIF
(  865) ENDDO
(  866) 
(  867) !----------------------------------------------------------------------
(  868) 
(  869) !     5.           FINAL CALCULATIONS 
(  870) !                  ------------------
(  871) 
(  872) DO JL=KIDIA,KFDIA
(  873)   IF(KCTOP(JL) == -1) LDCUM(JL)=.FALSE.
(  874)   KCBOT(JL)=MAX(KCBOT(JL),KCTOP(JL))
(  875)   IF(LDCUM(JL)) THEN
(  876)     PWMEAN(JL)=MAX(1.E-2_JPRB,PWMEAN(JL)/MAX(1.0_JPRB,ZDPMEAN(JL)))
(  877)     PWMEAN(JL)=SQRT(2.0_JPRB*PWMEAN(JL))
(  878)   ENDIF
(  879) ENDDO
(  880) 
(  881) END ASSOCIATE
(  882) IF (LHOOK) CALL DR_HOOK('CUASCN',1,ZHOOK_HANDLE)
(  883) END SUBROUTINE CUASCN











































