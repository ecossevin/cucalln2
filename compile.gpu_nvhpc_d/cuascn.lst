(  863) !----------------------------------------------------------------------
(  864) 
(  865) !     5.           FINAL CALCULATIONS 
(  866) !                  ------------------
(  867) 
(  868) DO JL=KIDIA,KFDIA
(  869)   IF(KCTOP(JL) == -1) LDCUM(JL)=.FALSE.
(  870)   KCBOT(JL)=MAX(KCBOT(JL),KCTOP(JL))
(  871)   IF(LDCUM(JL)) THEN
(  872)     PWMEAN(JL)=MAX(1.E-2_JPRB,PWMEAN(JL)/MAX(1.0_JPRB,ZDPMEAN(JL)))
(  873)     PWMEAN(JL)=SQRT(2.0_JPRB*PWMEAN(JL))
(  874)   ENDIF
(  875) ENDDO
(  876) 
(  877) END ASSOCIATE
(  878) IF (LHOOK) CALL DR_HOOK('CUASCN',1,ZHOOK_HANDLE)
(  879) END SUBROUTINE CUASCN















































