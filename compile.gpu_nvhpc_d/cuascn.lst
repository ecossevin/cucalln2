(  644) # 645 "./cuascn.F90"
(  645)           IF(KLAB(JL,JK+1) == 2) THEN
(  646) # 647 "./cuascn.F90"
(  647)            !IF(ZBUO(JL,JK) < 0.0_JPRB.AND.KTYPE(JL)==1) THEN
(  648)             IF(ZBUO(JL,JK) < -0.1_JPRB) THEN
(  649)               PTENH(JL,JK)=0.5_JPRB*(PTEN(JL,JK)+PTEN(JL,JK-1))
(  650)               PQENH(JL,JK)=0.5_JPRB*(PQEN(JL,JK)+PQEN(JL,JK-1))
(  651)               ZBUO(JL,JK)=ZBC-PTENH(JL,JK)*(1.0_JPRB+RETV*PQENH(JL,JK))
