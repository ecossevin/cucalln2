(  710)            &(ZBUO(JL,JK)>-2._JPRB.OR.(PTEN(JL,JK-1)-PTEN(JL,JK))/(ZRG*(PGEO(JL,JK-1)-PGEO(JL,JK)))&
(  711)            &<-3.E-3_JPRB) ) THEN
(  712)               KCTOP(JL)=JK
(  713)               LLO1(JL)=.TRUE.
(  714)             ELSE
(  715)               KLAB(JL,JK)=0
(  716)               PMFU(JL,JK)=0.0_JPRB
(  717)               PKINEU(JL,JK)=0.0_JPRB
(  718)               ZDMFDE(JL)=PMFU(JL,JK+1)
(  719)               PLUDE(JL,JK)=PLU(JL,JK+1)*ZDMFDE(JL)
(  720)             ENDIF
(  721)             
(  722) ! stor  e detrainment rates for updraught
(  723) 
(  724)             IF ( PMFU(JL,JK+1) > 0.0_JPRB ) THEN
(  725)               PMFUDE_RATE(JL,JK)=ZDMFDE(JL)
(  726)             ENDIF
(  727)             
(  728)           ENDIF
(  729) 
(  730) !       ELSEIF(LLFLAG(JL).AND.KTYPE(JL)==2.AND.PQU(JL,JK) == ZQOLD(JL)) THEN
(  731)         ELSEIF(KTYPE(JL)==2.AND.PQU(JL,JK) == ZQOLD(JL)) THEN
(  732)           KLAB(JL,JK)=0
(  733)           PMFU(JL,JK)=0.0_JPRB
(  734)           PKINEU(JL,JK)=0.0_JPRB
(  735)           ZDMFDE(JL)=PMFU(JL,JK+1)
(  736)           PLUDE(JL,JK)=PLU(JL,JK+1)*ZDMFDE(JL)
(  737)           PMFUDE_RATE(JL,JK)=ZDMFDE(JL)
(  738) 
(  739)         ENDIF
(  740)       ENDIF
(  741)     ENDDO
(  742) 
(  743) !              CALCULATE PRECIPITATION RATE BY
(  744) !              ANALYTIC INTEGRATION OF EQUATION FOR L
(  745) 
(  746)     DO JL=KIDIA,KFDIA






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 14

(  747)       IF(LLO1(JL)) THEN
(  748)         IF(PLU(JL,JK) > ZDNOPRC) THEN
(  749)           PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.5_JPRB,PKINEU(JL,JK+1))))
(  750) !       increase conversion for liquid phase only
(  751)           IF (LDTDKMF) THEN
(  752)              ZZCO=FOEALFCU(PTU(JL,JK))*1.3_JPRB+(1.0_JPRB-FOEALFCU(PTU(JL,JK)))
(  753)           ELSE
(  754)              ZZCO=1.0_JPRB+0.3_JPRB*FOEALFCU(PTU(JL,JK))
(  755)           ENDIF   
(  756)         ! IF(LSCVFLAG(JL)) ZZCO=1.3_JPRB
(  757) 
(  758)           IF (YDSPP_CONFIG%LSPP .AND. LLPERT_RPRCON) THEN
(  759)             ZXPRCDGW=ZPRCDGW*EXP(PN1RPRCON%MU(1)+PN1RPRCON%XMAG(1)*PGP2DSPP(JL, IPRPRCON))
(  760)           ELSE
(  761)             ZXPRCDGW=ZPRCDGW
(  762)           ENDIF
(  763)           ZPRCON=ZXPRCDGW/(0.75_JPRB*PWU(JL,JK))*ZZCO
(  764) 
(  765) !           PARAMETERS FOR BERGERON-FINDEISEN PROCESS (T < -5C)
(  766) 
(  767)           ZDT=MIN(RTBERCU-RTICECU,MAX(RTBERCU-PTU(JL,JK),0.0_JPRB))
(  768)           ZCBF=1+Z_CPRC2*SQRT(ZDT)
(  769)           ZZCO=ZPRCON*ZCBF
(  770) 
(  771)           IF (NACTAERO > 0) THEN
(  772) !         (Prognostic) aerosols in clouds, CCN effect only in pure warm phase
(  773) !         then phases out in mixed phase - ***NOT*** linear physics 
(  774) ! CCN number taken at each height from environment
(  775)             IF (LAERLIQAUTOCP) THEN
(  776)               ZALFAW=FOEALFCU(PTU(JL,JK))
(  777)               ZLCRIT=ZALFAW*PLCRIT_AER(JL,JK)+(1.0_JPRB-ZALFAW)*ZDNOPRC
(  778) ! CCN number determined at cloud base (entrainment ignored)
(  779)             ELSEIF (LAERLIQAUTOCPB) THEN 
(  780)               ZALFAW=FOEALFCU(PTU(JL,JK))
(  781)               ZLCRIT=ZALFAW*PLCRIT_AER(JL,KCBOT(JL))+(1.0_JPRB-ZALFAW)*ZDNOPRC
(  782)             ELSE
(  783)               ZLCRIT=ZDNOPRC/ZCBF
(  784)             ENDIF
(  785)           ELSE
(  786)             ZLCRIT=ZDNOPRC/ZCBF
(  787)          ENDIF
(  788) 
(  789)           ZDFI=PGEOH(JL,JK)-PGEOH(JL,JK+1)
(  790)           ZC=(PLU(JL,JK)-ZLUOLD(JL))
(  791)           ZD=ZZCO*(1.0_JPRB-EXP(-(PLU(JL,JK)/ZLCRIT)**2))*ZDFI
(  792)           ZINT=EXP(-ZD)
(  793)           ZLNEW=ZLUOLD(JL)*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  794)           ZLNEW=MAX(0.0_JPRB,MIN(PLU(JL,JK),ZLNEW))
(  795)           ZLNEW=MIN(Z_CLDMAX,ZLNEW)
(  796)           ZPRECIP(JL)=MAX(0.0_JPRB,ZLUOLD(JL)+ZC-ZLNEW)
(  797)           PDMFUP(JL,JK)=ZPRECIP(JL)*PMFU(JL,JK)
(  798)           PLRAIN(JL,JK)=PLRAIN(JL,JK)+ZPRECIP(JL)
(  799)           PLU(JL,JK)=ZLNEW
(  800)         ENDIF
(  801)       ENDIF
(  802)     ENDDO
(  803) 
(  804)     IF (LPHYLIN) THEN






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 15

(  805) 
(  806) !DEC$ IVDEP
(  807) !NEC$ IVDEP
(  808)       DO JL=KIDIA,KFDIA
(  809)         IF(LLO1(JL)) THEN
(  810)           IF(PLRAIN(JL,JK) > 0.0_JPRB) THEN
(  811)             ZVW=21.18_JPRB*PLRAIN(JL,JK)**0.2_JPRB
(  812)             ZVI=Z_CWIFRAC*ZVW
(  813)             ZALFAW=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(PTU(JL,JK)-RLPTRC))+1.0_JPRB))
(  814)             ZVV=ZALFAW*ZVW+(1.0_JPRB-ZALFAW)*ZVI
(  815)             ZROLD=PLRAIN(JL,JK)-ZPRECIP(JL)
(  816)             ZC=ZPRECIP(JL)
(  817)             PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.1_JPRB,PKINEU(JL,JK))))
(  818)             ZD=ZVV/PWU(JL,JK)
(  819)             ZINT=EXP(-ZD)
(  820)             ZRNEW=ZROLD*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  821)             ZRNEW=MAX(0.0_JPRB,MIN(PLRAIN(JL,JK),ZRNEW))
(  822)             PLRAIN(JL,JK)=ZRNEW
(  823)           ENDIF
(  824)         ENDIF
(  825)       ENDDO
(  826) 
(  827)     ELSE
(  828) 
(  829)       DO JL=KIDIA,KFDIA
(  830)         IF(LLO1(JL)) THEN
(  831)           IF(PLRAIN(JL,JK) > 0.0_JPRB) THEN
(  832)             ZVW=21.18_JPRB*PLRAIN(JL,JK)**0.2_JPRB
(  833)             ZVI=Z_CWIFRAC*ZVW
(  834)             ZALFAW=FOEALFCU(PTU(JL,JK))
(  835)             IF(LSCVFLAG(JL)) ZALFAW=1.0_JPRB
(  836)             ZVV=ZALFAW*ZVW+(1.0_JPRB-ZALFAW)*ZVI
(  837)             ZROLD=PLRAIN(JL,JK)-ZPRECIP(JL)
(  838)             ZC=ZPRECIP(JL)
(  839)             PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.1_JPRB,PKINEU(JL,JK))))
(  840)             ZD=ZVV/PWU(JL,JK)
(  841)             ZINT=EXP(-ZD)
(  842)             ZRNEW=ZROLD*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  843)             ZRNEW=MAX(0.0_JPRB,MIN(PLRAIN(JL,JK),ZRNEW))
(  844)             PLRAIN(JL,JK)=ZRNEW
(  845)           ENDIF
(  846)         ENDIF
(  847)       ENDDO
(  848) 
(  849)     ENDIF
(  850) 
(  851)     DO JL=KIDIA,KFDIA 
(  852)       !JL=JLX(JLL)
(  853)       IF (LLFLAG(JL)) THEN
(  854)         PMFUL(JL,JK)=PLU(JL,JK)*PMFU(JL,JK)
(  855)         PMFUS(JL,JK)=(RCPD*PTU(JL,JK)+PGEOH(JL,JK))*PMFU(JL,JK)
(  856)         PMFUQ(JL,JK)=PQU(JL,JK)*PMFU(JL,JK)
(  857)         ZALFAW=FOEALFCU(PTU(JL,JK))
(  858)         IF(LSCVFLAG(JL)) ZALFAW=1.0_JPRB
(  859)         PLUDELI(JL,JK,1)=ZALFAW*PLUDE(JL,JK)
(  860)         PLUDELI(JL,JK,2)=(1.0_JPRB-ZALFAW)*PLUDE(JL,JK)
(  861)       ENDIF
(  862)     ENDDO






