(  591)                          &(0.5_JPRB+SIGN(0.5_JPRB,RTT-PTEN(JL,JK)))*ZGLAC
(  592)             PTU(JL,JK)=PTU(JL,JK)+RALFDCP*PLGLAC(JL,JK)
