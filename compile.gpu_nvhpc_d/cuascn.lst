(  472)    & PQSEN,    PAPH,          PGEOH,&
(  473)    & PMFU,     PGP2DSPP,      ZDMFEN,   ZDMFDE )  
(  474) 
(  475) !                  DO ADIABATIC ASCENT FOR ENTRAINING/DETRAINING PLUME
(  476) !                  ---------------------------------------------------
(  477) 
(  478)   IF(LLO3) THEN
(  479) 
(  480)     DO JL=KIDIA,KFDIA
(  481)       ZQOLD(JL)=0.0_JPRB
