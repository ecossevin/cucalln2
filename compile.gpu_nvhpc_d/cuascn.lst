(  260) !*    1.           SPECIFY PARAMETERS
(  261) !                  ------------------
(  262) 
(  263) IF (LHOOK) CALL DR_HOOK('CUASCN',0,ZHOOK_HANDLE)
(  264) ASSOCIATE(NACTAERO=>YGFL%NACTAERO, &
(  265)  & LAERLIQAUTOCP=>YDECLDP%LAERLIQAUTOCP, LAERLIQAUTOCPB=>YDECLDP%LAERLIQAUTOCPB, &
(  266)  & RLMIN=>YDECLDP%RLMIN, RCPD=>YDCST%RCPD, RETV=>YDCST%RETV, RG=>YDCST%RG, RTT=>YDCST%RTT, &
(  267)  & RALFDCP=>YDTHF%RALFDCP, RTBERCU=>YDTHF%RTBERCU, RTICECU=>YDTHF%RTICECU, &
(  268)  & ENTRORG=>YDECUMF%ENTRORG, ENTR_RH=>YDECUMF%ENTR_RH, ENTSHALP=>YDECUMF%ENTSHALP, RMFCFL=>YDECUMF%RMFCFL, &
(  269)  & RMFCMIN=>YDECUMF%RMFCMIN, RPRCON=>YDECUMF%RPRCON, LMFGLAC=>YDECUMF%LMFGLAC, &
(  270)  & LSCVLIQ=>YDECUMF%LSCVLIQ, LPHYLIN=>YDEPHLI%LPHYLIN, RLPTRC=>YDEPHLI%RLPTRC)
(  271) 
(  272) ZCONS2=RMFCFL/(RG*PTSPHY)
(  273) ZRG=1.0_JPRB/RG
(  274) ZORCPD=1.0_JPRB/RCPD
(  275) ZFACBUO=0.5_JPRB/(1.0_JPRB+0.5_JPRB)
(  276) ZPRCDGW=RPRCON/RG
(  277) ZDNOPRC=3.E-4_JPRB !condensate threshold for precip
(  278) Z_CLDMAX=5.E-3_JPRB
(  279) Z_CWIFRAC=0.5_JPRB
(  280) Z_CPRC2=0.5_JPRB
(  281) Z_CWDRAG=(3._JPRB/8._JPRB)*0.506_JPRB/0.2_JPRB
(  282) 






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 6

(  283) IF(LMFGLAC) THEN
(  284)   ZGLAC=1.0_JPRB
(  285) ELSE
(  286)   ZGLAC=0.0_JPRB
(  287) ENDIF
(  288) 
(  289) !----------------------------------------------------------------------
(  290) 
(  291) !     2.           SET DEFAULT VALUES
(  292) !                  ------------------
(  293) 
(  294) LLO3=.FALSE.
(  295) DO JL=KIDIA,KFDIA
(  296)   ZLUOLD(JL)=0.0_JPRB
(  297)   IF(.NOT.LDCUM(JL)) THEN
(  298)     KCBOT(JL)=-1
(  299)     PMFUB(JL)=0.0_JPRB
(  300)     PQU(JL,KLEV)=0.0_JPRB
(  301)     KTYPE(JL)=0
(  302)   ENDIF
(  303)   PWMEAN(JL)=0.0_JPRB
(  304)   ZDPMEAN(JL)=0.0_JPRB
(  305)   ZOENTR(JL)=0.0_JPRB
(  306)   LSCVFLAG(JL)=.FALSE.
(  307)   IF(KTYPE(JL)>1.AND.LSCVLIQ) LSCVFLAG(JL)=.TRUE.
(  308) ENDDO
(  309) 
(  310) !  Prepare SPP
(  311) IF (YDSPP_CONFIG%LSPP) THEN
(  312)   
(  313)   IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  314)   LLPERT_ENTRORG=IPN > 0
(  315)   IF (LLPERT_ENTRORG) THEN
(  316)     PN1ENTRORG = YDSPP_CONFIG%SM%PN(IPN)
(  317)     IPENTRORG  = PN1ENTRORG%MP
(  318)   ENDIF
(  319) 
(  320)   IPN = YDSPP_CONFIG%PPTR%ENTSHALP
(  321)   LLPERT_ENTSHALP= IPN > 0
(  322)   IF (LLPERT_ENTSHALP) THEN
(  323)     PN1ENTSHALP = YDSPP_CONFIG%SM%PN(IPN)
(  324)     IPENTSHALP  = PN1ENTSHALP%MP
(  325)   ENDIF
(  326) 
(  327)   IPN = YDSPP_CONFIG%PPTR%RPRCON
(  328)   LLPERT_RPRCON= IPN > 0
(  329)   IF (LLPERT_RPRCON) THEN
(  330)     PN1RPRCON = YDSPP_CONFIG%SM%PN(IPN)
(  331)     IPRPRCON  = PN1RPRCON%MP
(  332)   ENDIF
(  333) 
(  334) ELSE
(  335)   LLPERT_ENTRORG  =.FALSE.
(  336)   LLPERT_ENTSHALP =.FALSE.
(  337)   LLPERT_RPRCON   =.FALSE.
(  338) ENDIF
(  339) 
(  340) 






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 7

(  341) ! initalize various quantities
(  342) ! note that liquid water and kinetic energy at cloud base is 
(  343) ! preserved from cubase
(  344) 
(  345) DO JL=KIDIA,KFDIA
(  346)   LLKLAB(JL)=.FALSE.
(  347)   IF(.NOT.LDCUM(JL).OR.KTYPE(JL) == 3) LLKLAB(JL)=.TRUE.
(  348) ENDDO
(  349) 
(  350) DO JK=1,KLEV
