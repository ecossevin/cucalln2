(  709)               LLO1(JL)=.TRUE.
(  710)             ELSE
(  711)               KLAB(JL,JK)=0
(  712)               PMFU(JL,JK)=0.0_JPRB
(  713)               PKINEU(JL,JK)=0.0_JPRB
(  714)               ZDMFDE(JL)=PMFU(JL,JK+1)
(  715)               PLUDE(JL,JK)=PLU(JL,JK+1)*ZDMFDE(JL)
(  716)             ENDIF
(  717)             
(  718) ! stor  e detrainment rates for updraught
(  719) 
(  720)             IF ( PMFU(JL,JK+1) > 0.0_JPRB ) THEN
(  721)               PMFUDE_RATE(JL,JK)=ZDMFDE(JL)
(  722)             ENDIF
(  723)             
(  724)           ENDIF
(  725) 
(  726) !       ELSEIF(LLFLAG(JL).AND.KTYPE(JL)==2.AND.PQU(JL,JK) == ZQOLD(JL)) THEN
(  727)         ELSEIF(KTYPE(JL)==2.AND.PQU(JL,JK) == ZQOLD(JL)) THEN
(  728)           KLAB(JL,JK)=0
(  729)           PMFU(JL,JK)=0.0_JPRB
(  730)           PKINEU(JL,JK)=0.0_JPRB
(  731)           ZDMFDE(JL)=PMFU(JL,JK+1)
(  732)           PLUDE(JL,JK)=PLU(JL,JK+1)*ZDMFDE(JL)
(  733)           PMFUDE_RATE(JL,JK)=ZDMFDE(JL)
(  734) 
(  735)         ENDIF
(  736)       ENDIF
(  737)     ENDDO
(  738) 
(  739) !              CALCULATE PRECIPITATION RATE BY
(  740) !              ANALYTIC INTEGRATION OF EQUATION FOR L
(  741) 
(  742)     DO JL=KIDIA,KFDIA
(  743)       IF(LLO1(JL)) THEN
(  744)         IF(PLU(JL,JK) > ZDNOPRC) THEN
(  745)           PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.5_JPRB,PKINEU(JL,JK+1))))
(  746) !       increase conversion for liquid phase only






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 14

(  747)           IF (LDTDKMF) THEN
(  748)              ZZCO=FOEALFCU(PTU(JL,JK))*1.3_JPRB+(1.0_JPRB-FOEALFCU(PTU(JL,JK)))
(  749)           ELSE
(  750)              ZZCO=1.0_JPRB+0.3_JPRB*FOEALFCU(PTU(JL,JK))
(  751)           ENDIF   
(  752)         ! IF(LSCVFLAG(JL)) ZZCO=1.3_JPRB
(  753) 
(  754)           IF (YDSPP_CONFIG%LSPP .AND. LLPERT_RPRCON) THEN
(  755)             ZXPRCDGW=ZPRCDGW*EXP(PN1RPRCON%MU(1)+PN1RPRCON%XMAG(1)*PGP2DSPP(JL, IPRPRCON))
(  756)           ELSE
(  757)             ZXPRCDGW=ZPRCDGW
(  758)           ENDIF
(  759)           ZPRCON=ZXPRCDGW/(0.75_JPRB*PWU(JL,JK))*ZZCO
(  760) 
(  761) !           PARAMETERS FOR BERGERON-FINDEISEN PROCESS (T < -5C)
(  762) 
(  763)           ZDT=MIN(RTBERCU-RTICECU,MAX(RTBERCU-PTU(JL,JK),0.0_JPRB))
(  764)           ZCBF=1+Z_CPRC2*SQRT(ZDT)
(  765)           ZZCO=ZPRCON*ZCBF
(  766) 
(  767)           IF (NACTAERO > 0) THEN
(  768) !         (Prognostic) aerosols in clouds, CCN effect only in pure warm phase
(  769) !         then phases out in mixed phase - ***NOT*** linear physics 
(  770) ! CCN number taken at each height from environment
(  771)             IF (LAERLIQAUTOCP) THEN
(  772)               ZALFAW=FOEALFCU(PTU(JL,JK))
(  773)               ZLCRIT=ZALFAW*PLCRIT_AER(JL,JK)+(1.0_JPRB-ZALFAW)*ZDNOPRC
(  774) ! CCN number determined at cloud base (entrainment ignored)
(  775)             ELSEIF (LAERLIQAUTOCPB) THEN 
(  776)               ZALFAW=FOEALFCU(PTU(JL,JK))
(  777)               ZLCRIT=ZALFAW*PLCRIT_AER(JL,KCBOT(JL))+(1.0_JPRB-ZALFAW)*ZDNOPRC
(  778)             ELSE
(  779)               ZLCRIT=ZDNOPRC/ZCBF
(  780)             ENDIF
(  781)           ELSE
(  782)             ZLCRIT=ZDNOPRC/ZCBF
(  783)          ENDIF
(  784) 
(  785)           ZDFI=PGEOH(JL,JK)-PGEOH(JL,JK+1)
(  786)           ZC=(PLU(JL,JK)-ZLUOLD(JL))
(  787)           ZD=ZZCO*(1.0_JPRB-EXP(-(PLU(JL,JK)/ZLCRIT)**2))*ZDFI
(  788)           ZINT=EXP(-ZD)
(  789)           ZLNEW=ZLUOLD(JL)*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  790)           ZLNEW=MAX(0.0_JPRB,MIN(PLU(JL,JK),ZLNEW))
(  791)           ZLNEW=MIN(Z_CLDMAX,ZLNEW)
(  792)           ZPRECIP(JL)=MAX(0.0_JPRB,ZLUOLD(JL)+ZC-ZLNEW)
(  793)           PDMFUP(JL,JK)=ZPRECIP(JL)*PMFU(JL,JK)
(  794)           PLRAIN(JL,JK)=PLRAIN(JL,JK)+ZPRECIP(JL)
(  795)           PLU(JL,JK)=ZLNEW
(  796)         ENDIF
(  797)       ENDIF
(  798)     ENDDO
(  799) 
(  800)     IF (LPHYLIN) THEN
(  801) 
(  802) !DEC$ IVDEP
(  803) !NEC$ IVDEP
(  804)       DO JL=KIDIA,KFDIA






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 15

(  805)         IF(LLO1(JL)) THEN
(  806)           IF(PLRAIN(JL,JK) > 0.0_JPRB) THEN
(  807)             ZVW=21.18_JPRB*PLRAIN(JL,JK)**0.2_JPRB
(  808)             ZVI=Z_CWIFRAC*ZVW
(  809)             ZALFAW=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(PTU(JL,JK)-RLPTRC))+1.0_JPRB))
(  810)             ZVV=ZALFAW*ZVW+(1.0_JPRB-ZALFAW)*ZVI
(  811)             ZROLD=PLRAIN(JL,JK)-ZPRECIP(JL)
(  812)             ZC=ZPRECIP(JL)
(  813)             PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.1_JPRB,PKINEU(JL,JK))))
(  814)             ZD=ZVV/PWU(JL,JK)
(  815)             ZINT=EXP(-ZD)
(  816)             ZRNEW=ZROLD*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  817)             ZRNEW=MAX(0.0_JPRB,MIN(PLRAIN(JL,JK),ZRNEW))
(  818)             PLRAIN(JL,JK)=ZRNEW
(  819)           ENDIF
(  820)         ENDIF
(  821)       ENDDO
(  822) 
(  823)     ELSE
(  824) 
(  825)       DO JL=KIDIA,KFDIA
(  826)         IF(LLO1(JL)) THEN
(  827)           IF(PLRAIN(JL,JK) > 0.0_JPRB) THEN
(  828)             ZVW=21.18_JPRB*PLRAIN(JL,JK)**0.2_JPRB
(  829)             ZVI=Z_CWIFRAC*ZVW
(  830)             ZALFAW=FOEALFCU(PTU(JL,JK))
(  831)             IF(LSCVFLAG(JL)) ZALFAW=1.0_JPRB
(  832)             ZVV=ZALFAW*ZVW+(1.0_JPRB-ZALFAW)*ZVI
(  833)             ZROLD=PLRAIN(JL,JK)-ZPRECIP(JL)
(  834)             ZC=ZPRECIP(JL)
(  835)             PWU(JL,JK)=MIN(15._JPRB,SQRT(2.0_JPRB*MAX(0.1_JPRB,PKINEU(JL,JK))))
(  836)             ZD=ZVV/PWU(JL,JK)
(  837)             ZINT=EXP(-ZD)
(  838)             ZRNEW=ZROLD*ZINT+ZC/ZD*(1.0_JPRB-ZINT)
(  839)             ZRNEW=MAX(0.0_JPRB,MIN(PLRAIN(JL,JK),ZRNEW))
(  840)             PLRAIN(JL,JK)=ZRNEW
(  841)           ENDIF
(  842)         ENDIF
(  843)       ENDDO
(  844) 
(  845)     ENDIF
(  846) 
(  847)     DO JL=KIDIA,KFDIA 
(  848)       !JL=JLX(JLL)
(  849)       IF (LLFLAG(JL)) THEN
(  850)         PMFUL(JL,JK)=PLU(JL,JK)*PMFU(JL,JK)
(  851)         PMFUS(JL,JK)=(RCPD*PTU(JL,JK)+PGEOH(JL,JK))*PMFU(JL,JK)
(  852)         PMFUQ(JL,JK)=PQU(JL,JK)*PMFU(JL,JK)
(  853)         ZALFAW=FOEALFCU(PTU(JL,JK))
(  854)         IF(LSCVFLAG(JL)) ZALFAW=1.0_JPRB
(  855)         PLUDELI(JL,JK,1)=ZALFAW*PLUDE(JL,JK)
(  856)         PLUDELI(JL,JK,2)=(1.0_JPRB-ZALFAW)*PLUDE(JL,JK)
(  857)       ENDIF
(  858)     ENDDO
(  859) 
(  860)   ENDIF
(  861) ENDDO
(  862) 






