(  497)           IF(JK < KCBOT(JL)) THEN
(  498)             ZMFMAX=(PAPH(JL,JK)-PAPH(JL,JK-1))*ZCONS2
(  499)             ZXS=MAX(PMFU(JL,JK+1)-ZMFMAX,0.0_JPRB)
