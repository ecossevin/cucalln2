(    9) # 10 "./fcttre.func.h"
(   10) !*
(   11) !     ------------------------------------------------------------------
(   12) # 13 "./fcttre.func.h"
(   13) !     This COMDECK includes the Thermodynamical functions for the cy39
(   14) !       ECMWF Physics package.
(   15) !       Consistent with YOMCST Basic physics constants, assuming the
(   16) !       partial pressure of water vapour is given by a first order
(   17) !       Taylor expansion of Qs(T) w.r.t. to Temperature, using constants
(   18) !       in YOETHF
(   19) !       Two sets of functions are available. In the first set only the
(   20) !       cases water or ice are distinguished by temperature.  This set 
(   21) !       consists of the functions FOEDELTA,FOEEW,FOEDE and FOELH.
(   22) !       The second set considers, besides the two cases water and ice 
(   23) !       also a mix of both for the temperature range YDTHF%RTICE < T < YDTHF%RTWAT.
(   24) !       This set contains FOEALFA,FOEEWM,FOEDEM,FOELDCPM and FOELHM.
(   25) !       FKOOP modifies the ice saturation mixing ratio for homogeneous 
(   26) !       nucleation. FOE_DEWM_DT provides an approximate first derivative
(   27) !       of FOEEWM.
(   28) # 29 "./fcttre.func.h"
(   29) !       Depending on the consideration of mixed phases either the first 
(   30) !       set (e.g. surface, post-processing) or the second set 
(   31) !       (e.g. clouds, condensation, convection) should be used.
(   32) # 33 "./fcttre.func.h"
(   33) !     ------------------------------------------------------------------






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 24

(   34) !     *****************************************************************
(   35) # 36 "./fcttre.func.h"
(   36) !                NO CONSIDERATION OF MIXED PHASES
(   37) # 38 "./fcttre.func.h"
(   38) !     *****************************************************************
(   39) REAL(KIND=JPRB) :: FOEDELTA
(   40) REAL(KIND=JPRB) :: PTARE
(   41) FOEDELTA (PTARE) = MAX (0.0_JPRB,SIGN(1.0_JPRB,PTARE-YDCST%RTT))
(   42) # 43 "./fcttre.func.h"
(   43) !                  FOEDELTA = 1    water
(   44) !                  FOEDELTA = 0    ice
(   45) # 46 "./fcttre.func.h"
(   46) !     THERMODYNAMICAL FUNCTIONS .
(   47) # 48 "./fcttre.func.h"
(   48) !     Pressure of water vapour at saturation
(   49) !        INPUT : PTARE = TEMPERATURE
(   50) REAL(KIND=JPRB) :: FOEEW,FOEDE,FOEDESU,FOELH,FOELDCP
(   51) FOEEW ( PTARE ) = YDTHF%R2ES*EXP (&
(   52)   &(YDTHF%R3LES*FOEDELTA(PTARE)+YDTHF%R3IES*(1.0_JPRB-FOEDELTA(PTARE)))*(PTARE-YDCST%RTT)&
(   53) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE)))))
(   54) # 55 "./fcttre.func.h"
(   55) FOEDE ( PTARE ) = &
(   56)   &(FOEDELTA(PTARE)*YDTHF%R5ALVCP+(1.0_JPRB-FOEDELTA(PTARE))*YDTHF%R5ALSCP)&
(   57) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE))))**2
(   58) # 59 "./fcttre.func.h"
(   59) FOEDESU ( PTARE ) = &
(   60)   &(FOEDELTA(PTARE)*YDTHF%R5LES+(1.0_JPRB-FOEDELTA(PTARE))*YDTHF%R5IES)&
(   61) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE))))**2
(   62) # 63 "./fcttre.func.h"
(   63) FOELH ( PTARE ) =&
(   64)          &FOEDELTA(PTARE)*YDCST%RLVTT + (1.0_JPRB-FOEDELTA(PTARE))*YDCST%RLSTT
(   65) # 66 "./fcttre.func.h"
(   66) FOELDCP ( PTARE ) = &
(   67)          &FOEDELTA(PTARE)*YDTHF%RALVDCP + (1.0_JPRB-FOEDELTA(PTARE))*YDTHF%RALSDCP
(   68) # 69 "./fcttre.func.h"
(   69) !     *****************************************************************
(   70) # 71 "./fcttre.func.h"
(   71) !           CONSIDERATION OF MIXED PHASES
(   72) # 73 "./fcttre.func.h"
(   73) !     *****************************************************************
(   74) # 75 "./fcttre.func.h"
(   75) !     FOEALFA is calculated to distinguish the three cases:
(   76) # 77 "./fcttre.func.h"
(   77) !                       FOEALFA=1            water phase
(   78) !                       FOEALFA=0            ice phase
(   79) !                       0 < FOEALFA < 1      mixed phase
(   80) # 81 "./fcttre.func.h"
(   81) !               INPUT : PTARE = TEMPERATURE
(   82) REAL(KIND=JPRB) :: FOEALFA
(   83) FOEALFA (PTARE) = MIN(1.0_JPRB,((MAX(YDTHF%RTICE,MIN(YDTHF%RTWAT,PTARE))-YDTHF%RTICE)&
(   84)  &*YDTHF%RTWAT_RTICE_R)**2) 
(   85) # 87 "./fcttre.func.h"
(   87) !     Pressure of water vapour at saturation
(   88) !        INPUT : PTARE = TEMPERATURE
(   89) REAL(KIND=JPRB) :: FOEEWM,FOEDEM,FOELDCPM,FOELHM,FOE_DEWM_DT
(   90) FOEEWM ( PTARE ) = YDTHF%R2ES *&
(   91)      &(FOEALFA(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))+&
(   92)   &(1.0_JPRB-FOEALFA(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)))






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 25

(   93) # 94 "./fcttre.func.h"
(   94) FOE_DEWM_DT( PTARE ) = YDTHF%R2ES * ( &
(   95)      & YDTHF%R3LES*FOEALFA(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES)) &
(   96)      &    *(YDCST%RTT-YDTHF%R4LES)/(PTARE-YDTHF%R4LES)**2 + &
(   97)      & YDTHF%R3IES*(1.0-FOEALFA(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)) &
(   98)      &    *(YDCST%RTT-YDTHF%R4IES)/(PTARE-YDTHF%R4IES)**2)
(   99) # 100 "./fcttre.func.h"
(  100) FOEDEM ( PTARE ) = FOEALFA(PTARE)*YDTHF%R5ALVCP*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  101)              &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%R5ALSCP*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  102) # 103 "./fcttre.func.h"
(  103) FOELDCPM ( PTARE ) = FOEALFA(PTARE)*YDTHF%RALVDCP+&
(  104)             &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%RALSDCP
(  105) # 106 "./fcttre.func.h"
(  106) FOELHM ( PTARE ) =&
(  107)          &FOEALFA(PTARE)*YDCST%RLVTT+(1.0_JPRB-FOEALFA(PTARE))*YDCST%RLSTT
(  108) # 110 "./fcttre.func.h"
(  110) !     Temperature normalization for humidity background change of variable
(  111) !        INPUT : PTARE = TEMPERATURE
(  112) REAL(KIND=JPRB) :: FOETB
(  113) FOETB ( PTARE )=FOEALFA(PTARE)*YDTHF%R3LES*(YDCST%RTT-YDTHF%R4LES)*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  114)              &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%R3IES*(YDCST%RTT-YDTHF%R4IES)*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  115) # 116 "./fcttre.func.h"
(  116) !     ------------------------------------------------------------------
(  117) !     *****************************************************************
(  118) # 119 "./fcttre.func.h"
(  119) !           CONSIDERATION OF DIFFERENT MIXED PHASE FOR CONV
(  120) # 121 "./fcttre.func.h"
(  121) !     *****************************************************************
(  122) # 123 "./fcttre.func.h"
(  123) !     FOEALFCU is calculated to distinguish the three cases:
(  124) # 125 "./fcttre.func.h"
(  125) !                       FOEALFCU=1            water phase
(  126) !                       FOEALFCU=0            ice phase
(  127) !                       0 < FOEALFCU < 1      mixed phase
(  128) # 129 "./fcttre.func.h"
(  129) !               INPUT : PTARE = TEMPERATURE
(  130) REAL(KIND=JPRB) :: FOEALFCU 
(  131) FOEALFCU (PTARE) = MIN(1.0_JPRB,((MAX(YDTHF%RTICECU,MIN(YDTHF%RTWAT,PTARE))&
(  132) &-YDTHF%RTICECU)*YDTHF%RTWAT_RTICECU_R)**2) 
(  133) # 135 "./fcttre.func.h"
(  135) !     Pressure of water vapour at saturation
(  136) !        INPUT : PTARE = TEMPERATURE
(  137) REAL(KIND=JPRB) :: FOEEWMCU,FOEDEMCU,FOELDCPMCU,FOELHMCU
(  138) FOEEWMCU ( PTARE ) = YDTHF%R2ES *&
(  139)      &(FOEALFCU(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))+&
(  140)   &(1.0_JPRB-FOEALFCU(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)))
(  141) # 142 "./fcttre.func.h"
(  142) FOEDEMCU ( PTARE )=FOEALFCU(PTARE)*YDTHF%R5ALVCP*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  143)              &(1.0_JPRB-FOEALFCU(PTARE))*YDTHF%R5ALSCP*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  144) # 145 "./fcttre.func.h"
(  145) FOELDCPMCU ( PTARE ) = FOEALFCU(PTARE)*YDTHF%RALVDCP+&
(  146)             &(1.0_JPRB-FOEALFCU(PTARE))*YDTHF%RALSDCP
(  147) # 148 "./fcttre.func.h"
(  148) FOELHMCU ( PTARE ) =&
(  149)          &FOEALFCU(PTARE)*YDCST%RLVTT+(1.0_JPRB-FOEALFCU(PTARE))*YDCST%RLSTT
(  150) !     ------------------------------------------------------------------
(  151) # 152 "./fcttre.func.h"
(  152) !     Pressure of water vapour at saturation






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 26

(  153) !     This one is for the WMO definition of saturation, i.e. always
(  154) !     with respect to water.
(  155) !     
(  156) !     Duplicate to FOEELIQ and FOEEICE for separate ice variable
(  157) !     FOEELIQ always respect to water 
(  158) !     FOEEICE always respect to ice 
(  159) !     FOEELIQ2ICE is the ratio of vapour pressures over water and ice 
(  160) !       (analytically simplified to avoid a suspected Cray compiler bug and using a single call to exp)
(  161) !     (could use FOEEW and FOEEWMO, but naming convention unclear)
(  162) !     FOELSON returns e wrt liquid water using D Sonntag (1994, Met. Zeit.)
(  163) !      - now recommended for use with radiosonde data (WMO CIMO guide, 2014)
(  164) !      unlike the FOEE functions does not include 1/(YDCST%RETV+1.0_JPRB) factor
(  165) # 166 "./fcttre.func.h"
(  166) REAL(KIND=JPRB) :: FOEEWMO, FOEELIQ, FOEEICE, FOEELIQ2ICE, FOELSON 
(  167) FOEEWMO( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))
(  168) FOEELIQ( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))
(  169) FOEEICE( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES))
(  170) FOEELIQ2ICE( PTARE )  = EXP(      (PTARE-YDCST%RTT)*(YDTHF%R3LES/(PTARE-YDTHF%R4LES) - YDTHF%R3IES/(PTARE-YDTHF%R4IES)))
(  171) FOELSON( PTARE ) = EXP( -6096.9385_JPRB/PTARE + 21.2409642_JPRB &
(  172) 	             - 2.711193E-2_JPRB * PTARE    &
(  173)                      + 1.673952E-5_JPRB * PTARE**2 &
(  174) 		     + 2.433502_JPRB * LOG(PTARE))
(  175) # 176 "./fcttre.func.h"
(  176) REAL(KIND=JPRB) :: FOEEWM_V,FOEEWMCU_V,FOELES_V,FOEIES_V
(  177) REAL(KIND=JPRB) :: EXP1,EXP2
(  178)       FOELES_V(PTARE)=YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES)
(  179)       FOEIES_V(PTARE)=YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)
(  180)       FOEEWM_V( PTARE,EXP1,EXP2 )=YDTHF%R2ES*(FOEALFA(PTARE)*EXP1+ &
(  181)           & (1.0_JPRB-FOEALFA(PTARE))*EXP2)
(  182)       FOEEWMCU_V ( PTARE,EXP1,EXP2 ) = YDTHF%R2ES*(FOEALFCU(PTARE)*EXP1+&
(  183)           &(1.0_JPRB-FOEALFCU(PTARE))*EXP2)
(  184) # 258 "./cuascn.F90"
(  258) # 258 "./cuascn.F90"
(  258) !----------------------------------------------------------------------
(  259) # 260 "./cuascn.F90"
(  260) !*    1.           SPECIFY PARAMETERS
(  261) !                  ------------------
(  262) # 263 "./cuascn.F90"
(  263) IF (LHOOK) CALL DR_HOOK('CUASCN',0,ZHOOK_HANDLE)
(  264) ASSOCIATE(NACTAERO=>YGFL%NACTAERO, &
(  265)  & LAERLIQAUTOCP=>YDECLDP%LAERLIQAUTOCP, LAERLIQAUTOCPB=>YDECLDP%LAERLIQAUTOCPB, &
(  266)  & RLMIN=>YDECLDP%RLMIN, RCPD=>YDCST%RCPD, RETV=>YDCST%RETV, RG=>YDCST%RG, RTT=>YDCST%RTT, &
(  267)  & RALFDCP=>YDTHF%RALFDCP, RTBERCU=>YDTHF%RTBERCU, RTICECU=>YDTHF%RTICECU, &
(  268)  & ENTRORG=>YDECUMF%ENTRORG, ENTR_RH=>YDECUMF%ENTR_RH, ENTSHALP=>YDECUMF%ENTSHALP, RMFCFL=>YDECUMF%RMFCFL, &
(  269)  & RMFCMIN=>YDECUMF%RMFCMIN, RPRCON=>YDECUMF%RPRCON, LMFGLAC=>YDECUMF%LMFGLAC, &
(  270)  & LSCVLIQ=>YDECUMF%LSCVLIQ, LPHYLIN=>YDEPHLI%LPHYLIN, RLPTRC=>YDEPHLI%RLPTRC)
(  271) # 272 "./cuascn.F90"
(  272) ZCONS2=RMFCFL/(RG*PTSPHY)
(  273) ZRG=1.0_JPRB/RG
(  274) ZORCPD=1.0_JPRB/RCPD
(  275) ZFACBUO=0.5_JPRB/(1.0_JPRB+0.5_JPRB)
(  276) ZPRCDGW=RPRCON/RG
(  277) ZDNOPRC=3.E-4_JPRB !condensate threshold for precip
(  278) Z_CLDMAX=5.E-3_JPRB
(  279) Z_CWIFRAC=0.5_JPRB
(  280) Z_CPRC2=0.5_JPRB
(  281) Z_CWDRAG=(3._JPRB/8._JPRB)*0.506_JPRB/0.2_JPRB
(  282) # 283 "./cuascn.F90"






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 27

(  283) IF(LMFGLAC) THEN
(  284)   ZGLAC=1.0_JPRB
(  285) ELSE
(  286)   ZGLAC=0.0_JPRB
(  287) ENDIF
(  288) # 289 "./cuascn.F90"
(  289) !----------------------------------------------------------------------
(  290) # 291 "./cuascn.F90"
(  291) !     2.           SET DEFAULT VALUES
(  292) !                  ------------------
(  293) # 294 "./cuascn.F90"
(  294) LLO3=.FALSE.
(  295) DO JL=KIDIA,KFDIA
(  296)   ZLUOLD(JL)=0.0_JPRB
(  297)   IF(.NOT.LDCUM(JL)) THEN
(  298)     KCBOT(JL)=-1
(  299)     PMFUB(JL)=0.0_JPRB
(  300)     PQU(JL,KLEV)=0.0_JPRB
(  301)     KTYPE(JL)=0
(  302)   ENDIF
(  303)   PWMEAN(JL)=0.0_JPRB
(  304)   ZDPMEAN(JL)=0.0_JPRB
(  305)   ZOENTR(JL)=0.0_JPRB
(  306)   LSCVFLAG(JL)=.FALSE.
(  307)   IF(KTYPE(JL)>1.AND.LSCVLIQ) LSCVFLAG(JL)=.TRUE.
(  308) ENDDO
(  309) # 310 "./cuascn.F90"
(  310) !  Prepare SPP
(  311) IF (YDSPP_CONFIG%LSPP) THEN
(  312)   
(  313)   IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  314)   LLPERT_ENTRORG=IPN > 0
(  315)   IF (LLPERT_ENTRORG) THEN
(  316)     PN1ENTRORG = YDSPP_CONFIG%SM%PN(IPN)
(  317)     IPENTRORG  = PN1ENTRORG%MP
(  318)   ENDIF
(  319) # 320 "./cuascn.F90"
(  320)   IPN = YDSPP_CONFIG%PPTR%ENTSHALP
(  321)   LLPERT_ENTSHALP= IPN > 0
(  322)   IF (LLPERT_ENTSHALP) THEN
(  323)     PN1ENTSHALP = YDSPP_CONFIG%SM%PN(IPN)
(  324)     IPENTSHALP  = PN1ENTSHALP%MP
(  325)   ENDIF
(  326) # 327 "./cuascn.F90"
(  327)   IPN = YDSPP_CONFIG%PPTR%RPRCON
(  328)   LLPERT_RPRCON= IPN > 0
(  329)   IF (LLPERT_RPRCON) THEN
(  330)     PN1RPRCON = YDSPP_CONFIG%SM%PN(IPN)
(  331)     IPRPRCON  = PN1RPRCON%MP
(  332)   ENDIF
(  333) # 334 "./cuascn.F90"
(  334) ELSE
(  335)   LLPERT_ENTRORG  =.FALSE.
(  336)   LLPERT_ENTSHALP =.FALSE.
(  337)   LLPERT_RPRCON   =.FALSE.
(  338) ENDIF
(  339) # 341 "./cuascn.F90"
(  341) ! initalize various quantities






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 28

(  342) ! note that liquid water and kinetic energy at cloud base is 
(  343) ! preserved from cubase
(  344) # 345 "./cuascn.F90"
(  345) DO JL=KIDIA,KFDIA
(  346)   LLKLAB(JL)=.FALSE.
(  347)   IF(.NOT.LDCUM(JL).OR.KTYPE(JL) == 3) LLKLAB(JL)=.TRUE.
(  348) ENDDO
(  349) # 350 "./cuascn.F90"
(  350) DO JK=1,KLEV
(  351)   DO JL=KIDIA,KFDIA
(  352)     IF (JK /= KCBOT(JL)) THEN 
(  353)       PLU(JL,JK)=0.0_JPRB
(  354)     ENDIF
(  355)     PKINEU(JL,JK)=0.0_JPRB
(  356)   ENDDO
(  357)   DO JL=KIDIA,KFDIA
(  358)     PMFU(JL,JK)=0.0_JPRB
(  359)     PMFUS(JL,JK)=0.0_JPRB
(  360)     PMFUQ(JL,JK)=0.0_JPRB
(  361)     PMFUL(JL,JK)=0.0_JPRB
(  362)     PWU(JL,JK)=0.0_JPRB
(  363)   ENDDO
(  364)   DO JL=KIDIA,KFDIA
(  365)     PLUDE(JL,JK)=0.0_JPRB
(  366)     PLUDELI(JL,JK,1)=0.0_JPRB
(  367)     PLUDELI(JL,JK,2)=0.0_JPRB
(  368)     PLGLAC(JL,JK)=0.0_JPRB
(  369)     PDMFUP(JL,JK)=0.0_JPRB
(  370)     PLRAIN(JL,JK)=0.0_JPRB
(  371)   ENDDO
(  372)   DO JL=KIDIA,KFDIA
(  373)     ZBUO(JL,JK)=0.0_JPRB
(  374)     IF( LLKLAB(JL) ) KLAB(JL,JK)=0
(  375)     IF(.NOT.LDCUM(JL).AND.PAPH(JL,JK) < 4.E4_JPRB) KCTOP0(JL)=JK
(  376)     PDMFEN(JL,JK)=0.0_JPRB
(  377)     PMFUDE_RATE(JL,JK)=0.0_JPRB
(  378)   ENDDO
(  379) ENDDO
(  380) !DIR$ IVDEP
(  381) !NEC$ IVDEP
(  382) !OCL NOVREC
(  383) DO JL=KIDIA,KFDIA
(  384)   IF(KTYPE(JL) == 3) LDCUM(JL)=.FALSE.
(  385) ENDDO
(  386) # 387 "./cuascn.F90"
(  387) !----------------------------------------------------------------------
(  388) # 389 "./cuascn.F90"
(  389) !     3.0          INITIALIZE VALUES AT cloud base LEVEL
(  390) !                  -------------------------------------
(  391) # 392 "./cuascn.F90"
(  392) DO JL=KIDIA,KFDIA
(  393)   KCTOP(JL)=KCBOT(JL)
(  394)   IF(LDCUM(JL)) THEN
(  395)     IKB=KCBOT(JL)
(  396)     PKINEU(JL,IKB)=0.5*PWUBASE(JL)**2
(  397)     PMFU(JL,IKB)=PMFUB(JL)
(  398)     PMFUS(JL,IKB)=PMFUB(JL)*(RCPD*PTU(JL,IKB)+PGEOH(JL,IKB))
(  399)     PMFUQ(JL,IKB)=PMFUB(JL)*PQU(JL,IKB)






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 29

(  400)     PMFUL(JL,IKB)=PMFUB(JL)*PLU(JL,IKB)
(  401)   ENDIF
(  402) ENDDO
(  403) # 404 "./cuascn.F90"
(  404) !----------------------------------------------------------------------
(  405) # 406 "./cuascn.F90"
(  406) !     4.           DO ASCENT: SUBCLOUD LAYER (KLAB=1) ,CLOUDS (KLAB=2)
(  407) !                  BY DOING FIRST DRY-ADIABATIC ASCENT AND THEN
(  408) !                  BY ADJUSTING T,Q AND L ACCORDINGLY IN *CUADJTQ*,
(  409) !                  THEN CHECK FOR BUOYANCY AND SET FLAGS ACCORDINGLY
(  410) !                  -------------------------------------------------
(  411) # 412 "./cuascn.F90"
(  412) DO JK=KLEV-1,3,-1
(  413) # 414 "./cuascn.F90"
(  414) !                  SPECIFY CLOUD BASE VALUES FOR MIDLEVEL CONVECTION
(  415) !                  IN *CUBASMC* IN CASE THERE IS NOT ALREADY CONVECTION
(  416) !                  ----------------------------------------------------
(  417) # 418 "./cuascn.F90"
(  418)   IK=JK
(  419)   !$loki inline
(  420)   CALL CUBASMCN &
(  421)    & (YDCST, YDECUMF, KIDIA,    KFDIA,    KLON,    KLEV,&
(  422)    & IK,&
(  423)    & PTEN,     PQEN,     PQSEN,&
(  424)    & PVERVEL,  PGEO,     PGEOH,    LDCUM,    KTYPE,    KLAB,&
(  425)    & KCBOT,    PMFU,     PMFUB,    PLRAIN,&
(  426)    & PTU,      PQU,      PLU,&
(  427)    & PMFUS,    PMFUQ,    PMFUL,    PDMFUP)  
(  428) # 429 "./cuascn.F90"
(  429)   IS=0
(  430)   JLM=0
(  431)   DO JL=KIDIA,KFDIA
(  432)  ! also liquid only for ktype=3
(  433)   ! IF(KTYPE(JL)>1.AND.LSCVLIQ) LSCVFLAG(JL)=.TRUE.
(  434)     LLFLAG(JL)=.FALSE.
(  435)     ZPRECIP(JL)=0.0_JPRB
(  436)     LLO1(JL)=.FALSE.
(  437)     IS=IS+KLAB(JL,JK+1)
(  438)     IF(KLAB(JL,JK+1) == 0) KLAB(JL,JK)=0
(  439)     IF((LDCUM(JL).AND.KLAB(JL,JK+1) == 2).OR.&
(  440)        & (KTYPE(JL) == 3 .AND. KLAB(JL,JK+1) == 1)) THEN  
(  441)       LLFLAG(JL)=.TRUE.
(  442)       JLM=JLM+1
(  443)       JLX(JLM)=JL
(  444)     ENDIF
(  445)     IF(KLAB(JL,JK+1) > 0) THEN
(  446)       LLFLAGUV(JL)=.TRUE.
(  447)     ELSE
(  448)       LLFLAGUV(JL)=.FALSE.
(  449)     ENDIF
(  450)     ZPH(JL)=PAPH(JL,JK)
(  451)     IF(KTYPE(JL) == 3.AND.JK == KCBOT(JL)) THEN
(  452)       ZMFMAX=(PAPH(JL,JK)-PAPH(JL,JK-1))*ZCONS2
(  453)       IF(PMFUB(JL) > ZMFMAX) THEN
(  454)         ZFAC=ZMFMAX/PMFUB(JL)
(  455)         PMFU(JL,JK+1)=PMFU(JL,JK+1)*ZFAC
(  456)         PMFUS(JL,JK+1)=PMFUS(JL,JK+1)*ZFAC
(  457)         PMFUQ(JL,JK+1)=PMFUQ(JL,JK+1)*ZFAC






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 30

(  458)         PMFUB(JL)=ZMFMAX
(  459)       ENDIF
(  460)     ENDIF
(  461)   ENDDO
(  462) # 463 "./cuascn.F90"
(  463)   IF(IS > 0) LLO3=.TRUE.
(  464) # 465 "./cuascn.F90"
(  465) !*                  SPECIFY ENTRAINMENT RATES IN *CUENTR*
(  466) !                   -------------------------------------
(  467) # 468 "./cuascn.F90"
(  468)   IK=JK
(  469)   !$loki inline
(  470)   CALL CUENTR &
(  471)    & (YDCST, YDECUMF, YDSPP_CONFIG, KIDIA,    KFDIA,    KLON,     KLEV, &
(  472)    & IK,       KCBOT,         KTYPE,&
(  473)    & LDCUM,    LLO3,&
(  474)    & PQSEN,    PAPH,          PGEOH,&
(  475)    & PMFU,     PGP2DSPP,      ZDMFEN,   ZDMFDE )  
(  476) # 477 "./cuascn.F90"
(  477) !                  DO ADIABATIC ASCENT FOR ENTRAINING/DETRAINING PLUME
(  478) !                  ---------------------------------------------------
(  479) # 480 "./cuascn.F90"
(  480)   IF(LLO3) THEN
(  481) # 482 "./cuascn.F90"
(  482)     DO JL=KIDIA,KFDIA
(  483)       ZQOLD(JL)=0.0_JPRB
(  484)     ENDDO
(  485)     DO JL=KIDIA,KFDIA  
(  486)         !JL=JLX(JLL)
(  487)         IF (LLFLAG(JL)) THEN
(  488)           ZDMFDE(JL)=MIN(ZDMFDE(JL),0.75_JPRB*PMFU(JL,JK+1))
(  489)           IF(JK==KCBOT(JL)) THEN
(  490)             IF (YDSPP_CONFIG%LSPP .AND. LLPERT_ENTRORG) THEN
(  491)               ZXENTRORG=ENTRORG*EXP(PN1ENTRORG%MU(1)+PN1ENTRORG%XMAG(1)*PGP2DSPP(JL, IPENTRORG))
(  492)             ELSE
(  493)               ZXENTRORG=ENTRORG
(  494)             ENDIF
(  495)             ZOENTR(JL)=-ZXENTRORG*(MIN(1.0_JPRB,PQEN(JL,JK)/PQSEN(JL,JK))-ENTR_RH)*&
(  496)             &(PGEOH(JL,JK)-PGEOH(JL,JK+1))*ZRG
(  497)             ZOENTR(JL)=MIN(0.4_JPRB,ZOENTR(JL))*PMFU(JL,JK+1)
(  498)           ENDIF
(  499)           IF(JK < KCBOT(JL)) THEN
(  500)             ZMFMAX=(PAPH(JL,JK)-PAPH(JL,JK-1))*ZCONS2
(  501)             ZXS=MAX(PMFU(JL,JK+1)-ZMFMAX,0.0_JPRB)
(  502)             PWMEAN(JL)=PWMEAN(JL)+PKINEU(JL,JK+1)*(PAP(JL,JK+1)-PAP(JL,JK))
(  503)             ZDPMEAN(JL)=ZDPMEAN(JL)+PAP(JL,JK+1)-PAP(JL,JK)
(  504)             ZDMFEN(JL)=ZOENTR(JL)
(  505)             IF(KTYPE(JL)>=2)THEN
(  506)               IF (YDSPP_CONFIG%LSPP .AND. LLPERT_ENTSHALP) THEN
(  507)                 ZXENTSHALP=ENTSHALP*EXP(PN1ENTSHALP%MU(1)+PN1ENTSHALP%XMAG(1)*PGP2DSPP(JL, IPENTSHALP))
(  508)               ELSE
(  509)                 ZXENTSHALP=ENTSHALP
(  510)               ENDIF
(  511)                ZDMFEN(JL)=ZXENTSHALP*ZDMFEN(JL)
(  512)                ZDMFDE(JL)=ZDMFEN(JL)
(  513)              ! ZDMFDE(JL)=MAX(ZDMFDE(JL),ZDMFEN(JL))
(  514)             ENDIF
(  515)             ZDMFDE(JL)=ZDMFDE(JL)*(1.6_JPRB-MIN(1.0_JPRB,PQEN(JL,JK)/PQSEN(JL,JK)))






NVFORTRAN (Version     24.5)          03/24/2025  12:36:06      page 31

(  516)             ZMFTEST=PMFU(JL,JK+1)+ZDMFEN(JL)-ZDMFDE(JL)
(  517)             ZCHANGE=MAX(ZMFTEST-ZMFMAX,0.0_JPRB)
(  518)             ZXE=MAX(ZCHANGE-ZXS,0.0_JPRB)
(  519)             ZDMFEN(JL)=ZDMFEN(JL)-ZXE
(  520)             ZCHANGE=ZCHANGE-ZXE
(  521)             ZDMFDE(JL)=ZDMFDE(JL)+ZCHANGE
(  522)           ENDIF
(  523) # 524 "./cuascn.F90"
(  524)           PDMFEN(JL,JK) = ZDMFEN(JL)-ZDMFDE(JL)
(  525) # 526 "./cuascn.F90"
(  526)           PMFU(JL,JK)=PMFU(JL,JK+1)+ZDMFEN(JL)-ZDMFDE(JL)
(  527)           ZQEEN=PQENH(JL,JK+1)*ZDMFEN(JL)
(  528)           ZSEEN=(RCPD*PTENH(JL,JK+1)+PGEOH(JL,JK+1))*ZDMFEN(JL)
(  529)           IF(PLITOT(JL,JK) > RLMIN) THEN
(  530)             ZLEEN=PLITOT(JL,JK)*ZDMFEN(JL)
(  531)           ELSE
(  532)             ZLEEN=0.0_JPRB
(  533)           ENDIF
(  534)           ZSCDE=(RCPD*PTU(JL,JK+1)+PGEOH(JL,JK+1))*ZDMFDE(JL)
(  535)           ZQUDE=PQU(JL,JK+1)*ZDMFDE(JL)
(  536)           PLUDE(JL,JK)=PLU(JL,JK+1)*ZDMFDE(JL)
(  537)           ZMFUSK=PMFUS(JL,JK+1)+ZSEEN-ZSCDE
(  538)           ZMFUQK=PMFUQ(JL,JK+1)+ZQEEN-ZQUDE
(  539)           ZMFULK=PMFUL(JL,JK+1)+ZLEEN-PLUDE(JL,JK)
(  540)           ZFAC=1.0_JPRB/MAX(RMFCMIN,PMFU(JL,JK))
(  541)           PLU(JL,JK)=ZMFULK*ZFAC
(  542)           PQU(JL,JK)=ZMFUQK*ZFAC
(  543)           PTU(JL,JK)=(ZMFUSK*ZFAC-PGEOH(JL,JK))*ZORCPD
