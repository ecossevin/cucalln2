(  583)         IF (LLFLAG(JL)) THEN
(  584)           IF(PQU(JL,JK) /= ZQOLD(JL)) THEN
(  585)             ZOEALFA   = MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(PTU(JL,JK  )-RLPTRC))+1.0_JPRB))
(  586)             ZOEALFAP  = MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(PTU(JL,JK+1)-RLPTRC))+1.0_JPRB))
