(  652)             IF(ZBUO(JL,JK) < -0.1_JPRB) THEN
(  653)               PTENH(JL,JK)=0.5_JPRB*(PTEN(JL,JK)+PTEN(JL,JK-1))
(  654)               PQENH(JL,JK)=0.5_JPRB*(PQEN(JL,JK)+PQEN(JL,JK-1))
