(    1) SUBROUTINE CUADJTQS &
(    2)  &(YDTHF, YDCST, KIDIA,    KFDIA,    KLON,    KLEV,&
(    3)  & KK,&
(    4)  & PSP,      PT,       PQ,       LDFLAG,   KCALL)  
(    5) 
(    6) !**   *CUADJTQS* - SIMPLIFIED VERSION OF MOIST ADJUSTMENT
(    7) 
(    8) !     PURPOSE.
(    9) !     --------
(   10) !     TO PRODUCE T,Q AND L VALUES FOR CLOUD ASCENT
(   11) 
(   12) !     INTERFACE
(   13) !     ---------
(   14) !     THIS ROUTINE IS CALLED FROM SUBROUTINES:
(   15) 
(   16) !       *COND*       
(   17) !       *CUBMADJ*    
(   18) !       *CUBMD*      
(   19) !       *CONDAD*     
(   20) !       *CUBMADJAD*  
(   21) !       *CUBMDAD*    
(   22) 
(   23) !     INPUT ARE UNADJUSTED T AND Q VALUES,
(   24) !     IT RETURNS ADJUSTED VALUES OF T AND Q
(   25) 
(   26) !     PARAMETER     DESCRIPTION                                   UNITS
(   27) !     ---------     -----------                                   -----
(   28) !     INPUT PARAMETERS (INTEGER):
(   29) 
(   30) !    *KIDIA*        START POINT
(   31) !    *KFDIA*        END POINT
(   32) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   33) !    *KLEV*         NUMBER OF LEVELS
(   34) !    *KK*           LEVEL
(   35) !    *KCALL*        DEFINES CALCULATION AS
(   36) !                      KCALL=0  ENV. T AND QS IN*CUINI*
(   37) !                      KCALL=1  CONDENSATION IN UPDRAFTS  (E.G. CUBASE, CUASC)
(   38) !                      KCALL=2  EVAPORATION IN DOWNDRAFTS (E.G. CUDLFS,CUDDRAF)
(   39) 
(   40) !     INPUT PARAMETERS (LOGICAL):
(   41) 
(   42) !    *LDLAND*       LAND-SEA MASK (.TRUE. FOR LAND POINTS)
(   43) 
(   44) !     INPUT PARAMETERS (REAL):
(   45) 
(   46) !    *PSP*          PRESSURE                                        PA
(   47) 
(   48) !     UPDATED PARAMETERS (REAL):
(   49) 
(   50) !    *PT*           TEMPERATURE                                     K






NVFORTRAN (Version     24.5)          03/19/2025  06:56:00      page 2

(   51) !    *PQ*           SPECIFIC HUMIDITY                             KG/KG
(   52) 
(   53) !     AUTHOR.
(   54) !     -------
(   55) !      J.F. MAHFOUF      ECMWF         
(   56) 
(   57) !     MODIFICATIONS.
(   58) !     --------------
(   59) !      M.Hamrud     01-Oct-2003 CY28 Cleaning  
(   60) !      20180303 : Gabor: Just a comment line to force recompilation due to
(   61) !                        compiler wrapper optimation exception liat change
(   62) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   63) 
(   64) !----------------------------------------------------------------------
(   65) 
(   66) USE PARKIND1  ,ONLY : JPIM     ,JPRB
(   67) USE YOMHOOK   ,ONLY : LHOOK,   DR_HOOK, JPHOOK
(   68) 
(   69) USE YOMCST   , ONLY : TCST
(   70) USE YOETHF   , ONLY : TTHF  
(   71) 
(   72) IMPLICIT NONE
(   73) 
(   74) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(   75) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(   76) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(   77) TYPE(TCST)        ,INTENT(IN)    :: YDCST
(   78) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(   79) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(   80) INTEGER(KIND=JPIM),INTENT(IN)    :: KK 
(   81) REAL(KIND=JPRB)   ,INTENT(IN)    :: PSP(KLON) 
(   82) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PT(KLON,KLEV) 
(   83) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PQ(KLON,KLEV) 
(   84) LOGICAL           ,INTENT(IN)    :: LDFLAG(KLON) 
(   85) INTEGER(KIND=JPIM),INTENT(IN)    :: KCALL 
(   86) REAL(KIND=JPRB) ::     Z3ES(KLON),             Z4ES(KLON),&
(   87)  & Z5ALCP(KLON),           ZALDCP(KLON)  
(   88) 
(   89) INTEGER(KIND=JPIM) :: JL
(   90) 
(   91) REAL(KIND=JPRB) :: ZQMAX, ZQP, ZCOND, ZCOND1, ZTARG, ZCOR, ZQSAT, ZFOEEW, Z2S
(   92) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(   93) 
(   94) !DIR$ VFUNCTION EXPHF
(   95) #include "fcttre.func.h"
(   96) !----------------------------------------------------------------------
(   97) 
(   98) !     1.           DEFINE CONSTANTS
(   99) !                  ----------------
(  100) 
(  101) IF (LHOOK) CALL DR_HOOK('CUADJTQS',0,ZHOOK_HANDLE)
(  102) ASSOCIATE(RETV=>YDCST%RETV, RTT=>YDCST%RTT, &
(  103)  & R2ES=>YDTHF%R2ES, R3IES=>YDTHF%R3IES, R3LES=>YDTHF%R3LES, R4IES=>YDTHF%R4IES, &
(  104)  & R4LES=>YDTHF%R4LES, R5ALSCP=>YDTHF%R5ALSCP, R5ALVCP=>YDTHF%R5ALVCP, RALSDCP=>YDTHF%RALSDCP, &
(  105)  & RALVDCP=>YDTHF%RALVDCP)
(  106) 
(  107) ZQMAX=0.5_JPRB
(  108) 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:00      page 3

(  109) !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  110) !                  -----------------------------------------------------
(  111) 
(  112) !*    ICE-WATER THERMODYNAMICAL FUNCTIONS
(  113) 
(  114) DO JL=KIDIA,KFDIA
(  115)   IF (PT(JL,KK) > RTT) THEN
(  116)     Z3ES(JL)=R3LES
(  117)     Z4ES(JL)=R4LES
(  118)     Z5ALCP(JL)=R5ALVCP
(  119)     ZALDCP(JL)=RALVDCP
(  120)   ELSE
(  121)     Z3ES(JL)=R3IES
(  122)     Z4ES(JL)=R4IES
(  123)     Z5ALCP(JL)=R5ALSCP
(  124)     ZALDCP(JL)=RALSDCP
(  125)   ENDIF
(  126) ENDDO
(  127) 
(  128) IF (KCALL == 1 ) THEN
(  129) 
(  130) !DIR$    IVDEP
(  131) !OCL NOVREC
(  132)   DO JL=KIDIA,KFDIA
(  133)     IF(LDFLAG(JL)) THEN
(  134)       ZQP    =1.0_JPRB/PSP(JL)
(  135)       ZTARG    =PT(JL,KK)
(  136)       ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  137)       ZQSAT    =ZQP    *ZFOEEW    
(  138)       IF (ZQSAT     > ZQMAX) THEN
(  139)         ZQSAT    =ZQMAX
(  140)       ENDIF
(  141)       ZCOR    =1.0_JPRB/(1.0_JPRB-RETV*ZQSAT    )
(  142)       ZQSAT    =ZQSAT    *ZCOR    
(  143)       Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  144)       ZCOND    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  145)       ZCOND    =MAX(ZCOND    ,0.0_JPRB)
(  146) !     IF(ZCOND /= _ZERO_) THEN
(  147)       PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND    
(  148)       PQ(JL,KK)=PQ(JL,KK)-ZCOND    
(  149)       ZTARG    =PT(JL,KK)
(  150)       ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  151)       ZQSAT    =ZQP    *ZFOEEW    
(  152)       IF (ZQSAT     > ZQMAX) THEN
(  153)         ZQSAT    =ZQMAX
(  154)       ENDIF
(  155)       ZCOR    =1.0_JPRB/(1.0_JPRB-RETV*ZQSAT    )
(  156)       ZQSAT    =ZQSAT    *ZCOR    
(  157)       Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  158)       ZCOND1    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  159)       IF(ZCOND ==  0.0_JPRB)ZCOND1=0.0_JPRB
(  160)       PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND1    
(  161)       PQ(JL,KK)=PQ(JL,KK)-ZCOND1    
(  162) !     ENDIF
(  163)     ENDIF
(  164)   ENDDO
(  165) 
(  166) ENDIF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:00      page 4

(  167) 
(  168) IF(KCALL == 2) THEN
(  169) 
(  170) !DIR$    IVDEP
(  171) !OCL NOVREC
(  172)   DO JL=KIDIA,KFDIA
(  173)     IF(LDFLAG(JL)) THEN
(  174)       ZQP    =1.0_JPRB/PSP(JL)
(  175)       ZTARG    =PT(JL,KK)
(  176)       ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  177)       ZQSAT    =ZQP    *ZFOEEW    
(  178)       IF (ZQSAT     > ZQMAX) THEN
(  179)         ZQSAT    =ZQMAX
(  180)       ENDIF
(  181)       ZCOR    =1.0_JPRB/(1.0_JPRB-RETV  *ZQSAT    )
(  182)       ZQSAT    =ZQSAT    *ZCOR    
(  183)       Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  184)       ZCOND    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  185)       ZCOND    =MIN(ZCOND    ,0.0_JPRB)
(  186) !     IF(ZCOND /= _ZERO_) THEN
(  187)       PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND    
(  188)       PQ(JL,KK)=PQ(JL,KK)-ZCOND    
(  189)       ZTARG    =PT(JL,KK)
(  190)       ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  191)       ZQSAT    =ZQP    *ZFOEEW    
(  192)       IF (ZQSAT     > ZQMAX) THEN
(  193)         ZQSAT    =ZQMAX
(  194)       ENDIF
(  195)       ZCOR    =1.0_JPRB/(1.0_JPRB-RETV  *ZQSAT    )
(  196)       ZQSAT    =ZQSAT    *ZCOR    
(  197)       Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  198)       ZCOND1    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  199)       IF(ZCOND ==  0.0_JPRB)ZCOND1=0.0_JPRB
(  200)       PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND1    
(  201)       PQ(JL,KK)=PQ(JL,KK)-ZCOND1    
(  202) !     ENDIF
(  203)     ENDIF
(  204)   ENDDO
(  205) 
(  206) ENDIF
(  207) 
(  208) IF(KCALL == 0) THEN
(  209) 
(  210) !DIR$    IVDEP
(  211) !OCL NOVREC
(  212)   DO JL=KIDIA,KFDIA
(  213)     ZQP    =1.0_JPRB/PSP(JL)
(  214)     ZTARG    =PT(JL,KK)
(  215)     ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  216)     ZQSAT    =ZQP    *ZFOEEW    
(  217)     IF (ZQSAT     > ZQMAX) THEN
(  218)       ZQSAT    =ZQMAX
(  219)     ENDIF
(  220)     ZCOR    =1.0_JPRB/(1.0_JPRB-RETV  *ZQSAT    )
(  221)     ZQSAT    =ZQSAT    *ZCOR    
(  222)     Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  223)     ZCOND1    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  224)     PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND1    






