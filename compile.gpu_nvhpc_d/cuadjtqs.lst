(  250)     ZQSAT    =ZQP    *ZFOEEW    
(  251)     IF (ZQSAT     > ZQMAX) THEN
(  252)       ZQSAT    =ZQMAX
(  253)     ENDIF
(  254)     ZCOR    =1.0_JPRB/(1.0_JPRB-RETV  *ZQSAT    )
(  255)     ZQSAT    =ZQSAT    *ZCOR    
(  256)     Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  257)     ZCOND    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  258)     PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND    
(  259)     PQ(JL,KK)=PQ(JL,KK)-ZCOND    
(  260)     ZTARG    =PT(JL,KK)
(  261)     ZFOEEW    =R2ES*EXP(Z3ES(JL)*(ZTARG    -RTT)/(ZTARG    -Z4ES(JL)))
(  262)     ZQSAT    =ZQP    *ZFOEEW    
(  263)     IF (ZQSAT     > ZQMAX) THEN
(  264)       ZQSAT    =ZQMAX
(  265)     ENDIF
(  266)     ZCOR    =1.0_JPRB/(1.0_JPRB-RETV  *ZQSAT    )
(  267)     ZQSAT    =ZQSAT    *ZCOR    
(  268)     Z2S    =Z5ALCP(JL)/(ZTARG    -Z4ES(JL))**2
(  269)     ZCOND1    =(PQ(JL,KK)-ZQSAT    )/(1.0_JPRB+ZQSAT    *ZCOR    *Z2S    )
(  270)     PT(JL,KK)=PT(JL,KK)+ZALDCP(JL)*ZCOND1    
(  271)     PQ(JL,KK)=PQ(JL,KK)-ZCOND1    
(  272)   ENDDO
(  273) # 274 "./cuadjtqs.F90"
(  274) ENDIF
(  275) # 276 "./cuadjtqs.F90"
(  276) END ASSOCIATE
(  277) IF (LHOOK) CALL DR_HOOK('CUADJTQS',1,ZHOOK_HANDLE)
(  278) END SUBROUTINE CUADJTQS
