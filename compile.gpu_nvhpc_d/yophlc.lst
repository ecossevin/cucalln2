(   51) ! ASEAZ0 : REAL    : CONSTANT Z0 OVER SEA (M)
(   52) ! NDIFLC : INTEGER : CONTROL DIFFERENT VERT DIFF SCHEMES
(   53) !                   - 1: CALL VDIFLCZ (DIRECT+TL+ADJ):
(   54) !                        X(T+1)-X(T-1)=K*X(T+1)
(   55) !                        K=CONSTANT
(   56) !                   - 2: CALL VDIFLCZ1 (DIRECT):
(   57) !                        X(T*)-X(T)=K(X(T))*(ALPHA*X(T*)+(1-ALPHA)*X(T))
(   58) !                        DX=X(T*)-X(T)
(   59) !                        X(T+1)=X(T-1)+2*DX
