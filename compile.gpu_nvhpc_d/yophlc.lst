(   39) ! LSPHLC : LOGICAL : SWITCH TO TURN ON THE SIMPLE PHYSICS SCHEME
(   40) ! LVDFLC : LOGICAL : TO TURN ON THE VERTICAL DIFFUSION ON U,V
(   41) ! LVDFDS : LOGICAL : TO TURN ON THE VERT DIFF ALSO ON THE DRY STATIC ENERGY
(   42) ! LSDRLC : LOGICAL : TO TURN ON THE SURFACE DRAG ON U,V
(   43) ! LSDRDS : LOGICAL : TO TURN ON THE SURFACE DRAG ALSO ON THE DRY STATIC ENERGY
(   44) ! LZMCON : LOGICAL : IF TRUE THE VERT DIFF COEFF K IS CONSTANT
(   45) ! LKEXP  : LOGICAL : EXPONENTIAL APPROXIMATION OF THE CONSTANT K
(   46) ! ALPHA  : REAL    : COEFFICIENT FOR THE IMPLICIT TIME STEP SCHEME
(   47) ! AH0    : REAL    : REFERENCE HEIGHT FOR CONSTANT VERT DIFF (M)
(   48) ! USTARL : REAL    : CONSTANT USTAR OVER LAND (M SEC-1)
(   49) ! USTARS : REAL    : CONSTANT USTAR OVER SEA (M SEC-1)
(   50) ! ALANDZ0: REAL    : CONSTANT Z0 OVER LAND (M)






