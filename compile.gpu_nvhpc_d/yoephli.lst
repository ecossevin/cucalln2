(   51) !*     *YOEPHLI* CONTAINS CONSTANTS NEEDED BY 
(   52) !     THE LINEARIZED PHYSICS
(   53) 
(   54) !     J.F. MAHFOUF        E.C.M.W.F.    23/06/96
(   55) 
(   56) !     NAME        TYPE     DESCRIPTION
(   57) !     ----        ----     -----------
(   58) 
(   59) !     *RLPTRC*    REAL     CRITICAL TEMPERATURE FOR MIXED PHASE PROPERTIES
(   60) !                          OF WATER 
(   61) !     *RLPAL1*    REAL     SMOOTHING COEFFICIENT
(   62) !     *RLPAL2*    REAL     SMOOTHING COEFFICIENT
(   63) !     *RLPBB*     REAL     CONSTANT FROM THE LOUIS ET AL. FORMULATION
(   64) !     *RLPCC*     REAL     CONSTANT FROM THE LOUIS ET AL. FORMULATION
(   65) !     *RLPDD*     REAL     CONSTANT FROM THE LOUIS ET AL. FORMULATION
(   66) !     *RLPMIXL*   REAL     PSEUDO DEPTH OF THE PLANETARY BOUNDARY LAYER
(   67) !     *RLPBETA*   REAL     REDUCTION FACTOR OF THE ASYMPTOTIC MIXING LENGTH
(   68) !     *RLPDRAG*   REAL     COEFFICIENT FOR THE ESTIMATION OF SURFACE DRAG
(   69) !     *RLPEVAP*   REAL     FRACTION OF POSSIBLE RAINFALL EVAPORATION
(   70) !     *RLPP00*    REAL     PRESSURE ABOVE WHICH RADIATION IS NOT APPLIED
(   71) !     *LTLEVOL*   LOGICAL  SWITCH FOR TL EVOLUTION OF PERTURBATION RUN
(   72) !     *LPHYLIN*   LOGICAL  TRUE WHEN LINEARIZED PHYSICS IS ACTIVATED 
(   73) !     *LENOPERT   LOGICAL  TRUE WHEN NO PERTURBATION IS REQUIRED
(   74) !                          FOR SURFACE ARRAYS
(   75) !     *LEPPCFLS   LOGICAL  TRUE WHEN POST-PROCESSING OF SURFACE FIELDS 
(   76) !                          REQUIRED
(   77) !     *LRAISANEN  LOGICAL  TRUE WHEN RAISANEN OVERLAP SCHEME IS
(   78) !                          ACTIVATED
(   79) !     *LOPPTWINS* LOGICAL  TRUE FOR RUNNING OPPOSITE TWINS (BOTH NL AND TL)
(   80) !     ------------------------------------------------------------------
(   81) 
(   82) END MODULE YOEPHLI
































