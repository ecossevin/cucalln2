(   37) SUBROUTINE SAVE_TSPP_CONFIG (KLUN, YD)
(   38) USE UTIL_SPP_MODEL_MOD
(   39) USE UTIL_SPP_PERT_POINTER_MOD
(   40) IMPLICIT NONE
(   41) INTEGER, INTENT (IN) :: KLUN
