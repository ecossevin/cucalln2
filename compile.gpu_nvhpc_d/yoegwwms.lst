(    1) MODULE YOEGWWMS
(    2) 
(    3) USE PARKIND1  ,ONLY : JPIM     ,JPRB
(    4) 
(    5) IMPLICIT NONE
(    6) 
(    7) SAVE  
(    8) 
(    9) ! YOEGWWMS --  parameters/switches for the Warner McIntyre GW parameterization
(   10) 
(   11) !-----------------------------------------------------------------
(   12) 
(   13) TYPE :: TEGWWMS
(   14) LOGICAL            :: LOZPR     !If .TRUE. then enhancement of mom. flux over tropics
(   15) LOGICAL            :: LGACALC   !If .TRUE. recalculate vertical coordinate stretch for equal ratio
(   16) LOGICAL            :: LGSATL    !If .TRUE. then spectrum is saturated up to m* at launch
(   17) LOGICAL            :: LGINDL    !If .TRUE. then saturation and launch spectrum is independent of launch location
(   18) INTEGER(KIND=JPIM) :: NLAUNCHL(3)!launch levels of gravity wave spectrum (Pa)
(   19) INTEGER(KIND=JPIM) :: NLAUNCHLEV!Number of independent launch heights to be treated
(   20) INTEGER(KIND=JPIM) :: NLAUNCH   !single launch level as used for simplified
(   21) INTEGER(KIND=JPIM) :: NSLOPE    !slope at small-m end of spectrum
(   22) INTEGER(KIND=JPIM) :: NGAUSS    !if LOZPR=TRUE and GGAUSS=2 then gaussian distribution of GFLUXLAUN based on GGAUSSA and GGA
(   23)                                 !if LOZPR=TRUE and GGAUSS=1 then FLUXLAUN=GCOEFF*PPRECIP
(   24) REAL(KIND=JPRB)    :: GFLUXLAUNL(3)!total launch momentum flux (Pa) in each azimuth for all launch evels
(   25) REAL(KIND=JPRB)    :: GFLUXLAUN !total launch momentum flux (Pa) in each azimuth at NLAUNCH
(   26) REAL(KIND=JPRB)    :: GMSTAR_L(3)!m* (expressed as length, see Scinocca 2003)
(   27) REAL(KIND=JPRB)    :: GCSTAR    !C* (see McLandress and Scinocca 2005)
(   28) REAL (KIND=JPRB)   :: GPTWO     !2*p where p is the exponent of omega for the expression of the launch energy density
(   29) REAL(KIND=JPRB)    :: GTPHYGWWMS!Time frequency (s) of call of scheme
(   30) 
(   31) REAL(KIND=JPRB)    :: GGAUSSA   !gaussian distribution half-width (used if GGAUSS=1)
(   32) REAL(KIND=JPRB)    :: GGAUSSB(3)!height of gaussian distribution (ie amplification factor)
(   33) REAL(KIND=JPRB)    :: GCOEFF    !if GGAUSS=1 then FLUXLAUN=GCOEFF*PPRECIP
(   34) !---------------------------------------------------------------------
(   35) CONTAINS
(   36) END TYPE TEGWWMS
(   37) 
(   38) !!TYPE(TEGWWMS), POINTER :: YREGWWMS => NULL()
(   39) !---------------------------------------------------------------------
(   40) 
(   41) END MODULE YOEGWWMS















