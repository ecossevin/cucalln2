(  304) subroutine map_indices_spp_nml( sm, ku_nam, ku_out, kidx_map )
(  305)   !
(  306)   !   need to map perturbations in nam_spp_modif to active perturbations in sm
(  307)   !
(  308)   type(spp_model), intent(inout) :: sm
(  309)   integer(kind=jpim), intent(in) :: ku_nam
(  310)   integer(kind=jpim), intent(in) :: ku_out
