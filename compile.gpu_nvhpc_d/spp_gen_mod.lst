(  101) subroutine update_mu_spp_pertn( pn )
(  102)   !
(  103)   !   if distribution is log-normal and ln1==T, compute mean mu(.) of Gaussian distribution that
(  104)   !     yields mean of log-normal distribution equal to one
(  105)   !
(  106)   type(spp_pert), intent(inout) :: pn
(  107) 
(  108)   integer(kind=jpim) :: jmag






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 3

(  109) 
(  110)   if (pn%ln1.and.(pn%idistr==1)) then
(  111)     do jmag=1, pn%nmag
(  112)       pn%mu( jmag ) = -0.5_jprb * ( pn%xmag( jmag ) * pn%sdev )**2
(  113)     enddo
(  114)   else
(  115)     pn%mu= 0._jprb
(  116)   endif
(  117) 
(  118) end subroutine update_mu_spp_pertn
(  119) 
(  120) subroutine implement_spp_pertn( sm, cdlabel, pxmag, xclipmin, xclipmax, ic, &
(  121)                               & kidistr, knseed_off, knrf, ln1, radgrid, cd_rf_pert_label, &
(  122)                               & xuniform_offset )
(  123)   !
(  124)   !   configures a new defined perturbation in spp_model sm component.
(  125)   !    The subroutine increments sm%ndef and stores the configuration of the perturbation in sm%pndef( sm%ndef )
(  126)   !
(  127)   type(spp_model),           intent(inout) :: sm
(  128)   character(len=*),          intent(in)    :: cdlabel
(  129)   real(kind=jprb), dimension(:)        , intent(in)    :: pxmag
(  130)   ! optional arguments
(  131)   integer(kind=jpim), optional        , intent(in)    :: kidistr
(  132)   integer(kind=jpim), dimension(:), optional        , intent(in)    :: knseed_off
(  133)   integer(kind=jpim), optional        , intent(in)    :: knrf
(  134)   integer(kind=jpim), optional        , intent(in)    :: ic
(  135)   logical,            optional        , intent(in)    :: ln1
(  136)   logical,            optional        , intent(in)    :: radgrid
(  137)   character(len=*),   optional        , intent(in)    :: cd_rf_pert_label
(  138)   real(kind=jprb),    optional        , intent(in)    :: xuniform_offset
(  139)   real(kind=jprb),    optional        , intent(in)    :: xclipmin
(  140)   real(kind=jprb),    optional        , intent(in)    :: xclipmax
(  141) 
(  142)   type(spp_pert) :: pn
(  143) 
(  144)   pn%label      = cdlabel    ! who I am
(  145)   pn%on         = .false.    ! default is off
(  146) 
(  147)   !
(  148)   !   inherit global settings for random field
(  149)   !
(  150)   pn%tau    = sm%tau
(  151)   pn%sdev   = sm%sdev
(  152)   pn%xlcor  = sm%xlcor
(  153) 
(  154)   pn%nmag = size(pxmag)
(  155)   if (pn%nmag > jp_mag) then
(  156)     call abor1('It is not possible to request more than jp_mag different magnitudes. Change jp_mag in spp_test_mod. ')
(  157)   endif
(  158)   pn%xmag(1:pn%nmag)= pxmag(:)
(  159) 
(  160)   if (present(ic)) then
(  161)    pn%ic = ic
(  162)   endif
(  163) 
(  164)   if (present(xclipmin)) then
(  165)    pn%xclipmin = xclipmin
(  166)   endif






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 4

(  167) 
(  168)   if (present(xclipmax)) then
(  169)    pn%xclipmax = xclipmax
(  170)   endif
(  171) 
(  172)   if (present(kidistr)) then
(  173)     pn%idistr = kidistr
(  174)   else
(  175)     pn%idistr = 1
(  176)   endif
(  177) 
(  178)   if (present(xuniform_offset)) then
(  179)     pn%xuniform_offset = xuniform_offset
(  180)   else
(  181)     pn%xuniform_offset = 0.5_jprb
(  182)   endif
(  183) 
(  184)   if (present(ln1)) then
(  185)     pn%ln1 = ln1  ! default set in type declaration
(  186)   endif
(  187)   call update_mu_spp_pertn(pn)
(  188) 
(  189)   !
(  190)   !  random field required on radiation grid?
(  191)   !
(  192)   if (present(radgrid)) then
(  193)     pn%radgrid= radgrid
(  194)   endif
(  195)   !
(  196)   !  ML: The number of random fields nrf could be determined from size(nseed_off)
(  197)   !
(  198)   if (present(knrf)) then
(  199)     pn%nrf = knrf
(  200)   else
(  201)     pn%nrf = 1
(  202)   endif
(  203)   if (pn%radgrid) then
(  204)     pn%nrf_radgrid = pn%nrf
(  205)   else
(  206)     pn%nrf_radgrid = 0
(  207)   endif
(  208)   !
(  209)   !
(  210)   !
(  211)   if (present(cd_rf_pert_label)) then
(  212)     if (present(knrf).or.present(knseed_off)) then
(  213)       call abor1('Neither knrf nor knseed_off are meaningful arguments when cd_rf_pert_label is present.')
(  214)     endif
(  215)     pn%rf_pert_label = cd_rf_pert_label
(  216)     pn%nrf         = 0
(  217)     pn%nrf_radgrid = 0
(  218)   endif
(  219) 
(  220)   !
(  221)   !   potentially use hash function like CRC-32 to generate seed modifier
(  222)   !
(  223)   if (present(knseed_off)) then
(  224)     pn%noff=size(knseed_off)






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 5

(  225)     if (pn%noff > jp_off) then
(  226)       call abor1('Too many seed offsets; increase jp_off in spp_test_mod.')
(  227)     endif
(  228)     if (pn%noff /= pn%nrf ) then
(  229)       call abor1('The number of random fields must be equal to the number of random seeds.')
(  230)     endif
(  231)     pn%nseed_off(1:pn%noff) = knseed_off
(  232)   else if (present(cd_rf_pert_label)) then
(  233)     pn%nseed_off = 0
(  234)   else
(  235)     pn%nseed_off = sm%kseed_off
(  236)   endif
(  237)   !
(  238)   !   update SPP model
(  239)   !
(  240)   if ( (sm%ndef +1) > sm%nmax) then
(  241)     call abor1( 'nmax is too small.')
(  242)   endif
(  243)   sm%ndef = sm%ndef + 1
(  244)   sm%pndef( sm%ndef ) = pn
(  245)   sm%defined_perts(sm%ndef) = cdlabel
(  246)   !
(  247)   !   seed offsets for next perturbation if called without nseed_off arguments
(  248)   !
(  249)   if (sm%kseed_off < 2_jpim **30) then
(  250)     sm%kseed_off = 2*sm%kseed_off
(  251)   else
(  252)     sm%kseed_off = 2_jpim **8 + 2_jpim **9
(  253)   endif
(  254) end subroutine implement_spp_pertn
