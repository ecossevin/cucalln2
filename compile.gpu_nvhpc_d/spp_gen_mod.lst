(  260) subroutine get_active_spp_perts( sm, ku_nam, ku_out )
(  261)   !
(  262)   !   read namelist input from unit kunit to determine active perturbations and make adjustments to their configuration
(  263)   !   create list of seeds for all random fields
(  264)   !
(  265)   type(spp_model), intent(inout) :: sm
(  266)   integer(kind=jpim), intent(in) :: ku_nam
(  267)   integer(kind=jpim), intent(in) :: ku_out
(  268) 
(  269)   integer(kind=jpim) :: inreq ! number of requested perturbations
(  270)   integer(kind=jpim) :: jjpert, kf0, kf1
(  271) 
(  272)   character(len=jp_lab_len), dimension(jpmaxperts) :: requested_perts
(  273) 
(  274)   namelist /nam_spp_active/ requested_perts
(  275) 
(  276)   if (sm%nmax>jpmaxperts) then
(  277)     write(ku_out,'(A,I5)') 'spp_gen_mod:get_active_spp_perts: increase jpmaxperts to at least ',sm%nmax
(  278)     call abor1('spp_gen_mod:get_active_spp_perts: array requested_perts is too small.')
(  279)   endif
(  280) 
(  281)   requested_perts= cp_undefined
(  282)   read(ku_nam,nml=nam_spp_active)






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 6

(  283) 
(  284)   inreq = count(requested_perts /= cp_undefined )
(  285)   write(ku_out,*) inreq," perturbations have been requested"
(  286)   sm%nact = inreq
(  287) 
(  288)   !
(  289)   !   check that requested perturbations are actually implemented
(  290)   !
(  291)   do jjpert=1, sm%nact
(  292)     if ( .not.any(sm%defined_perts == requested_perts(jjpert) ) ) then
(  293)       ! abort with suitable error message
(  294)       call abor1( "the requested perturbation "//trim(requested_perts(jjpert))//" is not known in "//trim( sm%version ))
(  295)     else
(  296)       sm%active_perts(jjpert)=requested_perts(jjpert)
(  297)       sm%pn(jjpert) = sm%pndef( get_spp_idx_def(requested_perts(jjpert),sm) )
(  298)       sm%pn(jjpert)%on  =.true.
(  299)     endif
(  300)   enddo
(  301) end subroutine get_active_spp_perts
