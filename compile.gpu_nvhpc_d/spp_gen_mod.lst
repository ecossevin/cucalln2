(  321)     call abor1('spp_gen_mod:map_indices_spp_nml: array pnx is too small.')
(  322)   endif
(  323) # 324 "./spp_gen_mod.F90"
(  324)   pnx(:)%label = cp_undefined
(  325)   read(ku_nam,nml=nam_spp_modif)
(  326) # 327 "./spp_gen_mod.F90"
(  327)   do jjpert=1, sm%nact
(  328)     if (pnx(jjpert)%label /= cp_undefined) then
(  329)       kidx_map(jjpert) = get_spp_idx(  pnx(jjpert)%label, sm )
(  330)     endif
(  331)   enddo
(  332) # 333 "./spp_gen_mod.F90"
(  333) end subroutine map_indices_spp_nml
(  334) # 336 "./spp_gen_mod.F90"
(  336) subroutine modify_spp_perts( sm, kidx_map, ku_nam, ku_out )
(  337)   !
(  338)   !   Read namelist input from unit kunit to determine active perturbations and make adjustments to their configuration.
(  339)   !
(  340)   !   kidx_map is obtained from initial pass through namelist nam_spp_modif and links the perturbations pnx with the perturbations sm%pn
(  341)   !
(  342)   !   create list of seeds for all random fields
(  343)   !
(  344)   type(spp_model), intent(inout) :: sm
(  345)   integer(kind=jpim), dimension(jpmaxperts), intent(in):: kidx_map
(  346)   integer(kind=jpim), intent(in) :: ku_nam
(  347)   integer(kind=jpim), intent(in) :: ku_out
(  348) # 349 "./spp_gen_mod.F90"
(  349)   integer(kind=jpim) :: jjpert, kf0, kf1
(  350) # 351 "./spp_gen_mod.F90"
(  351)   integer(kind=jpim) :: i_rf_donor
(  352) # 353 "./spp_gen_mod.F90"
(  353)   type(spp_pert), dimension(jpmaxperts) :: pnx   ! configurations of active individual perturbations
(  354) # 355 "./spp_gen_mod.F90"






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 17

(  355)   namelist /nam_spp_modif/ pnx
(  356) # 357 "./spp_gen_mod.F90"
(  357)   if (sm%nact>jpmaxperts) then
(  358)     write(ku_out,'(A,I5)') 'spp_gen_mod:modify_spp_perts: increase jpmaxperts to at least ',sm%nact
(  359)     call abor1('spp_gen_mod:modify_spp_perts: array pnx is too small.')
(  360)   endif
(  361) # 362 "./spp_gen_mod.F90"
(  362)   pnx(:)%label=cp_undefined
(  363) # 364 "./spp_gen_mod.F90"
(  364)   do jjpert=1, jpmaxperts
(  365)     if (kidx_map(jjpert)>0) then
(  366)       pnx(jjpert) = sm%pn( kidx_map(jjpert) )
(  367)     endif
(  368)   enddo
(  369) # 370 "./spp_gen_mod.F90"
(  370)   !
(  371)   !   make requested changes to settings
(  372)   !
(  373)   read(ku_nam,nml=nam_spp_modif)
(  374) # 375 "./spp_gen_mod.F90"
(  375)   do jjpert=1, jpmaxperts
(  376)     if (kidx_map(jjpert)>0) then
(  377)       sm%pn( kidx_map(jjpert) ) = pnx( jjpert)
(  378)       call update_mu_spp_pertn(sm%pn( kidx_map(jjpert) ))
(  379)     endif
(  380)   enddo
(  381)   !
(  382)   !   set nrf/nrf_radgrid if fields that are taken from another perturbation
(  383)   !
(  384)   do jjpert=1, sm%nact
(  385)     if (sm%pn(jjpert)%rf_pert_label /= cp_undefined ) then
(  386)       sm%pn(jjpert)%nrf         = 0
(  387)       sm%pn(jjpert)%nrf_radgrid = 0
(  388)       sm%pn(jjpert)%nseed_off   = 0
(  389)       sm%pn(jjpert)%noff        = 0
(  390)     endif
(  391)   enddo
(  392)   !
(  393)   !   calculate total number of random fields and
(  394)   !     pointers mp to random fields for individual perturbations
(  395)   !
(  396)   sm%nrftotal=sum( sm%pn(1:sm%nact)%nrf )
(  397)   sm%nrftotal_radgrid=sum( sm%pn(1:sm%nact)%nrf_radgrid )
(  398)   do jjpert=1, sm%nact
(  399)     if (sm%pn(jjpert)%nrf > 0) then
(  400)       sm%pn(jjpert)%mp         = 1 + sum( sm%pn(1:jjpert-1)%nrf )
(  401)       sm%pn(jjpert)%mp_radgrid = 1 + sum( sm%pn(1:jjpert-1)%nrf_radgrid )
(  402)     else
(  403)       sm%pn(jjpert)%mp         = -1
(  404)       sm%pn(jjpert)%mp_radgrid = -1
(  405)     endif
(  406)   enddo
(  407)   !
(  408)   !   pointers to random fields that are taken from another perturbation
(  409)   !
(  410)   do jjpert=1, sm%nact
(  411)     if (sm%pn(jjpert)%rf_pert_label /= cp_undefined ) then
(  412)       i_rf_donor = get_spp_idx(  sm%pn(jjpert)%rf_pert_label, sm )






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 18

(  413)       if (i_rf_donor < 0) then
(  414)         write(ku_out, *) 'jjpert = ',jjpert,', sm%pn(jjpert)%label = ',sm%pn(jjpert)%label
(  415)         write(ku_out, *) 'sm%pn(jjpert)%rf_pert_label = ',sm%pn(jjpert)%rf_pert_label
(  416)         call abor1('Cannot find sm%pn(jjpert)%rf_pert_label in active perturbations.')
(  417)       endif
(  418)       sm%pn(jjpert)%mp         = sm%pn(i_rf_donor)%mp
(  419)       sm%pn(jjpert)%mp_radgrid = sm%pn(i_rf_donor)%mp_radgrid
(  420)     endif
(  421)   enddo
(  422)   !
(  423)   !   create list of seed offsets for the random fields
(  424)   !
(  425)   kf1=0
(  426)   do jjpert=1, sm%nact
(  427)     if (sm%pn(jjpert)%nrf > 0) then
(  428)       kf0=kf1+1
(  429)       kf1=kf0+sm%pn(jjpert)%noff-1 !ML: the number of seeds does not need to match the number of random fields. This could cause problems. How to resolve this?
(  430)       sm%nseed_off(kf0:kf1) = sm%pn(jjpert)%nseed_off(1:sm%pn(jjpert)%noff )
(  431)     endif
(  432)   enddo
(  433) end subroutine modify_spp_perts
(  434) # 435 "./spp_gen_mod.F90"
(  435) integer(kind=jpim) function get_spp_idx( cd_label, sm )
(  436)   !
(  437)   !   get index from active perturbations for perturbation named cd_label in spp_model sm
(  438)   !
(  439)   character(len=*), intent(in)      :: cd_label
(  440)   type(spp_model)          , intent(in)      :: sm
(  441) # 442 "./spp_gen_mod.F90"
(  442)   integer(kind=jpim) :: ipn
(  443)   integer(kind=jpim) :: jj
(  444)   ipn=-1
(  445)   do jj=1, sm%nact
(  446)     if (cd_label == sm%pn(jj)%label) then
(  447)       ipn=jj
(  448)       exit  ! no further search needed
(  449)     endif
(  450)   enddo
(  451)   if (ipn == -1) then
(  452)     !
(  453)     !   this should never happen, abort immediately
(  454)     !
(  455)     call abor1( "get_spp_idx: there is no perturbation " //trim(cd_label))
(  456)   endif
(  457)   get_spp_idx=ipn
(  458) end function get_spp_idx
