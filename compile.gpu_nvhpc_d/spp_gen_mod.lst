(  273) # 274 "./spp_gen_mod.F90"
(  274)   namelist /nam_spp_active/ requested_perts
(  275) # 276 "./spp_gen_mod.F90"
(  276)   if (sm%nmax>jpmaxperts) then
(  277)     write(ku_out,'(A,I5)') 'spp_gen_mod:get_active_spp_perts: increase jpmaxperts to at least ',sm%nmax
