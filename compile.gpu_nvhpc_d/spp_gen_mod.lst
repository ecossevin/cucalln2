(   71) subroutine allocate_spp_model( sm, knmax)
(   72)   !
(   73)   !   allocate all dynamic arrays in the spp_model variable ydspp
(   74)   !
(   75)   type(spp_model), intent(inout) :: sm
(   76)   integer(kind=jpim), intent(in) :: knmax
(   77) 
(   78)   sm%nmax = knmax
(   79)   allocate(sm%defined_perts( knmax ) )
(   80)   allocate(sm%active_perts(  knmax ) )
(   81)   allocate(sm%pndef(         knmax ) )
(   82)   allocate(sm%pn(            knmax ) )
(   83)   allocate(sm%nseed_off(     knmax * jp_off ) )
(   84) 
(   85) end subroutine allocate_spp_model
(   86) 
(   87) subroutine deallocate_spp_model( sm )
(   88)   !
(   89)   !   deallocate all arrays in the spp_model variable ydspp
