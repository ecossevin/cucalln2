(  312) 
(  313)   integer(kind=jpim) :: jjpert
(  314)   type(spp_pert), dimension(jpmaxperts) :: pnx   ! configurations of active individual perturbations
(  315) 
(  316)   namelist /nam_spp_modif/ pnx
(  317) 
(  318)   kidx_map = -1
