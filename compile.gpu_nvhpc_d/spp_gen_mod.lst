(   51)   character(len=jp_ver_len)  :: version
(   52)   integer(kind=jpim)         :: nmax  ! max. number of perturbations for array dimensioning
(   53)   character(len=jp_lab_len), dimension(:), allocatable :: defined_perts
(   54)   character(len=jp_lab_len), dimension(:), allocatable :: active_perts
(   55)   integer(kind=jpim) :: ndef=0 ! number of defined perturbations
(   56)   integer(kind=jpim) :: nact ! number of active perturbations
(   57)   integer(kind=jpim) :: nrftotal=0 ! total number of random fields
(   58)   integer(kind=jpim) :: nrftotal_radgrid=0 ! total number of random fields on the radiation grid
(   59)   integer(kind=jpim), dimension(:), allocatable :: nseed_off ! seed offsets for random fields 1..nrftotal
(   60)   type(spp_pert), dimension(:), allocatable :: pndef  ! configurations of defined individual perturbations
(   61)   type(spp_pert), dimension(:), allocatable :: pn   ! configurations of active individual perturbations
(   62)   real(kind=jprb)    :: tau    ! global default decorrelation time
(   63)   real(kind=jprb)    :: xlcor  ! global default correlation length scale
(   64)   real(kind=jprb)    :: sdev   ! global default standard deviation
(   65)   integer(kind=jpim) :: kseed_off ! random number seed offset for current perturbation
(   66) end type spp_model
