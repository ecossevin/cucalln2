(    7) integer(kind=jpim), parameter :: jp_lab_len=16      ! string length for perturbation labels
(    8) integer(kind=jpim), parameter :: jp_ver_len=32      ! string length for version
(    9) integer(kind=jpim), parameter :: jp_mag  =4         ! max size of xmag
(   10) integer(kind=jpim), parameter :: jp_cli  =4         ! max size of xclipmin/xclipmax
(   11) integer(kind=jpim), parameter :: jp_off  =2         ! max size of nseed_off
(   12) integer(kind=jpim), parameter :: jpmaxperts=128     ! max number of perturbations in the context of namelist inputs
(   13) character(len=jp_lab_len), parameter :: cp_undefined='????????????????'
(   14) 
(   15) type spp_pert
(   16)   !
(   17)   !   define variables for an individual perturbation of 1 variable or 1 parameter
(   18)   !
(   19)   character(len=jp_lab_len) :: label=cp_undefined
(   20)   logical                   :: on=.false.       ! on/off
(   21)   integer(kind=jpim)        :: idistr           ! Determines the distribution; 
(   22)                                                 !  0: normal, 
(   23)                                                 !  1: log-normal, 
(   24)                                                 !  2: uniform
(   25)   real(kind=jprb), dimension(jp_mag)   :: xmag=0._jprb        ! amplitude
(   26)   real(kind=jprb), dimension(jp_mag)   :: mu=0._jprb          ! mean of Gaussian
(   27)   real(kind=jprb)           :: xclipmin=-HUGE(1.0_jprb) ! lower clipping limit
(   28)   real(kind=jprb)           :: xclipmax= HUGE(1.0_jprb) ! upper clipping limit
(   29)   real(kind=jprb)           :: xuniform_offset  ! Offset of distribution if idistr = 2
(   30)   integer(kind=jpim)        :: nmag=1           !   number of used magnitudes
(   31)   logical                   :: ln1=.true.       ! T implies the mean of the log-normal distribution is 1
(   32)   integer(kind=jpim),dimension(jp_off) :: nseed_off=0       ! random number seed offsets
(   33)   integer(kind=jpim)        :: noff=1           !   number of used seed offsets
(   34) 
(   35)   integer(kind=jpim)        :: nrf=1            ! number of random fields for this perturbation
(   36)                                                 !   [e.b. would be 2 for CUDUDV but 1 for RTAU and most others]
(   37)   integer(kind=jpim)        :: nrf_radgrid=0    ! number of random fields on the radiation grid
(   38)   logical                   :: radgrid=.false.  ! perturbation requires random field on radiation grid
(   39)   character(len=jp_lab_len) :: rf_pert_label=cp_undefined ! point to random field of perturbation rf_pert_label
(   40)   integer(kind=jpim)        :: ic=1             ! Sign of correlation in case rf_pert_label is used
(   41)   integer(kind=jpim)        :: mp               ! pointer to first random field
(   42)                                                 !   [correspond to MP* IN TSPP_DATA, e.g. MPCFM ... MPZHSVDAERO]
(   43)   integer(kind=jpim)        :: mp_radgrid       ! pointer to first random field on radiation grid
(   44)   real(kind=jprb)           :: tau, sdev, xlcor ! random field characteristics
(   45) end type spp_pert
(   46) 
(   47) type spp_model
(   48)   !
(   49)   !    define a model of perturbations
(   50)   !






