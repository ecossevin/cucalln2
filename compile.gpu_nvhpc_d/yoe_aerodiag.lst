(   10) !*    ** *YOE_AERODIAG* - FIXED INDICES IN AEROSOL DIAGNOSTICS ARRAYS
(   11) !     ------------------------------------------------------------------
(   12) 
(   13) INTEGER(KIND=JPIM), PARAMETER :: NPAERODIAG = 8    ! per-aerosol-bin diagnostics (flux,od,mass)
(   14) INTEGER(KIND=JPIM), PARAMETER :: NPAERAOT = 3      ! per-layer aerosol optical thicknesses
(   15) INTEGER(KIND=JPIM), PARAMETER :: NPAERLISI_VAR = 6 ! lidar simulator variables
(   16) INTEGER(KIND=JPIM), PARAMETER :: NPAERLISI_WVL = 3 ! lidar simulator wavelengths
(   17) INTEGER(KIND=JPIM), PARAMETER :: NPAERLISI = NPAERLISI_VAR * NPAERLISI_WVL
(   18) 
(   19) ! General per-aerosol-bin diagnostics
(   20) ! WARNING - The numbering of these may affect the sequence of elements in
(   21) !   the PDHFSS array, as filled in postphy.F90
(   22) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_SRC = 1 ! Source/gain
(   23) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_DDP = 2 ! Dry deposition
(   24) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_SDM = 3 ! Sedimentation
(   25) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_WDL = 4 ! Wet deposition (large-scale)
(   26) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_WDC = 5 ! Wet deposition (convective)
(   27) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_NGT = 6 ! Negative fixer
(   28) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_OD  = 7 ! Optical depth (at 550nm)
(   29) INTEGER(KIND=JPIM), PARAMETER :: JPAERODIAG_MSS = 8 ! Total column mass
(   30) 
(   31) ! Labels for the above for prefixing field names
(   32) CHARACTER(LEN=3), PARAMETER :: CPAERODIAG_LABEL(8) = &
(   33)   & (/ 'SRC', 'DDP', 'SDM', 'WDL', 'WDC', 'NGT', 'OD.', 'TC.' /)
(   34) 
(   35) ! Optical thickness variables
(   36) INTEGER(KIND=JPIM), PARAMETER :: JPAERAOT_TOTAL   = 1 ! Total AOT
(   37) INTEGER(KIND=JPIM), PARAMETER :: JPAERAOT_NATURAL = 2 ! Natural AOT (SS+DU)
(   38) INTEGER(KIND=JPIM), PARAMETER :: JPAERAOT_ANTHRO  = 3 ! Anthropogenic AOT (OM+BC+SU)
(   39) 
(   40) ! Lidar simulator: variables
(   41) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_EXT    = 1 ! Extinction coefficient
(   42) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_SSA    = 2 ! Single-scattering albedo
(   43) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_BSTOA  = 3 ! Backscatter from TOA (satellite lidar)
(   44) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_BSGND  = 4 ! Backscatter from ground-based lidar
(   45) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_MOLBSC = 5 ! Unattenuated molecular backscattering coefficient
(   46) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_AERBSC = 6 ! Unattenuated aerosol backscattering coefficient
(   47) !INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_EXTD  = 7 ! Dust-only extinction coefficient
(   48) 
(   49) ! ... and wavelengths
(   50) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_355  = 1 ! 355 nm






