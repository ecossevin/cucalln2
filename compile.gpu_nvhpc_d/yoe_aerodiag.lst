(   51) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_532  = 2 ! 532 nm
(   52) INTEGER(KIND=JPIM), PARAMETER :: JPAERLISI_1064 = 3 ! 1064 nm
(   53) 
(   54) 
(   55) ! -----------------------------------------------------------------------------
(   56) ! And the structures for controlling per-wavelength aerosol optical diagnostics
(   57) 
(   58) INTEGER(KIND=JPIM), PARAMETER :: NPAERO_WVL_DIAG = 20 ! Maximum number of aerosol optical diagnostic wavelengths
(   59) INTEGER(KIND=JPIM), PARAMETER :: NPAERO_WVL_DIAG_TYPES = 5 ! Number of optical diagnostic types
(   60) 
(   61) TYPE TYPE_AERO_WVL_DIAG
(   62) SEQUENCE
(   63) INTEGER(KIND=JPIM) :: IWVL                             ! Wavelength in nm
(   64) INTEGER(KIND=JPIM) :: IGRIBDIAG(NPAERO_WVL_DIAG_TYPES) ! GRIB codes for diagnostics as numbered below
(   65) END TYPE TYPE_AERO_WVL_DIAG
(   66) 
(   67) ! Optical depth MUST be number 1, since without interactive aerosol it's the only one used.
(   68) INTEGER(KIND=JPIM), PARAMETER :: JPAERO_WVL_AOD       = 1 ! Optical depth
(   69) INTEGER(KIND=JPIM), PARAMETER :: JPAERO_WVL_AODABS    = 2 ! Absorption optical depth
(   70) INTEGER(KIND=JPIM), PARAMETER :: JPAERO_WVL_AODFM     = 3 ! Fine-mode optical depth
(   71) INTEGER(KIND=JPIM), PARAMETER :: JPAERO_WVL_SSA       = 4 ! Single scattering albedo
(   72) INTEGER(KIND=JPIM), PARAMETER :: JPAERO_WVL_ASSIMETRY = 5 ! Asymmetry ("assimetry") parameter
(   73) 
(   74) ! Labels for the above for prefixing field names
(   75) CHARACTER(LEN=8), PARAMETER :: CPAERO_WVL_DIAG_LABEL(5) = &
(   76)   & (/ 'OptDepth', 'AbOptDep', 'FMOptDep', 'SScatAlb', 'Asymmetr' /)
(   77) 
