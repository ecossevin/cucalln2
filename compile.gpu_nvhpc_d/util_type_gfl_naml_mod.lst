(  545) INTEGER*8 FUNCTION SIZE_TYPE_GFL_NAML (YD, CDPATH, LDPRINT) RESULT (KSIZE)
(  546) 
(  547) IMPLICIT NONE
(  548) TYPE (TYPE_GFL_NAML),     INTENT (IN), TARGET :: YD
(  549) CHARACTER(LEN=*), INTENT (IN), OPTIONAL :: CDPATH
(  550) LOGICAL,          INTENT (IN), OPTIONAL :: LDPRINT
(  551) INTEGER*8 :: ISIZE, JSIZE
(  552) LOGICAL :: LLPRINT
(  553) CHARACTER(LEN=128) :: CLPATH
(  554) 
(  555) LLPRINT = .FALSE.
(  556) IF (PRESENT (LDPRINT)) THEN
(  557)   LLPRINT = LDPRINT
(  558) ENDIF
(  559) CLPATH=''
