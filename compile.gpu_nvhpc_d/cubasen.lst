(    1) SUBROUTINE CUBASEN &
(    2)  & (PPLDARE, PPLRG,    YDTHF, YDCST, YDEPHLI, YDECLDP,  YDECUMF, YDSPP_CONFIG, &
(    3)  & KIDIA,    KFDIA,    KLON,     KLEV,  KINDEX,  LDMIXS, LDTDKMF, &
(    4)  & PTENH,    PQENH,    PGEOH,    PAPH,&
(    5)  & PQHFL,    PAHFS,    PGP2DSPP, PKMFL,&
(    6)  & PTEN,     PQEN,     PQSEN,    PGEO,&
(    7)  & PTU,      PQU,      PLU,      PWU2H,  PWUBASE,&
(    8)  & KLAB,     LDCUM,    LDSC,     KCBOT,    KBOTSC,&
(    9)  & KCTOP,    KDPL,     PCAPE )  
(   10) 
(   11) !          THIS ROUTINE CALCULATES CLOUD BASE FIELDS
(   12) !          CLOUD BASE HEIGHT AND CLOUD TOP HEIGHT
(   13) 
(   14) !          PURPOSE.
(   15) !          --------
(   16) !          TO PRODUCE CLOUD BASE AND CLOUD TOP VALUES FOR CU-PARAMETRIZATION
(   17) 
(   18) !          INTERFACE
(   19) !          ---------
(   20) !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   21) !          INPUT ARE ENVIRONM. VALUES OF T,Q,P,PHI AT HALF LEVELS.
(   22) !          IT RETURNS CLOUD FIELDS VALUES AND FLAGS AS FOLLOWS;
(   23) !                 KLAB=0 FOR STABLE LAYERS
(   24) !                 KLAB=1 FOR SUBCLOUD LEVELS
(   25) !                 KLAB=2 FOR CLOUD LEVELS LEVEL
(   26) 
(   27) !          METHOD.
(   28) !          --------
(   29) !          LIFT SURFACE AIR DRY-ADIABATICALLY TO CLOUD TOP
(   30) !          (ENTRAINING PLUME, WITH ENTRAINMENT PROPORTIONAL TO (1/Z))
(   31) 
(   32) !     PARAMETER     DESCRIPTION                                   UNITS
(   33) !     ---------     -----------                                   -----
(   34) !     INPUT PARAMETERS (INTEGER):
(   35) 
(   36) !    *KIDIA*        START POINT
(   37) !    *KFDIA*        END POINT
(   38) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   39) !    *KLEV*         NUMBER OF LEVELS
(   40) !    *KINDEX*       TOP INDEX FOR OUTER VERTICAL LOOP
(   41) 
(   42) !    INPUT PARAMETERS (LOGICAL):
(   43) !    *LDMIXS*        WEAK (FALSE) OR STRONG (TRUE) CLOUD MIXING FOR SURFACE PARCEL ONLY
(   44) !    *LDTDKMF*      Arpege tuning (if TRUE)
(   45) 
(   46) !    INPUT PARAMETERS (REAL):
(   47) 
(   48) ! not used at the moment because we want to use linear intepolation
(   49) ! for fields on the half levels.
(   50) 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 2

(   51) !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS           K
(   52) !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS      KG/KG
(   53) 
(   54) !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   55) !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   56) !    *PKMFL*        SURFACE KINEMATIC MOMENTUM FLUX              M2/S2  
(   57) 
(   58) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   59) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS             PA
(   60) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   61) !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   62) !    *PQSEN*        PROVISIONAL ENVIRONMENT SATU. HUMIDITY (T+1)  KG/KG
(   63) !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   64) !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   65) !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   66) !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   67) 
(   68) !    UPDATED PARAMETERS (REAL):
(   69) 
(   70) !    *PTU*          TEMPERATURE IN UPDRAFTS                         K
(   71) !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                    KG/KG
(   72) !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS              KG/KG
(   73) !    *PWU2H*        KINETIC ENERGY IN UPDRAFTS  SURFACE PARCEL    M2/S2
(   74) 
(   75) !    UPDATED PARAMETERS (INTEGER):
(   76) 
(   77) !    *KLAB*         FLAG KLAB=1 FOR SUBCLOUD LEVELS
(   78) !                        KLAB=2 FOR CLOUD LEVELS
(   79) 
(   80) !    OUTPUT PARAMETERS (LOGICAL):
(   81) 
(   82) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS 
(   83) !    *LDSC*         FLAG: .TRUE. IF BL-CLOUDS EXIST
(   84) 
(   85) !    OUTPUT PARAMETERS (INTEGER):
(   86) 
(   87) !    *KCBOT*       CLOUD BASE LEVEL !    
(   88) !    *KCTOP*       CLOUD TOP LEVEL = HEIGHEST HALF LEVEL 
(   89) !                  WITH A NON-ZERO CLOUD UPDRAFT.
(   90) !    *KBOTSC*      CLOUD BASE LEVEL OF BL-CLOUDS
(   91) !    *KDPL*        DEPARTURE LEVEL
(   92) !    *PCAPE*       PSEUDOADIABATIQUE max CAPE (J/KG)
(   93) 
(   94) !          EXTERNALS
(   95) !          ---------
(   96) !          *CUADJTQ* FOR ADJUSTING T AND Q DUE TO CONDENSATION IN ASCENT
(   97) 
(   98) !     AUTHOR.
(   99) !     -------
(  100) !      A. Pier Siebesma   KNMI ********      
(  101) 
(  102) !     MODIFICATIONS.
