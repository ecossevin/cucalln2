(  153) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAHFS(KLON,KLEV+1) 
(  154) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGP2DSPP(KLON,YDSPP_CONFIG%SM%NRFTOTAL)
(  155) REAL(KIND=JPRB)   ,INTENT(IN)    :: PKMFL(KLON)
(  156) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTEN(KLON,KLEV) 
(  157) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQEN(KLON,KLEV) 
(  158) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQSEN(KLON,KLEV) 
(  159) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEO(KLON,KLEV) 
(  160) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PTU(KLON,KLEV) 
(  161) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PQU(KLON,KLEV) 
(  162) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PLU(KLON,KLEV) 
(  163) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PWU2H(KLON,KLEV) 
(  164) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PWUBASE(KLON) 
(  165) INTEGER(KIND=JPIM),INTENT(INOUT) :: KLAB(KLON,KLEV) 
(  166) LOGICAL           ,INTENT(INOUT) :: LDCUM(KLON) 






