(  448)           IF (.NOT. LDTDKMF)  ZMIX(JL)   = MIN(1.0_JPRB, ZMIX(JL))
(  449)           ZQF = (PQENH(JL,JK+1) + PQENH(JL,JK))*0.5_JPRB
(  450)           ZSF = (ZSENH(JL,JK+1) + ZSENH(JL,JK))*0.5_JPRB
(  451)           ZTMP = 1.0_JPRB/(1.0_JPRB+ZMIX(JL))
(  452)           ZQU(JL,JK)= (ZQU(JL,JK+1)*(1.0_JPRB-ZMIX(JL))&
(  453)          & +2.0_JPRB*ZMIX(JL)*ZQF) * ZTMP  
(  454)           ZSUH (JL,JK)= (ZSUH(JL,JK+1)*(1.0_JPRB-ZMIX(JL))&
(  455)          & +2.0_JPRB*ZMIX(JL)*ZSF) * ZTMP  
(  456)           ZQOLD(JL)  = ZQU(JL,JK)
(  457)           ZTU (JL,JK) = (ZSUH(JL,JK)-PGEOH(JL,JK))*ZRCPD
(  458)           ZPH  (JL)    = PAPH(JL,JK)
(  459)         ENDIF
(  460)       ENDDO
(  461) # 462 "./cubasen.F90"
(  462)     ELSE
(  463) # 464 "./cubasen.F90"
(  464)       ZXENTRORG=ENTRORG
(  465)       DO JL=KIDIA,KFDIA
(  466)         IF (LLGO_ON(JL)) THEN
(  467)           !SPP: perturb ENTRORG parameter
(  468)           IF (YDSPP_CONFIG%LSPP .AND. LLPERT_ENTRORG) THEN
(  469)             ZXENTRORG=ENTRORG*EXP(PN1%MU(1)+PN1%XMAG(1)*PGP2DSPP(JL, IPENTRORG))
(  470)           ENDIF
(  471)           ZDZ(JL)    = (PGEOH(JL,JK) - PGEOH(JL,JK+1))*ZRG
(  472)           ZMIX(JL)=ENTRTEST*ZXENTRORG*ZDZ(JL)*MIN(1.0_JPRB,(PQSEN(JL,JK)/PQSEN(JL,KLEV))**3)
(  473)         ENDIF
(  474)       ENDDO
(  475) # 476 "./cubasen.F90"
(  476)       DO JL=KIDIA,KFDIA
(  477)         IF (LLGO_ON(JL)) THEN
(  478)           IS         = IS+1
(  479)           ZMIX(JL)=MIN(1.0_JPRB,ZMIX(JL))
(  480)           ZQF = (PQENH(JL,JK+1) + PQENH(JL,JK))*0.5_JPRB
(  481)           ZSF = (ZSENH(JL,JK+1) + ZSENH(JL,JK))*0.5_JPRB
(  482)           ZQU(JL,JK)= ZQU(JL,JK+1)*(1.0_JPRB-ZMIX(JL))+ ZQF*ZMIX(JL)
(  483)           ZSUH(JL,JK)= ZSUH(JL,JK+1)*(1.0_JPRB-ZMIX(JL))+ ZSF*ZMIX(JL)
(  484)           ZQOLD(JL)  = ZQU(JL,JK)
(  485)           ZTU (JL,JK)= (ZSUH(JL,JK)-PGEOH(JL,JK))*ZRCPD
(  486)           ZPH  (JL)  = PAPH(JL,JK)
(  487)         ENDIF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 26

(  488)       ENDDO
(  489) # 490 "./cubasen.F90"
(  490)     ENDIF
(  491) # 492 "./cubasen.F90"
(  492)     IF (IS == 0) EXIT
(  493)      
(  494)     IK=JK
(  495)      
(  496)     !$loki inline
(  497)     CALL CUADJTQ &
(  498)      & ( YDTHF, YDCST, YDEPHLI,  KIDIA,    KFDIA,    KLON,    KLEV,      IK,&
(  499)      &   ZPH,      ZTU,      ZQU,     LLGO_ON,   1)  
(  500)    
(  501)    !DIR$ IVDEP
(  502)    !OCL NOVREC
(  503)    
(  504)     DO JL=KIDIA,KFDIA
(  505)       IF(LLGO_ON(JL)) THEN
(  506)    
(  507)    ! add condensation to water
(  508)    
(  509)         ZDQ=MAX(ZQOLD(JL)-ZQU(JL,JK),0.0_JPRB)
(  510)         ZLU(JL,JK)=ZLU(JL,JK+1)+ZDQ
(  511) # 512 "./cubasen.F90"
(  512)    ! freezing
(  513)    
(  514)         ZLGLAC=ZDQ*((1.0_JPRB-FOEALFCU(ZTU(JL,JK)))-&
(  515)          & (1.0_JPRB-FOEALFCU(ZTU(JL,JK+1))))  
(  516)               
(  517)    
(  518)    ! pseudo-microphysics
(  519)    
(  520)         ZLU(JL,JK)=0.5_JPRB*ZLU(JL,JK) 
(  521)    
(  522)    ! update dry static energy after condensation + freezing
(  523)    
(  524)         ZTU(JL,JK)     = ZTU(JL,JK)+RALFDCP*ZLGLAC
(  525)         ZSUH(JL,JK)    = RCPD*ZTU(JL,JK)+PGEOH(JL,JK)
(  526)          
(  527)    ! Buoyancy on half and full levels
(  528)             
(  529)         ZTVUH           = (1.0_JPRB+RETV*ZQU(JL,JK)-ZLU(JL,JK))*ZTU(JL,JK)&
(  530)          & +RALFDCP*ZLGLAC  
(  531)         ZTVENH          = (1.0_JPRB+RETV*ZQENH(JL,JK)) &
(  532)          & *(ZSENH(JL,JK)-PGEOH(JL,JK))*ZRCPD  
(  533)         ZBUOH(JL,JK)   = (ZTVUH-ZTVENH)*RG/ZTVENH
(  534) # 535 "./cubasen.F90"
(  535)         ZBUOF          = (ZBUOH(JL,JK) + ZBUOH(JL,JK+1))*0.5_JPRB
(  536)    
(  537)    ! solve kinetic energy equation
(  538)    
(  539)         ZTMP=1.0_JPRB/(1.0_JPRB+2.0_JPRB*ZBW*ZMIX(JL))
(  540)         ZWU2H(JL,JK) = (ZWU2H(JL,JK+1)*(1.0_JPRB-2.0_JPRB*ZBW*ZMIX(JL))&
(  541)          & +2.0_JPRB*ZAW*ZBUOF*ZDZ(JL)) * ZTMP  
(  542) # 543 "./cubasen.F90"
(  543)         IF(JKK==KLEV) THEN
(  544)            PWU2H(JL,JK) = ZWU2H(JL,JK) !save surface parcel KE
(  545)         ENDIF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 27

(  546)    
(  547)    ! compute CAPE for diagnostics
(  548)    
(  549)         ZCAPE(JL,JKK)  = ZCAPE(JL,JKK) + MAX(0.0_JPRB,ZBUOF*ZDZ(JL))
(  550)    
(  551)    ! first layer with liquid water - find exact cloud base
(  552)    
(  553)         IF(ZLU(JL,JK) >0.0_JPRB.AND.ILAB(JL,JK+1)==1) THEN
(  554)            
(  555)           IK=JK+1
(  556)           ZQSU=FOEEWM(ZTU(JL,IK))/PAPH(JL,IK)
(  557)           ZESDP=ZQSU
(  558)           ZQSU=MIN(0.5_JPRB,ZQSU)
(  559)           ZCOR=1.0_JPRB/(1.0_JPRB-RETV  *ZQSU)
(  560)           ZQSU=ZQSU*ZCOR
(  561)           ZDQ=MIN(0._JPRB,ZQU(JL,IK)-ZQSU)
(  562)           ZALFAW=FOEALFA(ZTU(JL,IK))
(  563)           ZFACW=R5LES/((ZTU(JL,IK)-R4LES)**2)
(  564)           ZFACI=R5IES/((ZTU(JL,IK)-R4IES)**2)
(  565)           ZFAC=ZALFAW*ZFACW+(1.-ZALFAW)*ZFACI
(  566)           ZCOR=1.0_JPRB/(1.0_JPRB-RETV*ZESDP)
(  567)           ZDQSDT=ZFAC*ZCOR*ZQSU
(  568)           ZDTDP=RD*ZTU(JL,IK)/(RCPD*PAPH(JL,IK))
(  569)           ZDP=ZDQ/(ZDQSDT*ZDTDP)
(  570)           ZCBASE(JL)=PAPH(JL,IK)+ZDP
(  571)            
(  572)    ! chose nearest half level as cloud base
(  573)    
(  574)           ZPDIFFTOP=ZCBASE(JL)-PAPH(JL,JK)
(  575)           ZPDIFFBOT=PAPH(JL,JK+1)-ZCBASE(JL)
(  576)            
(  577)           IF(ZPDIFFTOP > ZPDIFFBOT.AND.ZWU2H(JL,JK+1)>0.0_JPRB) THEN
(  578)             JKB=MIN(KLEV-1,JK+1)
(  579)             ILAB(JL,JKB)=2 
(  580)             ILAB(JL,JK)=2
(  581)             LL_LDBASE(JL) =.TRUE.
(  582)             LLDSC(JL)   =.TRUE.
(  583)             IBOTSC(JL) =JKB
(  584)             ICBOT(JL)  =JKB
(  585)             ZLU(JL,JK+1) = RLMIN
(  586)           ELSEIF(ZPDIFFTOP <= ZPDIFFBOT.AND.ZWU2H(JL,JK)>0.0_JPRB) THEN
(  587)             ILAB(JL,JK)=2
(  588)             LL_LDBASE(JL) =.TRUE.
(  589)             LLDSC(JL)   =.TRUE.
(  590)             IBOTSC(JL) =JK
(  591)             ICBOT(JL)  =JK
(  592)           ENDIF
(  593)    
(  594)         ENDIF
(  595)    
(  596)    ! decide on presence of convection, cloud base and cloud top based on
(  597)    ! kinetic energy
(  598)    
(  599)         IF (ZWU2H(JL,JK) < 0.0_JPRB) THEN
(  600)           LLGO_ON(JL) = .FALSE.             
(  601)           IF (ZLU(JL,JK+1)>0.0_JPRB) THEN
(  602)             ICTOP(JL)   = JK
(  603)             LLDCUM(JL)   = .TRUE.






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 28

(  604)           ELSE
(  605)             LLDCUM(JL)   = .FALSE.
(  606)           ENDIF
(  607)         ELSE
(  608)           IF (ZLU(JL,JK)>0.0_JPRB) THEN
(  609)             ILAB(JL,JK) = 2
(  610)           ELSE
(  611)             ILAB(JL,JK) = 1
(  612)           ENDIF
(  613)         ENDIF
(  614)       ENDIF
(  615)     ENDDO
(  616)    
(  617) !     IF (IS == 0) EXIT
(  618)   ENDDO
(  619)    
(  620)   IF( JKK==KLEV.OR. (JKK==KLEV-1.AND.KINDEX==KLEV-1) ) THEN
(  621) # 622 "./cubasen.F90"
(  622)       ! set values for departure level for PBL clouds = first model level
(  623)     DO JL=KIDIA,KFDIA
(  624)       LDSC(JL)  = LLDSC(JL)
(  625)       IF(LDSC(JL)) THEN
(  626)         KBOTSC(JL)= IBOTSC(JL)
(  627)       ELSE
(  628)         KBOTSC(JL)=-1
(  629)       ENDIF
(  630)     
(  631)       JKT=ICTOP(JL)
(  632)       JKB=ICBOT(JL)
(  633)       LLDEEP(JL)=PAPH(JL,JKB)-PAPH(JL,JKT)>RDEPTHS
(  634)       IF(LLDEEP(JL).AND.KINDEX<KLEV-1) LLDCUM(JL)=.FALSE. ! no deep allowed for KLEV
(  635)       LLDEEP(JL)=.FALSE. ! for deep convection start only at level KLEV-1
(  636)                          ! and form mixed layer, so go on
(  637)       ! test further for deep convective columns as not yet found
(  638)     ! IF ( LLDEEP(JL) ) LLFIRST(JL)=.FALSE.
(  639)       LLGO_ON(JL) = .NOT.LLDEEP(JL)
(  640)       IF(KINDEX==KLEV-1) LLGO_ON(JL) = .NOT.LLDCUM(JL)
(  641)       IF(LLDCUM(JL)) THEN
(  642)         KCBOT(JL)= ICBOT(JL)
(  643)         KCTOP(JL)= ICTOP(JL)
(  644)         KDPL(JL)  = IDPL(JL)
(  645)         LDCUM(JL) = LLDCUM(JL)
(  646)         PWUBASE(JL)=SQRT(MAX(ZWU2H(JL,JKB),0.0_JPRB))
(  647)       ELSE
(  648)         KCTOP(JL)=-1
(  649)         KCBOT(JL)=-1
(  650)         KDPL(JL) =KLEV-1
(  651)         LDCUM(JL)=.FALSE.
(  652)         PWUBASE(JL)=0.0_JPRB
(  653)       ENDIF
(  654)     ENDDO
(  655)     DO JK=KLEV,1,-1
(  656)       DO JL=KIDIA,KFDIA
(  657)         JKT=ICTOP(JL)
(  658)         IF ( JK>=JKT.OR. (KINDEX>=KLEV-1.AND.JKK==KLEV) ) THEN
(  659)           KLAB(JL,JK)=ILAB(JL,JK)
(  660)           PTU(JL,JK)=ZTU(JL,JK)
(  661)           PQU(JL,JK)=ZQU(JL,JK)






