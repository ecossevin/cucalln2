(  662)           PLU(JL,JK)=ZLU(JL,JK)
(  663)         ENDIF
(  664)       ENDDO
(  665)     ENDDO
(  666)   ENDIF
(  667)    
(  668)   IF( JKK < KLEV ) THEN
(  669)     LLRESET=.FALSE.
(  670)     DO JL=KIDIA,KFDIA
(  671)       IF ( .NOT.LLDEEP(JL) ) THEN
(  672)         JKT=ICTOP(JL)
(  673)         JKB=ICBOT(JL)
(  674)            ! test on cloud thickness and buoyancy
(  675)         LLDEEP(JL)=PAPH(JL,JKB)-PAPH(JL,JKT)>=RDEPTHS 
(  676)       ENDIF
(  677)       LLRESETJL(JL)=LLDEEP(JL).AND.LLFIRST(JL)
(  678)       LLRESET=LLRESET.OR.LLRESETJL(JL)
(  679)     ENDDO
(  680) # 682 "./cubasen.F90"
(  682)     IF(LLRESET) THEN
(  683)       DO JK=KLEV,1,-1
(  684)         DO JL=KIDIA,KFDIA
(  685)           IF ( LLRESETJL(JL) ) THEN 
(  686)             JKT=ICTOP(JL)
(  687)             JKB=IDPL(JL)
(  688)             IF ( JK<=JKB .AND. JK>=JKT ) THEN
(  689)               KLAB(JL,JK)=ILAB(JL,JK)
(  690)               PTU(JL,JK)=ZTU(JL,JK)
(  691)               PQU(JL,JK)=ZQU(JL,JK)
(  692)               PLU(JL,JK)=ZLU(JL,JK)
(  693)             ELSE 
(  694)               KLAB(JL,JK)=1
(  695)               PTU(JL,JK)=PTENH(JL,JK)
(  696)               PQU(JL,JK)=PQENH(JL,JK)
(  697)               PLU(JL,JK)=0.0_JPRB
(  698)             ENDIF
(  699)             IF ( JK<JKT ) KLAB(JL,JK)=0
(  700)           ENDIF
(  701)         ENDDO
(  702)       ENDDO
(  703)     ENDIF
(  704) # 705 "./cubasen.F90"
(  705)     DO JL=KIDIA,KFDIA
(  706)       IF ( LLDEEP(JL) .AND. LLFIRST(JL) ) THEN
(  707)         KDPL(JL)  = IDPL(JL)
(  708)         KCTOP(JL) = ICTOP(JL)
(  709)         KCBOT(JL) = ICBOT(JL)
(  710)         LDCUM(JL) = LLDCUM(JL)
(  711)         LDSC(JL)  = .FALSE.
(  712)         KBOTSC(JL)= -1
(  713)         JKB=KCBOT(JL)
(  714)         PWUBASE(JL)=SQRT(MAX(ZWU2H(JL,JKB),0.0_JPRB))
(  715) !  no initialization of wind for deep here, this is done in
(  716) !  CUINI and CUASCN
(  717)         LLFIRST(JL)=.FALSE.
(  718)       ENDIF
(  719)       LLGO_ON(JL) = .NOT.LLDEEP(JL)
(  720)     ENDDO






