(  372)                ZQEXC=MIN(ZQEXC, 2.E-3_JPRB)
(  373)             ELSE
(  374)                ZTEXC=MIN(ZTEXC, 1.0_JPRB)
(  375)                ZQEXC=MIN(ZQEXC, 5.E-4_JPRB)
(  376)             ENDIF
(  377)           ENDIF
(  378)           ZQU (JL,JKK) = ZQENH(JL,JKK) + ZQEXC
(  379)           ZSUH (JL,JKK) = ZSENH(JL,JKK) + RCPD*ZTEXC
(  380)           ZTU (JL,JKK) = (ZSENH(JL,JKK)-PGEOH(JL,JKK))*ZRCPD + ZTEXC
(  381)           ZLU (JL,JKK) = 0.0_JPRB
(  382)          ! construct mixed layer for parcels emanating in lowest 60 hPa
(  383)           IF (PAPH(JL,KLEV+1)-PAPH(JL,JKK-1)<60.E2_JPRB) THEN
(  384)             ZQU(JL,JKK) =0.0_JPRB
(  385)             ZSUH(JL,JKK)=0.0_JPRB
