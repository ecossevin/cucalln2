(  170) INTEGER(KIND=JPIM),INTENT(OUT)   :: KCTOP(KLON) 
(  171) INTEGER(KIND=JPIM),INTENT(OUT)   :: KDPL(KLON) 
(  172) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PCAPE(KLON) 
(  173) INTEGER(KIND=JPIM) ::  ICTOP(KLON),            ICBOT(KLON),&
(  174)  & IBOTSC(KLON),           ILAB(KLON,KLEV),&
(  175)  & IDPL(KLON)  
(  176) 
(  177) LOGICAL ::         LL_LDBASE(KLON),&
(  178)  & LLGO_ON(KLON),&
(  179)  & LLDEEP(KLON),    LLDCUM(KLON), &
(  180)  & LLDSC(KLON),     LLFIRST(KLON)  
(  181) LOGICAL ::     LLRESET,        LLRESETJL(KLON)
(  182) LOGICAL :: LLPERT_ENTRORG, LLPERT_ENTSTPC1  ! SPP perturbation on?
(  183) 
(  184) 
(  185) 
(  186) INTEGER(KIND=JPIM) :: IK, IS, JK, JL, JKK, JKT1, JKT2, JKT, JKB
(  187) INTEGER(KIND=JPIM) :: IPENTRORG, IPENTSTPC1
(  188) 
(  189) REAL(KIND=JPRB)    :: ZS(KLON,KLEV), ZSENH(KLON,KLEV+1), ZQENH(KLON,KLEV+1), ZSUH (KLON,KLEV),&
(  190)  & ZBUOH(KLON,KLEV), ZWU2H(KLON,KLEV) 
(  191) REAL(KIND=JPRB) :: ZQOLD(KLON),ZPH(KLON)
(  192) REAL(KIND=JPRB) :: ZMIX(KLON)
(  193) REAL(KIND=JPRB) :: ZDZ(KLON), ZCBASE(KLON)
(  194) 
(  195) REAL(KIND=JPRB) :: ZLU(KLON,KLEV), ZQU(KLON,KLEV), ZTU(KLON,KLEV)
(  196) 
(  197) REAL(KIND=JPRB) :: ZCAPE(KLON,KLEV) ! local for CAPE at every departure level
(  198) 
(  199) REAL(KIND=JPRB) :: ZBUOF     ! BUOYANCY
(  200) REAL(KIND=JPRB) :: ZRHO      ! DENSITY AT SURFACE (KG/M^3) 
(  201) REAL(KIND=JPRB) :: ZKHVFL    ! SURFACE BUOYANCY FLUX (K M/S)
(  202) REAL(KIND=JPRB) :: ZWS       ! SIGMA_W AT LOWEST MODEL HALFLEVEL (M/S)
(  203) REAL(KIND=JPRB) :: ZUST      ! U* 
(  204) REAL(KIND=JPRB) :: ZQEX(KLON), ZQEXC ! HUMIDITY EXCESS AT LOWEST MODEL HALFLEVEL (KG/KG)
(  205) REAL(KIND=JPRB) :: ZTEX(KLON), ZTEXC ! TEMPERATURE EXCESS AT LOWEST MODEL HALFLEVEL (K)
(  206) REAL(KIND=JPRB) :: ZEPS      ! FRACTIONAL ENTRAINMENT RATE   [M^-1]
(  207) REAL(KIND=JPRB) :: ZTVENH    ! ENVIRONMENT VIRTUAL TEMPERATURE AT HALF LEVELS (K)  
(  208) REAL(KIND=JPRB) :: ZTVUH     ! UPDRAFT VIRTUAL TEMPERATURE AT HALF LEVELS     (K)
(  209) REAL(KIND=JPRB) :: ZLGLAC    ! UPDRAFT LIQUID WATER FROZEN IN ONE LAYER
(  210) REAL(KIND=JPRB) :: ZQSU, ZCOR, ZDQ, ZALFAW, ZFACW, ZFACI, ZFAC,&
(  211)  & ZESDP, ZDQSDT, ZDTDP, ZDP,ZPDIFFTOP,ZPDIFFBOT,ZSF,ZQF,ZAW,ZBW  
(  212) REAL(KIND=JPRB) :: ZWORK1, ZWORK2! work arrays for T and w perturbations
(  213) REAL(KIND=JPRB) :: ZRCPD, ZRG, ZTMP
(  214) 
(  215) REAL(KIND=JPRB) :: ZXENTRORG, ZXENTSTPC1
(  216) INTEGER(KIND=JPIM) :: IPN ! SPP perturbation pointer
(  217) TYPE(SPP_PERT)     :: PN1, PN2 
(  218) 
(  219) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(  220) 
(  221) 
(  222) #include "cuadjtq.intfb.h"
(  223) #include "fcttre.func.h"
(  224) 






