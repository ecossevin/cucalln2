(  282) # 283 "./cubasen.F90"
(  283) !----------------------------------------------------------------------
(  284) !       -----------------------------------------------------------
(  285) !       1.1  PREPARE FIELDS ON HALF LEVELS BY LINEAR INTERPOLATION
(  286) !             OF SPECIFIC HUMIDITY AND STATIC ENERGY
(  287) !       -----------------------------------------------------------
(  288) # 289 "./cubasen.F90"
(  289) DO JK=1,KLEV
(  290)   DO JL=KIDIA,KFDIA
(  291)     PWU2H(JL,JK)=0.0_JPRB
(  292)     ZWU2H(JL,JK)=0.0_JPRB
(  293)     ZS   (JL,JK) = RCPD*PTEN(JL,JK) + PGEO(JL,JK)
(  294)     ZQENH(JL,JK) = PQENH(JL,JK)
(  295)     ZSENH(JL,JK) = RCPD*PTENH(JL,JK)+PGEOH(JL,JK)
(  296)   ENDDO
(  297) ENDDO
(  298) # 299 "./cubasen.F90"
(  299) DO JKK=KLEV,JKT1,-1 ! Big external loop for level testing:
(  300)                     ! find first departure level that produces deepest cloud top
(  301)                     ! or take surface level for shallow convection and Sc
(  302)    !
(  303)    !        ---------------------------------------------------------
(  304)    !        1.2    INITIALISE FIELDS AT DEPARTURE HALF MODEL LEVEL
(  305)    !        ---------------------------------------------------------
(  306)    !
(  307)   IS=0
(  308)   DO JL=KIDIA,KFDIA
(  309)     IF (LLGO_ON(JL)) THEN
(  310)       IS=IS+1
(  311)       IDPL(JL)    =JKK      ! departure level
(  312)       ICBOT  (JL) =JKK      ! cloud base level for convection, (-1 if not found)
(  313)       IBOTSC (JL) =KLEV-1   ! sc    base level for sc-clouds , (-1 if not found)






NVFORTRAN (Version     24.5)          03/19/2025  06:56:01      page 23

(  314)       ICTOP(JL)   =KLEV-1   ! cloud top for convection (-1 if not found)
(  315)       LLDCUM(JL)  =.FALSE.  ! on exit: true if cloudbase=found
(  316)       LLDSC (JL)  =.FALSE.  ! on exit: true if cloudbase=found
(  317)       LL_LDBASE(JL)   =.FALSE. ! on exit: true if cloudbase=found
(  318)     ENDIF 
(  319)   ENDDO
(  320) # 321 "./cubasen.F90"
(  321)   IF(IS /= 0) THEN
(  322) # 323 "./cubasen.F90"
(  323)     IF(JKK == KLEV) THEN
(  324) # 325 "./cubasen.F90"
(  325)       ZTEXC=0.2_JPRB
(  326)       ZQEXC=1.E-4_JPRB
(  327)       DO JL=KIDIA,KFDIA
(  328)         IF (LLGO_ON(JL)) THEN
(  329)           ZRHO  = PAPH(JL,JKK+1)/(RD*(PTEN(JL,JKK)*(1.0_JPRB+RETV*PQEN(JL,JKK))))
(  330)           ZKHVFL= (PAHFS(JL,JKK+1)*ZRCPD+RETV*PTEN(JL,JKK)*PQHFL(JL,JKK+1))/(ZRHO*PPLRG*PPLDARE)
(  331)           ZUST  = MAX( SQRT(PKMFL(JL)), 0.1_JPRB )
(  332)           ZWS   = ZUST**3._JPRB - 1.5_JPRB*RKAP*ZKHVFL*(PGEOH(JL,KLEV)-PGEOH(JL,KLEV+1))/PTEN(JL,KLEV)
(  333)           ZTEX(JL)= 0.0_JPRB
(  334)           ZQEX(JL)= 0.0_JPRB
(  335)           IF( ZKHVFL < 0.0_JPRB ) THEN
(  336)             ZWS =1.2_JPRB*ZWS**.3333_JPRB
(  337)             ILAB(JL,JKK)= 1
(  338)             ZTEX(JL)   = MAX(-1.5_JPRB*PAHFS(JL,JKK+1)/(ZRHO*ZWS*RCPD*PPLRG*PPLDARE),ZTEXC)
(  339)             ZQEX(JL)   = MAX(-1.5_JPRB*PQHFL(JL,JKK+1)/(ZRHO*ZWS*PPLRG*PPLDARE),ZQEXC)
(  340)             ZQU (JL,JKK) = ZQENH(JL,JKK) + ZQEX(JL)
(  341)             ZSUH (JL,JKK)= ZSENH(JL,JKK) + RCPD*ZTEX(JL)
(  342)             ZTU (JL,JKK) = (ZSENH(JL,JKK)-PGEOH(JL,JKK))*ZRCPD + ZTEX(JL)
(  343)             ZLU (JL,JKK) = 0.0_JPRB
(  344)             ZWU2H(JL,JKK) = ZWS**2+0.1_JPRB
(  345)             PWU2H(JL,JKK) = ZWU2H(JL,JKK)
(  346)         !
(  347)         !  determine buoyancy at lowest half level
(  348)         !
(  349)             ZTVENH            = (1.0_JPRB+RETV*ZQENH(JL,JKK)) &
(  350)              & *(ZSENH(JL,JKK)-PGEOH(JL,JKK))*ZRCPD  
(  351)             ZTVUH             = (1.0_JPRB+RETV*ZQU(JL,JKK))*ZTU(JL,JKK)
(  352)             ZBUOH(JL,JKK) = (ZTVUH-ZTVENH)*RG/ZTVENH
(  353)           ELSE
(  354)             LLGO_ON(JL)=.FALSE.      ! non-convective point
(  355)           ENDIF
(  356)         ENDIF
(  357)       ENDDO
(  358)    
(  359)     ELSE
(  360) # 361 "./cubasen.F90"
(  361)       DO JL=KIDIA,KFDIA
(  362)         IF (LLGO_ON(JL)) THEN
(  363)           ZRHO  = PAPH(JL,JKK+1)/(RD*(PTEN(JL,JKK)*(1.+RETV*PQEN(JL,JKK))))
(  364)           ILAB(JL,JKK)= 1
(  365)           ZTEXC=0.2_JPRB
(  366)           ZQEXC=1.E-4_JPRB
(  367)           IF(JKK==KLEV-1) THEN
(  368)             ZTEXC=MAX(ZTEXC,ZTEX(JL))
(  369)             ZQEXC=MAX(ZQEXC,ZQEX(JL))
(  370)             IF (LDTDKMF) THEN
(  371)                ZTEXC=MIN(ZTEXC, 3.0_JPRB)






