(  422)    !       ------------------------------------------------------------
(  423)    !        1.2  DO THE VERTICAL ASCENT UNTIL VELOCITY BECOMES NEGATIVE
(  424)    !       ------------------------------------------------------------
(  425)   DO JK=JKK-1,JKT2,-1
(  426)     IS=0
(  427) # 428 "./cubasen.F90"
(  428)     IF(JKK==KLEV.OR.KINDEX==KLEV-1) THEN ! 1/z mixing for shallow
(  429) # 430 "./cubasen.F90"






