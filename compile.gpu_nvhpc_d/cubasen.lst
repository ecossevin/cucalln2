(  236)  & ENTSTPC3=>YDECUMF%ENTSTPC3, NJKT2=>YDECUMF%NJKT2, RDEPTHS=>YDECUMF%RDEPTHS)
(  237) ZAW    = 1.0_JPRB
(  238) ZBW    = 1.0_JPRB
(  239) # 240 "./cubasen.F90"
(  240) DO JL=KIDIA,KFDIA
(  241)   PWUBASE(JL)=0.0_JPRB
(  242)   LLGO_ON(JL)=.TRUE.
