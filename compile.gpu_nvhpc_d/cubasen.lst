(  721)   ENDIF
(  722) # 723 "./cubasen.F90"
(  723) ENDDO ! end of big loop for search of departure level     
(  724) # 725 "./cubasen.F90"
(  725)       ! chose maximum CAPE value
(  726) PCAPE(KIDIA:KFDIA) = ZCAPE(KIDIA:KFDIA,1)
(  727) DO JK=2,KLEV
(  728)   DO JL=KIDIA,KFDIA
(  729)     PCAPE(JL) = MAX(PCAPE(JL),ZCAPE(JL,JK))
