(  392)                 ZSUH(JL,JKK)=ZSUH(JL,JKK)+ZSENH(JL,JK)*ZWORK2
(  393)               ENDIF
(  394)             ENDDO
(  395)             ZQU(JL,JKK) =ZQU(JL,JKK) /ZWORK1+ZQEXC
(  396)             ZSUH(JL,JKK)=ZSUH(JL,JKK)/ZWORK1+RCPD*ZTEXC
(  397)             ZTU(JL,JKK) =(ZSUH(JL,JKK)-PGEOH(JL,JKK))*ZRCPD+ZTEXC
(  398)           ENDIF
(  399)           ZWU2H(JL,JKK) = 1.0_JPRB
(  400)         ! PWU2H(JL,JKK) = ZWU2H(JL,JKK)
(  401) # 402 "./cubasen.F90"
(  402)       !
(  403)       !  determine buoyancy at lowest half level
(  404)       !
(  405)           ZTVENH            = (1.0_JPRB+RETV*ZQENH(JL,JKK)) &
(  406)            & *(ZSENH(JL,JKK)-PGEOH(JL,JKK))*ZRCPD  
(  407)           ZTVUH             = (1.0_JPRB+RETV*ZQU(JL,JKK))*ZTU(JL,JKK)
(  408)           ZBUOH(JL,JKK) = (ZTVUH-ZTVENH)*RG/ZTVENH
(  409)         ENDIF
(  410)       ENDDO
(  411)    
(  412)     ENDIF
(  413) # 414 "./cubasen.F90"
