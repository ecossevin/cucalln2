(  699)                 &  / (PGEO(JL, -1 + JK)*ZRG - PGEO(JL, JK)*ZRG) - PTEN(JL, JK) / (PGEO(JL, -1 + JK)*ZRG - PGEO(JL, JK)*ZRG) 
