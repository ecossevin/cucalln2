(  676)                   PMFU(JL, JK) = PMFU(JL, JK + 1) + ZDMFEN(JL) - ZDMFDE(JL)
(  677)                 END IF
(  678)                 
(  679)                 IF (ZBUO(JL, JK) > -0.2_JPRB) THEN
(  680)                   IKB = KCBOT(JL)
