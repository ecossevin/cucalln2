(  662)                 
(  663)                 IF (LDTDKMF) THEN
(  664)                   PKINEU(JL, JK) = (PKINEU(JL, JK + 1)*(1 - ZDKEN) + ZDKBUO) / (1 + ZDKEN)
(  665)                   ZBUOC = ZBUO(JL, JK)
(  666)                 ELSE
(  667)                   PKINEU(JL, JK) = MAX(-1.E3_JPRB, (PKINEU(JL, JK + 1)*(1 - ZDKEN) + ZDKBUO) / (1 + ZDKEN))
(  668)                 END IF
