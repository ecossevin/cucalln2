(  307)     
(  308)     !----------------------------------------------------------------------
(  309)     
(  310)     !     2.           SET DEFAULT VALUES
(  311)     !                  ------------------
(  312)     
(  313)     LLO3 = .false.
(  314)     
(  315) !$acc loop vector
(  316)     DO JL=KIDIA,KFDIA
(  317)       ZLUOLD(JL) = 0.0_JPRB
(  318)       IF (.not.LDCUM(JL)) THEN
(  319)         KCBOT(JL) = -1
(  320)         PMFUB(JL) = 0.0_JPRB
(  321)         PQU(JL, KLEV) = 0.0_JPRB
(  322)         KTYPE(JL) = 0
