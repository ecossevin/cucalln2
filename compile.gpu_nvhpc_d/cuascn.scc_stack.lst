(  297)     Z_CLDMAX = 5.E-3_JPRB
(  298)     Z_CWIFRAC = 0.5_JPRB
(  299)     Z_CPRC2 = 0.5_JPRB
(  300)     Z_CWDRAG = (3._JPRB / 8._JPRB)*0.506_JPRB / 0.2_JPRB
(  301)     
(  302)     IF (YDECUMF%LMFGLAC) THEN
(  303)       ZGLAC = 1.0_JPRB
