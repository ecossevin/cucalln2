(  693)                 ! Erase values if below departure level
(  694)                 IF (JK > KDPL(JL)) THEN
(  695)                   PMFU(JL, JK) = PMFU(JL, JK + 1)
(  696)                   PKINEU(JL, JK) = 0.5_JPRB
