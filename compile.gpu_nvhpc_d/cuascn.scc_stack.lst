(    2) REAL(KIND=JPRB) :: FMINJ, FMAXJ, X, Y
(    3) FMINJ(X,Y) = Y - 0.5_JPRB*(ABS(X-Y)-(X-Y))
(    4) FMAXJ(X,Y) = Y + 0.5_JPRB*(ABS(X-Y)+(X-Y))
