(  329)       
(  330)       !  Prepare SPP
(  331)       IF (YDSPP_CONFIG%LSPP) THEN
(  332)         
(  333)         IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  334)         LLPERT_ENTRORG = IPN > 0
(  335)         IF (LLPERT_ENTRORG) THEN
(  336)           PN1ENTRORG = YDSPP_CONFIG%SM%PN(IPN)
(  337)           IPENTRORG = PN1ENTRORG%MP
(  338)         END IF
(  339)         
(  340)         IPN = YDSPP_CONFIG%PPTR%ENTSHALP






