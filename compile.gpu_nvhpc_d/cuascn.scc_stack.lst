(  398)       !     3.0          INITIALIZE VALUES AT cloud base LEVEL
(  399)       !                  -------------------------------------
(  400)       
(  401)       KCTOP(JL) = KCBOT(JL)
(  402)       IF (LDCUM(JL)) THEN
(  403)         IKB = KCBOT(JL)
(  404)         PKINEU(JL, IKB) = 0.5*PWUBASE(JL)**2
(  405)         PMFU(JL, IKB) = PMFUB(JL)
(  406)         PMFUS(JL, IKB) = PMFUB(JL)*(YDCST%RCPD*PTU(JL, IKB) + PGEOH(JL, IKB))
(  407)         PMFUQ(JL, IKB) = PMFUB(JL)*PQU(JL, IKB)
