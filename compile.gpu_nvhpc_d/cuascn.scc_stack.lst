(  589)                 ! add glaciation of rain
(  590)                 ZFAC = 0.545_JPRB*(TANH(0.17_JPRB*(PTEN(JL, JK) - YDEPHLI%RLPTRC)) + 1.0_JPRB)
(  591)                 PLGLAC(JL, JK) = PLGLAC(JL, JK) + ZFAC*PDMFUP(JL, JK + 1) / MAX(YDECUMF%RMFCMIN, PMFU(JL, JK + 1))*(0.5_JPRB
(  592)                 & SIGN(0.5_JPRB, YDCST%RTT - PTEN(JL, JK)))*ZGLAC
