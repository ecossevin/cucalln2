(  534)             ZSCDE = (YDCST%RCPD*PTU(JL, JK + 1) + PGEOH(JL, JK + 1))*ZDMFDE(JL)
(  535)             ZQUDE = PQU(JL, JK + 1)*ZDMFDE(JL)
