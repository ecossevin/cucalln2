(  566)           IF (YDECUMF%LSCVLIQ) THEN
(  567)             CALL CUADJTQ_LOKI(YDTHF, YDCST, YDEPHLI, KIDIA, KFDIA, KLON, KLEV, IK, ZPH, PTU, PQU, LLFLAG, 6, LSCVFLAG,  &
