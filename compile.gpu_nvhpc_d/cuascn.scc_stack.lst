(  412)     
(  413)     !----------------------------------------------------------------------
(  414)     
(  415)     !     4.           DO ASCENT: SUBCLOUD LAYER (KLAB=1) ,CLOUDS (KLAB=2)
(  416)     !                  BY DOING FIRST DRY-ADIABATIC ASCENT AND THEN
(  417)     !                  BY ADJUSTING T,Q AND L ACCORDINGLY IN *CUADJTQ*,
(  418)     !                  THEN CHECK FOR BUOYANCY AND SET FLAGS ACCORDINGLY
(  419)     !                  -------------------------------------------------
(  420)     
(  421) !$acc loop seq
(  422)     DO JK=KLEV - 1,3,-1
(  423)       
(  424)       !                  SPECIFY CLOUD BASE VALUES FOR MIDLEVEL CONVECTION
(  425)       !                  IN *CUBASMC* IN CASE THERE IS NOT ALREADY CONVECTION
(  426)       !                  ----------------------------------------------------
