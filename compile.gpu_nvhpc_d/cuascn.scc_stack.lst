(  324)       PWMEAN(JL) = 0.0_JPRB
(  325)       ZDPMEAN(JL) = 0.0_JPRB
(  326)       ZOENTR(JL) = 0.0_JPRB
(  327)       LSCVFLAG(JL) = .false.
(  328)       IF (KTYPE(JL) > 1 .and. YDECUMF%LSCVLIQ) LSCVFLAG(JL) = .true.
(  329)       
(  330)       !  Prepare SPP
(  331)       IF (YDSPP_CONFIG%LSPP) THEN
(  332)         
(  333)         IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  334)         LLPERT_ENTRORG = IPN > 0
(  335)         IF (LLPERT_ENTRORG) THEN
(  336)           PN1ENTRORG = YDSPP_CONFIG%SM%PN(IPN)
(  337)           IPENTRORG = PN1ENTRORG%MP
(  338)         END IF
(  339)         






NVFORTRAN (Version     24.5)          03/19/2025  06:55:34      page 26

(  340)         IPN = YDSPP_CONFIG%PPTR%ENTSHALP
(  341)         LLPERT_ENTSHALP = IPN > 0
(  342)         IF (LLPERT_ENTSHALP) THEN
(  343)           PN1ENTSHALP = YDSPP_CONFIG%SM%PN(IPN)
(  344)           IPENTSHALP = PN1ENTSHALP%MP
(  345)         END IF
(  346)         
(  347)         IPN = YDSPP_CONFIG%PPTR%RPRCON
(  348)         LLPERT_RPRCON = IPN > 0
(  349)         IF (LLPERT_RPRCON) THEN
(  350)           PN1RPRCON = YDSPP_CONFIG%SM%PN(IPN)
(  351)           IPRPRCON = PN1RPRCON%MP
(  352)         END IF
(  353)         
(  354)       ELSE
(  355)         LLPERT_ENTRORG = .false.
(  356)         LLPERT_ENTSHALP = .false.
(  357)         LLPERT_RPRCON = .false.
(  358)       END IF
(  359)       
(  360)       
(  361)       ! initalize various quantities
(  362)       ! note that liquid water and kinetic energy at cloud base is
(  363)       ! preserved from cubase
(  364)       
(  365)       LLKLAB = .false.
(  366)       IF (.not.LDCUM(JL) .or. KTYPE(JL) == 3) LLKLAB = .true.
(  367)       
(  368) !$acc loop seq
(  369)       DO JK=1,KLEV
(  370)         IF (JK /= KCBOT(JL)) THEN
(  371)           PLU(JL, JK) = 0.0_JPRB
