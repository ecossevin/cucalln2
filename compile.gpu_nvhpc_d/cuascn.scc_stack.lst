(  373)         PKINEU(JL, JK) = 0.0_JPRB
(  374)         PMFU(JL, JK) = 0.0_JPRB
(  375)         PMFUS(JL, JK) = 0.0_JPRB
(  376)         PMFUQ(JL, JK) = 0.0_JPRB
(  377)         PMFUL(JL, JK) = 0.0_JPRB
(  378)         PWU(JL, JK) = 0.0_JPRB
(  379)         PLUDE(JL, JK) = 0.0_JPRB
