(  479)       
(  480)       IF (LLO3) THEN
(  481)         
(  482)         
(  483) !$acc loop vector
(  484)         DO JL=KIDIA,KFDIA
(  485)           ZQOLD(JL) = 0.0_JPRB
(  486)           !JL=JLX(JLL)
(  487)           IF (LLFLAG(JL)) THEN
(  488)             ZDMFDE(JL) = MIN(ZDMFDE(JL), 0.75_JPRB*PMFU(JL, JK + 1))
(  489)             IF (JK == KCBOT(JL)) THEN
