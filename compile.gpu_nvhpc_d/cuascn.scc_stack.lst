(  428)       IK = JK
(  429)       CALL CUBASMCN_LOKI(YDCST, YDECUMF, KIDIA, KFDIA, KLON, KLEV, IK, PTEN, PQEN, PQSEN, PVERVEL, PGEO, PGEOH, LDCUM, KTYPE,  &
(  430)       & KLAB, KCBOT, PMFU, PMFUB, PLRAIN, PTU, PQU, PLU, PMFUS, PMFUQ, PMFUL, PDMFUP, YDSTACK_L=YLSTACK_L)
(  431)       
(  432)       IS = 0
(  433)       JLM = 0
(  434)       ! also liquid only for ktype=3
(  435)       ! IF(KTYPE(JL)>1.AND.LSCVLIQ) LSCVFLAG(JL)=.TRUE.
(  436)       
(  437) !$acc loop vector
(  438)       DO JL=KIDIA,KFDIA
(  439)         LLFLAG(JL) = .false.
(  440)         ZPRECIP(JL) = 0.0_JPRB
(  441)         LLO1(JL) = .false.
(  442)         IS = IS + KLAB(JL, JK + 1)
(  443)         IF (KLAB(JL, 1 + JK) == 0) KLAB(JL, JK) = 0
(  444)         IF (LDCUM(JL) .and. KLAB(JL, 1 + JK) == 2 .or. KTYPE(JL) == 3 .and. KLAB(JL, 1 + JK) == 1) THEN
(  445)           LLFLAG(JL) = .true.
(  446)           JLM = JLM + 1
(  447)           JLX = JL
(  448)         END IF
(  449)         IF (KLAB(JL, 1 + JK) > 0) THEN
(  450)           LLFLAGUV = .true.
(  451)         ELSE
(  452)           LLFLAGUV = .false.
(  453)         END IF
(  454)         ZPH(JL) = PAPH(JL, JK)
(  455)         IF (KTYPE(JL) == 3 .and. JK == KCBOT(JL)) THEN






NVFORTRAN (Version     24.5)          03/19/2025  06:55:34      page 28

(  456)           ZMFMAX = (PAPH(JL, JK) - PAPH(JL, JK - 1))*ZCONS2
(  457)           IF (PMFUB(JL) > ZMFMAX) THEN
(  458)             ZFAC = ZMFMAX / PMFUB(JL)
(  459)             PMFU(JL, JK + 1) = PMFU(JL, JK + 1)*ZFAC
(  460)             PMFUS(JL, JK + 1) = PMFUS(JL, JK + 1)*ZFAC
(  461)             PMFUQ(JL, JK + 1) = PMFUQ(JL, JK + 1)*ZFAC
(  462)             PMFUB(JL) = ZMFMAX
(  463)           END IF
(  464)         END IF
(  465)       END DO
(  466)       
(  467)       
(  468)       IF (IS > 0) LLO3 = .true.
(  469)       
(  470)       !*                  SPECIFY ENTRAINMENT RATES IN *CUENTR*
(  471)       !                   -------------------------------------
(  472)       
(  473)       IK = JK
(  474)       CALL CUENTR_LOKI(YDCST, YDECUMF, YDSPP_CONFIG, KIDIA, KFDIA, KLON, KLEV, IK, KCBOT, KTYPE, LDCUM, LLO3, PQSEN, PAPH,  &
(  475)       & PGEOH, PMFU, PGP2DSPP, ZDMFEN, ZDMFDE, YDSTACK_L=YLSTACK_L)
(  476)       
(  477)       !                  DO ADIABATIC ASCENT FOR ENTRAINING/DETRAINING PLUME
(  478)       !                  ---------------------------------------------------
(  479)       
(  480)       IF (LLO3) THEN
(  481)         
(  482)         
(  483) !$acc loop vector
(  484)         DO JL=KIDIA,KFDIA
(  485)           ZQOLD(JL) = 0.0_JPRB
(  486)           !JL=JLX(JLL)
(  487)           IF (LLFLAG(JL)) THEN
(  488)             ZDMFDE(JL) = MIN(ZDMFDE(JL), 0.75_JPRB*PMFU(JL, JK + 1))
(  489)             IF (JK == KCBOT(JL)) THEN
(  490)               IF (YDSPP_CONFIG%LSPP .and. LLPERT_ENTRORG) THEN
(  491)                 ZXENTRORG = YDECUMF%ENTRORG*EXP(PN1ENTRORG%MU(1) + PN1ENTRORG%XMAG(1)*PGP2DSPP(JL, IPENTRORG))
(  492)               ELSE
(  493)                 ZXENTRORG = YDECUMF%ENTRORG
(  494)               END IF
(  495)               ZOENTR(JL) = -ZXENTRORG*(MIN(1.0_JPRB, PQEN(JL, JK) / PQSEN(JL, JK)) - YDECUMF%ENTR_RH)*(PGEOH(JL, JK) - PGEOH(JL,  &
(  496)               & JK + 1))*ZRG
(  497)               ZOENTR(JL) = MIN(0.4_JPRB, ZOENTR(JL))*PMFU(JL, JK + 1)
(  498)             END IF
(  499)             IF (JK < KCBOT(JL)) THEN
(  500)               ZMFMAX = (PAPH(JL, JK) - PAPH(JL, JK - 1))*ZCONS2
(  501)               ZXS = MAX(PMFU(JL, JK + 1) - ZMFMAX, 0.0_JPRB)
(  502)               PWMEAN(JL) = PWMEAN(JL) + PKINEU(JL, JK + 1)*(PAP(JL, JK + 1) - PAP(JL, JK))
(  503)               ZDPMEAN(JL) = ZDPMEAN(JL) + PAP(JL, JK + 1) - PAP(JL, JK)
(  504)               ZDMFEN(JL) = ZOENTR(JL)
(  505)               IF (KTYPE(JL) >= 2) THEN
(  506)                 IF (YDSPP_CONFIG%LSPP .and. LLPERT_ENTSHALP) THEN
(  507)                   ZXENTSHALP = YDECUMF%ENTSHALP*EXP(PN1ENTSHALP%MU(1) + PN1ENTSHALP%XMAG(1)*PGP2DSPP(JL, IPENTSHALP))
(  508)                 ELSE
(  509)                   ZXENTSHALP = YDECUMF%ENTSHALP
(  510)                 END IF
(  511)                 ZDMFEN(JL) = ZXENTSHALP*ZDMFEN(JL)
(  512)                 ZDMFDE(JL) = ZDMFEN(JL)
(  513)                 ! ZDMFDE(JL)=MAX(ZDMFDE(JL),ZDMFEN(JL))






NVFORTRAN (Version     24.5)          03/19/2025  06:55:34      page 29

(  514)               END IF
(  515)               ZDMFDE(JL) = ZDMFDE(JL)*(1.6_JPRB - MIN(1.0_JPRB, PQEN(JL, JK) / PQSEN(JL, JK)))
(  516)               ZMFTEST = PMFU(JL, JK + 1) + ZDMFEN(JL) - ZDMFDE(JL)
(  517)               ZCHANGE = MAX(ZMFTEST - ZMFMAX, 0.0_JPRB)
(  518)               ZXE = MAX(ZCHANGE - ZXS, 0.0_JPRB)
(  519)               ZDMFEN(JL) = ZDMFEN(JL) - ZXE
(  520)               ZCHANGE = ZCHANGE - ZXE
(  521)               ZDMFDE(JL) = ZDMFDE(JL) + ZCHANGE
(  522)             END IF
(  523)             
(  524)             PDMFEN(JL, JK) = ZDMFEN(JL) - ZDMFDE(JL)
(  525)             
(  526)             PMFU(JL, JK) = PMFU(JL, JK + 1) + ZDMFEN(JL) - ZDMFDE(JL)
(  527)             ZQEEN = PQENH(JL, JK + 1)*ZDMFEN(JL)
(  528)             ZSEEN = (YDCST%RCPD*PTENH(JL, JK + 1) + PGEOH(JL, JK + 1))*ZDMFEN(JL)
(  529)             IF (PLITOT(JL, JK) > YDECLDP%RLMIN) THEN
(  530)               ZLEEN = PLITOT(JL, JK)*ZDMFEN(JL)
(  531)             ELSE
(  532)               ZLEEN = 0.0_JPRB
(  533)             END IF
(  534)             ZSCDE = (YDCST%RCPD*PTU(JL, JK + 1) + PGEOH(JL, JK + 1))*ZDMFDE(JL)
(  535)             ZQUDE = PQU(JL, JK + 1)*ZDMFDE(JL)
(  536)             PLUDE(JL, JK) = PLU(JL, JK + 1)*ZDMFDE(JL)
(  537)             ZMFUSK = PMFUS(JL, JK + 1) + ZSEEN - ZSCDE
(  538)             ZMFUQK = PMFUQ(JL, JK + 1) + ZQEEN - ZQUDE
(  539)             ZMFULK = PMFUL(JL, JK + 1) + ZLEEN - PLUDE(JL, JK)
(  540)             ZFAC = 1.0_JPRB / MAX(YDECUMF%RMFCMIN, PMFU(JL, JK))
(  541)             PLU(JL, JK) = ZMFULK*ZFAC
(  542)             PQU(JL, JK) = ZMFUQK*ZFAC
(  543)             PTU(JL, JK) = (ZMFUSK*ZFAC - PGEOH(JL, JK))*ZORCPD
(  544)             PTU(JL, JK) = MAX(100._JPRB, PTU(JL, JK))
(  545)             PTU(JL, JK) = MIN(400._JPRB, PTU(JL, JK))
(  546)             ZQOLD(JL) = PQU(JL, JK)
(  547)             PLRAIN(JL, JK) = PLRAIN(JL, JK + 1)*MAX(0.0_JPRB, PMFU(JL, JK + 1) - ZDMFDE(JL))*ZFAC
(  548)             ZLUOLD(JL) = PLU(JL, JK)
(  549)           END IF
(  550)           ! reset to environmental values if below departure level
(  551)           IF (JK > KDPL(JL)) THEN
(  552)             PTU(JL, JK) = PTENH(JL, JK)
(  553)             PQU(JL, JK) = PQENH(JL, JK)
(  554)             PLU(JL, JK) = 0.0_JPRB
(  555)             ZLUOLD(JL) = PLU(JL, JK)
(  556)           END IF
(  557)         END DO
