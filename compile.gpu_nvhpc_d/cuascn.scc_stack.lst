(  997)                   PMFUDE_RATE(JL, JK) = ZDMFDE
(  998)                 END IF
(  999)                 
( 1000)               END IF
( 1001)               
( 1002)               !       ELSEIF(LLFLAG(JL).AND.KTYPE(JL)==2.AND.PQU(JL,JK) == ZQOLD(JL)) THEN
( 1003)             ELSE IF (KTYPE(JL) == 2 .and. PQU(JL, JK) == ZQOLD) THEN
( 1004)               KLAB(JL, JK) = 0
( 1005)               PMFU(JL, JK) = 0.0_JPRB
( 1006)               PKINEU(JL, JK) = 0.0_JPRB
( 1007)               ZDMFDE = PMFU(JL, JK + 1)
( 1008)               PLUDE(JL, JK) = PLU(JL, JK + 1)*ZDMFDE
( 1009)               PMFUDE_RATE(JL, JK) = ZDMFDE
( 1010)               
( 1011)             END IF
( 1012)           END IF
( 1013)           
( 1014)           !              CALCULATE PRECIPITATION RATE BY
( 1015)           !              ANALYTIC INTEGRATION OF EQUATION FOR L
( 1016)           
( 1017)           IF (LLO1) THEN
( 1018)             IF (PLU(JL, JK) > ZDNOPRC) THEN
( 1019)               PWU(JL, JK) = MIN(15._JPRB, SQRT(2.0_JPRB*MAX(0.5_JPRB, PKINEU(JL, JK + 1))))
( 1020)               !       increase conversion for liquid phase only
( 1021)               IF (LDTDKMF) THEN
( 1022)                 ZZCO = FOEALFCU(PTU(JL, JK))*1.3_JPRB + (1.0_JPRB - FOEALFCU(PTU(JL, JK)))
( 1023)               ELSE
( 1024)                 ZZCO = 1.0_JPRB + 0.3_JPRB*FOEALFCU(PTU(JL, JK))
( 1025)               END IF
( 1026)               ! IF(LSCVFLAG(JL)) ZZCO=1.3_JPRB
( 1027)               
( 1028)               IF (YDSPP_CONFIG%LSPP .and. LLPERT_RPRCON) THEN
( 1029)                 ZXPRCDGW = ZPRCDGW*EXP(PN1RPRCON%MU(1) + PN1RPRCON%XMAG(1)*PGP2DSPP(JL, IPRPRCON))
( 1030)               ELSE
( 1031)                 ZXPRCDGW = ZPRCDGW
( 1032)               END IF
( 1033)               ZPRCON = ZXPRCDGW / (0.75_JPRB*PWU(JL, JK))*ZZCO
( 1034)               
( 1035)               !           PARAMETERS FOR BERGERON-FINDEISEN PROCESS (T < -5C)
( 1036)               






NVFORTRAN (Version     24.5)          03/24/2025  13:20:43      page 19

( 1037)               ZDT = MIN(YDTHF%RTBERCU - YDTHF%RTICECU, MAX(YDTHF%RTBERCU - PTU(JL, JK), 0.0_JPRB))
( 1038)               ZCBF = 1 + Z_CPRC2*SQRT(ZDT)
( 1039)               ZZCO = ZPRCON*ZCBF
( 1040)               
( 1041)               IF (YGFL%NACTAERO > 0) THEN
( 1042)                 !         (Prognostic) aerosols in clouds, CCN effect only in pure warm phase
( 1043)                 !         then phases out in mixed phase - ***NOT*** linear physics
( 1044)                 ! CCN number taken at each height from environment
( 1045)                 IF (YDECLDP%LAERLIQAUTOCP) THEN
( 1046)                   ZALFAW = FOEALFCU(PTU(JL, JK))
( 1047)                   ZLCRIT = ZALFAW*PLCRIT_AER(JL, JK) + (1.0_JPRB - ZALFAW)*ZDNOPRC
( 1048)                   ! CCN number determined at cloud base (entrainment ignored)
( 1049)                 ELSE IF (YDECLDP%LAERLIQAUTOCPB) THEN
( 1050)                   ZALFAW = FOEALFCU(PTU(JL, JK))
( 1051)                   ZLCRIT = ZALFAW*PLCRIT_AER(JL, KCBOT(JL)) + (1.0_JPRB - ZALFAW)*ZDNOPRC
( 1052)                 ELSE
( 1053)                   ZLCRIT = ZDNOPRC / ZCBF
( 1054)                 END IF
( 1055)               ELSE
( 1056)                 ZLCRIT = ZDNOPRC / ZCBF
( 1057)               END IF
( 1058)               
( 1059)               ZDFI = PGEOH(JL, JK) - PGEOH(JL, JK + 1)
( 1060)               ZC = (PLU(JL, JK) - ZLUOLD)
( 1061)               ZD = ZZCO*(1.0_JPRB - EXP(-(PLU(JL, JK) / ZLCRIT)**2))*ZDFI
( 1062)               ZINT = EXP(-ZD)
( 1063)               ZLNEW = ZLUOLD*ZINT + ZC / ZD*(1.0_JPRB - ZINT)
( 1064)               ZLNEW = MAX(0.0_JPRB, MIN(PLU(JL, JK), ZLNEW))
( 1065)               ZLNEW = MIN(Z_CLDMAX, ZLNEW)
( 1066)               ZPRECIP = MAX(0.0_JPRB, ZLUOLD + ZC - ZLNEW)
( 1067)               PDMFUP(JL, JK) = ZPRECIP*PMFU(JL, JK)
( 1068)               PLRAIN(JL, JK) = PLRAIN(JL, JK) + ZPRECIP
( 1069)               PLU(JL, JK) = ZLNEW
( 1070)             END IF
( 1071)           END IF
( 1072)           
( 1073)           IF (YDEPHLI%LPHYLIN) THEN
( 1074)             
( 1075)             !DEC$ IVDEP
( 1076)             !NEC$ IVDEP
( 1077)             IF (LLO1) THEN
( 1078)               IF (PLRAIN(JL, JK) > 0.0_JPRB) THEN
( 1079)                 ZVW = 21.18_JPRB*PLRAIN(JL, JK)**0.2_JPRB
( 1080)                 ZVI = Z_CWIFRAC*ZVW
( 1081)                 ZALFAW = MIN(1.0_JPRB, 0.545_JPRB*(TANH(0.17_JPRB*(PTU(JL, JK) - YDEPHLI%RLPTRC)) + 1.0_JPRB))
( 1082)                 ZVV = ZALFAW*ZVW + (1.0_JPRB - ZALFAW)*ZVI
( 1083)                 ZROLD = PLRAIN(JL, JK) - ZPRECIP
( 1084)                 ZC = ZPRECIP
( 1085)                 PWU(JL, JK) = MIN(15._JPRB, SQRT(2.0_JPRB*MAX(0.1_JPRB, PKINEU(JL, JK))))
( 1086)                 ZD = ZVV / PWU(JL, JK)
( 1087)                 ZINT = EXP(-ZD)
( 1088)                 ZRNEW = ZROLD*ZINT + ZC / ZD*(1.0_JPRB - ZINT)
( 1089)                 ZRNEW = MAX(0.0_JPRB, MIN(PLRAIN(JL, JK), ZRNEW))
( 1090)                 PLRAIN(JL, JK) = ZRNEW
( 1091)               END IF
( 1092)             END IF
( 1093)             
( 1094)           ELSE






NVFORTRAN (Version     24.5)          03/24/2025  13:20:43      page 20

( 1095)             
( 1096)             IF (LLO1) THEN
( 1097)               IF (PLRAIN(JL, JK) > 0.0_JPRB) THEN
( 1098)                 ZVW = 21.18_JPRB*PLRAIN(JL, JK)**0.2_JPRB
( 1099)                 ZVI = Z_CWIFRAC*ZVW
( 1100)                 ZALFAW = FOEALFCU(PTU(JL, JK))
( 1101)                 IF (LSCVFLAG(JL)) ZALFAW = 1.0_JPRB
( 1102)                 ZVV = ZALFAW*ZVW + (1.0_JPRB - ZALFAW)*ZVI
( 1103)                 ZROLD = PLRAIN(JL, JK) - ZPRECIP
( 1104)                 ZC = ZPRECIP
( 1105)                 PWU(JL, JK) = MIN(15._JPRB, SQRT(2.0_JPRB*MAX(0.1_JPRB, PKINEU(JL, JK))))
( 1106)                 ZD = ZVV / PWU(JL, JK)
( 1107)                 ZINT = EXP(-ZD)
( 1108)                 ZRNEW = ZROLD*ZINT + ZC / ZD*(1.0_JPRB - ZINT)
( 1109)                 ZRNEW = MAX(0.0_JPRB, MIN(PLRAIN(JL, JK), ZRNEW))
( 1110)                 PLRAIN(JL, JK) = ZRNEW
( 1111)               END IF
( 1112)             END IF
( 1113)             
( 1114)           END IF
( 1115)           
( 1116)           !JL=JLX(JLL)
( 1117)           IF (LLFLAG) THEN
( 1118)             PMFUL(JL, JK) = PLU(JL, JK)*PMFU(JL, JK)
( 1119)             PMFUS(JL, JK) = (YDCST%RCPD*PTU(JL, JK) + PGEOH(JL, JK))*PMFU(JL, JK)
( 1120)             PMFUQ(JL, JK) = PQU(JL, JK)*PMFU(JL, JK)
( 1121)             ZALFAW = FOEALFCU(PTU(JL, JK))
( 1122)             IF (LSCVFLAG(JL)) ZALFAW = 1.0_JPRB
( 1123)             PLUDELI(JL, JK, 1) = ZALFAW*PLUDE(JL, JK)
( 1124)             PLUDELI(JL, JK, 2) = (1.0_JPRB - ZALFAW)*PLUDE(JL, JK)
( 1125)           END IF
( 1126)           
( 1127)         END IF
( 1128)       END DO
( 1129)       
( 1130)       !----------------------------------------------------------------------
( 1131)       
( 1132)       !     5.           FINAL CALCULATIONS
( 1133)       !                  ------------------
( 1134)       
( 1135)       IF (KCTOP(JL) == -1) LDCUM(JL) = .false.
( 1136)       KCBOT(JL) = MAX(KCBOT(JL), KCTOP(JL))
( 1137)       IF (LDCUM(JL)) THEN
( 1138)         PWMEAN(JL) = MAX(1.E-2_JPRB, PWMEAN(JL) / MAX(1.0_JPRB, ZDPMEAN))
( 1139)         PWMEAN(JL) = SQRT(2.0_JPRB*PWMEAN(JL))
( 1140)       END IF
( 1141)     END DO
