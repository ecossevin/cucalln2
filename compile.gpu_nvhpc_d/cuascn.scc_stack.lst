(  491)                 ZXENTRORG = YDECUMF%ENTRORG*EXP(PN1ENTRORG%MU(1) + PN1ENTRORG%XMAG(1)*PGP2DSPP(JL, IPENTRORG))
(  492)               ELSE
(  493)                 ZXENTRORG = YDECUMF%ENTRORG
(  494)               END IF
(  495)               ZOENTR(JL) = -ZXENTRORG*(MIN(1.0_JPRB, PQEN(JL, JK) / PQSEN(JL, JK)) - YDECUMF%ENTR_RH)*(PGEOH(JL, JK) - PGEOH
(  496)               & JK + 1))*ZRG
