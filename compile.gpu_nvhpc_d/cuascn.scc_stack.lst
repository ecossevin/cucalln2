(    1) !OPTIONS XOPT(HSFUN)
(    2) MODULE CUASCN_LOKI_MOD
(    3)   CONTAINS
(    4)   SUBROUTINE CUASCN_LOKI (YDTHF, YDCST, YDEPHLI, YDECLDP, YDECUMF, YDSPP_CONFIG, YGFL, KIDIA, KFDIA, KLON, KLEV, LDTDKMF,  &
(    5)   & PTSPHY, PTENH, PQENH, PUEN, PVEN, PTEN, PQEN, PQSEN, PLITOT, PGEO, PGEOH, PAP, PAPH, PVERVEL, PWUBASE, PGP2DSPP, LDLAND,
(    6)   & LDCUM, KTYPE, KLAB, LSCVFLAG, PTU, PQU, PLU, PLRAIN, PMFU, PMFUB, PLGLAC, PMFUS, PMFUQ, PMFUL, PLUDE, PLUDELI, PDMFUP,  
(    7)   & PLCRIT_AER, PDMFEN, KCBOT, KCTOP, KCTOP0, KDPL, PMFUDE_RATE, PKINEU, PWU, PWMEAN, YDSTACK_L)
(    8)     
(    9)     !          THIS ROUTINE DOES THE CALCULATIONS FOR CLOUD ASCENTS
(   10)     !          FOR CUMULUS PARAMETERIZATION
(   11)     
(   12)     !          PURPOSE.
(   13)     !          --------
(   14)     !          TO PRODUCE CLOUD ASCENTS FOR CU-PARAMETRIZATION
(   15)     !          (VERTICAL PROFILES OF T,Q,L,U AND V AND CORRESPONDING
(   16)     !           FLUXES AS WELL AS PRECIPITATION RATES)
(   17)     
(   18)     !          INTERFACE
(   19)     !          ---------
(   20)     
(   21)     !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   22)     
(   23)     !          METHOD.
(   24)     !          --------
(   25)     !          LIFT SURFACE AIR DRY-ADIABATICALLY TO CLOUD BASE
(   26)     !          AND THEN CALCULATE MOIST ASCENT FOR
(   27)     !          ENTRAINING/DETRAINING PLUME.
(   28)     !          ENTRAINMENT AND DETRAINMENT RATES DIFFER FOR
(   29)     !          SHALLOW AND DEEP CUMULUS CONVECTION.
(   30)     !          IN CASE THERE IS NO PENETRATIVE OR SHALLOW CONVECTION
(   31)     !          CHECK FOR POSSIBILITY OF MID LEVEL CONVECTION
(   32)     !          (CLOUD BASE VALUES CALCULATED IN *CUBASMC*)
(   33)     
(   34)     !     PARAMETER     DESCRIPTION                                   UNITS
(   35)     !     ---------     -----------                                   -----
(   36)     !     INPUT PARAMETERS (INTEGER):
(   37)     
(   38)     !    *KIDIA*        START POINT
(   39)     !    *KFDIA*        END POINT
(   40)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   41)     !    *KLEV*         NUMBER OF LEVELS
(   42)     !    *KTYPE*        TYPE OF CONVECTION
(   43)     !                       1 = PENETRATIVE CONVECTION
(   44)     !                       2 = SHALLOW CONVECTION
(   45)     !                       3 = MIDLEVEL CONVECTION
(   46)     !    *KCBOT*        CLOUD BASE LEVEL
(   47)     !    *KDPL*         DEPARTURE LEVEL FOR CONVECTION
(   48)     
(   49)     !    INPUT PARAMETERS (REAL):
(   50)     






NVFORTRAN (Version     24.5)          03/24/2025  13:20:43      page 2

(   51)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                      S
(   52)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS          K
(   53)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS     KG/KG
(   54)     !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)      M/S
(   55)     !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)      M/S
(   56)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)      K
(   57)     !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1) KG/KG
(   58)     !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)  KG/KG
(   59)     !    *PGEO*         GEOPOTENTIAL                                 M2/S2
(   60)     !    *PLITOT*       GRID MEAN LIQUID WATER+ICE CONTENT           KG/KG
(   61)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                  M2/S2
(   62)     !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS           PA
(   63)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   64)     !    *PVERVEL*      VERTICAL VELOCITY                            PA/S
(   65)     !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   66)     !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(   67)     
(   68)     !    INPUT PARAMETERS (LOGICAL):
(   69)     
(   70)     !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   71)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   72)     !    *LDTDKMF*      Arpege tuning (if TRUE)
(   73)     
(   74)     !    UPDATED PARAMETERS (INTEGER):
(   75)     
(   76)     !    *KLAB*         FLAG KLAB=1 FOR SUBCLOUD LEVELS
(   77)     !                        KLAB=2 FOR CLOUD LEVELS
(   78)     
(   79)     !    UPDATED PARAMETERS (REAL):
(   80)     
(   81)     !    *PTU*          TEMPERATURE IN UPDRAFTS                        K
(   82)     !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                   KG/KG
(   83)     !    *PLU*          LIQUID WATER CONTENT IN UPDRAFTS             KG/KG
(   84)     !    *PLRAIN*       RAIN   WATER CONTENT IN UPDRAFTS             KG/KG
(   85)     
(   86)     !    OUTPUT PARAMETERS (INTEGER):
(   87)     
(   88)     !    *KCTOP*        CLOUD TOP LEVEL
(   89)     !    *KCTOP0*       FIRST GUESS OF CLOUD TOP LEVEL
(   90)     !    *LSCVFLAG*     MASK FOR LIQUID ONLY SHALLOW
(   91)     
(   92)     !    OUTPUT PARAMETERS (REAL):
(   93)     
(   94)     !    *PMFU*         MASSFLUX IN UPDRAFTS                         KG/(M2*S)
(   95)     !    *PMFUB*        MASSFLUX IN UPDRAFTS AT CLOUD BASE           KG/(M2*S)
(   96)     !    *PMFUS*        FLUX OF DRY STATIC ENERGY IN UPDRAFTS         J/(M2*S)
(   97)     !    *PMFUQ*        FLUX OF SPEC. HUMIDITY IN UPDRAFTS           KG/(M2*S)
(   98)     !    *PMFUL*        FLUX OF LIQUID WATER IN UPDRAFTS             KG/(M2*S)
(   99)     !    *PLUDE*        DETRAINED TOTAL CONDENSATE                   KG/(M2*S)
(  100)     !    *PLUDELI*      DETRAINED LIQUID, ICE                        KG/(M2*S)
(  101)     !    *PLGLAC*       FROZEN CLOUD WATER/RAIN CONTENT              KG/KG
(  102)     !    *PDMFUP*       FLUX DIFFERENCE OF PRECIP. IN UPDRAFTS       KG/(M2*S)
(  103)     !    *PMFUDE_RATE*  UPDRAFT DETRAINMENT RATE                     KG/(M2*S)
(  104)     !    *PKINEU*       UPDRAFT KINETIC ENERGY                       M2/S2
(  105)     !    *PWMEAN*       MEAN UPDRAUGHT VELOCITY                      M/S
(  106)     
(  107)     !          EXTERNALS
(  108)     !          ---------






