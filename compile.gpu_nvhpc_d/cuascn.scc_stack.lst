(  657)                 IF (ZDMFEN(JL) > 0.0_JPRB) THEN
(  658)                   ZDKEN = MIN(1.0_JPRB, (1 + Z_CWDRAG)*ZDMFEN(JL) / MAX(YDECUMF%RMFCMIN, PMFU(JL, JK + 1)))
(  659)                 ELSE
(  660)                   ZDKEN = MIN(1.0_JPRB, (1 + Z_CWDRAG)*ZDMFDE(JL) / MAX(YDECUMF%RMFCMIN, PMFU(JL, JK + 1)))
