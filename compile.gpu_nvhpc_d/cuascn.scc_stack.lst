(  282) !$acc & LDLAND, LDCUM, KTYPE, KLAB, LSCVFLAG, PTU, PQU, PLU, PLRAIN, PMFU, PMFUB, PLGLAC, PMFUS, PMFUQ, PMFUL, PLUDE, PLUDELI,  &
(  283) !$acc & PDMFUP, PLCRIT_AER, PDMFEN, KCBOT, KCTOP, KCTOP0, KDPL, PMFUDE_RATE, PKINEU, PWU, PWMEAN, YDTHF, YDCST, YDEPHLI,  &
(  284) !$acc & YDECLDP, YDECUMF, YDSPP_CONFIG, YGFL )
(  285)     !----------------------------------------------------------------------
(  286)     
(  287)     !*    1.           SPECIFY PARAMETERS
(  288)     !                  ------------------
(  289)     
(  290)     
(  291)     ZCONS2 = YDECUMF%RMFCFL / (YDCST%RG*PTSPHY)
(  292)     ZRG = 1.0_JPRB / YDCST%RG
