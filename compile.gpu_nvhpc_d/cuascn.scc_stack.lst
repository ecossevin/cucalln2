(  381)         PLUDELI(JL, JK, 2) = 0.0_JPRB
(  382)         PLGLAC(JL, JK) = 0.0_JPRB
(  383)         PDMFUP(JL, JK) = 0.0_JPRB
(  384)         PLRAIN(JL, JK) = 0.0_JPRB
(  385)         ZBUO(JL, JK) = 0.0_JPRB
(  386)         IF (LLKLAB) KLAB(JL, JK) = 0
(  387)         IF (.not.LDCUM(JL) .and. PAPH(JL, JK) < 4.E4_JPRB) KCTOP0(JL) = JK
(  388)         PDMFEN(JL, JK) = 0.0_JPRB
(  389)         PMFUDE_RATE(JL, JK) = 0.0_JPRB
