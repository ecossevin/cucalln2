(  670)                   ZKEDKE = PKINEU(JL, JK) / MAX(1.E-3_JPRB, PKINEU(JL, JK + 1))
(  671)                   ZKEDKE = MAX(0.0_JPRB, MIN(1.0_JPRB, ZKEDKE))
(  672)                   ZOCUDET = (1.6_JPRB - MIN(1.0_JPRB, PQEN(JL, JK) / PQSEN(JL, JK)))
(  673)                   ZMFUN = ZOCUDET*SQRT(ZKEDKE)
