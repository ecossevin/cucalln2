(  514)               END IF






NVFORTRAN (Version     24.5)          03/19/2025  06:55:34      page 10

(  515)               ZDMFDE(JL) = ZDMFDE(JL)*(1.6_JPRB - MIN(1.0_JPRB, PQEN(JL, JK) / PQSEN(JL, JK)))
(  516)               ZMFTEST = PMFU(JL, JK + 1) + ZDMFEN(JL) - ZDMFDE(JL)
(  517)               ZCHANGE = MAX(ZMFTEST - ZMFMAX, 0.0_JPRB)
(  518)               ZXE = MAX(ZCHANGE - ZXS, 0.0_JPRB)
(  519)               ZDMFEN(JL) = ZDMFEN(JL) - ZXE
