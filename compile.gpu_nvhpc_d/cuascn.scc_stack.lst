(  470)       !*                  SPECIFY ENTRAINMENT RATES IN *CUENTR*
(  471)       !                   -------------------------------------
(  472)       
(  473)       IK = JK
(  474)       CALL CUENTR_LOKI(YDCST, YDECUMF, YDSPP_CONFIG, KIDIA, KFDIA, KLON, KLEV, IK, KCBOT, KTYPE, LDCUM, LLO3, PQSEN, PAPH,  
(  475)       & PGEOH, PMFU, PGP2DSPP, ZDMFEN, ZDMFDE, YDSTACK_L=YLSTACK_L)
