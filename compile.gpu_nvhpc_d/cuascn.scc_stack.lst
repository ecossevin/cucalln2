(  574)         
(  575)         
(  576) !$acc loop vector
(  577)         DO JL=KIDIA,KFDIA
(  578)           IF (YDEPHLI%LPHYLIN) THEN
(  579)             
(  580)             !DIR$ IVDEP
(  581)             !NEC$ IVDEP
(  582)             !OCL NOVREC
(  583)             !JL=JLX(JLL)
(  584)             IF (LLFLAG(JL)) THEN
