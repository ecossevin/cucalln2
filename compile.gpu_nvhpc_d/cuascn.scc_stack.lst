(  310)       IF (KTYPE(JL) > 1 .and. YDECUMF%LSCVLIQ) LSCVFLAG(JL) = .true.
(  311)       
(  312)       !  Prepare SPP
(  313)       IF (YDSPP_CONFIG%LSPP) THEN
(  314)         
(  315)         IPN = YDSPP_CONFIG%PPTR%ENTRORG
(  316)         LLPERT_ENTRORG = IPN > 0
(  317)         IF (LLPERT_ENTRORG) THEN
(  318)           PN1ENTRORG = YDSPP_CONFIG%SM%PN(IPN)
(  319)           IPENTRORG = PN1ENTRORG%MP
