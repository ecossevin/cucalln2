(   12)     
(   13)     !          PURPOSE.
(   14)     !          --------
(   15)     !          TO PRODUCE T,Q AND L VALUES FOR CLOUD ASCENT
(   16)     
(   17)     !          INTERFACE
(   18)     !          ---------
(   19)     !          THIS ROUTINE IS CALLED FROM SUBROUTINES:
(   20)     !              *COND*     (T AND Q AT CONDENSATION LEVEL)
(   21)     !              *CUBASE*   (T AND Q AT CONDENSATION LEVEL)
(   22)     !              *CUASC*    (T AND Q AT CLOUD LEVELS)
(   23)     !              *CUINI*    (ENVIRONMENTAL T AND QS VALUES AT HALF LEVELS)
(   24)     !              *CUSTRAT*  (T AND Q AT CONDENSATION LEVEL)
(   25)     !          INPUT ARE UNADJUSTED T AND Q VALUES,
(   26)     !          IT RETURNS ADJUSTED VALUES OF T AND Q
(   27)     
(   28)     !     PARAMETER     DESCRIPTION                                   UNITS
(   29)     !     ---------     -----------                                   -----
(   30)     !     INPUT PARAMETERS (INTEGER):
(   31)     
(   32)     !    *KIDIA*        START POINT
(   33)     !    *KFDIA*        END POINT
(   34)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   35)     !    *KLEV*         NUMBER OF LEVELS
(   36)     !    *KK*           LEVEL
(   37)     !    *KCALL*        DEFINES CALCULATION AS
(   38)     !                      KCALL=0  ENV. T AND QS IN*CUINI*
(   39)     !                      KCALL=1  CONDENSATION IN UPDRAFTS  (E.G. CUBASE, CUASC)
(   40)     !                      KCALL=2  EVAPORATION IN DOWNDRAFTS (E.G. CUDLFS,CUDDRAF)
(   41)     
(   42)     !     INPUT PARAMETERS (LOGICAL):
(   43)     
(   44)     !    *LDLAND*       LAND-SEA MASK (.TRUE. FOR LAND POINTS)
(   45)     
(   46)     !     INPUT PARAMETERS (REAL):
(   47)     
(   48)     !    *PSP*          PRESSURE                                        PA
(   49)     
(   50)     !     UPDATED PARAMETERS (REAL):
(   51)     
(   52)     !    *PT*           TEMPERATURE                                     K
(   53)     !    *PQ*           SPECIFIC HUMIDITY                             KG/KG
(   54)     
(   55)     !          EXTERNALS
(   56)     !          ---------
(   57)     !          3 LOOKUP TABLES ( TLUCUA, TLUCUB, TLUCUC )






