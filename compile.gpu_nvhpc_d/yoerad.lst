(  192) !  NAME     TYPE     PURPOSE
(  193) !  ----  :  ----   : ---------------------------------------------------
(  194) ! LERAD1H: LOGICAL : .T. TO ALLOW MORE FREQUENT RADIATION CALCULATIONS
(  195) !                  : DURING FIRST N HOURS OF FORECAST
(  196) ! NLNGR1H: INTEGER : NUMBER FORECAST HOURS DURING WHICH MORE FREQUENT
(  197) !                    RADIATION CALCULATIONS ARE REQUIRED
(  198) ! LEPO3RA: LOGICAL : .T. IF PROGNOSTIC OZONE (EC) IS PASSED TO RADIATION
(  199) ! NAER   : INTEGER : CONFIGURATION INDEX FOR AEROSOLS
(  200) ! NMODE  : INTEGER : CONFIGURATION FOR RADIATION CODE: FLUX VS. RADIANCE
(  201) ! NOZOCL : INTEGER : CHOICE OF OZONE/GHG CLIMATOLOGY (0: old O3, 1: new O3, 2: O3 climatological profile, 
(  202) !                                                 3-4: MACC/CAMS O3 and GHG monthly climatology,
(  203) !                                                 5-6: 3D concentrations of O3 and GHG from chemistry scheme)
(  204) ! NRADFR : INTEGER : FREQUENCY OF FULL RADIATION COMPUTATIONS
(  205) !                    IF(NRADFR.GT.0): RAD EVERY 'NRADFR' TIME-STEPS
(  206) !                    IF(NRADFR.LT.0): RAD EVERY '-NRADFR' HOURS
(  207) ! NRADPFR: INTEGER : PRINT FREQUENCY FOR RAD.STATISTICS (in RAD.T.STEPS)
(  208) ! NRADPLA: INTEGER : PRINT RAD.STATISTICS EVERY 'NRADPLA' ROWS
(  209) ! NRADINT: INTEGER : RADIATION INTERPOLATION METHOD
(  210) !                  : 1 = SPECTRAL TRANSFORM INTERPOLATION
(  211) !                  : 2 =  4 POINT HORIZONTAL INTERPOLATION
(  212) !                  : 3 = 12 POINT HORIZONTAL INTERPOLATION
(  213) ! NRADRES: INTEGER : RADIATION GRID SPECTRAL RESOLUTION
(  214) ! NRADNFR: INTEGER : NORMAL   FREQUENCY OF RADIATION STEPS
(  215) ! NRADSFR: INTEGER : START-UP FREQUENCY OF RADIATION STEPS
(  216) ! NRADE1H: INTEGER : START-UP FREQUENCY OF RADIATION STEPS FOR EPS
(  217) ! NRADE3H: INTEGER : SUBSEQUENT FREQUENCY OF RADIATION STEPS FOR EPS
(  218) ! NRADELG: INTEGER : LENGTH IN HOURS DURING WHICH THE FREQUENCY OF RADIATION IS INCREASED FOR EPS
(  219) ! NOVLP  : INTEGER : CLOUD OVERLAP CONFIGURATION IN PRE-MCRAD/ECRAD SCHEME
(  220) !                  : 1 = Max-rand (Geleyn & Hollingsworth)
(  221) !                  : 2 = Maximum
(  222) !                  : 3 = Random
(  223) ! NRPROMA: INTEGER : VECTOR LENGTH FOR RADIATION CALCULATIONS
(  224) ! NSW    : INTEGER : NUMBER OF SHORTWAVE SPECTRAL INTERVALS
(  225) ! NSWNL  : INTEGER : NUMBER OF SHORTWAVE SPECTRAL INTERVALS IN NL MODEL
(  226) ! NSWTL  : INTEGER : NUMBER OF SHORTWAVE SPECTRAL INTERVALS IN TL MODEL
(  227) ! NTLW   : INTEGER : MAXIMUM POSSIBLE NUMBER OF LW SPECTRAL INTERVALS 
(  228) ! NTSW   : INTEGER : MAXIMUM POSSIBLE NUMBER OF SW SPECTRAL INTERVALS 
(  229) ! NUV    : INTEGER : NUMBER OF UV SPECTRAL INTERVALS FOR THE UV PROCESSOR   
(  230) ! LOPTRPROMA:LOGICAL: .T. NRPROMA will be optimised
(  231) !                   : .F. NRPROMA will not be optimised (forced






