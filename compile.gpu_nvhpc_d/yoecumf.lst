(   84) 
(   85) !     NAME      TYPE      PURPOSE
(   86) !     ----      ----      -------
(   87) 
(   88) !     LMFPEN    LOGICAL  TRUE IF PENETRATIVE CONVECTION IS SWITCHED ON
(   89) !     LMFSCV    LOGICAL  TRUE IF SHALLOW     CONVECTION IS SWITCHED ON
(   90) !     LMFMID    LOGICAL  TRUE IF MIDLEVEL    CONVECTION IS SWITCHED ON
(   91) !     LMFDD     LOGICAL  TRUE IF CUMULUS DOWNDRAFT      IS SWITCHED ON
(   92) !     LMFDUDV   LOGICAL  TRUE IF CUMULUS FRICTION       IS SWITCHED ON
(   93) !     LMFDSNOW  LOGICAL  TRUE IF SNOW DETRAINMENT       IS SWITCHED ON
(   94) !     LMFWETB   LOGICAL  TRUE IF WET-BULB T FOR MELTING IS SWITCHED ON
(   95) !     LMFGLAC   LOGICAL  TRUE IF GLACIATION OF RAIN IN UPDRAUGHT IS SWITCHED ON
(   96) !     LSCVLIQ   LOGICAL  TRUE IF CONDENSATION FOR SHALLOW WITH RESPECT TO LIQUID ONLY
(   97) !     LMFUVDIS  LOGICAL  TRUE IF KIN.ENERGY DISSIPATION BY CUMULUS FRICTION IS SWITCHED ON
(   98) !     LMFENTHCONS LOGIC  TRUE IF CORRECTION FOR ENTHALPY CONSERVATION
(   99) !     LMFSMOOTH LOGICAL  TRUE IF MASS FLUXES TOP/BOTTOM SMOOTHED FOR TRACER TRANSPORT
(  100) !     LMFWSTAR  LOGICAL  TRUE IF GRANT W* CLOSURE USED FOR SHALLOW
(  101) !     LMFCUCA   LOGICAL  TRUE IF BASE MASSFLUX MODULATED BY CA OR 2D ADVECT FIELD
(  102) !     LMFPROFP  LOGICAL  TRUE IF INPUT T,Q PROFILES ARE PERTURBED
(  103) !     LNEWTAU   LOGICAL  TRUE NEW FORMULATION OF DEPENDANCE TO RESOLUTION
(  104) !     RXMIN     REAL     TUNING OF LNEWTAU FORMULATION
(  105) !     RTAULIM   REAL     TUNING OF LNEWTAU FORMULATION
(  106) !     RTAUFAC   REAL     TUNING OF LNEWTAU FORMULATION
(  107) !     ENTRORG   REAL     ENTRAINMENT RATE (POSITIVE BUOYANT CONVECTION)
(  108) !     ENTR_RH   REAL     DEPENDENCE OF THE ENTRAINMENT TO HUMIDITY






NVFORTRAN (Version     24.5)          03/19/2025  06:54:21      page 3

(  109) !     ENTSHALP  REAL     SHALLOW ENTRAINMENT DEFINED AS ENTSHALP*ENTRORG
(  110) !     ENTSTPC1  REAL     SHALLOW ENTRAINMENT TEST PARCEL ENTRAINMENTcst 1
(  111) !     ENTSTPC2  REAL     SHALLOW ENTRAINMENT TEST PARCEL ENTRAINMENTcst 2
(  112) !     ENTSTPC3  REAL     ADDITIONAL SHALLOW ENTRAINMENT FACTOR FOR INVERSION HEIGHT COMPUTATION
(  113) !     ENTRDD    REAL     ENTRAINMENT RATE FOR CUMULUS DOWNDRAFTS
(  114) !     DETRPEN   REAL     DETRAINMENT RATE FOR PENETRATIVE CONVECTION
(  115) !     RMFCMIN   REAL     MINIMUM MASSFLUX VALUE (FOR SAFETY)
(  116) !     RMFDEPS   REAL     FRACTIONAL MASSFLUX FOR DOWNDRAFTS AT LFS
(  117) !     RDEPTHS   REAL     MAXIMUM ALLOWED CLOUD THICKNESS FOR SHALLOW
(  118) !     RPRCON    REAL     COEFFICIENTS FOR DETERMINING CONVERSION
(  119) !                        FROM CLOUD WATER TO RAIN
(  120) !     RCPECONS  REAL     COEFFICIENT FOR RAIN EVAPORATION BELOW CLOUD
(  121) !     RCUCOV    REAL     CONVECTIVE CLOUD COVER FOR RAIN EVPORATION
(  122) !     RTAUMEL   REAL     TIME CONSTANT FOR MELTING
(  123) !     RHEBC     REAL     REL. HUMIDITY BELOW CLOUD FOR WHICH EVAPORATION STARTS
(  124) !     RTAUA     REAL     OPTIMISATION FACTOR FOR ADJUSTMENT TIME SCALE
(  125) !     RCAPDCYCL REAL     DIURNAL CYCLE MODULATION FOR CAPE
(  126) !                        0:NO  1:SURFACE SENS HEAT FLUX 2: SUBCLOUD CAPE
(  127) !     RCAPQADV  REAL     ADDITIONSL MOISTURE ADVECTION TERM FOR 'CAPE'
(  128) !                        0:NO  1:YES
(  129) !     RMINCAPE  REAL     FRACTION OF CAPE THAT IS ALWAYS ADJUSTED
(  130) !     RTAU0     REAL     PRORTIONALITY FACTOR USED FOR RCAPDCYCL TIME SCALE
(  131) !     RMFCFL    REAL     MULTIPLE OF CFL STABILITY CRITERIUM 
(  132) !     RMFLIA    REAL     VALUE OF ABSOLUT MASS FLUX LIMIT
(  133) !     RMFSOLCT  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR TRACERS
(  134) !                        0 : EXPLICIT  0-1 : SEMI-IMPLICIT >=1 : FULLY IMPLICIT
(  135) !     RMFSOLUV  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR MOMENTUM
(  136) !     RMFSOLTQ  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR T AND Q
(  137) !     RMFSOLRHS REAL     INCLUDE (1) OR NOT (0) MODEL TENDENCY AT RHS OF IMPLICIT SOLVER
(  138) !     RMFADVW   REAL     FRACTION OF SUBSIDENCE FROM CUMULUS TO BE DONE BY DYNAMICS
(  139) !     RMFADVWDD REAL     FRACTION OF DDMASS FLUX USED IN DYNAMICS/DIVERGENCE IF RMFADVW>0
(  140) !     RUVPER    REAL     UPDRAIGHT VELOCITY PERTURBATION AT KLEV FOR IMPLICIT
(  141) !     NJKT1, NJKT2, NJKT3-6 INTEGER  LEVEL LIMITS FOR CUBASEN/CUDDR, DIAGNOSTICS
(  142) !     RCVRFACTOR REAL    KESSLER FACTOR=5.09E-3 FOR EVAPORATION OF CONVECTIVE RAIN  (KESSLER,1969)
(  143) !     RBASE0    REAL     CLOUD BASE HEIGHT LIMIT FOR WHEN TO USE BITMAP IN POST PROCESSING
(  144) !     RMINCIN   REAL     MINIMUMB CONVECTIVE INHIBITION VALULE FOR BITMAP IN POST PROCESSING
(  145) !     ----------------------------------------------------------------
(  146) 
(  147) END MODULE YOECUMF

























