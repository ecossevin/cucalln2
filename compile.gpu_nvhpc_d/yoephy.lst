(  211) 
(  212) !  NAME     TYPE     PURPOSE
(  213) !  ----  :  ----   : ---------------------------------------------------
(  214) ! LEPHYS : LOGICAL : SWITCH THE FULL E.C.M.W.F. PHYSICS PACKAGE ON
(  215) ! LAGPHY : LOGICAL : IF TRUE, PHYSICS PACKAGE CALLED IN LAGGED MODE
(  216) ! LECOND : LOGICAL : TURN THE LARGE-SCALE CONDENSATION ON
(  217) ! LECUMF : LOGICAL : TURN THE MASS-FLUX CUMULUS CONVECTION SCHEME ON
(  218) ! LEDCLD : LOGICAL : TURN THE DIAGNOSTIC CLOUD SCHEME ON
(  219) ! LEPCLD : LOGICAL : TURN THE PROGNOSTIC CLOUD SCHEME ON
(  220) ! LEEVAP : LOGICAL : TURN THE EVAPORATION OF PRECIPITATION ON
(  221) ! LEGWDG : LOGICAL : TURN THE GRAVITY WAVE DRAG ON
(  222) ! LEGWWMS: LOGICAL : TURN THE WARNER-MCINTYRE-SCINOCCA NON-OROGRAPHIC GRAVITY WAVE SCHEME ON
(  223) ! LEOZOC : LOGICAL : TURN THE CLIMATOLOGICAL OZONE ON
(  224) ! LEQNGT : LOGICAL : TURN THE NEGATIVE HUMIDITY FIXER ON






NVFORTRAN (Version     24.5)          03/19/2025  06:54:20      page 5

(  225) ! LERADI : LOGICAL : TURN THE RADIATION SCHEME ON
(  226) ! LERADIMPL : LOGICAL : TURN THE RADIATION SCHEME TO BECOME IMPLICIT (VALID AT t+dt)
(  227) ! LERADS : LOGICAL : TURN THE INTERACTIVE SURFACE RADIATIVE PROPERTIESON
(  228) ! LESICE : LOGICAL : TURN THE INTERACTIVE SEA ICE PROCESSES ON
(  229) ! LESURF : LOGICAL : TURN THE INTERACTIVE SURFACE PROCESSES ON
(  230) ! LEVDIF : LOGICAL : TURN THE VERTICAL DIFFUSION ON
(  231) ! LEVDIFSL  : LOGICAL : USE THE UPDATED STATE FOR VERTICAL DIFFUSION
(  232) ! LEO3CH : LOGICAL : TURN THE O3 CHEMISTRY ON (for EC prog. ozone)
(  233) ! LO3CH_SAFE : LOGICAL : TURN INCREASED RELAXATION TO O3 TERM 
(  234) ! LO3CH_HLO  : LOGICAL : USE HYBRID LINEAR OZONE SCHEME
(  235) ! CO3CHEM    : CHARACTER(LEN=4) : OZONE CHEMISTRY VERSION
(  236) ! LO3CH_OLDVER : LOGICAL : USE OLD VERSION (v2.3) OF OZONE CHEMISTRY
(  237) ! LNEEONLINE: LOGICAL: USE ON-LINE CTESSEL IF TRUE 
(  238) ! LWETONLINE: LOGICAL: USE ON-LINE CTESSEL IF TRUE 
(  239) ! LBFASCO2 : LOGICAL : APPLY THE FLUX ADJUSTMENT TO GPP AND REC IN CTESSEL
(  240) ! LBUD23 : LOGICAL : SWITCH FOR 3 AND 2 DIMENSIONAL BUDGETS 
(  241) ! LPPTILES : LOGICAL : SWITCH FOR TILE POST-PROCESSING
(  242) ! LBUDCYCLE: LOGICL: SWITCH FOR DIURNAL CYCLE DIAGNOSTICS
(  243) ! LEXTRATEND: LOGICAL: SWITCH FOR EXTRA TENDENCY DIAGNOSTICS (ENS)
(  244) ! LEMETHOX: LOGICAL: TURN THE METHANE OXIDATION ON
(  245) ! LECURR : LOGICAL : IF TRUE, OCEAN CURRENT BOUNDARY CONDITION IS USED
(  246) ! LVDFTRAC: LOGICAL: TURN TRACER TRANSPORT BY VERTICAL DIFFUSION ON 
(  247) ! LVDFNEWTRAC: LOGICAL: TURN TRACER TRANSPORT BY VERTICAL DIFFUSION ON (NEW VERSION)
(  248) ! LMFTRAC: LOGICAL : TURN TRACER TRANSPORT BY MASS FLUX CONVECTION ON
(  249) ! LMFSCAV:LOGICAL  : TURN TRACER WET SCAAVENGING IN CUMULUS CONVECTION SCHEME ON
(  250) ! LERAIN : LOGICAL : RAIN ASSIMILATION
(  251) ! LEMWAVE : LOGICAL : ALL-SKY RADIANCE ASSIMILATION
(  252) ! LEOCWA : LOGICAL : WARM OCEAN LAYER PARAMETRIZATION
(  253) ! LEOBC  : LOGICAL : SST CORRECTION
(  254) ! LEOBCMAX : LOGICAL : REMOVE ANY SST CORRECTIONS LARGER THAN REOBCMAX
(  255) ! REOBCMAX : REAL : SST CORRECTIONS ABS(VALUES) LARGER THAN THIS VALUE IS IGNORED IF LEOBCCHK
(  256) ! LEOBCICE : LOGICAL : ICE CORRECTION (IMPLIED IF LEOBC)
(  257) ! LEOCCO : LOGICAL : COOL OCEAN SKIN PARAMETRIZATION
(  258) ! LEOCSA : LOGICAL : SALINTY EFFECT ON SATURATION AT OCEAN SURFACE
(  259) ! LEOCLA : LOGICAL : LANGMUIR CIRCULATION EFFECT IN SKIN LAYER SCHEME
(  260) ! RTHRFRTI : INTEGER : MINIMUM FRACTION FOR ALL SURFACE TILES
(  261) ! PRCIMIN : REAL : MINIMUM ICE FRACTION
(  262) ! LEVGEN : LOGICAL  : VAN GENUCHTEN HYDROLOGY (with SOIL TYPE field)
(  263) ! LESSRO : LOGICAL  : OROGRAPHIC (VIC-TYPE) RUNOFF
(  264) ! LEFLAKE : LOGICAL  : LAKE MODEL FLAKE
(  265) ! LEOCML : LOGICAL  : OCEAN MIX LAYER MODEL
(  266) ! LEOCLAKE : LOGICAL  : PERSISTED LAKE SST and ICE
(  267) ! LEOLAKESST : LOGICAL : USE LAKES TEMPERATURE AND ICE AS SST AND ICE ON LAKE POINTS
(  268) ! LOCMLTKE : LOGICAL  : IF TRUE JANSSEN'S VERSION OF THE MELLOR-YAMADA SCHEME IS RUN.
(  269) ! LECLIPQT0: LOGICAL: REMOVE NEGATIVE Q AND SUPERSATURATION AT INITIAL TIME
(  270) ! LECLIPCLDT0: LOGICAL: REMOVE NEGATIVE CLOUD WATER/ICE AND BOUND CLOUD COVER AT INITIAL TIME
(  271) ! LDUCTDIA : LOGICAL  : COMPUTATIONS AND ARCHIVING OF DUCTING DIAGNOSTICS
(  272) ! LDIAGTURB_EC : LOGICAL  : ACTIVATE 3D TURBULENCE EDR PARAMETERS FOR CAT AND MWT
(  273) ! LDIAGTURBGRAD_EC : LOGICAL  : ACTIVATE HORIZONTAL GRADIENTS FOR  3D TURBULENCE EDR PARAMETERS
(  274) ! LESN09 : LOGICAL  : IF true use the snow 2009 scheme (liquid water, density, snow cover fraction, exposed and forest albed
(  275) ! LELAIV : LOGICAL  : IF FALSE OVERWRITE CLIMATE LAI FIELDS WITH LUT VALUES
(  276) ! LECTESSEL : LOGICAL : LAND CARBON (CTESSEL) USED FOR CO2 FLUXES
(  277) ! LEAGS   : LOGICAL : LAND CARBON (CTESSEL) USED FOR CO2 AND EVAP FLUXES
(  278) ! LEFARQUHAR   : LOGICAL : FARQUHAR PHOTOSYNTHESIS MODEL (CTESSEL) USED FOR CO2 AND EVAP FLUXES
(  279) ! LEOPTSURF   : LOGICAL : USE FARQUHAR'S OPTIMIZED PARAMETERS FROM NAMELIST
(  280) ! LEC4MAP : LOGICAL : C4 PHOTOSYNTHESIS MAP (CTESSEL) USED FOR CO2 AND EVAP FLUXES
(  281) ! LEAIRCO2COUP : LOGICAL : CAMS CO2 USED FOR LAND SURFACE MODEL PHOTOSYNTHESIS
(  282) ! RLAIINT : REAL    : INTERACTIVE LAI CLIM RELAXATION (1=interactive ; 0=clim)






NVFORTRAN (Version     24.5)          03/19/2025  06:54:20      page 6

(  283) ! LEGBRAD : LOGICAL : ACTIVATE RADAR PRECIPITATION OBSERVATION OPERATOR
(  284) ! NPRACCL : INTEGER : ACCUMULATION LENGTH FOR RADAR PRECIPITATION OBSERVATION ASSIMILATION
(  285) ! LERAINGG : LOGICAL : ACTIVATE RAIN GAUGE OBSERVATION OPERATOR
(  286) ! LECLIM10D: Logical: IF TRUE interpolate between 10-day climate values (for albedo and LAI) 
(  287) ! LELIGHT : LOGICAL : ACTIVATES LIGHTNING PARAMETRIZATION.
(  288) ! NLIMODE : LOGICAL : SELECTION OF LIGHTNING PARAMETRIZATION (see CULIGHT routine).
(  289) ! RALFMINPSN : REAL : Albedo of permanent snow, used in Antarctica and on glaciers
(  290) ! NALBEDOSCHEME : INTEGER :   Surface shortwave albedo:
(  291) !                             0: ERBE
(  292) !                             1: MODIS 4 comp. (UV-Vis+NIR)x(direct+diffuse), nearest neigh to SW bands
(  293) !                             2: MODIS 6 component, weighting to SW bands
(  294) !                             3: MODIS 2 compoent (diffuse albedo for everything, weighting to SW bands
(  295) ! NEMISSSCHEME  : INTEGER :   Surface longwave emissivity scheme:
(  296) !                             0: 2-interval (infrared window and everything else)
(  297) !                             1: 6-interval scheme
(  298) ! LVEXTRDYNACC  : LOGICAL :   Make extra dyn diags cumulative rather instantaneous
(  299) 
(  300) !     -----------------------------------------------------------------
(  301) 
(  302) END MODULE YOEPHY












































