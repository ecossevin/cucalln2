(   58) !*    ** *YOECUMF2* - PARAMETERS FOR NEW LINEARIZED CUMULUS MASS-FLUX SCHEME
(   59) 
(   60) !     P.LOPEZ                       E. C. M. W. F.      21/8/2006
(   61) !     Inspired from M.TIEDTKE       E. C. M. W. F.      18/1/89
(   62) 
(   63) !     NAME      TYPE      PURPOSE
(   64) !     ----      ----      -------
(   65) 
(   66) !     LMFMID2    LOGICAL  TRUE IF MIDLEVEL    CONVECTION IS SWITCHED ON
(   67) !     LMFDD2     LOGICAL  TRUE IF CUMULUS DOWNDRAFT      IS SWITCHED ON
(   68) !     LMFDUDV2   LOGICAL  TRUE IF CUMULUS FRICTION       IS SWITCHED ON
(   69) !     LMFUVDIS2  LOGICAL  TRUE IF KIN.ENERGY DISSIPATION BY CUMULUS FRICTION IS SWITCHED ON
(   70) !     LMFWETB2   LOGICAL  TRUE IF WET BULB TEMPERATURE USED IN SNOW MELTING
(   71) !     LMFGLAC2   LOGICAL  TRUE IF RAIN GLACIATION CONTRIBUTION INCLUDED
(   72) !     DETRPEN2   REAL     DETRAINMENT RATE FOR PENETRATIVE CONVECTION
(   73) !     ENTSHALP2  REAL     SCALING FACTOR FOR SHALLOW CONVECTION ENTRAINMENT RATE
(   74) !     ENTRORG2   REAL     COEFFICIENT FOR ORGANIZED ENTRAINMENT DEEP CONVECTION
(   75) !     ENTSTPC12  REAL     SHALLOW ENTRAINMENT TEST PARCEL ENTRAINMENTcst 1
(   76) !     ENTSTPC22  REAL     SHALLOW ENTRAINMENT TEST PARCEL ENTRAINMENTcst 2
(   77) !LLL
(   78) !     ENTSTPC32  REAL     ENTRAINMENT SCALING FOR PBL HEIGHT COMPUTATION
(   79) !LLL
(   80) !     ENTRDD2    REAL     ENTRAINMENT RATE FOR CUMULUS DOWNDRAFTS
(   81) !     RMFCMIN2   REAL     MINIMUM MASSFLUX VALUE (FOR SAFETY)
(   82) !     RMFDEPS2   REAL     FRACTIONAL MASSFLUX FOR DOWNDRAFTS AT LFS
(   83) !     RDEPTHS2   REAL     MAXIMUM ALLOWED CLOUD THICKNESS FOR SHALLOW
(   84) !     RPRCON2    REAL     COEFFICIENTS FOR DETERMINING CONVERSION
(   85) !                         FROM CLOUD WATER TO RAIN
(   86) !     RCPECONS2  REAL     COEFFICIENT FOR RAIN EVAPORATION BELOW CLOUD
(   87) !     RCUCOV2    REAL     CONVECTIVE CLOUD COVER FOR RAIN EVPORATION
(   88) !     RTAUMEL2   REAL     TIME CONSTANT FOR MELTING
(   89) !     RTAU2      REAL     ADJUSTMENT TIME SCALE IN CAPE CLOSURE
(   90) !     RMFCFL2    REAL     MULTIPLE OF CFL STABILITY CRITERIUM 
(   91) !     RMFLIA2    REAL     VALUE OF ABSOLUTE MASS FLUX LIMIT
(   92) !     RMFSOLCT2  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR TRACERS
(   93) !                         0 : EXPLICIT,  0-1 : SEMI-IMPLICIT, >=1 : FULLY IMPLICIT.
(   94) !     RMFSOLUV2  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR MOMENTUM
(   95) !     RMFSOLTQ2  REAL     SOLVER FOR MASSFLUX ADVECTION EQUATION FOR T AND Q
(   96) !     RMFSOLRHS2 REAL     SOLVER FOR MODEL TENDENCY IN RHS OF IMPLICIT SOLVER
(   97) !     RUVPER2    REAL     UPDRAIGHT VELOCITY PERTURBATION AT KLEV FOR IMPLICIT
(   98) 
(   99) !LLL!     NJKT12, NJKT22, NJKT32  INTEGER LEVEL LIMITS FOR CUBASEN2, CUDDRAFN2
(  100) !     NJKT12, NJKT22, NJKT32, NJKT52, NJKT62  INTEGER LEVEL LIMITS FOR CUBASEN2, CUDDRAFN2, VDFHGHTNS
(  101) !     ---------------------------------------------------------------------
(  102) 
(  103) END MODULE YOECUMF2











