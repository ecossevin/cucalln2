(    9) MODULE SATUR_LOKI_MOD
(   10)   CONTAINS
(   11)   SUBROUTINE SATUR_LOKI (YDTHF, YDCST, KIDIA, KFDIA, KLON, KTDIA, KLEV, LDPHYLIN, PAPRSF, PT, PQSAT, KFLAG, YDSTACK_L)
(   12)     
(   13)     !***
(   14)     
(   15)     ! **   *SATUR* -  COMPUTES SPECIFIC HUMIDITY AT SATURATION
(   16)     
(   17)     !       J.F. MAHFOUF       E.C.M.W.F.     15/05/96
(   18)     
(   19)     !       Modified J. HAGUE          13/01/03 MASS Vector Functions
(   20)     
(   21)     !       PURPOSE.
(   22)     !       --------
(   23)     
(   24)     !       SPECIFIC HUMIDITY AT SATURATION IS USED BY THE
(   25)     !       DIAGNOSTIC CLOUD SCHEME TO COMPUTE RELATIVE HUMIDITY
(   26)     !       AND LIQUID WATER CONTENT
(   27)     
(   28)     !       INTERFACE
(   29)     !       ---------
(   30)     
(   31)     !       THIS ROUTINE IS CALLED FROM *CALLPAR*.
(   32)     
(   33)     !       PARAMETER     DESCRIPTION                                 UNITS
(   34)     !       ---------     -----------                                 -----
(   35)     !       INPUT PARAMETERS (INTEGER):
(   36)     
(   37)     !      *KIDIA*        START POINT
(   38)     !      *KFDIA*        END POINT
(   39)     !      *KLON*         NUMBER OF GRID POINTS PER PACKET
(   40)     !      *KTDIA*        START OF THE VERTICAL LOOP
(   41)     !      *KLEV*         NUMBER OF LEVELS
(   42)     
(   43)     !       INPUT PARAMETERS (REAL):
(   44)     
(   45)     !      *PAPRSF*        PRESSURE ON FULL LEVELS                      PA
(   46)     !      *PT*            TEMPERATURE AT T-DT                          K
(   47)     
(   48)     !       INPUT PARAMETERS (INTEGER):
(   49)     
(   50)     !      *KFLAG*         FLAG TO DETECT CALL FROM






NVFORTRAN (Version     24.5)          03/19/2025  06:55:17      page 2

(   51)     
(   52)     !                      CONVECTION  KFLAG=1
(   53)     !                      OTHER       KFLAG=2
(   54)     
(   55)     !       OUTPUT PARAMETER (REAL):
(   56)     
(   57)     !      *PQSAT*         SATURATION SPECIFIC HUMIDITY                 KG/KG
(   58)     
(   59)     !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   60)     !-------------------------------------------------------------------------
(   61)     
(   62)     USE, intrinsic :: ISO_FORTRAN_ENV, ONLY: REAL64
(   63)     USE, intrinsic :: ISO_C_BINDING, ONLY: C_SIZEOF
(   64)     USE PARKIND1, ONLY: JPIM, JPRB
(   65)     USE YOMHOOK, ONLY: LHOOK, JPHOOK
(   66)     
(   67)     USE YOMCST, ONLY: TCST
(   68)     USE YOETHF, ONLY: TTHF
(   69)     
(   70)     IMPLICIT NONE
(   71)     
(   72)     TYPE(TTHF), INTENT(IN) :: YDTHF
(   73)     TYPE(TCST), INTENT(IN) :: YDCST
(   74)     INTEGER(KIND=JPIM), INTENT(IN) :: KIDIA
(   75)     INTEGER(KIND=JPIM), INTENT(IN) :: KFDIA
(   76)     INTEGER(KIND=JPIM), INTENT(IN) :: KLON
(   77)     INTEGER(KIND=JPIM), INTENT(IN) :: KTDIA
(   78)     INTEGER(KIND=JPIM), INTENT(IN) :: KLEV
(   79)     LOGICAL, INTENT(IN) :: LDPHYLIN
(   80)     REAL(KIND=JPRB), INTENT(IN) :: PAPRSF(KLON, KLEV)
(   81)     REAL(KIND=JPRB), INTENT(IN) :: PT(KLON, KLEV)
(   82)     REAL(KIND=JPRB), INTENT(OUT) :: PQSAT(KLON, KLEV)
(   83)     INTEGER(KIND=JPIM), INTENT(IN) :: KFLAG
(   84)     INTEGER(KIND=JPIM) :: JK, JL
(   85)     
(   86)     REAL(KIND=JPRB) :: ZCOR, ZEW, ZFOEEW, ZQMAX, ZQS, ZTARG
(   87)     REAL(KIND=JPRB) :: ZALFA, ZFOEEWL, ZFOEEWI
(   88)     REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(   89)     
(   90)     !DIR$ VFUNCTION EXPHF
(   91)     
(   92) #include "fcttre.func.h"
(   93) !$acc routine vector
(   94)     INTEGER(KIND=8) :: YLSTACK_L
(   95)     INTEGER(KIND=8), INTENT(INOUT) :: YDSTACK_L
(   96)     YLSTACK_L = YDSTACK_L
(   97) !$acc data present( PAPRSF, PT, PQSAT, YDTHF, YDCST )
(   98)     
(   99)     !----------------------------------------------------------------------
(  100)     
(  101)     !*    1.           DEFINE CONSTANTS
(  102)     !                  ----------------
(  103)     
(  104)     
(  105)     ZQMAX = 0.5_JPRB
(  106)     
(  107)     !     *
(  108)     !----------------------------------------------------------------------






NVFORTRAN (Version     24.5)          03/19/2025  06:55:17      page 3

(  109)     
(  110)     !     *    2.           CALCULATE SATURATION SPECIFIC HUMIDITY
(  111)     !                       --------------------------------------
(  112)     
(  113)     
(  114) !$acc loop vector
(  115)     DO JL=KIDIA,KFDIA
(  116)       IF (LDPHYLIN) THEN
(  117) !$acc loop seq
(  118)         DO JK=KTDIA,KLEV
(  119)           ZTARG = PT(JL, JK)
(  120)           ZALFA = FOEALFA(ZTARG)
(  121)           
(  122)           ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4LES))
(  123)           ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4IES))
(  124)           ZFOEEW = ZALFA*ZFOEEWL + (1.0_JPRB - ZALFA)*ZFOEEWI
(  125)           
(  126)           ZQS = ZFOEEW / PAPRSF(JL, JK)
(  127)           IF (ZQS > ZQMAX) THEN
(  128)             ZQS = ZQMAX
(  129)           END IF
(  130)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQS)
(  131)           PQSAT(JL, JK) = ZQS*ZCOR
(  132)         END DO
(  133)       ELSE
(  134)         
(  135) !$acc loop seq
(  136)         DO JK=KTDIA,KLEV
(  137)           IF (KFLAG == 1) THEN
(  138)             ZEW = FOEEWMCU(PT(JL, JK))
(  139)           ELSE
(  140)             ZEW = FOEEWM(PT(JL, JK))
(  141)           END IF
(  142)           ZQS = ZEW / PAPRSF(JL, JK)
(  143)           ZQS = MIN(ZQMAX, ZQS)
(  144)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQS)
(  145)           PQSAT(JL, JK) = ZQS*ZCOR
(  146)         END DO
(  147)         
(  148)       END IF
(  149)     END DO
(  150)     
(  151)     
(  152)     
(  153) !$acc end data
(  154)   END SUBROUTINE SATUR_LOKI
(  155) END MODULE SATUR_LOKI_MOD

















