(   58)     
(   59)     !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   60)     !-------------------------------------------------------------------------
(   61)     
(   62)     USE, intrinsic :: ISO_FORTRAN_ENV, ONLY: REAL64
(   63)     USE, intrinsic :: ISO_C_BINDING, ONLY: C_SIZEOF
(   64)     USE PARKIND1, ONLY: JPIM, JPRB
(   65)     USE YOMHOOK, ONLY: LHOOK, JPHOOK
(   66)     
(   67)     USE YOMCST, ONLY: TCST
(   68)     USE YOETHF, ONLY: TTHF
(   69)     
(   70)     IMPLICIT NONE
(   71)     
(   72)     TYPE(TTHF), INTENT(IN) :: YDTHF
(   73)     TYPE(TCST), INTENT(IN) :: YDCST
(   74)     INTEGER(KIND=JPIM), INTENT(IN) :: KIDIA
(   75)     INTEGER(KIND=JPIM), INTENT(IN) :: KFDIA
(   76)     INTEGER(KIND=JPIM), INTENT(IN) :: KLON
(   77)     INTEGER(KIND=JPIM), INTENT(IN) :: KTDIA
(   78)     INTEGER(KIND=JPIM), INTENT(IN) :: KLEV
(   79)     LOGICAL, INTENT(IN) :: LDPHYLIN
(   80)     REAL(KIND=JPRB), INTENT(IN) :: PAPRSF(KLON, KLEV)
(   81)     REAL(KIND=JPRB), INTENT(IN) :: PT(KLON, KLEV)
(   82)     REAL(KIND=JPRB), INTENT(OUT) :: PQSAT(KLON, KLEV)
(   83)     INTEGER(KIND=JPIM), INTENT(IN) :: KFLAG
(   84)     INTEGER(KIND=JPIM) :: JK, JL
(   85)     
(   86)     REAL(KIND=JPRB) :: ZCOR, ZEW, ZFOEEW, ZQMAX, ZQS, ZTARG
(   87)     REAL(KIND=JPRB) :: ZALFA, ZFOEEWL, ZFOEEWI
(   88)     REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(   89)     
(   90)     !DIR$ VFUNCTION EXPHF
(   91)     
(   92) # 92 "./satur.scc_stack.F90"
(   92) # 1 "./fcttre.func.h"
(    1) ! (C) Copyright 1988- ECMWF.
(    2) !
