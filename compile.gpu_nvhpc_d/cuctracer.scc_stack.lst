(  407)         
(  408) !$acc loop vector
(  409)         DO JL=KIDIA,KFDIA
(  410) !$acc loop seq
(  411)           DO JK=2,KLEV
(  412)             IF (LLCUMBAS(JL, JK)) THEN
(  413)               PTENC(JL, JK, JN) = PTENC(JL, JK, JN) + (ZR1(JL, JK) - PCEN(JL, JK, JN))*ZTSPHY
(  414)               !  for implicit solution including tendency source term
(  415)               !  PTENC(JL,JK,JN)=(ZR1(JL,JK)-PCEN(JL,JK,JN))*ZTSPHY
(  416)             END IF
