(    1) MODULE CUCTRACER_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUCTRACER_LOKI (YDCST, YDCUMFS, YDECUMF2, YDECUMF, KIDIA, KFDIA, KLON, KLEV, KTRAC, KCTOP, KDTOP, KTYPE, LDCUM,
(    4)   & LDDRAF, PTSPHY, PAPH, PAP, PMFU, PMFD, PMFUO, PMFDO, PUDRATE, PDDRATE, PDMFUP, PDMFDP, PCEN, PTENC, PSCAV, YDSTACK_L)
(    5)     
(    6)     !**** *CUCTRACER* - COMPUTE CONVECTIVE TRANSPORT OF CHEM. TRACERS
(    7)     !                   IMPORTANT: ROUTINE IS FOR POSITIVE DEFINIT QUANTITIES
(    8)     !                              SCAVENGING IS DONE IF SCAVENGING COEFFICIENT>0
(    9)     
(   10)     !          P.BECHTOLD        E.C.M.W.F.              11/02/2004
(   11)     
(   12)     !**   INTERFACE.
(   13)     !     ----------
(   14)     
(   15)     !          *CUTRACER* IS CALLED FROM *CUMASTR*
(   16)     
(   17)     !     PARAMETER     DESCRIPTION                                   UNITS
(   18)     !     ---------     -----------                                   -----
(   19)     !     INPUT PARAMETERS (INTEGER):
(   20)     
(   21)     !    *KIDIA*        START POINT
(   22)     !    *KFDIA*        END POINT
(   23)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   24)     !    *KLEV*         NUMBER OF LEVELS
(   25)     !    *KTRAC*        NUMBER OF CHEMICAL TRACERS
(   26)     
(   27)     !    *KCTOP*        CLOUD TOP  LEVEL
(   28)     !    *KDTOP*        DOWNDRAFT TOP LEVEL
(   29)     !    *KTYPE*        TYPE OF CONVECTION
(   30)     !                       1 = PENETRATIVE CONVECTION
(   31)     !                       2 = SHALLOW CONVECTION
(   32)     !                       3 = MIDLEVEL CONVECTION
(   33)     
(   34)     
(   35)     !    INPUT PARAMETERS (LOGICAL):
(   36)     
(   37)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   38)     !    *LDDRAF*       FLAG: .TRUE. IF DOWNDRAFTS EXIST
(   39)     
(   40)     !    INPUT PARAMETERS (REAL):
(   41)     
(   42)     !    *PTSPHY*       PHYSICS TIME-STEP                              S
(   43)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS            PA
(   44)     !    *PAPH          PROVISIONAL PRESSURE ON FULL LEVELS            PA
(   45)     !    *PCEN*         PROVISIONAL ENVIRONMENT TRACER CONCENTRATION
(   46)     !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(   47)     !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
(   48)     !    *PUDRATE*      UPDRAFT DETRAINMENT                           KG/(M2*S)
(   49)     !    *PDDRATE*      DOWNDRAFT DETRAINMENT                         KG/(M2*S)
(   50)     !    *PDMFUP*       UPDRAUGT PRECIP (PRODUCTION) IN LAYER         KG/(M2*S)






NVFORTRAN (Version     24.5)          03/19/2025  06:55:18      page 2

(   51)     !    *PDMFDP*       DDRAUGHT PRECIP (PRODUCTION) IN LAYER         KG/(M2*S)
(   52)     !    *PSCAV*        WET SCAVENGING COEFFICIENTS                   UNITLESS
(   53)     
(   54)     !    UPDATED PARAMETERS (REAL):
(   55)     
(   56)     !    *PTENC*        UPDATED TENDENCY OF CHEM. TRACERS              1/S
(   57)     
(   58)     !          METHOD
(   59)     !          -------
(   60)     !     EXPLICIT UPSTREAM AND IMPLICIT SOLUTION OF VERTICAL ADVECTION
(   61)     !     DEPENDING ON VALUE OF RMFSOLCT: 0=EXPLICIT 0-1 SEMI-IMPLICIT >=1 IMPLICIT
(   62)     
(   63)     !     FOR EXPLICIT SOLUTION: ONLY ONE SINGLE ITERATION
(   64)     !     FOR IMPLICIT SOLUTION: FIRST IMPLICIT SOLVER, THEN EXPLICIT SOLVER
(   65)     !                            TO CORRECT TENDENCIES BELOW CLOUD BASE
(   66)     
(   67)     
(   68)     !------------------------------------------------------------------------------------
(   69)     !     COMMENTS FOR OFFLINE USERS IN CHEMICAL TRANSPORT MODELS
(   70)     !     (i.e. reading mass fluxes and detrainment rates from ECMWF archive:
(   71)     !      ------------------------------------------------------------------
(   72)     !     KCTOP IS FIRST LEVEL FROM TOP WHERE PMFU>0
(   73)     !     KDTOP IS FIRST LEVEL FROM TOP WHERE PMFD<0
(   74)     !     ATTENTION: ON ARCHIVE DETRAINMENT RATES HAVE UNITS KG/(M3*S), SO FOR USE
(   75)     !                IN CURRENT ROUTINE YOU HAVE TO MULTIPLY ARCHIVED VALUES BY DZ
(   76)     !     LDCUM  IS TRUE IF CONVECTION EXISTS, i.e. IF PMFU>0 IN COLUMN OR IF
(   77)     !                       KCTOP>0 AND KCTOP<KLEV
(   78)     !     LDDRAF IS TRUE IF DOWNDRAUGHTS EXIST IF PMFD<0 IN COLUMN OR IF
(   79)     !                       KDTOP>0 AND KDTOP<KLEV
(   80)     !     IF MASSFLUX SATISFIES CFL CRITERIUM M<=DP/Dt IT IS SUFFICIENT TO
(   81)     !     ONLY CONSIDER EXPLICIT SOLUTION (RMFSOLCT=0), IN THIS CASE
(   82)     !     YOU CAN IGNORE IMPLICIT PART 7.0 OF CURRENT ROUTINE
(   83)     !------------------------------------------------------------------------------------
(   84)     
(   85)     !          EXTERNALS
(   86)     !          ---------
(   87)     !          CUBIDIAG
(   88)     
(   89)     !          MODIFICATIONS
(   90)     !          -------------
(   91)     !        M.Hamrud      01-Oct-2003 CY28 Cleaning
(   92)     !        P.Bechtold    07-Oct-2009 add scavenging
(   93)     !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   94)     
