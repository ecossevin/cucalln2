(  168)     IP_ZCU = YLSTACK_L
(  169)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*KTRAC*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  170)     IP_ZCD = YLSTACK_L
(  171)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*KTRAC*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  172)     IP_ZTENC = YLSTACK_L
(  173)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*KTRAC*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)






