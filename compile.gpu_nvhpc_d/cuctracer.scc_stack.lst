(  174)     IP_ZMFC = YLSTACK_L
(  175)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*KTRAC*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  176)     IP_ZDP = YLSTACK_L
(  177)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  178)     IP_ZB = YLSTACK_L
(  179)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  180)     IP_ZR1 = YLSTACK_L
(  181)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  182)     IP_LLCUMASK = YLSTACK_L
(  183)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(LOGICAL(.true.)) + 7, -3), 3)
(  184)     IP_LLCUMBAS = YLSTACK_L
(  185)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(LOGICAL(.true.)) + 7, -3), 3)
(  187) !$acc & PCEN, PTENC, PSCAV, YDCST, YDCUMFS, YDECUMF2, YDECUMF )
(  188)     !----------------------------------------------------------------------
(  189)     
(  190)     IF (YDCUMFS%LECUMFS) THEN
(  191)       ZRMFSOLCT = YDECUMF2%RMFSOLCT2
(  192)       ZRMFCMIN = YDECUMF2%RMFCMIN2
(  193)     ELSE
(  194)       ZRMFSOLCT = YDECUMF%RMFSOLCT
(  195)       ZRMFCMIN = YDECUMF%RMFCMIN
(  196)     END IF
(  197)     
(  198)     ZIMP = 1.0_JPRB - ZRMFSOLCT
(  199)     ZTSPHY = 1.0_JPRB / PTSPHY
(  200)     
(  201)     
(  202) !$acc loop vector
(  203)     DO JL=KIDIA,KFDIA
(  204)       ZADVW(JL) = 0.0_JPRB
(  205)       IF (KTYPE(JL) == 1) ZADVW(JL) = YDECUMF%RMFADVW
(  206)       
(  207)       ! Initialize Cumulus mask + some setups
(  208)       
(  209) !$acc loop seq
(  210)       DO JK=2,KLEV
(  211)         LLCUMASK(JL, JK) = .false.
(  212)         IF (LDCUM(JL)) THEN
(  213)           ZDP(JL, JK) = YDCST%RG / (PAPH(JL, JK + 1) - PAPH(JL, JK))
(  214)           IF (JK >= -1 + KCTOP(JL)) THEN
(  215)             LLCUMASK(JL, JK) = .true.
(  216)           END IF
(  217)         END IF
(  218)       END DO
(  219)       !----------------------------------------------------------------------
(  220)       
(  221) !$acc loop seq
(  222)       DO JN=1,KTRAC
(  223)         
(  224)         !*    1.0          DEFINE TRACERS AT HALF LEVELS
(  225)         !                  -----------------------------
(  226)         
(  227) !$acc loop seq
(  228)         DO JK=2,KLEV
(  229)           IK = JK - 1
(  230)           ZCEN(JL, JK, JN) = PCEN(JL, JK, JN)
(  231)           ZCD(JL, JK, JN) = PCEN(JL, IK, JN)
(  232)           ZCU(JL, JK, JN) = PCEN(JL, IK, JN)






NVFORTRAN (Version     24.5)          03/19/2025  06:55:18      page 13

(  233)           ZMFC(JL, JK, JN) = 0.0_JPRB
(  234)           ZTENC(JL, JK, JN) = 0.0_JPRB
(  235)         END DO
(  236)         ZCU(JL, KLEV, JN) = PCEN(JL, KLEV, JN)
(  237)         
(  238)         !*    2.0          COMPUTE UPDRAFT VALUES
(  239)         !                  ----------------------
(  240)         
(  241) !$acc loop seq
(  242)         DO JK=KLEV - 1,3,-1
(  243)           IK = JK + 1
(  244)           IF (LLCUMASK(JL, JK)) THEN
(  245)             ZERATE = PMFU(JL, JK) - PMFU(JL, IK) + PUDRATE(JL, JK)
(  246)             ZMFA = 1.0_JPRB / MAX(ZRMFCMIN, PMFU(JL, JK))
(  247)             IF (JK >= KCTOP(JL)) THEN
(  248)               ZCU(JL, JK, JN) = (PMFU(JL, IK)*ZCU(JL, IK, JN) + ZERATE*PCEN(JL, JK, JN) - (PUDRATE(JL, JK) + PDMFUP(JL, JK) &
(  249)               & *PSCAV(JN))*ZCU(JL, IK, JN))*ZMFA
(  250)               ! if you have a source term dc/dt=dcdt write
(  251)               !             ZCU(JL,JK,JN)=( PMFU(JL,IK)*ZCU(JL,IK,JN)+ZERATE*PCEN(JL,JK,JN) &
(  252)               !                           -PUDRATE(JL,JK)*ZCU(JL,IK,JN) )*ZMFA
(  253)               !                           +dcdt(jl,ik,jn)*ptsphy
(  254)             END IF
(  255)           END IF
(  256)         END DO
(  257)         
(  258)         
(  259)         !*    3.0          COMPUTE DOWNDRAFT VALUES
(  260)         !                  ------------------------
(  261)         
(  262) !$acc loop seq
(  263)         DO JK=3,KLEV
(  264)           IK = JK - 1
(  265)           IF (LDDRAF(JL) .and. JK == KDTOP(JL)) THEN
(  266)             !Nota: in order to avoid final negative Tracer values at LFS the allowed value of ZCD
(  267)             !      depends on the jump in mass flux at the LFS
(  268)             !ZCD(JL,JK,JN)=0.5_JPRB*ZCU(JL,JK,JN)+0.5_JPRB*PCEN(JL,IK,JN)
(  269)             ZCD(JL, JK, JN) = 0.1_JPRB*ZCU(JL, JK, JN) + 0.9_JPRB*PCEN(JL, IK, JN)
(  270)           ELSE IF (LDDRAF(JL) .and. JK > KDTOP(JL)) THEN
(  271)             ZERATE = -PMFD(JL, JK) + PMFD(JL, IK) + PDDRATE(JL, JK)
(  272)             ZMFA = 1._JPRB / MIN(-ZRMFCMIN, PMFD(JL, JK))
(  273)             ZCD(JL, JK, JN) = (PMFD(JL, IK)*ZCD(JL, IK, JN) - ZERATE*PCEN(JL, IK, JN) + (PDDRATE(JL, JK) + PDMFDP(JL, JK) &
(  274)             & *PSCAV(JN))*ZCD(JL, IK, JN))*ZMFA
(  275)             ! if you have a source term dc/dt=dcdt write
(  276)             !             ZCD(JL,JK,JN)=( PMFD(JL,IK)*ZCD(JL,IK,JN)-ZERATE*PCEN(JL,IK,JN) &
(  277)             !                           &+PDDRATE(JL,JK)*ZCD(JL,IK,JN) &
(  278)             !                           &+dcdt(jl,ik,jn)*ptsphy
(  279)           END IF
(  280)         END DO
(  281)         
(  282)         ! In order to avoid negative Tracer at KLEV adjust ZCD
(  283)         JK = KLEV
(  284)         IK = JK - 1
(  285)         IF (LDDRAF(JL)) THEN
(  286)           ZPOSI = -ZDP(JL, JK)*(PMFU(JL, JK)*ZCU(JL, JK, JN) + PMFD(JL, JK)*ZCD(JL, JK, JN) - (PMFU(JL, JK) + PMFD(JL, JK)) &
(  287)           & *PCEN(JL, IK, JN))
(  288)           IF (PCEN(JL, JK, JN) + PTSPHY*ZPOSI < 0.0_JPRB) THEN
(  289)             ZMFA = 1._JPRB / MIN(-ZRMFCMIN, PMFD(JL, JK))
(  290)             ZCD(JL, JK, JN) = ((PMFU(JL, JK) + PMFD(JL, JK))*PCEN(JL, IK, JN) - PMFU(JL, JK)*ZCU(JL, JK, JN) + PCEN(JL, JK, JN) / &






NVFORTRAN (Version     24.5)          03/19/2025  06:55:18      page 14

(  291)             &  (PTSPHY*ZDP(JL, JK)))*ZMFA
(  292)           END IF
(  293)         END IF
(  294)         
(  295)       END DO
(  296)       
(  297)       !----------------------------------------------------------------------
(  298)       
(  299) !$acc loop seq
(  300)       DO JN=1,KTRAC
(  301)         
(  302)         !*    4.0          COMPUTE FLUXES
(  303)         !                  --------------
(  304)         
(  305) !$acc loop seq
(  306)         DO JK=2,KLEV
(  307)           IK = JK - 1
(  308)           IF (LLCUMASK(JL, JK)) THEN
(  309)             ZMFA = PMFU(JL, JK) + PMFD(JL, JK)
(  310)             ZMFC(JL, JK, JN) = PMFU(JL, JK)*ZCU(JL, JK, JN) + PMFD(JL, JK)*ZCD(JL, JK, JN) - ZIMP*ZMFA*ZCEN(JL, IK, JN)
(  311)           END IF
(  312)         END DO
(  313)         
(  314)         !*    5.0          COMPUTE TENDENCIES = RHS
(  315)         !                  ------------------------
(  316)         
(  317) !$acc loop seq
(  318)         DO JK=2,KLEV - 1
(  319)           IK = JK + 1
(  320)           IF (LLCUMASK(JL, JK)) THEN
(  321)             ZTENC(JL, JK, JN) = ZDP(JL, JK)*(ZMFC(JL, IK, JN) - ZMFC(JL, JK, JN))
(  322)             !ZTENC(JL,JK,JN)=ZTENC(JL,JK,JN)-ZDP(JL,JK)*PDMFUP(JL,JK)*PSCAV(JN)*ZCU(JL,JK,JN)
(  323)           END IF
(  324)         END DO
(  325)         
(  326)         JK = KLEV
(  327)         IF (LDCUM(JL)) THEN
(  328)           ZTENC(JL, JK, JN) = -ZDP(JL, JK)*ZMFC(JL, JK, JN)
(  329)           !ZTENC(JL,JK,JN)=ZTENC(JL,JK,JN)-ZDP(JL,JK)*PDMFUP(JL,JK)*PSCAV(JN)*ZCU(JL,JK,JN)
(  330)         END IF
(  331)         
(  332)       END DO
(  333)     END DO
(  334)     
(  335)     
(  336)     IF (ZRMFSOLCT == 0.0_JPRB) THEN
(  337)       
(  338)       
(  339)       !*    6.0          UPDATE TENDENCIES
(  340)       !                  -----------------
(  341)       
(  342)       
(  343) !$acc loop vector
(  344)       DO JL=KIDIA,KFDIA
(  345) !$acc loop seq
(  346)         DO JN=1,KTRAC
(  347) !$acc loop seq
(  348)           DO JK=2,KLEV






NVFORTRAN (Version     24.5)          03/19/2025  06:55:18      page 15

(  349)             IF (LLCUMASK(JL, JK)) THEN
(  350)               PTENC(JL, JK, JN) = PTENC(JL, JK, JN) + ZTENC(JL, JK, JN)
(  351)             END IF
(  352)           END DO
(  353)         END DO
(  354)       END DO
(  355)       
(  356)       
(  357)     ELSE
(  358)       
(  359)       !---------------------------------------------------------------------------
(  360)       
(  361)       !*    7.0          IMPLICIT SOLUTION
(  362)       !                  -----------------
(  363)       
(  364)       ! Fill bi-diagonal Matrix vectors A=k-1, B=k;
(  365)       ! reuse ZMFC=A and ZB=B;
(  366)       ! ZTENC corresponds to the RHS ("constants") of the equation
(  367)       ! The solution is in ZR1
(  368)       
(  369)       LLCUMBAS(:, :) = .false.
(  370)       ZB(:, :) = 1._JPRB
(  371)       
(  372) !$acc loop seq
(  373)       DO JN=1,KTRAC
(  374)         
(  375)         ! Fill vectors A, B and RHS
(  376)         
(  377)         
(  378) !$acc loop vector
(  379)         DO JL=KIDIA,KFDIA
(  380) !$acc loop seq
(  381)           DO JK=2,KLEV
(  382)             IK = JK + 1
(  383)             IM = JK - 1
(  384)             ! LLCUMBAS(JL,JK)=LLCUMASK(JL,JK).AND.JK<=KCBOT(JL)
(  385)             LLCUMBAS(JL, JK) = LLCUMASK(JL, JK)
(  386)             IF (LLCUMBAS(JL, JK)) THEN
(  387)               ZZP = ZRMFSOLCT*ZDP(JL, JK)*PTSPHY
(  388)               ZMFC(JL, JK, JN) = -ZZP*(PMFU(JL, JK) + PMFD(JL, JK))
(  389)               IF (JK < KLEV) THEN
(  390)                 ZB(JL, JK) = 1.0_JPRB + ZZP*(PMFU(JL, IK) + PMFD(JL, IK))
(  391)               ELSE
(  392)                 ZB(JL, JK) = 1.0_JPRB
(  393)               END IF
(  394)               ZZP = YDCST%RG*(PMFUO(JL, JK) + YDECUMF%RMFADVWDD*PMFDO(JL, JK)) / (PAP(JL, JK) - PAP(JL, IM))*PTSPHY*ZADVW(JL)
(  395)               ZC = ZZP*(PCEN(JL, IM, JN) - PCEN(JL, JK, JN))
(  396)               ZTENC(JL, JK, JN) = ZTENC(JL, JK, JN)*PTSPHY + PCEN(JL, JK, JN) - ZC
(  397)             END IF
(  398)           END DO
(  399)         END DO
(  400)         
(  401)         
(  402)         CALL CUBIDIAG_LOKI(KIDIA, KFDIA, KLON, KLEV, KCTOP, LLCUMBAS, ZMFC(:, :, JN), ZB, ZTENC(:, :, JN), ZR1,  &
(  403)         & YDSTACK_L=YLSTACK_L)
(  404)         
(  405)         ! Compute tendencies
(  406)         






