(  162)     
(  163)     
(  164) !$acc loop vector
(  165)     DO JL=KIDIA,KFDIA
(  166)       ZOENTR = 0.0_JPRB
(  167)       ZBUOY = 0.0_JPRB
(  168)       ZDMFEN = 0.0_JPRB
(  169)       ZDMFDE = 0.0_JPRB
(  170)       PDMFDE(JL, :) = 0.0_JPRB
