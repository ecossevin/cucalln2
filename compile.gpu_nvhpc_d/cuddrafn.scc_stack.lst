(    1) MODULE CUDDRAFN_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUDDRAFN_LOKI (YDCST, YDTHF, YDEPHLI, YDECUMF, KIDIA, KFDIA, KLON, KLEV, LDDRAF, PTENH, PQENH, PQSEN, PGEO, PGE
(    4)   & PAPH, PRFL, PTD, PQD, PMFU, PMFD, PMFDS, PMFDQ, PDMFDP, PDMFDE, PMFDDE_RATE, PKINED, YDSTACK_L)
(    5)     
(    6)     !          THIS ROUTINE CALCULATES CUMULUS DOWNDRAFT DESCENT
(    7)     
(    8)     !          PURPOSE.
(    9)     !          --------
(   10)     !          TO PRODUCE THE VERTICAL PROFILES FOR CUMULUS DOWNDRAFTS
(   11)     !          (I.E. T,Q,U AND V AND FLUXES)
(   12)     
(   13)     !          INTERFACE
(   14)     !          ---------
(   15)     
(   16)     !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   17)     !          INPUT IS T,Q,P,PHI,U,V AT HALF LEVELS.
(   18)     !          IT RETURNS FLUXES OF S,Q AND EVAPORATION RATE
(   19)     !          AND U,V AT LEVELS WHERE DOWNDRAFT OCCURS
(   20)     
(   21)     !          METHOD.
(   22)     !          --------
(   23)     !          CALCULATE MOIST DESCENT FOR ENTRAINING/DETRAINING PLUME BY
(   24)     !          A) MOVING AIR DRY-ADIABATICALLY TO NEXT LEVEL BELOW AND
(   25)     !          B) CORRECTING FOR EVAPORATION TO OBTAIN SATURATED STATE.
(   26)     
(   27)     !     PARAMETER     DESCRIPTION                                   UNITS
(   28)     !     ---------     -----------                                   -----
(   29)     !     INPUT PARAMETERS (INTEGER):
(   30)     
(   31)     !    *KIDIA*        START POINT
(   32)     !    *KFDIA*        END POINT
(   33)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   34)     !    *KLEV*         NUMBER OF LEVELS
(   35)     
(   36)     !    INPUT PARAMETERS (LOGICAL):
(   37)     
(   38)     !    *LDDRAF*       .TRUE. IF DOWNDRAFTS EXIST
(   39)     
(   40)     !    INPUT PARAMETERS (REAL):
(   41)     
(   42)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS          K
(   43)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS     KG/KG
(   44)     !    *PQSEN*        ENV. SATUR. SPEC. HUMIDITY (T+1)             KG/KG
(   45)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   46)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                  M2/S2
(   47)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   48)     !    *PMFU*         MASSFLUX UPDRAFTS                           KG/(M2*S)
(   49)     
(   50)     !    UPDATED PARAMETERS (REAL):






NVFORTRAN (Version     24.5)          03/19/2025  06:55:27      page 2

(   51)     
(   52)     !    *PRFL*         PRECIPITATION RATE                           KG/(M2*S)
(   53)     
(   54)     !    OUTPUT PARAMETERS (REAL):
(   55)     
(   56)     !    *PTD*          TEMPERATURE IN DOWNDRAFTS                      K
(   57)     !    *PQD*          SPEC. HUMIDITY IN DOWNDRAFTS                 KG/KG
(   58)     !    *PMFD*         MASSFLUX IN DOWNDRAFTS                       KG/(M2*S)
(   59)     !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS       J/(M2*S)
(   60)     !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS         KG/(M2*S)
(   61)     !    *PDMFDP*       FLUX DIFFERENCE OF PRECIP. IN DOWNDRAFTS     KG/(M2*S)
(   62)     !    *PMFDDE_RATE*  DOWNDRAFT DETRAINMENT RATE                   KG/(M2*S)
(   63)     !    *PKINED*       DOWNDRAFT KINETIC ENERGY                     M2/S2
(   64)     
(   65)     !          EXTERNALS
(   66)     !          ---------
(   67)     !          *CUADJTQ* FOR ADJUSTING T AND Q DUE TO EVAPORATION IN
(   68)     !          SATURATED DESCENT
(   69)     
(   70)     !          REFERENCE
(   71)     !          ---------
(   72)     !          (TIEDTKE,1989)
(   73)     
(   74)     !     AUTHOR.
(   75)     !     -------
(   76)     !      M.TIEDTKE         E.C.M.W.F.    12/86 MODIF. 12/89
