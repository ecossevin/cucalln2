(  179)         IF (LLO2) THEN
(  180)           IS = IS + 1
(  181)         END IF
(  182)         IF (IS == 0) CYCLE
(  183)         
(  184)         IF (LLO2) THEN
(  185)           ZENTR = YDECUMF%ENTRDD*PMFD(JL, JK - 1)*(PGEOH(JL, JK - 1) - PGEOH(JL, JK))*ZRG
(  186)           ! &*(1.6_JPRB-MIN(1.0_JPRB,PQENH(JL,JK-1)/PQSEN(JL,JK)))
(  187)           ZDMFEN = ZENTR
(  188)           ZDMFDE = ZENTR
(  189)         END IF
(  190)         
(  191)         IF (JK > ITOPDE) THEN
(  192)           IF (LLO2) THEN
(  193)             ZDMFEN = 0.0_JPRB
(  194)             ZDMFDE = PMFD(JL, ITOPDE)*(PAPH(JL, JK) - PAPH(JL, JK - 1)) / (PAPH(JL, KLEV + 1) - PAPH(JL, ITOPDE))
(  195)           END IF
(  196)         END IF
(  197)         
(  198)         IF (JK <= ITOPDE) THEN
(  199)           IF (LLO2) THEN
(  200)             ZDZ = -(PGEOH(JL, JK - 1) - PGEOH(JL, JK))*ZRG
(  201)             ZZENTR = ZOENTR*ZDZ*PMFD(JL, JK - 1)
(  202)             ZDMFEN = ZDMFEN + ZZENTR
(  203)             ZDMFEN = MAX(ZDMFEN, 0.3_JPRB*PMFD(JL, JK - 1))
(  204)             ZDMFEN = MAX(ZDMFEN, -0.75_JPRB*PMFU(JL, JK) - (PMFD(JL, JK - 1) - ZDMFDE))
(  205)             ZDMFEN = MIN(ZDMFEN, 0.0_JPRB)
(  206)           END IF
(  207)           
(  208)           PDMFDE(JL, JK) = ZDMFEN - ZDMFDE






