(  144) !$acc & PMFDDE_RATE, PKINED, YDCST, YDTHF, YDEPHLI, YDECUMF )
(  145)     
(  146)     ITOPDE = YDECUMF%NJKT3
(  147)     ZRG = 1.0_JPRB / YDCST%RG
(  148)     ZFACBUO = 0.5_JPRB / (1.0_JPRB + 0.5_JPRB)
(  149)     Z_CWDRAG = (3._JPRB / 8._JPRB)*0.506_JPRB / 0.2_JPRB
(  150)     !----------------------------------------------------------------------
(  151)     
(  152)     !     1.           CALCULATE MOIST DESCENT FOR CUMULUS DOWNDRAFT BY
(  153)     !                     (A) CALCULATING ENTRAINMENT/DETRAINMENT RATES,
(  154)     !                         INCLUDING ORGANIZED ENTRAINMENT DEPENDENT ON
(  155)     !                         NEGATIVE BUOYANCY AND ASSUMING
(  156)     !                         LINEAR DECREASE OF MASSFLUX IN PBL
(  157)     !                     (B) DOING MOIST DESCENT - EVAPORATIVE COOLING
(  158)     !                         AND MOISTENING IS CALCULATED IN *CUADJTQ*
(  159)     !                     (C) CHECKING FOR NEGATIVE BUOYANCY AND
(  160)     !                         SPECIFYING FINAL T,Q,U,V AND DOWNWARD FLUXES
(  161)     !                    -------------------------------------------------
(  162)     
(  163)     
(  164) !$acc loop vector
(  165)     DO JL=KIDIA,KFDIA
(  166)       ZOENTR = 0.0_JPRB






NVFORTRAN (Version     24.5)          03/19/2025  06:55:27      page 4

(  167)       ZBUOY = 0.0_JPRB
(  168)       ZDMFEN = 0.0_JPRB
(  169)       ZDMFDE = 0.0_JPRB
(  170)       PDMFDE(JL, :) = 0.0_JPRB
(  171)       PMFDDE_RATE(JL, :) = 0.0_JPRB
(  172)       PKINED(JL, :) = 0.0_JPRB
(  173)       
(  174) !$acc loop seq
(  175)       DO JK=3,KLEV
(  176)         IS = 0
(  177)         ZPH = PAPH(JL, JK)
(  178)         LLO2 = LDDRAF(JL) .and. PMFD(JL, JK - 1) < 0.0_JPRB
(  179)         IF (LLO2) THEN
(  180)           IS = IS + 1
(  181)         END IF
(  182)         IF (IS == 0) CYCLE
(  183)         
(  184)         IF (LLO2) THEN
(  185)           ZENTR = YDECUMF%ENTRDD*PMFD(JL, JK - 1)*(PGEOH(JL, JK - 1) - PGEOH(JL, JK))*ZRG
(  186)           ! &*(1.6_JPRB-MIN(1.0_JPRB,PQENH(JL,JK-1)/PQSEN(JL,JK)))
(  187)           ZDMFEN = ZENTR
(  188)           ZDMFDE = ZENTR
(  189)         END IF
(  190)         
(  191)         IF (JK > ITOPDE) THEN
(  192)           IF (LLO2) THEN
(  193)             ZDMFEN = 0.0_JPRB
(  194)             ZDMFDE = PMFD(JL, ITOPDE)*(PAPH(JL, JK) - PAPH(JL, JK - 1)) / (PAPH(JL, KLEV + 1) - PAPH(JL, ITOPDE))
(  195)           END IF
(  196)         END IF
(  197)         
(  198)         IF (JK <= ITOPDE) THEN
(  199)           IF (LLO2) THEN
(  200)             ZDZ = -(PGEOH(JL, JK - 1) - PGEOH(JL, JK))*ZRG
(  201)             ZZENTR = ZOENTR*ZDZ*PMFD(JL, JK - 1)
(  202)             ZDMFEN = ZDMFEN + ZZENTR
(  203)             ZDMFEN = MAX(ZDMFEN, 0.3_JPRB*PMFD(JL, JK - 1))
(  204)             ZDMFEN = MAX(ZDMFEN, -0.75_JPRB*PMFU(JL, JK) - (PMFD(JL, JK - 1) - ZDMFDE))
(  205)             ZDMFEN = MIN(ZDMFEN, 0.0_JPRB)
(  206)           END IF
(  207)           
(  208)           PDMFDE(JL, JK) = ZDMFEN - ZDMFDE
(  209)           
(  210)         END IF
(  211)         IF (LLO2) THEN
(  212)           PMFD(JL, JK) = PMFD(JL, JK - 1) + ZDMFEN - ZDMFDE
(  213)           ZSEEN = (YDCST%RCPD*PTENH(JL, JK - 1) + PGEOH(JL, JK - 1))*ZDMFEN
(  214)           ZQEEN = PQENH(JL, JK - 1)*ZDMFEN
(  215)           ZSDDE = (YDCST%RCPD*PTD(JL, JK - 1) + PGEOH(JL, JK - 1))*ZDMFDE
(  216)           ZQDDE = PQD(JL, JK - 1)*ZDMFDE
(  217)           ZMFDSK = PMFDS(JL, JK - 1) + ZSEEN - ZSDDE
(  218)           ZMFDQK = PMFDQ(JL, JK - 1) + ZQEEN - ZQDDE
(  219)           PQD(JL, JK) = ZMFDQK*(1.0_JPRB / MIN(-YDECUMF%RMFCMIN, PMFD(JL, JK)))
(  220)           PTD(JL, JK) = (ZMFDSK*(1.0_JPRB / MIN(-YDECUMF%RMFCMIN, PMFD(JL, JK))) - PGEOH(JL, JK)) / YDCST%RCPD
(  221)           PTD(JL, JK) = MIN(400._JPRB, PTD(JL, JK))
(  222)           PTD(JL, JK) = MAX(100._JPRB, PTD(JL, JK))
(  223)           ZCOND = PQD(JL, JK)
(  224)         END IF






