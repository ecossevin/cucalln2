(  237)         
(  238)         
(  239)         ZQMAX = 0.5_JPRB
(  240)         
(  241)         !*********************************************
(  242)         IF (.not.YDEPHLI%LPHYLIN) THEN
(  243)           !*********************************************
(  244)           
(  245)           !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
