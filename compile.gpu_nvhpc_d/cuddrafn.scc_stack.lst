(  340)         !IF (LHOOK) CALL DR_HOOK('CUADJTQ',1,ZHOOK_HANDLE)






NVFORTRAN (Version     24.5)          03/19/2025  06:55:27      page 7

(  341)         
(  342)         ! =========================================
(  343)         
(  344)         IF (LLO2) THEN
(  345)           ZCOND = ZCOND - PQD(JL, JK)
(  346)           ZBUO = PTD(JL, JK)*(1.0_JPRB + YDCST%RETV*PQD(JL, JK)) - PTENH(JL, JK)*(1.0_JPRB + YDCST%RETV*PQENH(JL, JK))
(  347)           IF (PRFL(JL) > 0.0_JPRB .and. PMFU(JL, JK) > 0.0_JPRB) THEN
(  348)             ZRAIN = PRFL(JL) / PMFU(JL, JK)
(  349)             ZBUO = ZBUO - PTD(JL, JK)*ZRAIN
(  350)           END IF
(  351)           IF (ZBUO >= 0.0_JPRB .or. PRFL(JL) <= PMFD(JL, JK)*ZCOND) THEN
(  352)             PMFD(JL, JK) = 0.0_JPRB
(  353)             ZBUO = 0.0_JPRB
(  354)           END IF
(  355)           PMFDS(JL, JK) = (YDCST%RCPD*PTD(JL, JK) + PGEOH(JL, JK))*PMFD(JL, JK)
(  356)           PMFDQ(JL, JK) = PQD(JL, JK)*PMFD(JL, JK)
(  357)           ZDMFDP = -PMFD(JL, JK)*ZCOND
(  358)           PDMFDP(JL, JK - 1) = ZDMFDP
(  359)           PRFL(JL) = PRFL(JL) + ZDMFDP
(  360)           
(  361)           ! COMPUTE ORGANIZED ENTRAINMENT FOR USE AT NEXT LEVEL
(  362)           
(  363)           ZBUOYZ = ZBUO / PTENH(JL, JK)
(  364)           ZBUOYV = ZBUOYZ
(  365)           ZBUOYZ = MIN(ZBUOYZ, 0.0_JPRB)
(  366)           ZDZ = -(PGEO(JL, JK - 1) - PGEO(JL, JK))
(  367)           ZBUOY = ZBUOY + ZBUOYZ*ZDZ
(  368)           ZOENTR = YDCST%RG*ZBUOYZ*0.5_JPRB / (1.0_JPRB + ZBUOY)
(  369)           
(  370)           ! STORE DOWNDRAUGHT DETRAINMENT RATES
(  371)           
(  372)           PMFDDE_RATE(JL, JK) = -ZDMFDE
(  373)           
(  374)           ! COMPUTE KINETIC ENERGY
(  375)           
(  376)           ZDKBUO = ZDZ*ZBUOYV*ZFACBUO
(  377)           IF (ZDMFEN < 0.0_JPRB) THEN
(  378)             ZDKEN = MIN(1.0_JPRB, (1 + Z_CWDRAG)*ZDMFEN / MIN(-YDECUMF%RMFCMIN, PMFD(JL, JK - 1)))
(  379)           ELSE
(  380)             ZDKEN = MIN(1.0_JPRB, (1 + Z_CWDRAG)*ZDMFDE / MIN(-YDECUMF%RMFCMIN, PMFD(JL, JK - 1)))
(  381)           END IF
(  382)           PKINED(JL, JK) = MAX(0.0_JPRB, (PKINED(JL, JK - 1)*(1 - ZDKEN) + ZDKBUO) / (1 + ZDKEN))
(  383)           
(  384)         END IF
(  385)         
(  386)       END DO
(  387)     END DO
(  388)     
(  389)     
(  390)     
(  391) !$acc end data
(  392)   END SUBROUTINE CUDDRAFN_LOKI
(  393) END MODULE CUDDRAFN_LOKI_MOD











