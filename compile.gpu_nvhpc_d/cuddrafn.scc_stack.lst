(  283)           
(  284)           
(  285)           !DIR$    IVDEP
(  286)           !OCL NOVREC
(  287)           IF (LLO2) THEN
(  288)             ZQP = 1.0_JPRB / ZPH
(  289)             
(  290)             ZTARG = PTD(JL, IK)
(  291)             ZOEALFA = 0.5_JPRB*(TANH(YDEPHLI%RLPAL1*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB)
(  292)             ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4LES))
(  293)             ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4IES))
(  294)             ZQSAT = ZQP*(ZOEALFA*ZFOEEWL + (1.0_JPRB - ZOEALFA)*ZFOEEWI)
(  295)             Z1S = TANH(YDEPHLI%RLPAL2*(ZQSAT - ZQMAX))
(  296)             ZQSAT = 0.5_JPRB*((1.0_JPRB - Z1S)*ZQSAT + (1.0_JPRB + Z1S)*ZQMAX)
(  297)             
(  298)             ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  299)             ZQSAT = ZQSAT*ZCOR
(  300)             
(  301)             Z2S = ZOEALFA*YDTHF%R5ALVCP*(1.0_JPRB / (ZTARG - YDTHF%R4LES)**2) + (1.0_JPRB - ZOEALFA)*YDTHF%R5ALSCP*(1.0_JPRB
(  302)             & (ZTARG - YDTHF%R4IES)**2)
(  303)             CUADJTQ_ZCOND = (PQD(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  304)             
(  305)             CUADJTQ_ZCOND = MIN(CUADJTQ_ZCOND, 0.0_JPRB)
(  306)             
(  307)             IF (CUADJTQ_ZCOND /= 0.0_JPRB) THEN
(  308)               
(  309)               PTD(JL, IK) = PTD(JL, IK) + (ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - ZOEALFA)*YDTHF%RALSDCP)*CUADJTQ_ZCOND
(  310)               PQD(JL, IK) = PQD(JL, IK) - CUADJTQ_ZCOND
(  311)               ZTARG = PTD(JL, IK)
(  312)               ZOEALFA = 0.5_JPRB*(TANH(YDEPHLI%RLPAL1*(ZTARG - YDEPHLI%RLPTRC)) + 1.0_JPRB)
(  313)               ZFOEEWL = YDTHF%R2ES*EXP(YDTHF%R3LES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4LES))
(  314)               ZFOEEWI = YDTHF%R2ES*EXP(YDTHF%R3IES*(ZTARG - YDCST%RTT) / (ZTARG - YDTHF%R4IES))
(  315)               ZQSAT = ZQP*(ZOEALFA*ZFOEEWL + (1.0_JPRB - ZOEALFA)*ZFOEEWI)
(  316)               Z1S = TANH(YDEPHLI%RLPAL2*(ZQSAT - ZQMAX))
(  317)               ZQSAT = 0.5_JPRB*((1.0_JPRB - Z1S)*ZQSAT + (1.0_JPRB + Z1S)*ZQMAX)
(  318)               
(  319)               ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  320)               ZQSAT = ZQSAT*ZCOR
(  321)               
(  322)               Z2S = ZOEALFA*YDTHF%R5ALVCP*(1.0_JPRB / (ZTARG - YDTHF%R4LES)**2) + (1.0_JPRB - ZOEALFA)*YDTHF%R5ALSCP*(1.0_JP
(  323)               & (ZTARG - YDTHF%R4IES)**2)
(  324)               ZCOND1 = (PQD(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  325)               
(  326)               PTD(JL, IK) = PTD(JL, IK) + (ZOEALFA*YDTHF%RALVDCP + (1.0_JPRB - ZOEALFA)*YDTHF%RALSDCP)*ZCOND1
(  327)               
(  328)               PQD(JL, IK) = PQD(JL, IK) - ZCOND1
(  329)             END IF
