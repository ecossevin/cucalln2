(  247)           
(  248)           
(  249)           
(  250)           !DIR$    IVDEP
(  251)           !OCL NOVREC
(  252)           IF (LLO2) THEN
(  253)             ZQP = 1.0_JPRB / ZPH
(  254)             ZQSAT = FOEEWMCU(PTD(JL, IK))*ZQP
(  255)             ZQSAT = MIN(0.5_JPRB, ZQSAT)
(  256)             ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  257)             ZQSAT = ZQSAT*ZCOR
(  258)             CUADJTQ_ZCOND = (PQD(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*FOEDEMCU(PTD(JL, IK)))
(  259)             CUADJTQ_ZCOND = MIN(CUADJTQ_ZCOND, 0.0_JPRB)
(  260)             PTD(JL, IK) = PTD(JL, IK) + FOELDCPMCU(PTD(JL, IK))*CUADJTQ_ZCOND
(  261)             PQD(JL, IK) = PQD(JL, IK) - CUADJTQ_ZCOND
(  262)             ZQSAT = FOEEWMCU(PTD(JL, IK))*ZQP
(  263)             ZQSAT = MIN(0.5_JPRB, ZQSAT)
(  264)             ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  265)             ZQSAT = ZQSAT*ZCOR
(  266)             ZCOND1 = (PQD(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*FOEDEMCU(PTD(JL, IK)))
(  267)             IF (CUADJTQ_ZCOND == 0.0_JPRB) ZCOND1 = MIN(ZCOND1, 0.0_JPRB)
(  268)             PTD(JL, IK) = PTD(JL, IK) + FOELDCPMCU(PTD(JL, IK))*ZCOND1
(  269)             PQD(JL, IK) = PQD(JL, IK) - ZCOND1
(  270)           END IF
