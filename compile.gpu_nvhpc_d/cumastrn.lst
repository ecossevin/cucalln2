(  384) 
(  385) !     1.           SPECIFY CONSTANTS AND PARAMETERS
(  386) !                  --------------------------------
(  387) 
(  388) IF (LHOOK) CALL DR_HOOK('CUMASTRN',0,ZHOOK_HANDLE)
(  389) ASSOCIATE(LMFCUCA=>YDML_PHY_EC%YRECUMF%LMFCUCA, LMFDD=>YDML_PHY_EC%YRECUMF%LMFDD, &
(  390)  & LMFDUDV=>YDML_PHY_EC%YRECUMF%LMFDUDV, LMFPEN=>YDML_PHY_EC%YRECUMF%LMFPEN, LMFSCV=>YDML_PHY_EC%YRECUMF%LMFSCV, &
(  391)  & LMFSMOOTH=>YDML_PHY_EC%YRECUMF%LMFSMOOTH, LMFUVDIS=>YDML_PHY_EC%YRECUMF%LMFUVDIS, &
(  392)  & LMFWSTAR=>YDML_PHY_EC%YRECUMF%LMFWSTAR, NJKT1=>YDML_PHY_EC%YRECUMF%NJKT1, NJKT2=>YDML_PHY_EC%YRECUMF%NJKT2, &
(  393)  & NJKT3=>YDML_PHY_EC%YRECUMF%NJKT3, NJKT5=>YDML_PHY_EC%YRECUMF%NJKT5, RCAPDCYCL=>YDML_PHY_EC%YRECUMF%RCAPDCYCL, &
(  394)  & RDEPTHS=>YDML_PHY_EC%YRECUMF%RDEPTHS, RCUCOV =>YDML_PHY_EC%YRECUMF%RCUCOV, &
(  395)  & RMFCFL=>YDML_PHY_EC%YRECUMF%RMFCFL, RMFCMIN=>YDML_PHY_EC%YRECUMF%RMFCMIN, RMFLIA=>YDML_PHY_EC%YRECUMF%RMFLIA, &
(  396)  & RMFSOLCT=>YDML_PHY_EC%YRECUMF%RMFSOLCT, RCAPQADV=>YDML_PHY_EC%YRECUMF%RCAPQADV,&
(  397)  & RMFSOLTQ=>YDML_PHY_EC%YRECUMF%RMFSOLTQ, RMFSOLUV=>YDML_PHY_EC%YRECUMF%RMFSOLUV, &
(  398)  & RMINCAPE=>YDML_PHY_EC%YRECUMF%RMINCAPE, RTAUA=>YDML_PHY_EC%YRECUMF%RTAUA, &






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 8

(  399)  & RUVPER=>YDML_PHY_EC%YRECUMF%RUVPER, RMFADVW=>YDML_PHY_EC%YRECUMF%RMFADVW,RMFADVWDD=>YDML_PHY_EC%YRECUMF%RMFADVWDD,&
(  400)  & LNEWTAU=>YDML_PHY_EC%YRECUMF%LNEWTAU, RXMIN=>YDML_PHY_EC%YRECUMF%RXMIN, RTAULIM=>YDML_PHY_EC%YRECUMF%RTAULIM, &
(  401)  & RTAUFAC=>YDML_PHY_EC%YRECUMF%RTAUFAC, RDXMIN=>YDML_PHY_EC%YRECUMF%RDXMIN, RDXMAX=>YDML_PHY_EC%YRECUMF%RDXMAX, &
(  402)  & LMFSCAV=>YDML_PHY_EC%YREPHY%LMFSCAV, LMFTRAC=>YDML_PHY_EC%YREPHY%LMFTRAC, &
(  403)  & LELIGHT=>YDML_PHY_EC%YREPHY%LELIGHT, LCHEM_LIGHT=>YDCHEM%LCHEM_LIGHT,&
(  404)  & RA=>YDCST%RA, RCPD=>YDCST%RCPD, RD=>YDCST%RD, RETV=>YDCST%RETV, RG=>YDCST%RG, &
(  405)  & RLVTT=>YDCST%RLVTT, RPI=>YDCST%RPI)
(  406) 
(  407) ZCONS2=RMFCFL/(RG*PTSPHY)
(  408) ZCONS=1.0_JPRB/(RG*PTSPHY)
(  409) ZORCPD=1.0_JPRB/RCPD
(  410) ZRDOCPD=RD*ZORCPD
(  411) ZRG=1.0_JPRB/RG
(  412) ZTAU(:)=0.0
(  413) 
(  414) ! prepare SPP PERTURBATIONS
(  415) IF (YDSPP_CONFIG%LSPP) THEN
(  416)   IPN  = YDSPP_CONFIG%PPTR%RTAU
(  417)   LLPERT_RTAU = IPN > 0
(  418)   IF (LLPERT_RTAU) THEN
(  419)     PN1    = YDSPP_CONFIG%SM%PN(IPN)
(  420)     IPRTAU = PN1%MP
(  421)   ENDIF
(  422) 
(  423) ELSE
(  424)   LLPERT_RTAU  =.FALSE.
(  425) ENDIF
(  426) 
(  427) !----------------------------------------------------------------------
(  428) DO JL=KIDIA,KFDIA
(  429)   PCAPE(JL)=0.0_JPRB
(  430)   PVDISCU(JL)=0.0_JPRB
(  431)   LDCUM(JL)=.FALSE.
(  432) ENDDO
(  433) 
(  434) !*    2.           INITIALIZE VALUES AT VERTICAL GRID POINTS IN 'CUINI'
(  435) !                  ---------------------------------------------------
(  436) 
(  437) CALL CUININ &
(  438)  & (YDCST,   YDTHF,    YDML_PHY_SLIN%YREPHLI,  YDML_PHY_EC%YRECUMF,&
(  439)  & KIDIA,    KFDIA,    KLON,     KLEV,&
(  440)  & PTEN,     PQEN,     PQSEN,    PUEN,     PVEN,&
(  441)  & PGEO,     PAPH,&
(  442)  & ILAB,&
(  443)  & ZTENH,    ZQENH,    ZQSENH,   PGEOH,&
(  444)  & PTU,      PQU,      ZTD,      ZQD,&
(  445)  & ZUU,      ZVU,      ZUD,      ZVD,&
(  446)  & PLU     )  
(  447) 
(  448) !---------------------------------------------------------------------
(  449) 
(  450) !*    3.0          CLOUD BASE CALCULATIONS
(  451) !                  -----------------------
(  452) 
(  453) !*             (A) DETERMINE CLOUD BASE VALUES IN 'CUBASE'
(  454) !                  ---------------------------------------
(  455) 
(  456) ZKMFL(:)=0.0_JPRB






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 9

(  457) LLMIXS = LDTDKMF
(  458) CALL CUBASEN &
(  459)  & (PPLDARE, PPLRG,    YDTHF,   YDCST,    YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECLDP,YDML_PHY_EC%YRECUMF,&
(  460)  & YDSPP_CONFIG, &
(  461)  & KIDIA,    KFDIA,    KLON,     KLEV,   NJKT1, LLMIXS, LDTDKMF,&
(  462)  & ZTENH,    ZQENH,    PGEOH,    PAPH,&
(  463)  & PQHFL,    PAHFS,    PGP2DSPP, ZKMFL,&
(  464)  & PTEN,     PQEN,     PQSEN,    PGEO,&
(  465)  & PTU,      PQU,      PLU,      ZKINEU,   ZWUBASE,&
(  466)  & ILAB,     LDCUM,    LDSC,     KCBOT,    KBOTSC,&
(  467)  & ICTOP0,   IDPL,     PCAPE )   
(  468) 
(  469) 
(  470) !*             (B) DETERMINE TOTAL MOISTURE CONVERGENCE AND
(  471) !*                 DECIDE ON TYPE OF CUMULUS CONVECTION 
(  472) !*                 ONE THE BASIS OF THE DEPTH OF THE CONVECTION
(  473) !*                 DEEP IF CLOUD DEPTH > 200MB
(  474) !*                 SHALLOW IF CLOUD DEPTH <200MB
(  475) !                  -----------------------------------------
(  476) 
(  477) ! CALCULATE COLUMN AND SUB CLOUD LAYER MOISTURE CONVERGENCE
(  478) ! AND SUB CLOUD LAYER MOIST STATIC ENERGY CONVERGENCE
(  479) 
(  480) !DIR$ LOOP_INFO EST_TRIPS(16)
(  481) DO JL=KIDIA,KFDIA
(  482)   ZDHPBL(JL)=0.0_JPRB
(  483)   IDTOP(JL)=0
(  484)   ZCAPPBL(JL)=0.
(  485)   ZKHVFL(JL)= (-PAHFS(JL,KLEV+1) * ZORCPD - RETV * PTEN(JL,KLEV) * PQHFL(JL,KLEV+1))/(PPLRG*PPLDARE)
(  486)   ZKHFL(JL) = (-PAHFS(JL,KLEV+1) - RLVTT * PQHFL(JL,KLEV+1))/(PPLRG*PPLDARE)
(  487) ENDDO
(  488) DO JK=NJKT2,KLEV
(  489) !DIR$ LOOP_INFO EST_TRIPS(16)
(  490)   DO JL=KIDIA,KFDIA
(  491)     IF(LDCUM(JL).AND.JK >= KCBOT(JL)) THEN
(  492)       ZDZ=(PAPH(JL,JK+1)-PAPH(JL,JK))
(  493)       ZDHPBL(JL)=ZDHPBL(JL)+(RLVTT*PTENQ(JL,JK)+RCPD*PTENT(JL,JK))*ZDZ
(  494)       ZCAPPBL(JL)=ZCAPPBL(JL)+(PTENT(JL,JK)+RETV*PTEN(JL,JK)*PTENQ(JL,JK))*ZDZ
(  495)     ENDIF
(  496)   ENDDO
(  497) ENDDO
(  498) 
(  499) !*                 ESTIMATE CLOUD HEIGHT FOR ENTRAINMENT/DETRAINMENT
(  500) !*                 CALCULATIONS IN CUASC AND INITIAL DETERMINATION OF 
(  501) !*                 CLOUD TYPE
(  502) !*                 (MAX.POSSIBLE CLOUD HEIGHT
(  503) !*                 FOR NON-ENTRAINING PLUME, FOLLOWING A.-S.,1974)
(  504) !                  -------------------------------------------------
(  505) 
(  506) 
(  507) !*                 SPECIFY INITIAL CLOUD TYPE
(  508) !*
(  509) 
(  510) !DIR$ LOOP_INFO EST_TRIPS(16)
(  511) DO JL=KIDIA,KFDIA
(  512)   IF (LDCUM(JL)) THEN
(  513)     IKB=KCBOT(JL)
(  514)     ITOPM2=ICTOP0(JL)






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 10

(  515)     ZPBMPT=PAPH(JL,IKB)-PAPH(JL,ITOPM2)
(  516)     IF (ZPBMPT >= RDEPTHS) THEN
(  517)       KTYPE(JL)=1
(  518)     ELSE
(  519)       KTYPE(JL)=2
(  520)     ENDIF
(  521)   ELSE
(  522)     KTYPE(JL)=0
(  523)   ENDIF
(  524) ENDDO
(  525) 
(  526) !*             (C) calculate initial updraught mass flux
(  527) !*                 and set lateral mixing rates
(  528) !*
(  529) !*                 for deep convection assume it is 10% of 
(  530) !*                 maximum value which is determined by the 
(  531) !*                 thickness of the layer and timestep
(  532) !*
(  533) !*                 for shallow convection calculated assuming
(  534) !*                 a balance of moist static energy in the 
(  535) !*                 sub-cloud layer (ignores present of downdraughts)
(  536) !                  ------------------------------------------
(  537) 
(  538) IF (LMFWSTAR) THEN
(  539) !DIR$ IVDEP
(  540) !OCL NOVREC
(  541) !DIR$ LOOP_INFO EST_TRIPS(16)
(  542)   DO JL=KIDIA,KFDIA
(  543)     IF (LDCUM(JL)) THEN
(  544)       IKB=KCBOT(JL)
(  545)       ZDZ=MAX(0.0_JPRB,MIN(1.5E3_JPRB,(PGEOH(JL,IKB)-PGEOH(JL,KLEV+1))/RG))
(  546)       ZMF_SHAL(JL)=0.07_JPRB*(RG/PTEN(JL,KLEV)*ZDZ*MAX(0.0_JPRB,ZKHVFL(JL)))**.3333
(  547)       ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  548)       ZMF_SHAL(JL)=MIN(ZMF_SHAL(JL),ZMFMAX)
(  549)     ENDIF
(  550)   ENDDO
(  551) ENDIF
(  552) 
(  553) !DIR$ LOOP_INFO EST_TRIPS(16)
(  554) DO JL=KIDIA,KFDIA
(  555)   IF (LDCUM(JL)) THEN
(  556)     IKB=KCBOT(JL)
(  557)     ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  558) 
(  559) ! deep convection
(  560) 
(  561)     IF (KTYPE(JL) == 1) THEN
(  562)       ZMFUB(JL)=ZMFMAX*0.1_JPRB
(  563) 
(  564)     ELSEIF (KTYPE(JL) == 2) THEN
(  565) 
(  566) ! shallow convection
(  567) 
(  568)       ZQUMQE=PQU(JL,IKB)+PLU(JL,IKB)-ZQENH(JL,IKB)
(  569)       ZDQMIN=MAX(0.01_JPRB*ZQENH(JL,IKB),1.E-10_JPRB)
(  570)       ZDH=RCPD*(PTU(JL,IKB)-ZTENH(JL,IKB))+RLVTT*ZQUMQE
(  571)       ZDH=RG*MAX(ZDH,1.E5_JPRB*ZDQMIN)
(  572)       IF (ZDHPBL(JL) > 0.0_JPRB) THEN






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 11

(  573)         ZMFUB(JL)=ZDHPBL(JL)/ZDH
(  574)         ZMFUB(JL)=MIN(ZMFUB(JL),ZMFMAX)
(  575)       ELSE
(  576)         ZMFUB(JL)=ZMFMAX*0.1_JPRB
(  577)         LDCUM(JL)=.FALSE.
(  578)       ENDIF
(  579)       IF(LMFWSTAR) ZMFUB(JL)=ZMF_SHAL(JL)
(  580)     ENDIF
(  581) 
(  582)   ELSE
(  583) 
(  584) ! no buoyancy cloud base from surface
(  585) ! set cloud base mass flux and mixing rate
(  586) ! to default value for safety
(  587) 
(  588)     ZMFUB(JL)=0.0_JPRB
(  589)   ENDIF
(  590) ENDDO
(  591) 
(  592) !-----------------------------------------------------------------------
(  593) 
(  594) !*    4.0          DETERMINE CLOUD ASCENT FOR ENTRAINING PLUME
(  595) !                  -------------------------------------------
(  596) 
(  597) !*             (A) ESTIMATE CLOUD HEIGHT FOR ENTRAINMENT/DETRAINMENT
(  598) !*                 CALCULATIONS IN CUASC (MAX.POSSIBLE CLOUD HEIGHT
(  599) !*                 FOR NON-ENTRAINING PLUME, FOLLOWING A.-S.,1974)
(  600) !                  -------------------------------------------------
(  601) 
(  602) ! CALCULATIONS NOW DONE IS SECTION 3 ABOVE SO THAT
(  603) ! INITIAL CLOUD DEPTH CAN BE USED TO SPECIFY
(  604) ! THE TYPE OF CONVECTION
(  605) 
(  606) !*             (B) DO ASCENT IN 'CUASC'IN ABSENCE OF DOWNDRAFTS
(  607) !                  --------------------------------------------
(  608) 
(  609) CALL CUASCN &
(  610)  & (YDTHF, YDCST, YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECLDP,YDML_PHY_EC%YRECUMF,YDSPP_CONFIG,YGFL,&
(  611)  & KIDIA,    KFDIA,    KLON,    KLEV, LDTDKMF,&
(  612)  & PTSPHY,&
(  613)  & ZTENH,    ZQENH,    PUEN,     PVEN,&
(  614)  & PTEN,     PQEN,     PQSEN,    PLITOT,&
(  615)  & PGEO,     PGEOH,    PAP,      PAPH,&
(  616)  & PVERVEL,  ZWUBASE,  PGP2DSPP,  &
(  617)  & LDLAND,   LDCUM,    KTYPE,    ILAB,     LLSCVFLAG,&
(  618)  & PTU,      PQU,      PLU,      PLRAIN,&
(  619)  & PMFU,     ZMFUB,    PLGLAC,&
(  620)  & ZMFUS,    ZMFUQ,    ZMFUL,    PLUDE,    PLUDELI,       ZDMFUP,&
(  621)  & PLCRIT_AER,&
(  622)  & ZDMFEN,&  
(  623)  & KCBOT,    KCTOP,    ICTOP0,   IDPL,     PMFUDE_RATE,   ZKINEU,   PWU,PWMEAN ) 
(  624) 
(  625) !*         (C) CHECK CLOUD DEPTH AND CHANGE ENTRAINMENT RATE ACCORDINGLY
(  626) !              CALCULATE PRECIPITATION RATE (FOR DOWNDRAFT CALCULATION)
(  627) !              -----------------------------------------------------
(  628) 
(  629) !DIR$ IVDEP
(  630) !OCL NOVREC






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 12

(  631) !DIR$ LOOP_INFO EST_TRIPS(16)
(  632) DO JL=KIDIA,KFDIA
(  633)   IF (LDCUM(JL)) THEN
(  634)     IKB=KCBOT(JL)
(  635)     ITOPM2=KCTOP(JL)
(  636)     ZPBMPT=PAPH(JL,IKB)-PAPH(JL,ITOPM2)
(  637)     IF(KTYPE(JL) == 1.AND.ZPBMPT < RDEPTHS) KTYPE(JL)=2
(  638)     IF(KTYPE(JL) == 2.AND.ZPBMPT >= RDEPTHS) KTYPE(JL)=1
(  639)     ICTOP0(JL)=KCTOP(JL)
(  640)   ENDIF
(  641)   ZRFL(JL)=ZDMFUP(JL,1)
(  642) ENDDO
(  643) DO JK=2,KLEV
(  644) !DIR$ LOOP_INFO EST_TRIPS(16)
(  645)   DO JL=KIDIA,KFDIA
(  646)     ZRFL(JL)=ZRFL(JL)+ZDMFUP(JL,JK)
(  647)   ENDDO
(  648) ENDDO
(  649) DO JK=1,KLEV
(  650) !DIR$ LOOP_INFO EST_TRIPS(16)
(  651)   DO JL=KIDIA,KFDIA
(  652)     PMFD(JL,JK)=0.0_JPRB
(  653)     ZMFDS(JL,JK)=0.0_JPRB
(  654)     ZMFDQ(JL,JK)=0.0_JPRB
(  655)     ZDMFDP(JL,JK)=0.0_JPRB
(  656)     ZDPMEL(JL,JK)=0.0_JPRB
(  657)   ENDDO
(  658) ENDDO
(  659) 
(  660) ! Needed for dissipation rate and if LMFUVDIS=T
(  661) DO JK=1,KLEV
(  662) !DIR$ LOOP_INFO EST_TRIPS(16)
(  663)   DO JL=KIDIA,KFDIA
(  664)     ZTENU(JL,JK)=PTENU(JL,JK)
(  665)     ZTENV(JL,JK)=PTENV(JL,JK)
(  666)   ENDDO
(  667) ENDDO
(  668) 
(  669) !-----------------------------------------------------------------------
(  670) 
(  671) !*    5.0          CUMULUS DOWNDRAFT CALCULATIONS
(  672) !                  ------------------------------
(  673) 
(  674) IF(LMFDD) THEN
(  675) 
(  676) !*             (A) DETERMINE LFS IN 'CUDLFS'
(  677) !                  -------------------------
(  678) 
(  679)   CALL CUDLFSN &
(  680)    & (YDTHF, YDCST, YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECUMF,&
(  681)    & KIDIA,    KFDIA,    KLON,     KLEV,&
(  682)    & KCBOT,    KCTOP,    LDCUM,&
(  683)    & ZTENH,    ZQENH,    PTEN,     PQSEN,    PGEO,&
