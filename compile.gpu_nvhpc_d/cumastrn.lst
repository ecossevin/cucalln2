(  993)           ZFAC=ZMFS(JL)*RG*RMFADVW*(PMFU(JL,JK)+RMFADVWDD*PMFD(JL,JK))/(PAPH(JL,JK)-PAPH(JL,JK+1))*PTSPHY
(  994)           IF(ABS(ZFAC)>0.98_JPRB) ZMFS(JL)=ZMFS(JL)/MAX(1.02_JPRB,ABS(ZFAC))
