(    9) # 10 "./fcttre.func.h"
(   10) !*
(   11) !     ------------------------------------------------------------------
(   12) # 13 "./fcttre.func.h"
(   13) !     This COMDECK includes the Thermodynamical functions for the cy39
(   14) !       ECMWF Physics package.
(   15) !       Consistent with YOMCST Basic physics constants, assuming the
(   16) !       partial pressure of water vapour is given by a first order
(   17) !       Taylor expansion of Qs(T) w.r.t. to Temperature, using constants
(   18) !       in YOETHF
(   19) !       Two sets of functions are available. In the first set only the
(   20) !       cases water or ice are distinguished by temperature.  This set 
(   21) !       consists of the functions FOEDELTA,FOEEW,FOEDE and FOELH.
(   22) !       The second set considers, besides the two cases water and ice 
(   23) !       also a mix of both for the temperature range YDTHF%RTICE < T < YDTHF%RTWAT.
(   24) !       This set contains FOEALFA,FOEEWM,FOEDEM,FOELDCPM and FOELHM.
(   25) !       FKOOP modifies the ice saturation mixing ratio for homogeneous 
(   26) !       nucleation. FOE_DEWM_DT provides an approximate first derivative
(   27) !       of FOEEWM.
(   28) # 29 "./fcttre.func.h"
(   29) !       Depending on the consideration of mixed phases either the first 
(   30) !       set (e.g. surface, post-processing) or the second set 
(   31) !       (e.g. clouds, condensation, convection) should be used.
(   32) # 33 "./fcttre.func.h"
(   33) !     ------------------------------------------------------------------
(   34) !     *****************************************************************
(   35) # 36 "./fcttre.func.h"
(   36) !                NO CONSIDERATION OF MIXED PHASES
(   37) # 38 "./fcttre.func.h"
(   38) !     *****************************************************************
(   39) REAL(KIND=JPRB) :: FOEDELTA
(   40) REAL(KIND=JPRB) :: PTARE
(   41) FOEDELTA (PTARE) = MAX (0.0_JPRB,SIGN(1.0_JPRB,PTARE-YDCST%RTT))
(   42) # 43 "./fcttre.func.h"
(   43) !                  FOEDELTA = 1    water
(   44) !                  FOEDELTA = 0    ice
(   45) # 46 "./fcttre.func.h"
(   46) !     THERMODYNAMICAL FUNCTIONS .
(   47) # 48 "./fcttre.func.h"
(   48) !     Pressure of water vapour at saturation
(   49) !        INPUT : PTARE = TEMPERATURE
(   50) REAL(KIND=JPRB) :: FOEEW,FOEDE,FOEDESU,FOELH,FOELDCP
(   51) FOEEW ( PTARE ) = YDTHF%R2ES*EXP (&
(   52)   &(YDTHF%R3LES*FOEDELTA(PTARE)+YDTHF%R3IES*(1.0_JPRB-FOEDELTA(PTARE)))*(PTARE-YDCST%RTT)&
(   53) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE)))))
(   54) # 55 "./fcttre.func.h"
(   55) FOEDE ( PTARE ) = &
(   56)   &(FOEDELTA(PTARE)*YDTHF%R5ALVCP+(1.0_JPRB-FOEDELTA(PTARE))*YDTHF%R5ALSCP)&
(   57) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE))))**2
(   58) # 59 "./fcttre.func.h"






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 47

(   59) FOEDESU ( PTARE ) = &
(   60)   &(FOEDELTA(PTARE)*YDTHF%R5LES+(1.0_JPRB-FOEDELTA(PTARE))*YDTHF%R5IES)&
(   61) &/ (PTARE-(YDTHF%R4LES*FOEDELTA(PTARE)+YDTHF%R4IES*(1.0_JPRB-FOEDELTA(PTARE))))**2
(   62) # 63 "./fcttre.func.h"
(   63) FOELH ( PTARE ) =&
(   64)          &FOEDELTA(PTARE)*YDCST%RLVTT + (1.0_JPRB-FOEDELTA(PTARE))*YDCST%RLSTT
(   65) # 66 "./fcttre.func.h"
(   66) FOELDCP ( PTARE ) = &
(   67)          &FOEDELTA(PTARE)*YDTHF%RALVDCP + (1.0_JPRB-FOEDELTA(PTARE))*YDTHF%RALSDCP
(   68) # 69 "./fcttre.func.h"
(   69) !     *****************************************************************
(   70) # 71 "./fcttre.func.h"
(   71) !           CONSIDERATION OF MIXED PHASES
(   72) # 73 "./fcttre.func.h"
(   73) !     *****************************************************************
(   74) # 75 "./fcttre.func.h"
(   75) !     FOEALFA is calculated to distinguish the three cases:
(   76) # 77 "./fcttre.func.h"
(   77) !                       FOEALFA=1            water phase
(   78) !                       FOEALFA=0            ice phase
(   79) !                       0 < FOEALFA < 1      mixed phase
(   80) # 81 "./fcttre.func.h"
(   81) !               INPUT : PTARE = TEMPERATURE
(   82) REAL(KIND=JPRB) :: FOEALFA
(   83) FOEALFA (PTARE) = MIN(1.0_JPRB,((MAX(YDTHF%RTICE,MIN(YDTHF%RTWAT,PTARE))-YDTHF%RTICE)&
(   84)  &*YDTHF%RTWAT_RTICE_R)**2) 
(   85) # 87 "./fcttre.func.h"
(   87) !     Pressure of water vapour at saturation
(   88) !        INPUT : PTARE = TEMPERATURE
(   89) REAL(KIND=JPRB) :: FOEEWM,FOEDEM,FOELDCPM,FOELHM,FOE_DEWM_DT
(   90) FOEEWM ( PTARE ) = YDTHF%R2ES *&
(   91)      &(FOEALFA(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))+&
(   92)   &(1.0_JPRB-FOEALFA(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)))
(   93) # 94 "./fcttre.func.h"
(   94) FOE_DEWM_DT( PTARE ) = YDTHF%R2ES * ( &
(   95)      & YDTHF%R3LES*FOEALFA(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES)) &
(   96)      &    *(YDCST%RTT-YDTHF%R4LES)/(PTARE-YDTHF%R4LES)**2 + &
(   97)      & YDTHF%R3IES*(1.0-FOEALFA(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)) &
(   98)      &    *(YDCST%RTT-YDTHF%R4IES)/(PTARE-YDTHF%R4IES)**2)
(   99) # 100 "./fcttre.func.h"
(  100) FOEDEM ( PTARE ) = FOEALFA(PTARE)*YDTHF%R5ALVCP*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  101)              &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%R5ALSCP*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  102) # 103 "./fcttre.func.h"
(  103) FOELDCPM ( PTARE ) = FOEALFA(PTARE)*YDTHF%RALVDCP+&
(  104)             &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%RALSDCP
(  105) # 106 "./fcttre.func.h"
(  106) FOELHM ( PTARE ) =&
(  107)          &FOEALFA(PTARE)*YDCST%RLVTT+(1.0_JPRB-FOEALFA(PTARE))*YDCST%RLSTT
(  108) # 110 "./fcttre.func.h"
(  110) !     Temperature normalization for humidity background change of variable
(  111) !        INPUT : PTARE = TEMPERATURE
(  112) REAL(KIND=JPRB) :: FOETB
(  113) FOETB ( PTARE )=FOEALFA(PTARE)*YDTHF%R3LES*(YDCST%RTT-YDTHF%R4LES)*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  114)              &(1.0_JPRB-FOEALFA(PTARE))*YDTHF%R3IES*(YDCST%RTT-YDTHF%R4IES)*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  115) # 116 "./fcttre.func.h"
(  116) !     ------------------------------------------------------------------
(  117) !     *****************************************************************
(  118) # 119 "./fcttre.func.h"






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 48

(  119) !           CONSIDERATION OF DIFFERENT MIXED PHASE FOR CONV
(  120) # 121 "./fcttre.func.h"
(  121) !     *****************************************************************
(  122) # 123 "./fcttre.func.h"
(  123) !     FOEALFCU is calculated to distinguish the three cases:
(  124) # 125 "./fcttre.func.h"
(  125) !                       FOEALFCU=1            water phase
(  126) !                       FOEALFCU=0            ice phase
(  127) !                       0 < FOEALFCU < 1      mixed phase
(  128) # 129 "./fcttre.func.h"
(  129) !               INPUT : PTARE = TEMPERATURE
(  130) REAL(KIND=JPRB) :: FOEALFCU 
(  131) FOEALFCU (PTARE) = MIN(1.0_JPRB,((MAX(YDTHF%RTICECU,MIN(YDTHF%RTWAT,PTARE))&
(  132) &-YDTHF%RTICECU)*YDTHF%RTWAT_RTICECU_R)**2) 
(  133) # 135 "./fcttre.func.h"
(  135) !     Pressure of water vapour at saturation
(  136) !        INPUT : PTARE = TEMPERATURE
(  137) REAL(KIND=JPRB) :: FOEEWMCU,FOEDEMCU,FOELDCPMCU,FOELHMCU
(  138) FOEEWMCU ( PTARE ) = YDTHF%R2ES *&
(  139)      &(FOEALFCU(PTARE)*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))+&
(  140)   &(1.0_JPRB-FOEALFCU(PTARE))*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)))
(  141) # 142 "./fcttre.func.h"
(  142) FOEDEMCU ( PTARE )=FOEALFCU(PTARE)*YDTHF%R5ALVCP*(1.0_JPRB/(PTARE-YDTHF%R4LES)**2)+&
(  143)              &(1.0_JPRB-FOEALFCU(PTARE))*YDTHF%R5ALSCP*(1.0_JPRB/(PTARE-YDTHF%R4IES)**2)
(  144) # 145 "./fcttre.func.h"
(  145) FOELDCPMCU ( PTARE ) = FOEALFCU(PTARE)*YDTHF%RALVDCP+&
(  146)             &(1.0_JPRB-FOEALFCU(PTARE))*YDTHF%RALSDCP
(  147) # 148 "./fcttre.func.h"
(  148) FOELHMCU ( PTARE ) =&
(  149)          &FOEALFCU(PTARE)*YDCST%RLVTT+(1.0_JPRB-FOEALFCU(PTARE))*YDCST%RLSTT
(  150) !     ------------------------------------------------------------------
(  151) # 152 "./fcttre.func.h"
(  152) !     Pressure of water vapour at saturation
(  153) !     This one is for the WMO definition of saturation, i.e. always
(  154) !     with respect to water.
(  155) !     
(  156) !     Duplicate to FOEELIQ and FOEEICE for separate ice variable
(  157) !     FOEELIQ always respect to water 
(  158) !     FOEEICE always respect to ice 
(  159) !     FOEELIQ2ICE is the ratio of vapour pressures over water and ice 
(  160) !       (analytically simplified to avoid a suspected Cray compiler bug and using a single call to exp)
(  161) !     (could use FOEEW and FOEEWMO, but naming convention unclear)
(  162) !     FOELSON returns e wrt liquid water using D Sonntag (1994, Met. Zeit.)
(  163) !      - now recommended for use with radiosonde data (WMO CIMO guide, 2014)
(  164) !      unlike the FOEE functions does not include 1/(YDCST%RETV+1.0_JPRB) factor
(  165) # 166 "./fcttre.func.h"
(  166) REAL(KIND=JPRB) :: FOEEWMO, FOEELIQ, FOEEICE, FOEELIQ2ICE, FOELSON 
(  167) FOEEWMO( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))
(  168) FOEELIQ( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES))
(  169) FOEEICE( PTARE ) = YDTHF%R2ES*EXP(YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES))
(  170) FOEELIQ2ICE( PTARE )  = EXP(      (PTARE-YDCST%RTT)*(YDTHF%R3LES/(PTARE-YDTHF%R4LES) - YDTHF%R3IES/(PTARE-YDTHF%R4IES)))
(  171) FOELSON( PTARE ) = EXP( -6096.9385_JPRB/PTARE + 21.2409642_JPRB &
(  172) 	             - 2.711193E-2_JPRB * PTARE    &
(  173)                      + 1.673952E-5_JPRB * PTARE**2 &
(  174) 		     + 2.433502_JPRB * LOG(PTARE))
(  175) # 176 "./fcttre.func.h"
(  176) REAL(KIND=JPRB) :: FOEEWM_V,FOEEWMCU_V,FOELES_V,FOEIES_V
(  177) REAL(KIND=JPRB) :: EXP1,EXP2






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 49

(  178)       FOELES_V(PTARE)=YDTHF%R3LES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4LES)
(  179)       FOEIES_V(PTARE)=YDTHF%R3IES*(PTARE-YDCST%RTT)/(PTARE-YDTHF%R4IES)
(  180)       FOEEWM_V( PTARE,EXP1,EXP2 )=YDTHF%R2ES*(FOEALFA(PTARE)*EXP1+ &
(  181)           & (1.0_JPRB-FOEALFA(PTARE))*EXP2)
(  182)       FOEEWMCU_V ( PTARE,EXP1,EXP2 ) = YDTHF%R2ES*(FOEALFCU(PTARE)*EXP1+&
(  183)           &(1.0_JPRB-FOEALFCU(PTARE))*EXP2)
(  184) # 382 "./cumastrn.F90"
(  382) # 383 "./cumastrn.F90"
(  383) !---------------------------------------------------------------------
(  384) # 385 "./cumastrn.F90"
(  385) !     1.           SPECIFY CONSTANTS AND PARAMETERS
(  386) !                  --------------------------------
(  387) # 388 "./cumastrn.F90"
(  388) IF (LHOOK) CALL DR_HOOK('CUMASTRN',0,ZHOOK_HANDLE)
(  389) ASSOCIATE(LMFCUCA=>YDML_PHY_EC%YRECUMF%LMFCUCA, LMFDD=>YDML_PHY_EC%YRECUMF%LMFDD, &
(  390)  & LMFDUDV=>YDML_PHY_EC%YRECUMF%LMFDUDV, LMFPEN=>YDML_PHY_EC%YRECUMF%LMFPEN, LMFSCV=>YDML_PHY_EC%YRECUMF%LMFSCV, &
(  391)  & LMFSMOOTH=>YDML_PHY_EC%YRECUMF%LMFSMOOTH, LMFUVDIS=>YDML_PHY_EC%YRECUMF%LMFUVDIS, &
(  392)  & LMFWSTAR=>YDML_PHY_EC%YRECUMF%LMFWSTAR, NJKT1=>YDML_PHY_EC%YRECUMF%NJKT1, NJKT2=>YDML_PHY_EC%YRECUMF%NJKT2, &
(  393)  & NJKT3=>YDML_PHY_EC%YRECUMF%NJKT3, NJKT5=>YDML_PHY_EC%YRECUMF%NJKT5, RCAPDCYCL=>YDML_PHY_EC%YRECUMF%RCAPDCYCL, &
(  394)  & RDEPTHS=>YDML_PHY_EC%YRECUMF%RDEPTHS, RCUCOV =>YDML_PHY_EC%YRECUMF%RCUCOV, &
(  395)  & RMFCFL=>YDML_PHY_EC%YRECUMF%RMFCFL, RMFCMIN=>YDML_PHY_EC%YRECUMF%RMFCMIN, RMFLIA=>YDML_PHY_EC%YRECUMF%RMFLIA, &
(  396)  & RMFSOLCT=>YDML_PHY_EC%YRECUMF%RMFSOLCT, RCAPQADV=>YDML_PHY_EC%YRECUMF%RCAPQADV,&
(  397)  & RMFSOLTQ=>YDML_PHY_EC%YRECUMF%RMFSOLTQ, RMFSOLUV=>YDML_PHY_EC%YRECUMF%RMFSOLUV, &
(  398)  & RMINCAPE=>YDML_PHY_EC%YRECUMF%RMINCAPE, RTAUA=>YDML_PHY_EC%YRECUMF%RTAUA, &
(  399)  & RUVPER=>YDML_PHY_EC%YRECUMF%RUVPER, RMFADVW=>YDML_PHY_EC%YRECUMF%RMFADVW,RMFADVWDD=>YDML_PHY_EC%YRECUMF%RMFADVWDD,&
(  400)  & LNEWTAU=>YDML_PHY_EC%YRECUMF%LNEWTAU, RXMIN=>YDML_PHY_EC%YRECUMF%RXMIN, RTAULIM=>YDML_PHY_EC%YRECUMF%RTAULIM, &
(  401)  & RTAUFAC=>YDML_PHY_EC%YRECUMF%RTAUFAC, RDXMIN=>YDML_PHY_EC%YRECUMF%RDXMIN, RDXMAX=>YDML_PHY_EC%YRECUMF%RDXMAX, &
(  402)  & LMFSCAV=>YDML_PHY_EC%YREPHY%LMFSCAV, LMFTRAC=>YDML_PHY_EC%YREPHY%LMFTRAC, &
(  403)  & LELIGHT=>YDML_PHY_EC%YREPHY%LELIGHT, LCHEM_LIGHT=>YDCHEM%LCHEM_LIGHT,&
(  404)  & RA=>YDCST%RA, RCPD=>YDCST%RCPD, RD=>YDCST%RD, RETV=>YDCST%RETV, RG=>YDCST%RG, &
(  405)  & RLVTT=>YDCST%RLVTT, RPI=>YDCST%RPI)
(  406) # 407 "./cumastrn.F90"
(  407) ZCONS2=RMFCFL/(RG*PTSPHY)
(  408) ZCONS=1.0_JPRB/(RG*PTSPHY)
(  409) ZORCPD=1.0_JPRB/RCPD
(  410) ZRDOCPD=RD*ZORCPD
(  411) ZRG=1.0_JPRB/RG
(  412) ZTAU(:)=0.0
(  413) # 414 "./cumastrn.F90"
(  414) ! prepare SPP PERTURBATIONS
(  415) IF (YDSPP_CONFIG%LSPP) THEN
(  416)   IPN  = YDSPP_CONFIG%PPTR%RTAU
(  417)   LLPERT_RTAU = IPN > 0
(  418)   IF (LLPERT_RTAU) THEN
(  419)     PN1    = YDSPP_CONFIG%SM%PN(IPN)
(  420)     IPRTAU = PN1%MP
(  421)   ENDIF
(  422) # 423 "./cumastrn.F90"
(  423) ELSE
(  424)   LLPERT_RTAU  =.FALSE.
(  425) ENDIF
(  426) # 427 "./cumastrn.F90"
(  427) !----------------------------------------------------------------------
(  428) DO JL=KIDIA,KFDIA
(  429)   PCAPE(JL)=0.0_JPRB
(  430)   PVDISCU(JL)=0.0_JPRB
(  431)   LDCUM(JL)=.FALSE.
(  432) ENDDO






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 50

(  433) # 434 "./cumastrn.F90"
(  434) !*    2.           INITIALIZE VALUES AT VERTICAL GRID POINTS IN 'CUINI'
(  435) !                  ---------------------------------------------------
(  436) # 437 "./cumastrn.F90"
(  437) CALL CUININ &
(  438)  & (YDCST,   YDTHF,    YDML_PHY_SLIN%YREPHLI,  YDML_PHY_EC%YRECUMF,&
(  439)  & KIDIA,    KFDIA,    KLON,     KLEV,&
(  440)  & PTEN,     PQEN,     PQSEN,    PUEN,     PVEN,&
(  441)  & PGEO,     PAPH,&
(  442)  & ILAB,&
(  443)  & ZTENH,    ZQENH,    ZQSENH,   PGEOH,&
(  444)  & PTU,      PQU,      ZTD,      ZQD,&
(  445)  & ZUU,      ZVU,      ZUD,      ZVD,&
(  446)  & PLU     )  
(  447) # 448 "./cumastrn.F90"
(  448) !---------------------------------------------------------------------
(  449) # 450 "./cumastrn.F90"
(  450) !*    3.0          CLOUD BASE CALCULATIONS
(  451) !                  -----------------------
(  452) # 453 "./cumastrn.F90"
(  453) !*             (A) DETERMINE CLOUD BASE VALUES IN 'CUBASE'
(  454) !                  ---------------------------------------
(  455) # 456 "./cumastrn.F90"
(  456) ZKMFL(:)=0.0_JPRB
(  457) LLMIXS = LDTDKMF
(  458) CALL CUBASEN &
(  459)  & (PPLDARE, PPLRG,    YDTHF,   YDCST,    YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECLDP,YDML_PHY_EC%YRECUMF,&
(  460)  & YDSPP_CONFIG, &
(  461)  & KIDIA,    KFDIA,    KLON,     KLEV,   NJKT1, LLMIXS, LDTDKMF,&
(  462)  & ZTENH,    ZQENH,    PGEOH,    PAPH,&
(  463)  & PQHFL,    PAHFS,    PGP2DSPP, ZKMFL,&
(  464)  & PTEN,     PQEN,     PQSEN,    PGEO,&
(  465)  & PTU,      PQU,      PLU,      ZKINEU,   ZWUBASE,&
(  466)  & ILAB,     LDCUM,    LDSC,     KCBOT,    KBOTSC,&
(  467)  & ICTOP0,   IDPL,     PCAPE )   
(  468) # 470 "./cumastrn.F90"
(  470) !*             (B) DETERMINE TOTAL MOISTURE CONVERGENCE AND
(  471) !*                 DECIDE ON TYPE OF CUMULUS CONVECTION 
(  472) !*                 ONE THE BASIS OF THE DEPTH OF THE CONVECTION
(  473) !*                 DEEP IF CLOUD DEPTH > 200MB
(  474) !*                 SHALLOW IF CLOUD DEPTH <200MB
(  475) !                  -----------------------------------------
(  476) # 477 "./cumastrn.F90"
(  477) ! CALCULATE COLUMN AND SUB CLOUD LAYER MOISTURE CONVERGENCE
(  478) ! AND SUB CLOUD LAYER MOIST STATIC ENERGY CONVERGENCE
(  479) # 480 "./cumastrn.F90"
(  480) !DIR$ LOOP_INFO EST_TRIPS(16)
(  481) DO JL=KIDIA,KFDIA
(  482)   ZDHPBL(JL)=0.0_JPRB
(  483)   IDTOP(JL)=0
(  484)   ZCAPPBL(JL)=0.
(  485)   ZKHVFL(JL)= (-PAHFS(JL,KLEV+1) * ZORCPD - RETV * PTEN(JL,KLEV) * PQHFL(JL,KLEV+1))/(PPLRG*PPLDARE)
(  486)   ZKHFL(JL) = (-PAHFS(JL,KLEV+1) - RLVTT * PQHFL(JL,KLEV+1))/(PPLRG*PPLDARE)
(  487) ENDDO
(  488) DO JK=NJKT2,KLEV
(  489) !DIR$ LOOP_INFO EST_TRIPS(16)
(  490)   DO JL=KIDIA,KFDIA
(  491)     IF(LDCUM(JL).AND.JK >= KCBOT(JL)) THEN






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 51

(  492)       ZDZ=(PAPH(JL,JK+1)-PAPH(JL,JK))
(  493)       ZDHPBL(JL)=ZDHPBL(JL)+(RLVTT*PTENQ(JL,JK)+RCPD*PTENT(JL,JK))*ZDZ
(  494)       ZCAPPBL(JL)=ZCAPPBL(JL)+(PTENT(JL,JK)+RETV*PTEN(JL,JK)*PTENQ(JL,JK))*ZDZ
(  495)     ENDIF
(  496)   ENDDO
(  497) ENDDO
(  498) # 499 "./cumastrn.F90"
(  499) !*                 ESTIMATE CLOUD HEIGHT FOR ENTRAINMENT/DETRAINMENT
(  500) !*                 CALCULATIONS IN CUASC AND INITIAL DETERMINATION OF 
(  501) !*                 CLOUD TYPE
(  502) !*                 (MAX.POSSIBLE CLOUD HEIGHT
(  503) !*                 FOR NON-ENTRAINING PLUME, FOLLOWING A.-S.,1974)
(  504) !                  -------------------------------------------------
(  505) # 507 "./cumastrn.F90"
(  507) !*                 SPECIFY INITIAL CLOUD TYPE
(  508) !*
(  509) # 510 "./cumastrn.F90"
(  510) !DIR$ LOOP_INFO EST_TRIPS(16)
(  511) DO JL=KIDIA,KFDIA
(  512)   IF (LDCUM(JL)) THEN
(  513)     IKB=KCBOT(JL)
(  514)     ITOPM2=ICTOP0(JL)
(  515)     ZPBMPT=PAPH(JL,IKB)-PAPH(JL,ITOPM2)
(  516)     IF (ZPBMPT >= RDEPTHS) THEN
(  517)       KTYPE(JL)=1
(  518)     ELSE
(  519)       KTYPE(JL)=2
(  520)     ENDIF
(  521)   ELSE
(  522)     KTYPE(JL)=0
(  523)   ENDIF
(  524) ENDDO
(  525) # 526 "./cumastrn.F90"
(  526) !*             (C) calculate initial updraught mass flux
(  527) !*                 and set lateral mixing rates
(  528) !*
(  529) !*                 for deep convection assume it is 10% of 
(  530) !*                 maximum value which is determined by the 
(  531) !*                 thickness of the layer and timestep
(  532) !*
(  533) !*                 for shallow convection calculated assuming
(  534) !*                 a balance of moist static energy in the 
(  535) !*                 sub-cloud layer (ignores present of downdraughts)
(  536) !                  ------------------------------------------
(  537) # 538 "./cumastrn.F90"
(  538) IF (LMFWSTAR) THEN
(  539) !DIR$ IVDEP
(  540) !OCL NOVREC
(  541) !DIR$ LOOP_INFO EST_TRIPS(16)
(  542)   DO JL=KIDIA,KFDIA
(  543)     IF (LDCUM(JL)) THEN
(  544)       IKB=KCBOT(JL)
(  545)       ZDZ=MAX(0.0_JPRB,MIN(1.5E3_JPRB,(PGEOH(JL,IKB)-PGEOH(JL,KLEV+1))/RG))
(  546)       ZMF_SHAL(JL)=0.07_JPRB*(RG/PTEN(JL,KLEV)*ZDZ*MAX(0.0_JPRB,ZKHVFL(JL)))**.3333
(  547)       ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  548)       ZMF_SHAL(JL)=MIN(ZMF_SHAL(JL),ZMFMAX)
(  549)     ENDIF
(  550)   ENDDO






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 52

(  551) ENDIF
(  552) # 553 "./cumastrn.F90"
(  553) !DIR$ LOOP_INFO EST_TRIPS(16)
(  554) DO JL=KIDIA,KFDIA
(  555)   IF (LDCUM(JL)) THEN
(  556)     IKB=KCBOT(JL)
(  557)     ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  558) # 559 "./cumastrn.F90"
(  559) ! deep convection
(  560) # 561 "./cumastrn.F90"
(  561)     IF (KTYPE(JL) == 1) THEN
(  562)       ZMFUB(JL)=ZMFMAX*0.1_JPRB
(  563) # 564 "./cumastrn.F90"
(  564)     ELSEIF (KTYPE(JL) == 2) THEN
(  565) # 566 "./cumastrn.F90"
(  566) ! shallow convection
(  567) # 568 "./cumastrn.F90"
(  568)       ZQUMQE=PQU(JL,IKB)+PLU(JL,IKB)-ZQENH(JL,IKB)
(  569)       ZDQMIN=MAX(0.01_JPRB*ZQENH(JL,IKB),1.E-10_JPRB)
(  570)       ZDH=RCPD*(PTU(JL,IKB)-ZTENH(JL,IKB))+RLVTT*ZQUMQE
(  571)       ZDH=RG*MAX(ZDH,1.E5_JPRB*ZDQMIN)
(  572)       IF (ZDHPBL(JL) > 0.0_JPRB) THEN
(  573)         ZMFUB(JL)=ZDHPBL(JL)/ZDH
(  574)         ZMFUB(JL)=MIN(ZMFUB(JL),ZMFMAX)
(  575)       ELSE
(  576)         ZMFUB(JL)=ZMFMAX*0.1_JPRB
(  577)         LDCUM(JL)=.FALSE.
(  578)       ENDIF
(  579)       IF(LMFWSTAR) ZMFUB(JL)=ZMF_SHAL(JL)
(  580)     ENDIF
(  581) # 582 "./cumastrn.F90"
(  582)   ELSE
(  583) # 584 "./cumastrn.F90"
(  584) ! no buoyancy cloud base from surface
(  585) ! set cloud base mass flux and mixing rate
(  586) ! to default value for safety
(  587) # 588 "./cumastrn.F90"
(  588)     ZMFUB(JL)=0.0_JPRB
(  589)   ENDIF
(  590) ENDDO
(  591) # 592 "./cumastrn.F90"
(  592) !-----------------------------------------------------------------------
(  593) # 594 "./cumastrn.F90"
(  594) !*    4.0          DETERMINE CLOUD ASCENT FOR ENTRAINING PLUME
(  595) !                  -------------------------------------------
(  596) # 597 "./cumastrn.F90"
(  597) !*             (A) ESTIMATE CLOUD HEIGHT FOR ENTRAINMENT/DETRAINMENT
(  598) !*                 CALCULATIONS IN CUASC (MAX.POSSIBLE CLOUD HEIGHT
(  599) !*                 FOR NON-ENTRAINING PLUME, FOLLOWING A.-S.,1974)
(  600) !                  -------------------------------------------------
(  601) # 602 "./cumastrn.F90"
(  602) ! CALCULATIONS NOW DONE IS SECTION 3 ABOVE SO THAT
(  603) ! INITIAL CLOUD DEPTH CAN BE USED TO SPECIFY
(  604) ! THE TYPE OF CONVECTION
(  605) # 606 "./cumastrn.F90"
(  606) !*             (B) DO ASCENT IN 'CUASC'IN ABSENCE OF DOWNDRAFTS
(  607) !                  --------------------------------------------
(  608) # 609 "./cumastrn.F90"






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 53

(  609) CALL CUASCN &
(  610)  & (YDTHF, YDCST, YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECLDP,YDML_PHY_EC%YRECUMF,YDSPP_CONFIG,YGFL,&
(  611)  & KIDIA,    KFDIA,    KLON,    KLEV, LDTDKMF,&
(  612)  & PTSPHY,&
(  613)  & ZTENH,    ZQENH,    PUEN,     PVEN,&
(  614)  & PTEN,     PQEN,     PQSEN,    PLITOT,&
(  615)  & PGEO,     PGEOH,    PAP,      PAPH,&
(  616)  & PVERVEL,  ZWUBASE,  PGP2DSPP,  &
(  617)  & LDLAND,   LDCUM,    KTYPE,    ILAB,     LLSCVFLAG,&
(  618)  & PTU,      PQU,      PLU,      PLRAIN,&
(  619)  & PMFU,     ZMFUB,    PLGLAC,&
(  620)  & ZMFUS,    ZMFUQ,    ZMFUL,    PLUDE,    PLUDELI,       ZDMFUP,&
(  621)  & PLCRIT_AER,&
(  622)  & ZDMFEN,&  
(  623)  & KCBOT,    KCTOP,    ICTOP0,   IDPL,     PMFUDE_RATE,   ZKINEU,   PWU,PWMEAN ) 
(  624) # 625 "./cumastrn.F90"
(  625) !*         (C) CHECK CLOUD DEPTH AND CHANGE ENTRAINMENT RATE ACCORDINGLY
(  626) !              CALCULATE PRECIPITATION RATE (FOR DOWNDRAFT CALCULATION)
(  627) !              -----------------------------------------------------
(  628) # 629 "./cumastrn.F90"
(  629) !DIR$ IVDEP
(  630) !OCL NOVREC
(  631) !DIR$ LOOP_INFO EST_TRIPS(16)
(  632) DO JL=KIDIA,KFDIA
(  633)   IF (LDCUM(JL)) THEN
(  634)     IKB=KCBOT(JL)
(  635)     ITOPM2=KCTOP(JL)
(  636)     ZPBMPT=PAPH(JL,IKB)-PAPH(JL,ITOPM2)
(  637)     IF(KTYPE(JL) == 1.AND.ZPBMPT < RDEPTHS) KTYPE(JL)=2
(  638)     IF(KTYPE(JL) == 2.AND.ZPBMPT >= RDEPTHS) KTYPE(JL)=1
(  639)     ICTOP0(JL)=KCTOP(JL)
(  640)   ENDIF
(  641)   ZRFL(JL)=ZDMFUP(JL,1)
(  642) ENDDO
(  643) DO JK=2,KLEV
(  644) !DIR$ LOOP_INFO EST_TRIPS(16)
(  645)   DO JL=KIDIA,KFDIA
(  646)     ZRFL(JL)=ZRFL(JL)+ZDMFUP(JL,JK)
(  647)   ENDDO
(  648) ENDDO
(  649) DO JK=1,KLEV
(  650) !DIR$ LOOP_INFO EST_TRIPS(16)
(  651)   DO JL=KIDIA,KFDIA
(  652)     PMFD(JL,JK)=0.0_JPRB
(  653)     ZMFDS(JL,JK)=0.0_JPRB
(  654)     ZMFDQ(JL,JK)=0.0_JPRB
(  655)     ZDMFDP(JL,JK)=0.0_JPRB
(  656)     ZDPMEL(JL,JK)=0.0_JPRB
(  657)   ENDDO
(  658) ENDDO
(  659) # 660 "./cumastrn.F90"
(  660) ! Needed for dissipation rate and if LMFUVDIS=T
(  661) DO JK=1,KLEV
(  662) !DIR$ LOOP_INFO EST_TRIPS(16)
(  663)   DO JL=KIDIA,KFDIA
(  664)     ZTENU(JL,JK)=PTENU(JL,JK)
(  665)     ZTENV(JL,JK)=PTENV(JL,JK)
(  666)   ENDDO






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 54

(  667) ENDDO
(  668) # 669 "./cumastrn.F90"
(  669) !-----------------------------------------------------------------------
(  670) # 671 "./cumastrn.F90"
(  671) !*    5.0          CUMULUS DOWNDRAFT CALCULATIONS
(  672) !                  ------------------------------
(  673) # 674 "./cumastrn.F90"
(  674) IF(LMFDD) THEN
(  675) # 676 "./cumastrn.F90"
(  676) !*             (A) DETERMINE LFS IN 'CUDLFS'
(  677) !                  -------------------------
(  678) # 679 "./cumastrn.F90"
(  679)   CALL CUDLFSN &
(  680)    & (YDTHF, YDCST, YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECUMF,&
(  681)    & KIDIA,    KFDIA,    KLON,     KLEV,&
(  682)    & KCBOT,    KCTOP,    LDCUM,&
(  683)    & ZTENH,    ZQENH,    PTEN,     PQSEN,    PGEO,&
(  684)    & PGEOH,    PAPH,     PTU,      PQU,&
(  685)    & ZMFUB,    ZRFL,&
(  686)    & ZTD,      ZQD,&
(  687)    & PMFD,     ZMFDS,    ZMFDQ,    ZDMFDP,&
(  688)    & IDTOP,    LLDDRAF )  
(  689) # 690 "./cumastrn.F90"
(  690) !*            (B)  DETERMINE DOWNDRAFT T,Q AND FLUXES IN 'CUDDRAF'
(  691) !                  -----------------------------------------------
(  692) # 693 "./cumastrn.F90"
(  693)   CALL CUDDRAFN &
(  694)    & (YDCST,   YDTHF,    YDML_PHY_SLIN%YREPHLI,YDML_PHY_EC%YRECUMF,&
(  695)    & KIDIA,    KFDIA,    KLON,    KLEV,&
(  696)    & LLDDRAF,&
(  697)    & ZTENH,    ZQENH,    PQSEN,&
(  698)    & PGEO,     PGEOH,    PAPH,     ZRFL,&
(  699)    & ZTD,      ZQD,      PMFU,&
(  700)    & PMFD,     ZMFDS,    ZMFDQ,    ZDMFDP,&
(  701)    & ZDMFDE,   PMFDDE_RATE,        ZKINED )  
(  702) # 703 "./cumastrn.F90"
(  703) ENDIF
(  704) # 705 "./cumastrn.F90"
(  705) !-----------------------------------------------------------------------
(  706) # 707 "./cumastrn.F90"
(  707) !*    6.0          CLOSURE
(  708) !                  ------
(  709) # 710 "./cumastrn.F90"
(  710) !*                  RECALCULATE CLOUD BASE MASSFLUX FROM A
(  711) !*                 CAPE CLOSURE FOR DEEP CONVECTION (KTYPE=1)
(  712) !*                 AND BY PBL EQUILIBRUM TAKING DOWNDRAFTS INTO
(  713) !*                 ACCOUNT FOR SHALLOW CONVECTION (KTYPE=2)          
(  714) !                  --------------------------------------------
(  715) # 716 "./cumastrn.F90"
(  716) !   DEEP CONVECTION
(  717) # 718 "./cumastrn.F90"
(  718) !DIR$ LOOP_INFO EST_TRIPS(16)
(  719) DO JL=KIDIA,KFDIA
(  720)   ZHEAT(JL)=0.0_JPRB
(  721)   ZCAPE(JL)=0.0_JPRB
(  722)   ZCAPE2(JL)=0.0_JPRB
(  723)   ZMFUB1(JL)=ZMFUB(JL)
(  724)   ZDQCV(JL)=0.0_JPRB






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 55

(  725)   ZSATFR(JL)=0.0_JPRB
(  726)   ZDX(JL)=2*RA*SQRT(RPI*PGAW(JL))
(  727)   ZDX(JL)=MAX(ZDX(JL),1.E2_JPRB)
(  728) ENDDO
(  729) # 730 "./cumastrn.F90"
(  730) DO JK=NJKT2,KLEV
(  731) !DIR$ LOOP_INFO EST_TRIPS(16)
(  732)   DO JL=KIDIA,KFDIA
(  733)     LLO1=LDCUM(JL).AND.KTYPE(JL) == 1
(  734)     LLO3=LLO1.AND.JK <= KCBOT(JL).AND.JK > KCTOP(JL)
(  735)     IF(LLO3) THEN
(  736)       ZDZ=(PGEO(JL,JK-1)-PGEO(JL,JK))
(  737)       IF (LDTDKMF) THEN
(  738)         ZHEAT(JL)=ZHEAT(JL) +&
(  739)          & (  (PTEN(JL,JK-1)-PTEN(JL,JK) + ZDZ*ZORCPD)/ZTENH(JL,JK)&
(  740)          & +  RETV*(PQEN(JL,JK-1)-PQEN(JL,JK))  ) *&
(  741)          & (RG*(PMFU(JL,JK)+PMFD(JL,JK)))
(  742)       ELSE
(  743)         ZHEAT(JL)=ZHEAT(JL) +MAX(0.0_JPRB,&
(  744)          & (  (PTEN(JL,JK-1)-PTEN(JL,JK) + ZDZ*ZORCPD)/ZTENH(JL,JK)&
(  745)          & +  RETV*(PQEN(JL,JK-1)-PQEN(JL,JK))  ) *&
(  746)          & (RG*(PMFU(JL,JK)+PMFD(JL,JK))) )
(  747)       ENDIF
(  748)       ZDZ=(PAP(JL,JK)-PAP(JL,JK-1))
(  749)       ZCAPE(JL)=ZCAPE(JL) +&
(  750)        & ((PTU(JL,JK)-ZTENH(JL,JK))/ZTENH(JL,JK)&
(  751)        & +RETV*(PQU(JL,JK)-ZQENH(JL,JK))&
(  752)        & -PLU(JL,JK) ) * ZDZ  ! -PLRAIN(JL,JK) not added
(  753)     ENDIF
(  754)     IF(LLO3.AND.RCAPQADV>0.0_JPRB) THEN
(  755)       ZTENH2(JL,JK)=ZTENH(JL,JK)-0.5_JPRB*(PTENTA(JL,JK)+PTENTA(JL,JK-1))*PTSPHY
(  756)       ZQENH2(JL,JK)=ZQENH(JL,JK)-0.5_JPRB*(PTENQA(JL,JK)+PTENQA(JL,JK-1))*PTSPHY
(  757)       ZCAPE2(JL)=ZCAPE2(JL) +&
(  758)        & ((PTU(JL,JK)-ZTENH2(JL,JK))/ZTENH2(JL,JK)&
(  759)        & +RETV*(PQU(JL,JK)-ZQENH2(JL,JK))&
(  760)        & -PLU(JL,JK) ) * ZDZ  ! -ZLRAIN(JL,JK) not added
(  761)     ENDIF
(  762)   ! IF(LLO1.AND.JK > KCTOP(JL)) THEN
(  763)     IF(LLO1) THEN
(  764)        ZDZ=(PAPH(JL,JK+1)-PAPH(JL,JK))
(  765)        ZDQCV(JL)=ZDQCV(JL)+PTENQA(JL,JK)*ZDZ*(PQEN(JL,JK)/PQSEN(JL,JK))
(  766)      ! ZMFA=2.5_JPRB/MAX(2.5_JPRB,-PVERVEL(JL,JK))*PQSEN(JL,JK)/ZDX(JL)
(  767)      ! ZDQCV(JL)=ZDQCV(JL)+MIN(ZMFA,PTENQA(JL,JK))*ZDZ*(PQEN(JL,JK)/PQSEN(JL,JK))
(  768)     ENDIF
(  769)     IF(LLO1.AND.JK >= KCTOP(JL)) THEN
(  770)        ZDZ=(PAPH(JL,JK+1)-PAPH(JL,JK))
(  771)        ZSATFR(JL)=ZSATFR(JL)+(PQEN(JL,JK)/PQSEN(JL,JK))*ZDZ
(  772)     ENDIF
(  773)   ENDDO
(  774) ENDDO
(  775) ! time scale and subcloud contribution to CAPE to be substracted for better diurnal cycle over land
(  776) !DIR$ LOOP_INFO EST_TRIPS(16)
(  777) DO JL=KIDIA,KFDIA
(  778)   ZCAPDCYCL(JL)=0.0_JPRB
(  779)   ZTAU(JL)=0.0_JPRB
(  780)   IF (LDTDKMF) THEN
(  781)      ZDX(JL) = PDX(JL)
(  782)      ZDX(JL)=MAX(ZDX(JL),1.E2_JPRB)






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 56

(  783)   ENDIF
(  784) !! CFL limit as function of resolution used in DWD ICON model
(  785) ! ZMFCFL(JL) = 2._JPRB*MIN(2._JPRB,1._JPRB + 2.5E-5_JPRB*ZDX(JL))
(  786)   IF(LDCUM(JL).AND.KTYPE(JL) == 1) THEN
(  787)     IF (LNEWTAU) THEN    
(  788)        ZTAURES = RTAULIM*(1._JPRB + RTAUFAC/((ZDX(JL)/1000._JPRB-RXMIN+1._JPRB)**2))    
(  789)     ELSE
(  790)        ZTAURES=1.0_JPRB+1.60_JPRB*ZDX(JL)/125.E3_JPRB
(  791)        ! for the 10-1 km resolution range increase ZTAURES
(  792)        IF(ZDX(JL)<8.E3_JPRB) THEN
(  793)          ZTAURES=1.0_JPRB+(LOG(8.E3_JPRB/ZDX(JL)))**2
(  794)        ENDIF
(  795)     ENDIF
(  796)     IF(ZDX(JL)>125.E3_JPRB) ZTAURES=MIN(3.0_JPRB,ZTAURES)
(  797) # 798 "./cumastrn.F90"
(  798)     IKD=IDPL(JL)
(  799)     IKB=KCBOT(JL)
(  800)     IK=KCTOP(JL)
(  801)     ZTAU(JL)=(PGEOH(JL,IK)-PGEOH(JL,IKB))/((2.0_JPRB+MIN(15.0_JPRB,PWMEAN(JL)))*RG)*ZTAURES*RTAUA
(  802)     IF (YDSPP_CONFIG%LSPP .AND. LLPERT_RTAU) THEN
(  803)       ZXTAU(JL)= ZTAU(JL)*EXP(PN1%MU(1)+PN1%XMAG(1)*PGP2DSPP(JL, IPRTAU))
(  804)     ELSE
(  805)       ZXTAU(JL)=ZTAU(JL)
(  806)     ENDIF
(  807) # 808 "./cumastrn.F90"
(  808)     LLO1=PAPH(JL,KLEV+1)-PAPH(JL,IKD)<50.E2_JPRB
(  809)     IF(LLO1.AND.LDLAND(JL).AND.RCAPDCYCL==1.0_JPRB) THEN
(  810)        ZDZ=MIN(1.E4_JPRB,PGEOH(JL,IKB)-PGEOH(JL,KLEV+1))/RG
(  811)        ZCAPDCYCL(JL)=ZXTAU(JL)*MAX(0.0_JPRB,ZKHVFL(JL))*RCPD/ZDZ
(  812)     ENDIF
(  813)     IF(LLO1.AND.RCAPDCYCL==2.0_JPRB) THEN
(  814)       ZIND=MAX(0._JPRB,MIN(1._JPRB,(RDXMAX-ZDX(JL))/(RDXMAX-RDXMIN)))
(  815)       IF(LDLAND(JL)) ZIND=1._JPRB
(  816)       ZCAPDCYCLLD(JL) =ZCAPPBL(JL)*ZTAU(JL)/ZTAURES
(  817)       ZDUTEN=2.0_JPRB+SQRT(0.5*(PUEN(JL,IKB)**2+PVEN(JL,IKB)**2+PUEN(JL,NJKT3)**2+PVEN(JL,NJKT3)**2))
(  818)       ZTAUPBL(JL)=MIN(1.E4_JPRB,PGEOH(JL,IKB)-PGEOH(JL,KLEV+1))/(RG*ZDUTEN)
(  819)       ZCAPDCYCLSE(JL)=ZCAPPBL(JL)*ZTAUPBL(JL)      
(  820)       ZCAPDCYCL(JL) = ZIND*ZCAPDCYCLLD(JL) + (1._JPRB-ZIND)*ZCAPDCYCLSE(JL)
(  821)     ENDIF
(  822) # 823 "./cumastrn.F90"
(  823)     ZDQCV(JL)=ZDQCV(JL)*RLVTT/PGEOH(JL,IK)*ZXTAU(JL)/MAX(1.25_JPRB,ZTAURES)*RCAPQADV
(  824)     ZSATFR(JL)=ZSATFR(JL)/(PAPH(JL,KLEV+1)-PAPH(JL,IK))
(  825) # 826 "./cumastrn.F90"
(  826)   ELSE
(  827)     ZTAU(JL)=0.0_JPRB
(  828)   ENDIF
(  829) ENDDO
(  830) # 831 "./cumastrn.F90"
(  831) IF (LMFCUCA) THEN
(  832) !only allow cloud base mass flux to vary by certain amount
(  833) !DIR$ LOOP_INFO EST_TRIPS(16)
(  834)   DO JL=KIDIA,KFDIA
(  835)     ZFACCA(JL)=MAX(0.3_JPRB,MIN(1.8_JPRB,PCUCONVCA(JL)))
(  836)   ENDDO
(  837) ELSE
(  838)   ZFACCA(KIDIA:KFDIA)=1.0_JPRB
(  839) ENDIF
(  840) # 841 "./cumastrn.F90"






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 57

(  841) !DIR$ LOOP_INFO EST_TRIPS(16)
(  842) DO JL=KIDIA,KFDIA
(  843)   IF(LDCUM(JL).AND.KTYPE(JL) == 1) THEN
(  844)     IKB=KCBOT(JL)
(  845)     ZCAPE2(JL)=RCAPQADV*ZCAPE2(JL)+(1.0_JPRB-RCAPQADV)*ZCAPE(JL)
(  846)     ZCAPDCYCL(JL)=MAX(ZCAPDCYCL(JL),-2*ZCAPE2(JL))
(  847)     IF(ZSATFR(JL)<=0.94.OR.PVERVEL(JL,NJKT5)<-100._JPRB) THEN
(  848)       ZCAPE(JL)=MAX(RMINCAPE*ZCAPE(JL),ZCAPE2(JL)-ZCAPDCYCL(JL)+ZDQCV(JL))
(  849)     ELSE
(  850)       ZCAPE(JL)=MAX(RMINCAPE*ZCAPE(JL),ZCAPE(JL)-ZCAPDCYCL(JL))
(  851)     ENDIF
(  852)     ZCAPE(JL)=MIN(ZCAPE(JL),5000.0_JPRB)
(  853)     ZHEAT(JL)=MAX(1.E-4_JPRB,ZHEAT(JL))
(  854) !    ZXTAU(JL)=MAX(720._JPRB,ZXTAU(JL))
(  855)     ZXTAU(JL)=MAX(3.6E3_JPRB/(5.0_JPRB*PPLRG*PPLDARE),MIN(3.0_JPRB*3.6E3_JPRB/(PPLRG*PPLDARE),ZXTAU(JL)))
(  856)     ZMFUB1(JL)=(ZCAPE(JL)*ZMFUB(JL))/(ZHEAT(JL)*ZXTAU(JL))
(  857)     ZMFUB1(JL)=MAX(ZMFUB1(JL),0.001_JPRB)*ZFACCA(JL)
(  858)     ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  859)     ZMFUB1(JL)=MIN(ZMFUB1(JL),ZMFMAX)
(  860)   ENDIF
(  861) ENDDO
(  862) # 863 "./cumastrn.F90"
(  863) IF(LDMCAPEA) THEN
(  864)   ! Prefer ZCAPE computed from real CUASCN updraft rather than PCAPE estimated from CUBASEN.
(  865)   DO JL=KIDIA,KFDIA
(  866)     PCAPE(JL) = RG*ZCAPE(JL)
(  867)   ENDDO
(  868) ENDIF
(  869) # 870 "./cumastrn.F90"
(  870) !  SHALLOW CONVECTION AND MID_LEVEL
(  871) # 872 "./cumastrn.F90"
(  872) !DIR$ IVDEP
(  873) !OCL NOVREC
(  874) !DIR$ LOOP_INFO EST_TRIPS(16)
(  875) DO JL=KIDIA,KFDIA
(  876)   IF ( LDCUM(JL) .AND. KTYPE(JL) >= 2 ) THEN
(  877)     IKB=KCBOT(JL)
(  878)     IF(PMFD(JL,IKB) < 0.0_JPRB) THEN
(  879)       ZEPS=-PMFD(JL,IKB)/MAX(ZMFUB(JL),1.E-10_JPRB)
(  880)     ELSE
(  881)       ZEPS=0.0_JPRB
(  882)     ENDIF
(  883) ! maximum permissible value of ud base mass flux 
(  884)     ZMFMAX=(PAPH(JL,IKB)-PAPH(JL,IKB-1))*ZCONS2
(  885) # 886 "./cumastrn.F90"
(  886) ! shallow convection
(  887) # 888 "./cumastrn.F90"
(  888)     IF(KTYPE(JL) == 2) THEN
(  889)       IF(ZDHPBL(JL) > 0.0_JPRB) THEN
(  890)         ZQUMQE=PQU(JL,IKB)+PLU(JL,IKB)-&
(  891)          & ZEPS*ZQD(JL,IKB)-(1.0_JPRB-ZEPS)*ZQENH(JL,IKB)  
(  892)         ZDH=RCPD*(PTU(JL,IKB)-ZEPS*ZTD(JL,IKB)-&
(  893)          & (1.0_JPRB-ZEPS)*ZTENH(JL,IKB))+RLVTT*ZQUMQE  
(  894)         ZDH2=RCPD*(PTU(JL,IKB-1)-ZEPS*ZTD(JL,IKB-1)-&
(  895)          & (1.0_JPRB-ZEPS)*ZTENH(JL,IKB-1))+RLVTT*ZQUMQE 
(  896)         ZDH=0.5_JPRB*(ZDH+ZDH2)
(  897)         ZDH=RG*MAX(ZDH,0.1_JPRB*RCPD)
(  898)         ZMFUB1(JL)=ZDHPBL(JL)/ZDH






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 58

(  899)         IF (.NOT. LDTDKMF) THEN
(  900)           IF(ZMFUB1(JL)>0.9_JPRB*ZMFMAX/RMFCFL.AND.ZDH<0.5_JPRB*RG*RCPD) THEN
(  901)             ZDH=0.75_JPRB*RCPD*RG
(  902)             ZMFUB1(JL)=ZDHPBL(JL)/ZDH
(  903)           ENDIF
(  904)         ENDIF  
(  905)       ELSE
(  906)         ZMFUB1(JL)=ZMFUB(JL)
(  907)       ENDIF
(  908)       IF(LMFWSTAR) ZMFUB1(JL)=ZMF_SHAL(JL)
(  909)       ZMFUB1(JL)=MIN(ZMFUB1(JL),ZMFMAX)
(  910)     ENDIF
(  911) # 912 "./cumastrn.F90"
(  912) ! mid-level convection
(  913) # 914 "./cumastrn.F90"
(  914)     IF(KTYPE(JL) == 3)THEN
(  915)       IF (LDTDKMF) THEN
(  916)         ZMFUB1(JL)=MAX(ZMFUB(JL),ZKHFL(JL)/PGEOH(JL,IKB))&
(  917)        &                    *(1.0_JPRB+ZEPS)
(  918)       ELSE
(  919)         ZMFUB1(JL)=MAX(ZMFUB(JL),5*ZKHFL(JL)/PGEOH(JL,IKB))&
(  920)        &                    *(1.0_JPRB+ZEPS)
(  921)       ENDIF
(  922)       IF(PGEOH(JL,IKB)<1.5E3_JPRB) THEN
(  923)         ZMFUB1(JL)=MIN(ZMFUB1(JL),ZMFMAX/(1.05_JPRB*RMFCFL))
(  924)       ELSE
(  925)         ZMFUB1(JL)=MIN(ZMFUB1(JL),ZMFMAX)
(  926)       ENDIF
(  927)     ENDIF
(  928) # 929 "./cumastrn.F90"
(  929)   ENDIF
(  930) ENDDO
(  931) # 932 "./cumastrn.F90"
(  932) ! rescale DD fluxes if deep and shallow convection
(  933) # 934 "./cumastrn.F90"
(  934) DO JK=1,KLEV
(  935) !DIR$ LOOP_INFO EST_TRIPS(16)
(  936)   DO JL=KIDIA,KFDIA
(  937)     IF ( LLDDRAF(JL) .AND.( KTYPE(JL) == 1.OR. KTYPE(JL) == 2 ) ) THEN
(  938)       ZFAC=ZMFUB1(JL)/MAX(ZMFUB(JL),1.E-10_JPRB)
(  939)       PMFD(JL,JK)=PMFD(JL,JK)*ZFAC
(  940)       ZMFDS(JL,JK)=ZMFDS(JL,JK)*ZFAC
(  941)       ZMFDQ(JL,JK)=ZMFDQ(JL,JK)*ZFAC
(  942)       ZDMFDP(JL,JK)=ZDMFDP(JL,JK)*ZFAC
(  943) !  also rescale detrainment flux for ERA pp
(  944)       PMFDDE_RATE(JL,JK)=PMFDDE_RATE(JL,JK)*ZFAC
(  945)     ENDIF
(  946)   ENDDO
(  947) ENDDO
