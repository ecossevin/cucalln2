( 1391)           ZUV2(JL,JK)=SQRT(ZDUTEN**2+ZDVTEN**2)
( 1392)           ZSUM22(JL)=ZSUM22(JL)+ZUV2(JL,JK)*ZDZ
( 1393)           ZSUM12(JL)=ZSUM12(JL)-(PUEN(JL,JK)*ZDUTEN+PVEN(JL,JK)*ZDVTEN)*ZDZ
( 1394)         ENDIF
( 1395)       ENDDO
( 1396)     ENDDO
( 1397)     ! Store vertically integrated dissipation rate (W m-2)
( 1398) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1399)     DO JL=KIDIA,KFDIA
( 1400)       PVDISCU(JL)=ZSUM12(JL)*ZRG
( 1401)     ENDDO
( 1402)     ! Calculate local temperature tendency (K) due to dissipation
( 1403)     DO JK=1,KLEV
( 1404) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1405)       DO JL=KIDIA,KFDIA
( 1406)         IF (LDCUM(JL).AND.JK>=KCTOP(JL)-1) THEN
( 1407)           ZTDIS=ZORCPD*ZSUM12(JL)*&
( 1408)          &             ZUV2(JL,JK)/MAX(1.E-15_JPRB,ZSUM22(JL))
( 1409)           PTENT(JL,JK)=PTENT(JL,JK)+ZTDIS
( 1410)         ENDIF
( 1411)       ENDDO
( 1412)     ENDDO
( 1413)   ENDIF
