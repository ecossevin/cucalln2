( 1517)           ZMFUUS(JL,JK)=ZMFUUS(JL,JK)-ZERATE
( 1518)           ZMFUDR(JL,JK)=ZMFUDR(JL,JK)+ZERATE
( 1519)           ZMFUDR(JL,JK-1)=ZMFUUS(JL,JK)
( 1520)         ENDIF
( 1521)       ENDDO
( 1522)     ENDDO
( 1523)     DO JK=KLEV-1,2,-1
