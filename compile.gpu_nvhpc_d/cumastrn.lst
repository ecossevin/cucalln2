(    1) # 1 "./cumastrn.F90"
(    1) SUBROUTINE CUMASTRN &
(    2)  & (PPLDARE, PPLRG,    YDTHF,   YDCST, YDML_PHY_SLIN,     YDML_PHY_EC, YGFL,&
(    3)  & YDCHEM,   YDSPP_CONFIG, YDPERTPAR, &
(    4)  & KIDIA,    KFDIA,    KLON,    KLEV,   PDX, LDTDKMF,&
(    5)  & LDMCAPEA, LDLAND,   PTSPHY,&
(    6)  & PTEN,     PQEN,     PUEN,     PVEN,     PLITOT,&
(    7)  & PVERVEL,  PQSEN,    PQHFL,    PAHFS,&
(    8)  & PAP,      PAPH,     PGEO,     PGEOH,    PGAW,&
(    9)  & PCUCONVCA,PGP2DSPP, &
(   10)  & PTENT,    PTENQ,    PTENU,    PTENV,    PTENTA,   PTENQA,&
(   11)  & LDCUM,    KTYPE,    KCBOT,    KCTOP,&
(   12)  & LDCUM_LIG, KCBOT_LIG, KCTOP_LIG,&
(   13)  & KBOTSC,   LDSC,&
(   14)  & LDSHCV,&
(   15)  & PLCRIT_AER,&     
(   16)  & PTU,      PQU,      PLU,      PLUDE,    PLUDELI,   PSNDE,&
(   17)  & PENTH,    PMFLXR,   PMFLXS,   PRAIN,    PLRAIN,    PRSUD,&
(   18)  & PMFU,     PMFD,     PLGLAC, &
(   19)  & PMFUDE_RATE,        PMFDDE_RATE,    PCAPE,   PWU, PWMEAN, PVDISCU, PDISS, &
(   20)  & KTRAC,    PCEN,     PTENC,    PSCAV, PSCAV0 )  
(   21) # 22 "./cumastrn.F90"
(   22) !**** *CUMASTR*  MASTER ROUTINE FOR CUMULUS MASSFLUX-SCHEME
(   23) # 24 "./cumastrn.F90"
(   24) !     PURPOSE
(   25) !     -------
(   26) !          THIS ROUTINE COMPUTES THE PHYSICAL TENDENCIES OF THE
(   27) !     PROGNOSTIC VARIABLES T,Q,U, V AND TRACERS DUE TO CONVECTIVE PROCESSES.
(   28) !     PROCESSES CONSIDERED ARE: CONVECTIVE FLUXES, FORMATION OF
(   29) !     PRECIPITATION, EVAPORATION OF FALLING RAIN BELOW CLOUD BASE,
(   30) !     SATURATED CUMULUS DOWNDRAFTS.
(   31) # 32 "./cumastrn.F90"
(   32) !**   INTERFACE.
(   33) !     ----------
(   34) # 35 "./cumastrn.F90"
(   35) !          *CUMASTR* IS CALLED FROM *CUCALL*
(   36) !     THE ROUTINE TAKES ITS INPUT FROM THE LONG-TERM STORAGE
(   37) !     T,Q,U,V,PHI AND P AND MOISTURE TENDENCIES.
(   38) !     IT RETURNS ITS OUTPUT TO THE SAME SPACE
(   39) !      1.MODIFIED TENDENCIES OF MODEL VARIABLES
(   40) !      2.RATES OF CONVECTIVE PRECIPITATION
(   41) !        (USED IN SUBROUTINE SURF)
(   42) !      3.CLOUD BASE, CLOUD TOP AND PRECIP FOR RADIATION
(   43) !        (USED IN SUBROUTINE CLOUD)
(   44) # 45 "./cumastrn.F90"
(   45) !     METHOD
(   46) !     -------
(   47) # 48 "./cumastrn.F90"
(   48) !     PARAMETERIZATION IS DONE USING A MASSFLUX-SCHEME.
(   49) !        (1) DEFINE CONSTANTS AND PARAMETERS
(   50) !        (2) SPECIFY VALUES (T,Q,QS...) AT HALF LEVELS AND
(   51) !            INITIALIZE UPDRAFT- AND DOWNDRAFT-VALUES IN 'CUINI'
(   52) !        (3) CALCULATE CLOUD BASE IN 'CUBASE'
(   53) !            AND SPECIFY CLOUD BASE MASSFLUX FROM PBL MOISTURE BUDGET
(   54) !        (4) DO CLOUD ASCENT IN 'CUASC' IN ABSENCE OF DOWNDRAFTS
(   55) !        (5) DO DOWNDRAFT CALCULATIONS:
(   56) !              (A) DETERMINE VALUES AT LFS IN 'CUDLFS'
(   57) !              (B) DETERMINE MOIST DESCENT IN 'CUDDRAF'






NVFORTRAN (Version     24.5)          03/19/2025  06:56:06      page 31

(   58) !              (C) RECALCULATE CLOUD BASE MASSFLUX CONSIDERING THE
(   59) !                  EFFECT OF CU-DOWNDRAFTS
(   60) !        (6) DO FINAL CLOUD ASCENT IN 'CUASC'
(   61) !        (7) DO FINAL ADJUSMENTS TO CONVECTIVE FLUXES IN 'CUFLX',
(   62) !            DO EVAPORATION IN SUBCLOUD LAYER
(   63) !        (8) CALCULATE INCREMENTS OF T AND Q IN 'CUDTDQ'
(   64) !        (9) CALCULATE INCREMENTS OF U AND V IN 'CUDUDV'
(   65) # 66 "./cumastrn.F90"
(   66) !     PARAMETER     DESCRIPTION                                   UNITS
(   67) !     ---------     -----------                                   -----
(   68) !     INPUT PARAMETERS (INTEGER):
(   69) # 70 "./cumastrn.F90"
(   70) !    *KIDIA*        START POINT
(   71) !    *KFDIA*        END POINT
(   72) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   73) !    *KLEV*         NUMBER OF LEVELS
(   74) !    *KTRAC*        NUMBER OF CHEMICAL TRACERS
(   75) # 76 "./cumastrn.F90"
(   76) !     INPUT PARAMETERS (LOGICAL)
(   77) # 78 "./cumastrn.F90"
(   78) !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   79) !    *LDTDKMF*      Arpege tuning (if TRUE)
(   80) # 81 "./cumastrn.F90"
(   81) !     INPUT PARAMETERS (REAL)
(   82) # 83 "./cumastrn.F90"
(   83) !    *PTSPHY*       TIME STEP FOR THE PHYSICS                       S
(   84) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   85) !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   86) !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)       M/S
(   87) !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)       M/S
(   88) !    *PCEN*         PROVISIONAL ENVIRONMENT TRACER CONCENTRATIONS KG/KG 
(   89) !    *PLITOT*       GRID MEAN LIQUID WATER+ICE CONTENT            KG/KG
(   90) !    *PVERVEL*      VERTICAL VELOCITY                             PA/S
(   91) !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   92) !    *PQHFL*        MOISTURE FLUX (EXCEPT FROM SNOW EVAP.)        KG/(SM2)
(   93) !    *PAHFS*        SENSIBLE HEAT FLUX                            W/M2
(   94) !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS             PA
(   95) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS             PA
(   96) !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   97) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   98) !    *PGAW*       NORMALISED GAUSSIAN QUADRATURE WEIGHT / NUMBER OF LONGITUDE POINTS
(   99) !                           LOCAL SUB-AREA == 4*RPI*RA**2 * PGAW
(  100) !    *PLCRIT_AER*   CRITICAL LIQUID MMR FOR AUTOCONVERSION PROCESS KG/KG
(  101) !    *PCUCONVCA*    COUPLING TO CELL AUTOMATON OR 2D ADV FIELD     ( )
(  102) !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(  103) !    *PSCAV*        SCAVENGING COEFFICIENTS FOR CHEM TRANSPORT    UNITLESS
(  104) # 105 "./cumastrn.F90"
(  105) !    UPDATED PARAMETERS (REAL):
(  106) # 107 "./cumastrn.F90"
(  107) !    *PTENT*        TEMPERATURE TENDENCY                           K/S
(  108) !    *PTENQ*        MOISTURE TENDENCY                             KG/(KG S)
(  109) !    *PTENU*        TENDENCY OF U-COMP. OF WIND                    M/S2
(  110) !    *PTENV*        TENDENCY OF V-COMP. OF WIND                    M/S2
(  111) !    *PTENC*        TENDENCY OF CHEMICAL TRACERS                   1/S
