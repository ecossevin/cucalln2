( 1550)      & LLDCUM,   LLDDRAF3,  PTSPHY,   PAPH,  PAP,&
( 1551)      & ZMFUUS,   ZMFDUS,    PMFU,     PMFD,  ZMFUDR,   ZMFDDR,&
