( 1451)   DO JL=KIDIA,KFDIA
( 1452)     !IF( LDCUM(JL).AND.KTYPE(JL)/=3 ) THEN
( 1453)      IF( LDCUM(JL).AND.KTYPE(JL)/=3.AND.KCBOT(JL)-KCTOP(JL)>=1 ) THEN
( 1454)          LLDCUM(JL)=.TRUE.
( 1455)          LLDDRAF3(JL)=LLDDRAF(JL)
( 1456)      ELSE
( 1457)          LLDCUM(JL)=.FALSE.
( 1458)          LLDDRAF3(JL)=.FALSE.
( 1459)      ENDIF
( 1460)   ENDDO
( 1461)   
( 1462) ! check and correct mass fluxes for CFL criterium
( 1463) 
( 1464)   ZMFS(:)=1.0_JPRB
( 1465)   IF(RMFSOLCT<=3.0_JPRB) THEN
( 1466)     DO JK=2,KLEV
( 1467) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1468)       DO JL=KIDIA,KFDIA
( 1469)         IF(LLDCUM(JL).AND.JK>=KCTOP(JL)) THEN
( 1470)           ZMFMAX=(PAPH(JL,JK)-PAPH(JL,JK-1))*0.8_JPRB*ZCONS
( 1471)           IF(PMFU(JL,JK)>ZMFMAX) &
( 1472)            & ZMFS(JL)=MIN(ZMFS(JL),ZMFMAX/PMFU(JL,JK))  
( 1473)         ENDIF
( 1474)       ENDDO
( 1475)     ENDDO
( 1476)   ENDIF
( 1477)   DO JK=1,KLEV
( 1478) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1479)     DO JL=KIDIA,KFDIA
( 1480)       IF(LLDCUM(JL).AND.JK>=KCTOP(JL)-1) THEN
( 1481)         ZMFUUS(JL,JK)=PMFU(JL,JK)*ZMFS(JL)
( 1482)         ZMFUDR(JL,JK)=PMFUDE_RATE(JL,JK)*ZMFS(JL)
( 1483)         ZDMFUPC(JL,JK)=(PMFLXR(JL,JK)+PMFLXS(JL,JK))*ZMFS(JL)
( 1484)         IKB=KCBOT(JL)
( 1485)         IF (JK>IKB) THEN
( 1486)           ZDMFUPC(JL,JK)=ZDMFUPC(JL,IKB)
