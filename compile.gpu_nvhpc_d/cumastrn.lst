(  951) !*    6.2          FINAL CLOSURE=SCALING
(  952) !                  ---------------------
(  953) 
(  954) !DIR$ LOOP_INFO EST_TRIPS(16)
(  955) DO JL=KIDIA,KFDIA
(  956)   IF(LDCUM(JL)) THEN
(  957)     ZMFS(JL)=ZMFUB1(JL)/MAX(RMFCMIN,ZMFUB(JL))
(  958)   ENDIF
(  959) ENDDO
(  960) DO JK=2,KLEV
(  961) !DIR$ LOOP_INFO EST_TRIPS(16)
(  962)   DO JL=KIDIA,KFDIA
(  963)     IF(LDCUM(JL).AND.JK>=KCTOP(JL)-1) THEN
(  964)       IKB=KCBOT(JL)
(  965)       IF(JK>IKB) THEN
(  966)         ZDZ=((PAPH(JL,KLEV+1)-PAPH(JL,JK))/(PAPH(JL,KLEV+1)-PAPH(JL,IKB)))
(  967)         PMFU(JL,JK)=PMFU(JL,IKB)*ZDZ
(  968)       ENDIF
(  969)       ZMFMAX=(PAPH(JL,JK)-PAPH(JL,JK-1))*ZCONS2 !*zmfcfl(jl)/rmfcfl
(  970)       IF (.NOT. LDTDKMF) ZMFMAX=MIN(ZMFMAX,RMFLIA)
(  971)       IF(PMFU(JL,JK)*ZMFS(JL)>ZMFMAX) THEN 
(  972)          ZMFS(JL)=MIN(ZMFS(JL),ZMFMAX/PMFU(JL,JK))  
(  973)          ZMFS(JL)=MAX(ZMFS(JL),1.E-10_JPRB)  
(  974)       ENDIF
