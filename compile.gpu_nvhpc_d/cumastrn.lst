( 1422) 
( 1423) IF (.NOT.LMFSCV .OR. .NOT.LMFPEN) THEN
( 1424)   DO JK=2,KLEV
( 1425) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1426)     DO JL=KIDIA,KFDIA
