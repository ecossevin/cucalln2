( 1559) 
( 1560) !*   12.           PUT DETRAINMENT RATES FROM MFLX UNITS IN UNITS MFLX/M 
( 1561) !                  FOR ERA40, ESTIMATE VOLUME MEAN RAIN AND SNOW CONTENT
( 1562) !                  ---------------------------------------------------
( 1563) 
( 1564) PDISS(:,1)=0.0_JPRB
( 1565) ZAR=1.0_JPRB/20.89_JPRB
( 1566) ZAS=1.0_JPRB/29.51_JPRB
( 1567) ZBR=1.0_JPRB/1.15_JPRB
( 1568) ZBS=1.0_JPRB/1.10_JPRB
( 1569) ZAK=1.0_JPRB/5.09E-3_JPRB
( 1570) DO JK=1,KLEV
( 1571) !DIR$ LOOP_INFO EST_TRIPS(16)
( 1572)   IK=MIN(JK+1,KLEV)
( 1573)   IKD=MAX(JK-1,1)
( 1574)   DO JL=KIDIA,KFDIA
( 1575)     PDISS(JL,JK)=0.0_JPRB
( 1576)     PRSUD(JL,JK,1)=0.0_JPRB
( 1577)     PRSUD(JL,JK,2)=0.0_JPRB
( 1578)     IF ( LDCUM(JL) .AND.JK>=KCTOP(JL)-1 ) THEN
( 1579)       PLUDELI(JL,JK,3)=PMFUDE_RATE(JL,JK)*(PQU(JL,IK)-ZQENH(JL,IK))+&
( 1580)                       &PMFDDE_RATE(JL,JK)*(ZQD(JL,IKD)-ZQENH(JL,IKD))
( 1581)       PLUDELI(JL,JK,4)=PMFUDE_RATE(JL,JK)*(PTU(JL,IK)-ZTENH(JL,IK))+&
( 1582)                       &PMFDDE_RATE(JL,JK)*(ZTD(JL,IKD)-ZTENH(JL,IKD))
( 1583)     ! Change units for detrainment as for ERA
( 1584)       ZRO=RG/(PGEOH(JL,JK)-PGEOH(JL,JK+1))  ! 1/dz
( 1585)       PMFUDE_RATE(JL,JK)=PMFUDE_RATE(JL,JK)*ZRO
( 1586)       PMFDDE_RATE(JL,JK)=PMFDDE_RATE(JL,JK)*ZRO
( 1587)       ZRO=RD*PTEN(JL,JK)*(1.0_JPRB+RETV*PQEN(JL,JK))/PAP(JL,JK)
( 1588)     ! Dissipation definition used in stoch Backscatter
( 1589)     ! PDISS(JL,JK)=MIN(PWMEAN(JL),17._JPRB)**2*PMFUDE_RATE(JL,JK)*ZRO*ZTAU(JL)
( 1590)       ZDUTEN=PTENU(JL,JK)-ZTENU(JL,JK)
( 1591)       ZDVTEN=PTENV(JL,JK)-ZTENV(JL,JK)
( 1592)     ! Dissipation used in eddy dissipation(EDR) turbulence diagnostic
( 1593)       PDISS(JL,JK)=ABS(PUEN(JL,JK)*ZDUTEN+PVEN(JL,JK)*ZDVTEN)**0.3333
( 1594) 
( 1595)     ! grid-mean convective rain/snow parametrization (Geer et al. 2009) with factor 0.5 for snow
( 1596)       PRSUD(JL,JK,1)=1.E-3_JPRB*ZRO*(PMFLXR(JL,JK)*3600._JPRB*ZAR)**ZBR
( 1597)       PRSUD(JL,JK,2)=0.5*1.E-3_JPRB*ZRO*(10.0_JPRB*PMFLXS(JL,JK)*3600._JPRB*ZAS)**ZBS
( 1598)     ! possible updraught fraction for incloud values
( 1599)     ! ZFAC=PAPH(JL,NJKT5)/MIN(PAPH(JL,NJKT5),MAX(200.E2_JPRB,PAPH(JL,JK)))
( 1600)     ! ZFAC=RCUCOV*ZFAC**2
( 1601)     ! grid-mean convective rain/snow parametrization similar to that used in evaporation
( 1602)     ! i.e. Kessler but without pressure factor and factor for snow
( 1603)     ! PRSUD(JL,JK,1)=1.E-3_JPRB*ZRO*(PMFLXR(JL,JK)*ZAK)**0.888_JPRB
( 1604)     ! PRSUD(JL,JK,2)=1.E-3_JPRB*ZRO*(PMFLXS(JL,JK)*2.5*ZAK)**0.888_JPRB
( 1605)     ELSE
( 1606)       PMFU(JL,JK)=0.0_JPRB
( 1607)       PMFD(JL,JK)=0.0_JPRB
( 1608)       PLUDE(JL,JK)=0.0_JPRB
( 1609)       PLUDELI(JL,JK,1)=0.0_JPRB
( 1610)       PLUDELI(JL,JK,2)=0.0_JPRB
( 1611)       PLUDELI(JL,JK,3)=0.0_JPRB
( 1612)       PLUDELI(JL,JK,4)=0.0_JPRB
( 1613)       PSNDE(JL,JK,1)=0.0_JPRB
( 1614)       PSNDE(JL,JK,2)=0.0_JPRB
( 1615)       PTU(JL,JK)=PTEN(JL,JK)
( 1616)       PQU(JL,JK)=PQEN(JL,JK)






