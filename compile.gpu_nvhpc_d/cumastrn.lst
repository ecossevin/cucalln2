( 1617)       PLU(JL,JK)=0.0_JPRB
( 1618)       PENTH(JL,JK)=0.0_JPRB
( 1619)       PMFUDE_RATE(JL,JK)=0.0_JPRB
( 1620)       PMFDDE_RATE(JL,JK)=0.0_JPRB
