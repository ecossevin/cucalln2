( 1488)       ELSE
( 1489)         ZMFUUS(JL,JK)=0._JPRB
( 1490)         ZMFUDR(JL,JK)=0._JPRB
( 1491)       ENDIF
( 1492)       IF ( LLDDRAF3(JL) .AND. JK>=IDTOP(JL)-1) THEN
( 1493)         ZMFDUS(JL,JK)=PMFD(JL,JK)*ZMFS(JL)
( 1494)         ZMFDDR(JL,JK)=PMFDDE_RATE(JL,JK)*ZMFS(JL)
( 1495)   !     ZDMFDPC(JL,JK)=ZDMFDPC(JL,JK)*ZMFS(JL)
( 1496)         ZDMFDPC(JL,JK)=0.0_JPRB
( 1497)       ELSE
( 1498)         ZMFDUS(JL,JK)=0._JPRB
( 1499)         ZMFDDR(JL,JK)=0._JPRB
( 1500)       ENDIF






