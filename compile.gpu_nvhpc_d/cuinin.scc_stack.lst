(  160)         PQENH(JL, JK) = PQEN(JL, JK - 1)
(  161)         PQSENH(JL, JK) = PQSEN(JL, JK - 1)
(  162)         ZPH = PAPH(JL, JK)
(  163)         LLFLAG = .true.
(  164)         
(  165)         !orig   IF(JK.GE.KLEV-1) GO TO 130
(  166)         IF (JK >= -1 + KLEV .or. JK < YDECUMF%NJKT2) CYCLE






