(  145)     !----------------------------------------------------------------------
(  146)     
(  147)     !*    1.           SPECIFY LARGE SCALE PARAMETERS AT HALF LEVELS
(  148)     !*                 ADJUST TEMPERATURE FIELDS IF STATICLY UNSTABLE
(  149)     !*                 FIND LEVEL OF MAXIMUM VERTICAL VELOCITY
(  150)     !                  ----------------------------------------------
(  151)     
(  152)     ZORCPD = 1._JPRB / YDCST%RCPD
(  153)     
(  154) !$acc loop vector
(  155)     DO JL=KIDIA,KFDIA
(  156) !$acc loop seq
(  157)       DO JK=2,KLEV
