(  185)             Z3ES = YDTHF%R3LES
(  186)             Z4ES = YDTHF%R4LES
(  187)             Z5ALCP = YDTHF%R5ALVCP
(  188)             ZALDCP = YDTHF%RALVDCP
(  189)           ELSE
(  190)             Z3ES = YDTHF%R3IES
(  191)             Z4ES = YDTHF%R4IES
(  192)             Z5ALCP = YDTHF%R5ALSCP
(  193)             ZALDCP = YDTHF%RALSDCP
(  194)           END IF
(  195)           
(  196)           
(  197)           
