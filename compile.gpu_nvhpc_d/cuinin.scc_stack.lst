(  213)           PQSENH(JL, IK) = PQSENH(JL, IK) - ZCOND1
(  214)           ZTARG = PTENH(JL, IK)
(  215)           ZFOEEW = YDTHF%R2ES*EXP(Z3ES*(ZTARG - YDCST%RTT) / (ZTARG - Z4ES))
(  216)           ZQSAT = ZQP*ZFOEEW
(  217)           IF (ZQSAT > ZQMAX) THEN
(  218)             ZQSAT = ZQMAX
(  219)           END IF
(  220)           ZCOR = 1.0_JPRB / (1.0_JPRB - YDCST%RETV*ZQSAT)
(  221)           ZQSAT = ZQSAT*ZCOR
(  222)           Z2S = Z5ALCP / (ZTARG - Z4ES)**2
(  223)           ZCOND1 = (PQSENH(JL, IK) - ZQSAT) / (1.0_JPRB + ZQSAT*ZCOR*Z2S)
(  224)           PTENH(JL, IK) = PTENH(JL, IK) + ZALDCP*ZCOND1






