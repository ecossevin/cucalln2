(   51)     !    *PQSENH*       ENV. SPEC. SATURATION HUMIDITY (T+1)
(   52)     !                   ON HALF LEVELS                              KG/KG
(   53)     !    *PTU*          TEMPERATURE IN UPDRAFTS                       K
(   54)     !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                  KG/KG
(   55)     !    *PTD*          TEMPERATURE IN DOWNDRAFTS                     K
(   56)     !    *PQU*          SPEC. HUMIDITY IN DOWNDRAFTS                KG/KG
