(    1) MODULE CUININ_LOKI_MOD
(    2)   CONTAINS
(    3)   SUBROUTINE CUININ_LOKI (YDCST, YDTHF, YDEPHLI, YDECUMF, KIDIA, KFDIA, KLON, KLEV, PTEN, PQEN, PQSEN, PUEN, PVEN, PGEO, PAP
(    4)   & KLAB, PTENH, PQENH, PQSENH, PGEOH, PTU, PQU, PTD, PQD, PUU, PVU, PUD, PVD, PLU, YDSTACK_L)
(    5)     
(    6)     !          PURPOSE
(    7)     !          -------
(    8)     
(    9)     !          THIS ROUTINE INTERPOLATES LARGE-SCALE FIELDS OF T,Q ETC.
(   10)     !          TO HALF LEVELS (I.E. GRID FOR MASSFLUX SCHEME),
(   11)     !          DETERMINES LEVEL OF MAXIMUM VERTICAL VELOCITY
(   12)     !          AND INITIALIZES VALUES FOR UPDRAFTS AND DOWNDRAFTS
(   13)     
(   14)     !          INTERFACE
(   15)     !          ---------
(   16)     !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   17)     
(   18)     !          METHOD.
(   19)     !          --------
(   20)     !          FOR EXTRAPOLATION TO HALF LEVELS SEE TIEDTKE(1989)
(   21)     
(   22)     !     PARAMETER     DESCRIPTION                                   UNITS
(   23)     !     ---------     -----------                                   -----
(   24)     !     INPUT PARAMETERS (INTEGER):
(   25)     
(   26)     !    *KIDIA*        START POINT
(   27)     !    *KFDIA*        END POINT
(   28)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   29)     !    *KLEV*         NUMBER OF LEVELS
(   30)     
(   31)     !    INPUT PARAMETERS (REAL):
(   32)     
(   33)     !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   34)     !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   35)     !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   36)     !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)       M/S
(   37)     !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)       M/S
(   38)     !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   39)     !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   40)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS             PA
(   41)     
(   42)     !    OUTPUT PARAMETERS (INTEGER):
(   43)     
(   44)     !    *KLAB*         FLAG KLAB=1 FOR SUBCLOUD LEVELS
(   45)     !                        KLAB=2 FOR CONDENSATION LEVEL
(   46)     
(   47)     !    OUTPUT PARAMETERS (REAL):
(   48)     
(   49)     !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS         K
(   50)     !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS    KG/KG






