(  475)         PMFLXR(JL,JK+1)=PMFLXR(JL,JK)+ZPDR&
(  476)          & +PDPMEL(JL,JK)+ZDRFL*PMFLXR(JL,JK)*ZDENOM  
(  477)         PMFLXS(JL,JK+1)=PMFLXS(JL,JK)+ZPDS &
(  478)          & -PDPMEL(JL,JK)+ZDRFL*PMFLXS(JL,JK)*ZDENOM  
