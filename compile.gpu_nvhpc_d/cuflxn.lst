(  381)         IF (LPHYLIN) THEN
(  382)           ZTARG=ZTEN-ZSNMLT/ZFAC
(  383)           ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  384)           ZFOEEWL=R2ES*EXP(R3LES*(ZTARG-RTT)/(ZTARG-R4LES))
(  385)           ZFOEEWI=R2ES*EXP(R3IES*(ZTARG-RTT)/(ZTARG-R4IES))
(  386)           ZOEEWM=ZOEALFA*ZFOEEWL + (1.0_JPRB-ZOEALFA)*ZFOEEWI
(  387)           PQSEN(JL,JK)=ZOEEWM/PAP(JL,JK)
(  388)         ELSE
(  389)           PQSEN(JL,JK)=FOEEWMCU(ZTEN-ZSNMLT/ZFAC)/PAP(JL,JK)
(  390)         ENDIF
(  391)       ENDIF
(  392)       IF (LPHYLIN) THEN
(  393)         ZALFAW=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTEN-RLPTRC))+1.0_JPRB))
(  394)       ELSE
(  395)         ZALFAW=FOEALFCU(ZTEN)
(  396)       ENDIF
(  397) !no liquid precipitation above melting level
(  398) !     add heat not yet liberated in updraught precip
(  399)       IF(PTEN(JL,JK) <= RTT .AND. ZALFAW > 0.0_JPRB) THEN






