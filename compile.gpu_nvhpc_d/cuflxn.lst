(  441)    ELSE
(  442)      ZRCUCOV(JL)=RCUCOV*0.6
(  443)    ENDIF
(  444)   ENDDO
(  445) ELSE
(  446)   DO JL=KIDIA,KFDIA
(  447)     ZRCUCOV(JL)=RCUCOV
(  448)   ENDDO
(  449) ENDIF
(  450) 
(  451) DO JK=KTOPM2,KLEV
(  452)   DO JL=KIDIA,KFDIA
(  453)     IF(LDCUM(JL).AND.JK >= KCBOT(JL)) THEN
