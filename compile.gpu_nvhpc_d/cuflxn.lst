(  460)         ZRNEW=ZRFL-ZDRFL1
(  461)         ZRMIN=ZRFL-ZRCUCOV(JL)*MAX(0.0_JPRB,ZRHEBC(JL)*PQSEN(JL,JK)-PQEN(JL,JK))&
