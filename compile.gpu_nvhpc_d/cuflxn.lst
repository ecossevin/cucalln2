(  410)          PSNDE(JL,JK,1)=MAX(PSNDE(JL,JK,1),0.0_JPRB)
(  411)          PSNDE(JL,JK,2)=MAX(PSNDE(JL,JK,2),0.0_JPRB)
(  412)       ENDIF
(  413)       PMFLXR(JL,JK+1)=PMFLXR(JL,JK)+ZALFAW*&
(  414)        & (PDMFUP(JL,JK)+PDMFDP(JL,JK))+PDPMEL(JL,JK)-PSNDE(JL,JK,1)
(  415)       PMFLXS(JL,JK+1)=PMFLXS(JL,JK)+(1.0_JPRB-ZALFAW)*&
(  416)        & (PDMFUP(JL,JK)+PDMFDP(JL,JK))-PDPMEL(JL,JK)-PSNDE(JL,JK,2)
(  417)       IF(PMFLXR(JL,JK+1)+PMFLXS(JL,JK+1) < 0.0_JPRB) THEN
(  418)         PDMFDP(JL,JK)=-(PMFLXR(JL,JK)+PMFLXS(JL,JK)+PDMFUP(JL,JK))
(  419)         PMFLXR(JL,JK+1)=0.0_JPRB
(  420)         PMFLXS(JL,JK+1)=0.0_JPRB
(  421)         PDPMEL(JL,JK)  =0.0_JPRB
(  422)       ELSEIF(PMFLXR(JL,JK+1) < 0.0_JPRB ) THEN
(  423)         PMFLXS(JL,JK+1)=PMFLXS(JL,JK+1)+PMFLXR(JL,JK+1)
(  424)         PMFLXR(JL,JK+1)=0.0_JPRB
(  425)       ELSEIF(PMFLXS(JL,JK+1) < 0.0_JPRB ) THEN
(  426)         PMFLXR(JL,JK+1)=PMFLXR(JL,JK+1)+PMFLXS(JL,JK+1)
(  427)         PMFLXS(JL,JK+1)=0.0_JPRB
(  428)       ENDIF
(  429)     ENDIF
(  430)   ENDDO
(  431) ENDDO
(  432) # 433 "./cuflxn.F90"
(  433) ! Increase area fraction for evaporation depending on average RH in cloud-layer 
(  434) IF (.NOT. LDTDKMF) THEN
(  435)   DO JL=KIDIA,KFDIA
(  436)    IF (KTYPE(JL)>=2) THEN
(  437)      IKB=KCBOT(JL)
