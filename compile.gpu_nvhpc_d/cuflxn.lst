(  483)           PMFLXS(JL,JK+1)=0.0_JPRB
(  484)           PDPMEL(JL,JK)  =0.0_JPRB
(  485)         ELSEIF(PMFLXR(JL,JK+1) < 0.0_JPRB ) THEN
(  486)           PMFLXS(JL,JK+1)=PMFLXS(JL,JK+1)+PMFLXR(JL,JK+1)
(  487)           PMFLXR(JL,JK+1)=0.0_JPRB
(  488)         ELSEIF(PMFLXS(JL,JK+1) < 0.0_JPRB ) THEN
(  489)           PMFLXR(JL,JK+1)=PMFLXR(JL,JK+1)+PMFLXS(JL,JK+1)
(  490)           PMFLXS(JL,JK+1)=0.0_JPRB
