(  457)          & (SQRT(PAPH(JL,JK)/PAPH(JL,KLEV+1))/RCVRFACTOR*&
(  458)          & ZRFL/ZRCUCOV(JL))**0.5777_JPRB*&
(  459)          & (PAPH(JL,JK+1)-PAPH(JL,JK))  
(  460)         ZRNEW=ZRFL-ZDRFL1
(  461)         ZRMIN=ZRFL-ZRCUCOV(JL)*MAX(0.0_JPRB,ZRHEBC(JL)*PQSEN(JL,JK)-PQEN(JL,JK))&
(  462)          & *ZCONS2*(PAPH(JL,JK+1)-PAPH(JL,JK))  
(  463)         ZRNEW=MAX(ZRNEW,ZRMIN)
(  464)         ZRFLN=MAX(ZRNEW,0.0_JPRB)
(  465)         ZDRFL=MIN(0.0_JPRB,ZRFLN-ZRFL)
(  466)         IF (LPHYLIN) THEN
(  467)           ZALFAW=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(PTEN(JL,JK)-RLPTRC))+1.0_JPRB))
(  468)         ELSE
(  469)           ZALFAW=FOEALFCU(PTEN(JL,JK))
(  470)         ENDIF
(  471)         IF(PTEN(JL,JK) < RTT) ZALFAW=0.0_JPRB
(  472)         ZPDR=ZALFAW*PDMFDP(JL,JK)
(  473)         ZPDS=(1.0_JPRB-ZALFAW)*PDMFDP(JL,JK)
