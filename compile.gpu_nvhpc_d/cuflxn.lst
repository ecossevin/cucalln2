(  283) !                  LINEAR DCREASE
(  284) !                  -----------------------------
(  285) # 286 "./cuflxn.F90"
(  286) !DIR$ IVDEP
(  287) !OCL NOVREC
(  288) DO JL=KIDIA,KFDIA
(  289)   IF(LDCUM(JL)) THEN
(  290)     IKB=KCBOT(JL)
(  291)     IK=IKB+1
(  292)     ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,IK))/(PAPH(JL,KLEV+1)-PAPH(JL,IKB)))
(  293)     IF(KTYPE(JL) == 3) ZZP=ZZP*ZZP
(  294)     PMFU(JL,IK)=PMFU(JL,IKB)*ZZP
(  295)     IF (LPHYLIN) THEN
(  296)       ZTARG=PTENH(JL,IKB)
(  297)       ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  298)       ZOELHM=ZOEALFA*RLVTT+(1.0_JPRB-ZOEALFA)*RLSTT
(  299)       PMFUS(JL,IK)=(PMFUS(JL,IKB)-ZOELHM*PMFUL(JL,IKB))*ZZP
(  300)     ELSE
(  301)       PMFUS(JL,IK)=(PMFUS(JL,IKB)-FOELHMCU(PTENH(JL,IKB))*PMFUL(JL,IKB))*ZZP
(  302)     ENDIF
(  303)     PMFUQ(JL,IK)=(PMFUQ(JL,IKB)+PMFUL(JL,IKB))*ZZP
(  304)     PMFUL(JL,IK)=0.0_JPRB
(  305)   ENDIF
(  306) ENDDO
(  307) DO JK=KTOPM2,KLEV
(  308) !DIR$ IVDEP
(  309) !OCL NOVREC
(  310)   DO JL=KIDIA,KFDIA
(  311)     IF(LDCUM(JL).AND.JK > KCBOT(JL)+1) THEN
(  312)       IKB=KCBOT(JL)+1
(  313)       ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,JK))/(PAPH(JL,KLEV+1)-PAPH(JL,IKB)))
(  314)       IF(KTYPE(JL) == 3) ZZP=ZZP*ZZP
(  315)       PMFU(JL,JK)=PMFU(JL,IKB)*ZZP
(  316)       PMFUS(JL,JK)=PMFUS(JL,IKB)*ZZP
(  317)       PMFUQ(JL,JK)=PMFUQ(JL,IKB)*ZZP
(  318)       PMFUL(JL,JK)=0.0_JPRB
(  319)     ENDIF
(  320)     IK=IDBAS(JL)
(  321)     LLDDRAF=LDDRAF(JL).AND.JK>IK.AND.IK<KLEV
(  322)     IF(LLDDRAF.AND.IK==KCBOT(JL)+1) THEN 
(  323)       ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,JK))/(PAPH(JL,KLEV+1)-PAPH(JL,IK)))      
(  324)       IF(KTYPE(JL) == 3)  ZZP=ZZP*ZZP
(  325)       PMFD(JL,JK)=PMFD(JL,IK)*ZZP
(  326)       PMFDS(JL,JK)=PMFDS(JL,IK)*ZZP
(  327)       PMFDQ(JL,JK)=PMFDQ(JL,IK)*ZZP
(  328)       PMFDDE_RATE(JL,JK)=-(PMFD(JL,JK-1)-PMFD(JL,JK))
(  329)     ELSEIF(LLDDRAF.AND.IK/=KCBOT(JL)+1.AND.JK==IK+1) THEN
(  330)       PMFDDE_RATE(JL,JK)=-(PMFD(JL,JK-1)-PMFD(JL,JK))
