Filename: ./cuflxn.F90

(    1) !OPTIONS XOPT(HSFUN)
(    2) SUBROUTINE CUFLXN &
(    3)  & (YDTHF, YDCST, YDEPHLI, YDECUMF,  KIDIA,    KFDIA,    KLON,   KLEV,&
(    4)  & PTSPHY,&
(    5)  & PTEN,     PQEN,     PQSEN,    PTENH,    PQENH,&
(    6)  & PAPH,     PAP,      PGEOH,    LDLAND,   LDCUM, LDTDKMF,&
(    7)  & KCBOT,    KCTOP,    KDTOP,    KTOPM2,&
(    8)  & KTYPE,    LDDRAF,&
(    9)  & PMFU,     PMFD,     PMFUS,    PMFDS,&
(   10)  & PMFUQ,    PMFDQ,    PMFUL,    PLUDE,    PLUDELI,   PLRAIN,  PSNDE,&
(   11)  & PDMFUP,   PDMFDP,   PDPMEL,   PLGLAC,&
(   12)  & PMFLXR,   PMFLXS,   PRAIN,    PMFUDE_RATE,  PMFDDE_RATE )  
(   13) 
(   14) !          PURPOSE
(   15) !          -------
(   16) 
(   17) !          THIS ROUTINE DOES THE FINAL CALCULATION OF CONVECTIVE
(   18) !          FLUXES IN THE CLOUD LAYER AND IN THE SUBCLOUD LAYER
(   19) 
(   20) !          INTERFACE
(   21) !          ---------
(   22) !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   23) 
(   24) !     PARAMETER     DESCRIPTION                                   UNITS
(   25) !     ---------     -----------                                   -----
(   26) !     INPUT PARAMETERS (INTEGER):
(   27) 
(   28) !    *KIDIA*        START POINT
(   29) !    *KFDIA*        END POINT
(   30) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   31) !    *KLEV*         NUMBER OF LEVELS
(   32) !    *KCBOT*        CLOUD BASE LEVEL
(   33) !    *KCTOP*        CLOUD TOP LEVEL
(   34) !    *KDTOP*        TOP LEVEL OF DOWNDRAFTS
(   35) 
(   36) !    INPUT PARAMETERS (LOGICAL):
(   37) 
(   38) !    *LDLAND*       LAND SEA MASK (.TRUE. FOR LAND)
(   39) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   40) !    *LDTDKMF*      Arpege tuning (if TRUE)
(   41) 
(   42) !    INPUT PARAMETERS (REAL):
(   43) 
(   44) !    *PTSPHY*       TIME STEP FOR THE PHYSICS                       S
(   45) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   46) !    *PQEN*         PROVISIONAL ENVIRONMENT SPEC. HUMIDITY (T+1)  KG/KG
(   47) !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   48) !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS           K
(   49) !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS      KG/KG
(   50) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS            PA






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 2

(   51) !    *PAP*          PROVISIONAL PRESSURE ON FULL LEVELS            PA
(   52) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                   M2/S2
(   53) 
(   54) !    UPDATED PARAMETERS (INTEGER):
(   55) 
(   56) !    *KTYPE*        SET TO ZERO IF LDCUM=.FALSE.
(   57) 
(   58) !    UPDATED PARAMETERS (LOGICAL):
(   59) 
(   60) !    *LDDRAF*       SET TO .FALSE. IF LDCUM=.FALSE. OR KDTOP<KCTOP   
(   61) 
(   62) !    UPDATED PARAMETERS (REAL):
(   63) 
(   64) !    *PMFU*         MASSFLUX IN UPDRAFTS                          KG/(M2*S)
(   65) !    *PMFD*         MASSFLUX IN DOWNDRAFTS                        KG/(M2*S)
(   66) !    *PMFUS*        FLUX OF DRY STATIC ENERGY IN UPDRAFTS          J/(M2*S)
(   67) !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS        J/(M2*S)
(   68) !    *PMFUQ*        FLUX OF SPEC. HUMIDITY IN UPDRAFTS            KG/(M2*S)
(   69) !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS          KG/(M2*S)
(   70) !    *PMFUL*        FLUX OF LIQUID WATER IN UPDRAFTS              KG/(M2*S)
(   71) !    *PLUDE*        DETRAINED LIQUID WATER                        KG/(M2*S)
(   72) !    *PLRAIN*       SNOW/RAIN MIXING RATIO                        KG/(KG)
(   73) !    *PSNDE*        DETRAINED SNOW/RAIN                           KG/(M2*S)
(   74) !    *PDMFUP*       FLUX DIFFERENCE OF PRECIP. IN UPDRAFTS        KG/(M2*S)
(   75) !    *PDMFDP*       FLUX DIFFERENCE OF PRECIP. IN DOWNDRAFTS      KG/(M2*S)
(   76) !    *PMFUDE_RATE*  UPDRAFT DETRAINMENT RATE                      KG/(M2*S)
(   77) !    *PMFDDE_RATE*  DOWNDRAFT DETRAINMENT RATE                    KG/(M2*S)
(   78) 
(   79) !    OUTPUT PARAMETERS (REAL):
(   80) 
(   81) !    *PDPMEL*       CHANGE IN PRECIP.-FLUXES DUE TO MELTING       KG/(M2*S)
(   82) !    *PLGLAC*       FLUX OF FROZEN CLOUD WATER IN UPDRAFTS        KG/(M2*S)
(   83) !    *PMFLXR*       CONVECTIVE RAIN FLUX                          KG/(M2*S)
(   84) !    *PMFLXS*       CONVECTIVE SNOW FLUX                          KG/(M2*S)
(   85) !    *PRAIN*        TOTAL PRECIP. PRODUCED IN CONV. UPDRAFTS      KG/(M2*S)
(   86) !                   (NO EVAPORATION IN DOWNDRAFTS)
(   87) 
(   88) !          EXTERNALS
(   89) !          ---------
(   90) !          NONE
(   91) 
(   92) !     AUTHOR.
(   93) !     -------
(   94) !      M.TIEDTKE         E.C.M.W.F.     7/86 MODIF. 12/89
(   95) 
(   96) !     MODIFICATIONS.
(   97) !     --------------
(   98) !      03-08-28 : Clean up LINPHYS; Bugs in Evapor.    P.BECHTOLD
(   99) !      05-02-11 : Extend DDMflux to surface if zero    P.BECHTOLD
(  100) !      M.Hamrud      01-Oct-2003 CY28 Cleaning
(  101) !      N.Semane+P.Bechtold     04-10-2012 Add RCVRFACTOR factor for small planet
(  102) !      20210913 : Modifications for Arpege Y.Bouteloup (LDTDKMF)
(  103) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(  104) !----------------------------------------------------------------------
(  105) 
(  106) USE PARKIND1 , ONLY : JPIM     ,JPRB
(  107) USE YOMHOOK  , ONLY : LHOOK,   DR_HOOK, JPHOOK
(  108) 






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 3

(  109) USE YOMCST   , ONLY : TCST
(  110) USE YOETHF   , ONLY : TTHF  
(  111) USE YOEPHLI  , ONLY : TEPHLI
(  112) USE YOECUMF  , ONLY : TECUMF
(  113) 
(  114) IMPLICIT NONE
(  115) 
(  116) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(  117) TYPE(TCST)        ,INTENT(IN)    :: YDCST
(  118) TYPE(TECUMF)      ,INTENT(IN)    :: YDECUMF
(  119) TYPE(TEPHLI)      ,INTENT(IN)    :: YDEPHLI
(  120) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(  121) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(  122) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(  123) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(  124) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTSPHY 
(  125) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTEN(KLON,KLEV) 
(  126) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQEN(KLON,KLEV) 
(  127) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PQSEN(KLON,KLEV) 
(  128) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTENH(KLON,KLEV) 
(  129) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQENH(KLON,KLEV) 
(  130) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAPH(KLON,KLEV+1) 
(  131) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAP(KLON,KLEV) 
(  132) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEOH(KLON,KLEV+1) 
(  133) LOGICAL           ,INTENT(IN)    :: LDLAND(KLON)
(  134) LOGICAL           ,INTENT(IN)    :: LDCUM(KLON) 
(  135) LOGICAL           ,INTENT(IN)    :: LDTDKMF
(  136) INTEGER(KIND=JPIM),INTENT(IN)    :: KCBOT(KLON) 
(  137) INTEGER(KIND=JPIM),INTENT(IN)    :: KCTOP(KLON) 
(  138) INTEGER(KIND=JPIM),INTENT(IN)    :: KDTOP(KLON) 
(  139) INTEGER(KIND=JPIM),INTENT(OUT)   :: KTOPM2 
(  140) INTEGER(KIND=JPIM),INTENT(INOUT) :: KTYPE(KLON) 
(  141) LOGICAL           ,INTENT(INOUT) :: LDDRAF(KLON) 
(  142) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFU(KLON,KLEV) 
(  143) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFD(KLON,KLEV) 
(  144) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFUS(KLON,KLEV) 
(  145) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFDS(KLON,KLEV) 
(  146) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFUQ(KLON,KLEV) 
(  147) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFDQ(KLON,KLEV) 
(  148) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFUL(KLON,KLEV) 
(  149) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PLUDE(KLON,KLEV) 
(  150) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PLUDELI(KLON,KLEV,2) 
(  151) REAL(KIND=JPRB)   ,INTENT(IN)    :: PLRAIN(KLON,KLEV) 
(  152) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PSNDE(KLON,KLEV,2) 
(  153) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PDMFUP(KLON,KLEV) 
(  154) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PDMFDP(KLON,KLEV) 
(  155) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PDPMEL(KLON,KLEV) 
(  156) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PLGLAC(KLON,KLEV) 
(  157) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PMFLXR(KLON,KLEV+1) 
(  158) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PMFLXS(KLON,KLEV+1) 
(  159) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PRAIN(KLON) 
(  160) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFUDE_RATE(KLON,KLEV)
(  161) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFDDE_RATE(KLON,KLEV)
(  162) 
(  163) REAL(KIND=JPRB) :: ZRHEBC(KLON), ZMFS(KLON), ZRCUCOV(KLON)
(  164) INTEGER(KIND=JPIM) :: IK, IKB, JK, JL
(  165) INTEGER(KIND=JPIM) :: IDBAS(KLON)
(  166) LOGICAL :: LLDDRAF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 4

(  167) 
(  168) REAL(KIND=JPRB) :: ZALFAW, ZCONS1, ZCONS1A, ZCONS2, &
(  169)  & ZDENOM, ZDRFL, ZDRFL1, ZFAC, ZFOEEWI, &
(  170)  & ZFOEEWL, ZOEALFA, ZOEEWM, ZOELHM, ZPDR, ZPDS, &
(  171)  & ZRFL, ZRFLN, ZRMIN, ZRNEW, ZSNMLT, ZTARG, &
(  172)  & ZTMST, ZZP, ZTWETB, ZWETB, ZTEN, ZGLAC, ZMFMAX, ZRHM
(  173) ! Numerical fit to wet bulb temperature
(  174) REAL(KIND=JPRB),PARAMETER :: ZTW1 = 1329.31_JPRB
(  175) REAL(KIND=JPRB),PARAMETER :: ZTW2 = 0.0074615_JPRB
(  176) REAL(KIND=JPRB),PARAMETER :: ZTW3 = 0.85E5_JPRB
(  177) REAL(KIND=JPRB),PARAMETER :: ZTW4 = 40.637_JPRB
(  178) REAL(KIND=JPRB),PARAMETER :: ZTW5 = 275.0_JPRB
(  179) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(  180) 
(  181) !DIR$ VFUNCTION EXPHF
(  182) #include "fcttre.func.h"
(  183) 
(  184) !--------------------------------------------------------------------
(  185) !*             SPECIFY CONSTANTS
(  186) 
(  187) IF (LHOOK) CALL DR_HOOK('CUFLXN',0,ZHOOK_HANDLE)
(  188) ASSOCIATE(LMFDSNOW=>YDECUMF%LMFDSNOW, RCPECONS=>YDECUMF%RCPECONS, &
(  189)  & RCUCOV=>YDECUMF%RCUCOV, RCVRFACTOR=>YDECUMF%RCVRFACTOR, RHEBC=>YDECUMF%RHEBC, &
(  190)  & RMFCFL=>YDECUMF%RMFCFL, RTAUMEL=>YDECUMF%RTAUMEL, &
(  191)  & RCPD=>YDCST%RCPD, RG=>YDCST%RG, RLMLT=>YDCST%RLMLT, RLSTT=>YDCST%RLSTT, &
(  192)  & RLVTT=>YDCST%RLVTT, RTT=>YDCST%RTT, &
(  193)  & R2ES=>YDTHF%R2ES, R3IES=>YDTHF%R3IES, R3LES=>YDTHF%R3LES, R4IES=>YDTHF%R4IES, &
(  194)  & R4LES=>YDTHF%R4LES, &
(  195)  & LPHYLIN=>YDEPHLI%LPHYLIN, RLPTRC=>YDEPHLI%RLPTRC, &
(  196)  & LMFWETB=>YDECUMF%LMFWETB, LMFGLAC=>YDECUMF%LMFGLAC)
(  197) ZTMST=PTSPHY
(  198) ZCONS1A=RCPD/(RLMLT*RG*RTAUMEL)
(  199) !ZCONS2=1.0_JPRB/(RG*ZTMST)
(  200) ZCONS2=RMFCFL/(RG*ZTMST)
(  201) IF(LMFWETB) THEN
(  202)   ZWETB=1.0_JPRB
(  203) ELSE
(  204)   ZWETB=0.0_JPRB
(  205) ENDIF
(  206) IF(LMFGLAC) THEN
(  207)   ZGLAC=0.0_JPRB
(  208) ELSE
(  209)   ZGLAC=1.0_JPRB
(  210) ENDIF
(  211) 
(  212) !*    1.0          DETERMINE FINAL CONVECTIVE FLUXES
(  213) !                  ---------------------------------
(  214) 
(  215) DO JL=KIDIA,KFDIA
(  216)   PRAIN(JL)=0.0_JPRB
(  217)   IF(.NOT.LDCUM(JL).OR.KDTOP(JL) < KCTOP(JL)) LDDRAF(JL)=.FALSE.
(  218)   IF(.NOT.LDCUM(JL)) KTYPE(JL)=0
(  219)   IDBAS(JL)=KLEV
(  220)   IF(LDLAND(JL)) THEN
(  221)     ZRHEBC(JL)=0.75_JPRB
(  222)     IF(KTYPE(JL)==1) ZRHEBC(JL)=0.70_JPRB
(  223)   ELSE
(  224)     ZRHEBC(JL)=RHEBC






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 5

(  225)     IF(KTYPE(JL)==1) ZRHEBC(JL)=0.85_JPRB
(  226)   ENDIF
(  227) ENDDO
(  228) ! TO GET IDENTICAL RESULTS FOR DIFFERENT NPROMA FORCE KTOPM2 TO 2
(  229) KTOPM2=2
(  230) DO JK=KTOPM2,KLEV
(  231)   IKB=MIN(JK+1,KLEV)
(  232) !DIR$ IVDEP
(  233) !OCL NOVREC
(  234)   DO JL=KIDIA,KFDIA
(  235)     PMFLXR(JL,JK)=0.0_JPRB
(  236)     PMFLXS(JL,JK)=0.0_JPRB
(  237)     PDPMEL(JL,JK)=0.0_JPRB
(  238)     PSNDE (JL,JK,1)=0.0_JPRB
(  239)     PSNDE (JL,JK,2)=0.0_JPRB
(  240)     IF(LDCUM(JL).AND.JK >= KCTOP(JL)) THEN
(  241)       PMFUS(JL,JK)=PMFUS(JL,JK)-PMFU(JL,JK)*(RCPD*PTENH(JL,JK)+PGEOH(JL,JK))
(  242)       PMFUQ(JL,JK)=PMFUQ(JL,JK)-PMFU(JL,JK)*PQENH(JL,JK)
(  243)       PLGLAC(JL,JK)=PMFU(JL,JK)*PLGLAC(JL,JK)
(  244)       LLDDRAF=LDDRAF(JL).AND.JK >= KDTOP(JL)
(  245)       IF(LLDDRAF) THEN
(  246)         PMFDS(JL,JK)=PMFDS(JL,JK)-PMFD(JL,JK)*&
(  247)          & (RCPD*PTENH(JL,JK)+PGEOH(JL,JK))  
(  248)         PMFDQ(JL,JK)=PMFDQ(JL,JK)-PMFD(JL,JK)*PQENH(JL,JK)
(  249)       ELSE
(  250)         PMFD(JL,JK)=0.0_JPRB
(  251)         PMFDS(JL,JK)=0.0_JPRB
(  252)         PMFDQ(JL,JK)=0.0_JPRB
(  253)         PDMFDP(JL,JK-1)=0.0_JPRB
(  254)       ENDIF
(  255)       IF(LLDDRAF.AND.PMFD(JL,JK)<0._JPRB .AND. PMFD(JL,IKB)==0._JPRB) THEN
(  256)         IDBAS(JL)=JK
(  257)       ENDIF
(  258)     ELSE
(  259)       PMFU(JL,JK)=0.0_JPRB
(  260)       PMFD(JL,JK)=0.0_JPRB
(  261)       PMFUS(JL,JK)=0.0_JPRB
(  262)       PMFDS(JL,JK)=0.0_JPRB
(  263)       PMFUQ(JL,JK)=0.0_JPRB
(  264)       PMFDQ(JL,JK)=0.0_JPRB
(  265)       PMFUL(JL,JK)=0.0_JPRB
(  266)       PLGLAC(JL,JK)=0.0_JPRB
(  267)       PDMFUP(JL,JK-1)=0.0_JPRB
(  268)       PDMFDP(JL,JK-1)=0.0_JPRB
(  269)       PLUDE(JL,JK-1)=0.0_JPRB
(  270)       PLUDELI(JL,JK-1,1)=0.0_JPRB
(  271)       PLUDELI(JL,JK-1,2)=0.0_JPRB
(  272)     ENDIF
(  273)   ENDDO
(  274) ENDDO
(  275) PMFLXR(:,KLEV+1)=0.0_JPRB
(  276) PMFLXS(:,KLEV+1)=0.0_JPRB
(  277) PMFLXR(:,1)=0.0_JPRB
(  278) PMFLXS(:,1)=0.0_JPRB
(  279) PSNDE(:,1,1)=0.0_JPRB
(  280) PSNDE(:,1,2)=0.0_JPRB
(  281) 
(  282) !*    1.5          SCALE FLUXES BELOW CLOUD BASE






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 6

(  283) !                  LINEAR DCREASE
(  284) !                  -----------------------------
(  285) 
(  286) !DIR$ IVDEP
(  287) !OCL NOVREC
(  288) DO JL=KIDIA,KFDIA
(  289)   IF(LDCUM(JL)) THEN
(  290)     IKB=KCBOT(JL)
(  291)     IK=IKB+1
(  292)     ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,IK))/(PAPH(JL,KLEV+1)-PAPH(JL,IKB)))
(  293)     IF(KTYPE(JL) == 3) ZZP=ZZP*ZZP
(  294)     PMFU(JL,IK)=PMFU(JL,IKB)*ZZP
(  295)     IF (LPHYLIN) THEN
(  296)       ZTARG=PTENH(JL,IKB)
(  297)       ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  298)       ZOELHM=ZOEALFA*RLVTT+(1.0_JPRB-ZOEALFA)*RLSTT
(  299)       PMFUS(JL,IK)=(PMFUS(JL,IKB)-ZOELHM*PMFUL(JL,IKB))*ZZP
(  300)     ELSE
(  301)       PMFUS(JL,IK)=(PMFUS(JL,IKB)-FOELHMCU(PTENH(JL,IKB))*PMFUL(JL,IKB))*ZZP
(  302)     ENDIF
(  303)     PMFUQ(JL,IK)=(PMFUQ(JL,IKB)+PMFUL(JL,IKB))*ZZP
(  304)     PMFUL(JL,IK)=0.0_JPRB
(  305)   ENDIF
(  306) ENDDO
(  307) DO JK=KTOPM2,KLEV
(  308) !DIR$ IVDEP
(  309) !OCL NOVREC
(  310)   DO JL=KIDIA,KFDIA
(  311)     IF(LDCUM(JL).AND.JK > KCBOT(JL)+1) THEN
(  312)       IKB=KCBOT(JL)+1
(  313)       ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,JK))/(PAPH(JL,KLEV+1)-PAPH(JL,IKB)))
(  314)       IF(KTYPE(JL) == 3) ZZP=ZZP*ZZP
(  315)       PMFU(JL,JK)=PMFU(JL,IKB)*ZZP
(  316)       PMFUS(JL,JK)=PMFUS(JL,IKB)*ZZP
(  317)       PMFUQ(JL,JK)=PMFUQ(JL,IKB)*ZZP
(  318)       PMFUL(JL,JK)=0.0_JPRB
(  319)     ENDIF
(  320)     IK=IDBAS(JL)
(  321)     LLDDRAF=LDDRAF(JL).AND.JK>IK.AND.IK<KLEV
(  322)     IF(LLDDRAF.AND.IK==KCBOT(JL)+1) THEN 
(  323)       ZZP=((PAPH(JL,KLEV+1)-PAPH(JL,JK))/(PAPH(JL,KLEV+1)-PAPH(JL,IK)))      
(  324)       IF(KTYPE(JL) == 3)  ZZP=ZZP*ZZP
(  325)       PMFD(JL,JK)=PMFD(JL,IK)*ZZP
(  326)       PMFDS(JL,JK)=PMFDS(JL,IK)*ZZP
(  327)       PMFDQ(JL,JK)=PMFDQ(JL,IK)*ZZP
(  328)       PMFDDE_RATE(JL,JK)=-(PMFD(JL,JK-1)-PMFD(JL,JK))
(  329)     ELSEIF(LLDDRAF.AND.IK/=KCBOT(JL)+1.AND.JK==IK+1) THEN
(  330)       PMFDDE_RATE(JL,JK)=-(PMFD(JL,JK-1)-PMFD(JL,JK))
(  331)     ENDIF
(  332)   ENDDO
(  333) ENDDO
(  334) 
(  335) !- rescale DD fluxes if total mass flux becomes negative
(  336) ZMFS(:)=1.0_JPRB
(  337) !DO JK=2,KLEV-1
(  338) DO JK=2,KLEV ! change for stability
(  339) !DIR$ LOOP_INFO EST_TRIPS(16)
(  340)   DO JL=KIDIA,KFDIA






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 7

(  341)     IF ( LDDRAF(JL) .AND. JK>=KDTOP(JL)-1 ) THEN
(  342)        ZMFMAX=ABS(PMFU(JL,JK))*0.98_JPRB
(  343)        IF(PMFD(JL,JK)+ZMFMAX+1.E-15_JPRB<0.0_JPRB) THEN
(  344)           ZMFS(JL)=MIN(ZMFS(JL),-ZMFMAX/PMFD(JL,JK))
(  345)        ENDIF
(  346)     ENDIF
(  347)   ENDDO
(  348) ENDDO
(  349) 
(  350) DO JK=2,KLEV
(  351) !DIR$ LOOP_INFO EST_TRIPS(16)
(  352)   DO JL=KIDIA,KFDIA
(  353)     IF ( ZMFS(JL)<1.0_JPRB .AND. JK>=KDTOP(JL)-1 ) THEN
(  354)       PMFD(JL,JK)=PMFD(JL,JK)*ZMFS(JL)
(  355)       PMFDS(JL,JK)=PMFDS(JL,JK)*ZMFS(JL)
(  356)       PMFDQ(JL,JK)=PMFDQ(JL,JK)*ZMFS(JL)
(  357)       PMFDDE_RATE(JL,JK)=PMFDDE_RATE(JL,JK)*ZMFS(JL)
(  358)       PDMFDP(JL,JK)=PDMFDP(JL,JK)*ZMFS(JL)
(  359)     ENDIF
(  360)   ENDDO
(  361) ENDDO
(  362) 
(  363) 
(  364) !*    2.            CALCULATE RAIN/SNOW FALL RATES
(  365) !*                  CALCULATE MELTING OF SNOW
(  366) !*                  CALCULATE EVAPORATION OF PRECIP
(  367) !                   -------------------------------
(  368) 
(  369) DO JK=KTOPM2,KLEV
(  370)   DO JL=KIDIA,KFDIA
(  371)     IF(LDCUM(JL).AND.JK >= KCTOP(JL)-1) THEN
(  372)       PRAIN(JL)=PRAIN(JL)+PDMFUP(JL,JK)
(  373)       ZTWETB=PTEN(JL,JK)-MAX(0.0_JPRB,PQSEN(JL,JK)-PQEN(JL,JK))*&
(  374)             &(ZTW1+ZTW2*(PAP(JL,JK)-ZTW3)-ZTW4*(PTEN(JL,JK)-ZTW5))
(  375)       ZTEN=ZTWETB*ZWETB+(1.0_JPRB-ZWETB)*PTEN(JL,JK)
(  376)       IF(PMFLXS(JL,JK) > 0.0_JPRB.AND.ZTEN > RTT) THEN
(  377)         ZCONS1=ZCONS1A*(1.0_JPRB+0.5_JPRB*(ZTEN-RTT))
(  378)         ZFAC=ZCONS1*(PAPH(JL,JK+1)-PAPH(JL,JK))
(  379)         ZSNMLT=MIN(PMFLXS(JL,JK),ZFAC*(ZTEN-RTT))
(  380)         PDPMEL(JL,JK)=ZSNMLT
(  381)         IF (LPHYLIN) THEN
(  382)           ZTARG=ZTEN-ZSNMLT/ZFAC
(  383)           ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  384)           ZFOEEWL=R2ES*EXP(R3LES*(ZTARG-RTT)/(ZTARG-R4LES))
(  385)           ZFOEEWI=R2ES*EXP(R3IES*(ZTARG-RTT)/(ZTARG-R4IES))
(  386)           ZOEEWM=ZOEALFA*ZFOEEWL + (1.0_JPRB-ZOEALFA)*ZFOEEWI
(  387)           PQSEN(JL,JK)=ZOEEWM/PAP(JL,JK)
(  388)         ELSE
(  389)           PQSEN(JL,JK)=FOEEWMCU(ZTEN-ZSNMLT/ZFAC)/PAP(JL,JK)
(  390)         ENDIF
(  391)       ENDIF
(  392)       IF (LPHYLIN) THEN
(  393)         ZALFAW=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTEN-RLPTRC))+1.0_JPRB))
(  394)       ELSE
(  395)         ZALFAW=FOEALFCU(ZTEN)
(  396)       ENDIF
(  397) !no liquid precipitation above melting level
(  398) !     add heat not yet liberated in updraught precip






NVFORTRAN (Version     24.5)          03/19/2025  06:56:04      page 8

(  399)       IF(PTEN(JL,JK) <= RTT .AND. ZALFAW > 0.0_JPRB) THEN
(  400)         PLGLAC(JL,JK)=PLGLAC(JL,JK)+ZGLAC*ZALFAW*PDMFUP(JL,JK)+ZALFAW*PDMFDP(JL,JK)
(  401)         ZALFAW=0.0_JPRB
(  402)       ENDIF
(  403)       IF(LMFDSNOW.AND.JK<=KCBOT(JL)) THEN
(  404)          PSNDE(JL,JK,2)=PLRAIN(JL,JK+1)*PMFUDE_RATE(JL,JK)
(  405)          PSNDE(JL,JK,1)=PSNDE(JL,JK,2)*ZALFAW
(  406)          PSNDE(JL,JK,2)=PSNDE(JL,JK,2)*(1.0_JPRB-ZALFAW)
(  407)          PSNDE(JL,JK,1)=MIN(PSNDE(JL,JK,1),ZALFAW*(PDMFUP(JL,JK)+PDMFDP(JL,JK)))
(  408)          PSNDE(JL,JK,2)=MIN(PSNDE(JL,JK,2),(1.0_JPRB-ZALFAW)*(PDMFUP(JL,JK)+PDMFDP(JL,JK))-PDPMEL(JL,JK))
(  409)         !PSNDE(JL,JK,1)=0.0_JPRB
(  410)          PSNDE(JL,JK,1)=MAX(PSNDE(JL,JK,1),0.0_JPRB)
(  411)          PSNDE(JL,JK,2)=MAX(PSNDE(JL,JK,2),0.0_JPRB)
(  412)       ENDIF
(  413)       PMFLXR(JL,JK+1)=PMFLXR(JL,JK)+ZALFAW*&
(  414)        & (PDMFUP(JL,JK)+PDMFDP(JL,JK))+PDPMEL(JL,JK)-PSNDE(JL,JK,1)
(  415)       PMFLXS(JL,JK+1)=PMFLXS(JL,JK)+(1.0_JPRB-ZALFAW)*&
(  416)        & (PDMFUP(JL,JK)+PDMFDP(JL,JK))-PDPMEL(JL,JK)-PSNDE(JL,JK,2)
(  417)       IF(PMFLXR(JL,JK+1)+PMFLXS(JL,JK+1) < 0.0_JPRB) THEN
(  418)         PDMFDP(JL,JK)=-(PMFLXR(JL,JK)+PMFLXS(JL,JK)+PDMFUP(JL,JK))
(  419)         PMFLXR(JL,JK+1)=0.0_JPRB
(  420)         PMFLXS(JL,JK+1)=0.0_JPRB
(  421)         PDPMEL(JL,JK)  =0.0_JPRB
(  422)       ELSEIF(PMFLXR(JL,JK+1) < 0.0_JPRB ) THEN
(  423)         PMFLXS(JL,JK+1)=PMFLXS(JL,JK+1)+PMFLXR(JL,JK+1)
(  424)         PMFLXR(JL,JK+1)=0.0_JPRB
(  425)       ELSEIF(PMFLXS(JL,JK+1) < 0.0_JPRB ) THEN
(  426)         PMFLXR(JL,JK+1)=PMFLXR(JL,JK+1)+PMFLXS(JL,JK+1)
(  427)         PMFLXS(JL,JK+1)=0.0_JPRB
(  428)       ENDIF
(  429)     ENDIF
(  430)   ENDDO
(  431) ENDDO
(  432) 
(  433) ! Increase area fraction for evaporation depending on average RH in cloud-layer 
(  434) IF (.NOT. LDTDKMF) THEN
(  435)   DO JL=KIDIA,KFDIA
(  436)    IF (KTYPE(JL)>=2) THEN
(  437)      IKB=KCBOT(JL)
(  438)      IK=KCTOP(JL)
(  439)      ZRHM=0.5*( PQEN(JL,IKB)/PQSEN(JL,IKB)+PQEN(JL,IK)/PQSEN(JL,IK) )
