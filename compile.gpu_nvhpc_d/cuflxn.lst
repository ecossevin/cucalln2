(  362) # 364 "./cuflxn.F90"
(  364) !*    2.            CALCULATE RAIN/SNOW FALL RATES
(  365) !*                  CALCULATE MELTING OF SNOW
(  366) !*                  CALCULATE EVAPORATION OF PRECIP
(  367) !                   -------------------------------
(  368) # 369 "./cuflxn.F90"
(  369) DO JK=KTOPM2,KLEV
(  370)   DO JL=KIDIA,KFDIA
(  371)     IF(LDCUM(JL).AND.JK >= KCTOP(JL)-1) THEN
(  372)       PRAIN(JL)=PRAIN(JL)+PDMFUP(JL,JK)
(  373)       ZTWETB=PTEN(JL,JK)-MAX(0.0_JPRB,PQSEN(JL,JK)-PQEN(JL,JK))*&
(  374)             &(ZTW1+ZTW2*(PAP(JL,JK)-ZTW3)-ZTW4*(PTEN(JL,JK)-ZTW5))
(  375)       ZTEN=ZTWETB*ZWETB+(1.0_JPRB-ZWETB)*PTEN(JL,JK)
(  376)       IF(PMFLXS(JL,JK) > 0.0_JPRB.AND.ZTEN > RTT) THEN
(  377)         ZCONS1=ZCONS1A*(1.0_JPRB+0.5_JPRB*(ZTEN-RTT))
(  378)         ZFAC=ZCONS1*(PAPH(JL,JK+1)-PAPH(JL,JK))
(  379)         ZSNMLT=MIN(PMFLXS(JL,JK),ZFAC*(ZTEN-RTT))
