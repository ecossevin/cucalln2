(   77) SUBROUTINE LOAD_TECLD (KLUN, YD)
(   78) USE PARKIND1, ONLY : JPRD
(   79) 
(   80) IMPLICIT NONE
(   81) INTEGER, INTENT (IN) :: KLUN
(   82) TYPE (TECLD), INTENT (OUT), TARGET :: YD
(   83) INTEGER :: IL1(1), IU1(1)
(   84) LOGICAL :: LCETA
(   85) REAL(KIND=JPRD) :: ZTMP0
(   86) REAL(KIND=JPRD), ALLOCATABLE :: ZTMP1 (:)
(   87) READ (KLUN) LCETA
(   88) IF (LCETA) THEN
(   89)   READ (KLUN) IL1
(   90)   READ (KLUN) IU1
(   91)   ALLOCATE (YD%CETA (IL1(1):IU1(1)))
(   92)   ALLOCATE (ZTMP1(LBOUND(YD%CETA,1):UBOUND(YD%CETA,1)))
(   93)   READ (KLUN) ZTMP1
(   94)   YD%CETA = ZTMP1
(   95)   DEALLOCATE (ZTMP1)
(   96) ENDIF
(   97) READ (KLUN) ZTMP0
(   98) YD%RANVA = ZTMP0
