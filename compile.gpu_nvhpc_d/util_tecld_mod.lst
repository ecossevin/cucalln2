(   37) SUBROUTINE SAVE_TECLD (KLUN, YD)
(   38) 
(   39) IMPLICIT NONE
(   40) INTEGER, INTENT (IN) :: KLUN
(   41) TYPE (TECLD), INTENT (IN), TARGET :: YD
(   42) LOGICAL :: LCETA
(   43) LCETA = ALLOCATED (YD%CETA)
(   44) WRITE (KLUN) LCETA
(   45) IF (LCETA) THEN
(   46)   WRITE (KLUN) LBOUND (YD%CETA)
(   47)   WRITE (KLUN) UBOUND (YD%CETA)
(   48)   WRITE (KLUN) YD%CETA
(   49) ENDIF
