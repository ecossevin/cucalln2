(  261) SUBROUTINE DD12_INIT (SELF, KDIMS1, KDIMS2, KBLOCKLIST)
(  262) 
(  263) CLASS (DD12) :: SELF
(  264) INTEGER, INTENT (IN) :: KDIMS1 (2) 
(  265) INTEGER, INTENT (IN) :: KDIMS2 (2) 
(  266) INTEGER, INTENT (IN), OPTIONAL, TARGET :: KBLOCKLIST (:)
(  267) 
(  268) INTEGER :: JBLK1, JBLK2
(  269) INTEGER :: JLON1, JLON2
(  270) INTEGER :: JGLO1, JGLO2
(  271) 
(  272) SELF%IPROMA1 = KDIMS1 (1); SELF%IGPBLKS1 = KDIMS1 (2)
(  273) SELF%IPROMA2 = KDIMS2 (1); SELF%IGPBLKS2 = KDIMS2 (2)
(  274) 
(  275) SELF%IGPTOT1 = SELF%IPROMA1 * SELF%IGPBLKS1
(  276) SELF%IGPTOT2 = SELF%IPROMA2 * SELF%IGPBLKS2
(  277) 
(  278) ALLOCATE (SELF%JLON1 (SELF%IPROMA2, SELF%IGPBLKS2))
(  279) ALLOCATE (SELF%JBLK1 (SELF%IPROMA2, SELF%IGPBLKS2))
(  280) 
(  281) DO JBLK2 = 1, SELF%IGPBLKS2
(  282)   DO JLON2 = 1, SELF%IPROMA2






NVFORTRAN (Version     24.5)          03/19/2025  06:54:53      page 6

(  283)     JGLO2 = (JBLK2 - 1) * SELF%IPROMA2 + JLON2
(  284)     JGLO1 = 1 + MODULO (JGLO2-1, SELF%IGPTOT1)
(  285)     JBLK1 = (JGLO1+SELF%IPROMA1-1) / SELF%IPROMA1
(  286)     JLON1 = 1 + MODULO (JGLO1-1, SELF%IPROMA1)
(  287)     SELF%JLON1 (JLON2, JBLK2) = JLON1
(  288) 
(  289)     IF (PRESENT (KBLOCKLIST)) THEN
(  290)       JBLK1 = 1 + MODULO (JBLK1-1, SIZE (KBLOCKLIST))
(  291)       JBLK1 = KBLOCKLIST (JBLK1)
(  292)     ENDIF
(  293) 
(  294)     SELF%JBLK1 (JLON2, JBLK2) = JBLK1
(  295)   ENDDO
(  296) ENDDO
(  297) 
(  298) END SUBROUTINE
