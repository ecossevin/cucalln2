(  428)               !Apply SPP perturbations or RP perturbation
(  429)               PTENU(JL, JK) = PTENU(JL, JK)*(1.0_JPRB - YDECUMF%RMFSOLRHS) + ZRDU*(ZR1(JL, JK) - PUEN(JL, JK))*ZTSPHY
(  430)               PTENV(JL, JK) = PTENV(JL, JK)*(1.0_JPRB - YDECUMF%RMFSOLRHS) + ZRDV*(ZR2(JL, JK) - PVEN(JL, JK))*ZTSPHY
(  431)             ELSE
