(    6)     !**** *CUDUDV* - UPDATES U AND V TENDENCIES,
(    7)     !                DOES GLOBAL DIAGNOSTIC OF DISSIPATION
(    8)     
(    9)     !**   INTERFACE.
(   10)     !     ----------
(   11)     
(   12)     !          *CUDUDV* IS CALLED FROM *CUMASTR*
(   13)     
(   14)     !     PARAMETER     DESCRIPTION                                   UNITS
(   15)     !     ---------     -----------                                   -----
(   16)     !     INPUT PARAMETERS (INTEGER):
(   17)     
(   18)     !    *KIDIA*        START POINT
(   19)     !    *KFDIA*        END POINT
(   20)     !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   21)     !    *KLEV*         NUMBER OF LEVELS
(   22)     !    *KTYPE*        TYPE OF CONVECTION
(   23)     !                       1 = PENETRATIVE CONVECTION
(   24)     !                       2 = SHALLOW CONVECTION
(   25)     !                       3 = MIDLEVEL CONVECTION
(   26)     !    *KCBOT*        CLOUD BASE LEVEL
(   27)     !    *KCTOP*        CLOUD TOP LEVEL
(   28)     
(   29)     !    INPUT PARAMETERS (LOGICAL):
(   30)     
(   31)     !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   32)     
(   33)     !    INPUT PARAMETERS (REAL):
(   34)     
(   35)     !    *PTSPHY*       TIME STEP FOR THE PHYSICS                      S
(   36)     !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS            PA
(   37)     !    *PAP *         PROVISIONAL PRESSURE ON FULL LEVELS            PA
(   38)     !    *PUEN*         PROVISIONAL ENVIRONMENT U-VELOCITY (T+1)       M/S
(   39)     !    *PVEN*         PROVISIONAL ENVIRONMENT V-VELOCITY (T+1)       M/S
(   40)     !    *PMFU*         MASSFLUX UPDRAFTS                             KG/(M2*S)
(   41)     !    *PMFD*         MASSFLUX DOWNDRAFTS                           KG/(M2*S)
(   42)     !    *PUU*          U-VELOCITY IN UPDRAFTS                         M/S
(   43)     !    *PUD*          U-VELOCITY IN DOWNDRAFTS                       M/S
(   44)     !    *PVU*          V-VELOCITY IN UPDRAFTS                         M/S
(   45)     !    *PVD*          V-VELOCITY IN DOWNDRAFTS                       M/S
(   46)     !    *PGP2DSPP*     Standard stochastic variable (mean=0, SD=1)
(   47)     
(   48)     !    UPDATED PARAMETERS (REAL):
(   49)     
(   50)     !    *PTENU*        TENDENCY OF U-COMP. OF WIND                    M/S2
(   51)     !    *PTENV*        TENDENCY OF V-COMP. OF WIND                    M/S2
(   52)     
(   53)     !            METHOD
(   54)     !            -------
(   55)     !       EXPLICIT UPSTREAM AND IMPLICIT SOLUTION OF VERTICAL ADVECTION
(   56)     !       DEPENDING ON VALUE OF RMFSOLUV:
(   57)     !       0=EXPLICIT 0-1 SEMI-IMPLICIT >=1 IMPLICIT






