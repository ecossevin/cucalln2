(  167)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  168)     IP_ZADVW = YLSTACK_L
(  169)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  170)     IP_ZDUDT = YLSTACK_L
(  171)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  172)     IP_ZDVDT = YLSTACK_L
(  173)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  174)     IP_ZDP = YLSTACK_L
(  175)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  176)     IP_ZB = YLSTACK_L
(  177)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  178)     IP_ZR1 = YLSTACK_L
(  179)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  180)     IP_ZR2 = YLSTACK_L
(  181)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(REAL(1, kind=JPRB)) + 7, -3), 3)
(  182)     IP_LLCUMBAS = YLSTACK_L
(  183)     YLSTACK_L = YLSTACK_L + ISHFT(ISHFT(KLON*KLEV*C_SIZEOF(LOGICAL(.true.)) + 7, -3), 3)
(  184) !$acc data present( KTYPE, KCBOT, KCTOP, LDCUM, PAPH, PAP, PUEN, PVEN, PMFU, PMFD, PMFUO, PMFDO, PUU, PUD, PVU, PVD, PGP2DSP
(  185) !$acc & PTENU, PTENV, YDCST, YDECUMF, YDSPP_CONFIG, YDPERTPAR )
(  186)     !----------------------------------------------------------------------
(  187)     
(  188)     ZIMP = 1.0_JPRB - YDECUMF%RMFSOLUV
(  189)     ZTSPHY = 1.0_JPRB / PTSPHY
(  190)     
(  191)     LLPPAR_CUDUV = .false.
(  192)     LLPERT_CUDUDV = .false.
(  193)     LLPERT_CUDUDVS = .false.
(  194)     
(  195)     
(  196) !$acc loop vector
(  197)     DO JL=KIDIA,KFDIA
(  198)       ZADVW(JL) = 0.0_JPRB
(  199)       IF (KTYPE(JL) == 1) ZADVW(JL) = YDECUMF%RMFADVW
(  200)       
(  201)       
(  202) !$acc loop seq
(  203)       DO JK=1,KLEV
(  204)         IF (LDCUM(JL)) THEN
(  205)           ZDP(JL, JK) = YDCST%RG / (PAPH(JL, JK + 1) - PAPH(JL, JK))
(  206)         END IF
(  207)       END DO
(  208)       
(  209)       !----------------------------------------------------------------------
(  210)       
(  211)       
(  212)       !*    1.0          CALCULATE FLUXES AND UPDATE U AND V TENDENCIES
(  213)       !                  ----------------------------------------------
(  214)       
(  215) !$acc loop seq
(  216)       DO JK=KTOPM2,KLEV
(  217)         IK = JK - 1
(  218)         IF (LDCUM(JL)) THEN
(  219)           ZMFUU(JL, JK) = PMFU(JL, JK)*(PUU(JL, JK) - ZIMP*PUEN(JL, IK))
(  220)           ZMFUV(JL, JK) = PMFU(JL, JK)*(PVU(JL, JK) - ZIMP*PVEN(JL, IK))
(  221)           ZMFDU(JL, JK) = PMFD(JL, JK)*(PUD(JL, JK) - ZIMP*PUEN(JL, IK))
(  222)           ZMFDV(JL, JK) = PMFD(JL, JK)*(PVD(JL, JK) - ZIMP*PVEN(JL, IK))
(  223)         END IF
(  224)       END DO






NVFORTRAN (Version     24.5)          03/24/2025  13:20:15      page 5

(  225)       
(  226)       ! linear fluxes below cloud
(  227)       IF (YDECUMF%RMFSOLUV == 0.0_JPRB) THEN
(  228) !$acc loop seq
(  229)         DO JK=KTOPM2,KLEV
(  230)           !DIR$ IVDEP
(  231)           !OCL NOVREC
(  232)           IF (LDCUM(JL) .and. JK > KCBOT(JL)) THEN
(  233)             IKB = KCBOT(JL)
(  234)             ZZP = ((PAPH(JL, KLEV + 1) - PAPH(JL, JK)) / (PAPH(JL, KLEV + 1) - PAPH(JL, IKB)))
(  235)             IF (KTYPE(JL) == 3) THEN
(  236)               ZZP = ZZP*ZZP
(  237)             END IF
(  238)             ZMFUU(JL, JK) = ZMFUU(JL, IKB)*ZZP
(  239)             ZMFUV(JL, JK) = ZMFUV(JL, IKB)*ZZP
(  240)             ZMFDU(JL, JK) = ZMFDU(JL, IKB)*ZZP
(  241)             ZMFDV(JL, JK) = ZMFDV(JL, IKB)*ZZP
(  242)           END IF
(  243)         END DO
(  244)       END IF
(  245)       
(  246)       !*    1.2          COMPUTE TENDENCIES
(  247)       !                  ------------------
(  248)       
(  249) !$acc loop seq
(  250)       DO JK=KTOPM2,KLEV
(  251)         
(  252)         IF (JK < KLEV) THEN
(  253)           IK = JK + 1
(  254)           IF (LDCUM(JL)) THEN
(  255)             ZDUDT(JL, JK) = ZDP(JL, JK)*(ZMFUU(JL, IK) - ZMFUU(JL, JK) + ZMFDU(JL, IK) - ZMFDU(JL, JK))
(  256)             ZDVDT(JL, JK) = ZDP(JL, JK)*(ZMFUV(JL, IK) - ZMFUV(JL, JK) + ZMFDV(JL, IK) - ZMFDV(JL, JK))
(  257)           END IF
(  258)           
(  259)         ELSE
(  260)           IF (LDCUM(JL)) THEN
(  261)             ZDUDT(JL, JK) = -ZDP(JL, JK)*(ZMFUU(JL, JK) + ZMFDU(JL, JK))
(  262)             ZDVDT(JL, JK) = -ZDP(JL, JK)*(ZMFUV(JL, JK) + ZMFDV(JL, JK))
(  263)           END IF
(  264)         END IF
(  265)         
(  266)       END DO
(  267)     END DO
(  268)     
(  269)     
(  270)     IF (YDECUMF%RMFSOLUV == 0.0_JPRB) THEN
(  271)       
(  272)       !*    1.3          UPDATE TENDENCIES
(  273)       !                  -----------------
(  274)       
(  275)       
(  276) !$acc loop vector
(  277)       DO JL=KIDIA,KFDIA
(  278) !$acc loop seq
(  279)         DO JK=KTOPM2,KLEV
(  280)           IF (LDCUM(JL)) THEN
(  281)             PTENU(JL, JK) = PTENU(JL, JK) + ZDUDT(JL, JK)
(  282)             PTENV(JL, JK) = PTENV(JL, JK) + ZDVDT(JL, JK)






NVFORTRAN (Version     24.5)          03/24/2025  13:20:15      page 6

(  283)           END IF
(  284)         END DO
(  285)       END DO
(  286)       
(  287)       
(  288)     ELSE
(  289)       !----------------------------------------------------------------------
(  290)       
(  291)       !*      1.6          IMPLICIT SOLUTION
(  292)       !                    -----------------
(  293)       
(  294)       ! Fill bi-diagonal Matrix vectors A=k-1, B=k;
(  295)       ! reuse ZMFUU=A and ZB=B;
(  296)       ! ZDUDT and ZDVDT correspond to the RHS ("constants") of the equation
(  297)       ! The solution is in ZR1 and ZR2
(  298)       
(  299)       LLCUMBAS(:, :) = .false.
(  300)       ZB(:, :) = 1.0_JPRB
(  301)       ZMFUU(:, :) = 0.0_JPRB
(  302)       
(  303)       ! Fill vectors A, B and RHS
(  304)       
(  305)       
(  306) !$acc loop vector
(  307)       DO JL=KIDIA,KFDIA
(  308) !$acc loop seq
(  309)         DO JK=KTOPM2,KLEV
(  310)           IK = JK + 1
(  311)           IM = JK - 1
(  312)           LLCUMBAS(JL, JK) = LDCUM(JL) .and. JK >= KCTOP(JL) - 1
(  313)           IF (LLCUMBAS(JL, JK)) THEN
(  314)             ZZP = YDECUMF%RMFSOLUV*ZDP(JL, JK)*PTSPHY
(  315)             ZMFUU(JL, JK) = -ZZP*(PMFU(JL, JK) + PMFD(JL, JK))
(  316)             IF (JK < KLEV) THEN
(  317)               ZB(JL, JK) = 1.0_JPRB + ZZP*(PMFU(JL, IK) + PMFD(JL, IK))
(  318)             ELSE
(  319)               ZB(JL, JK) = 1.0_JPRB
(  320)             END IF
(  321)             ZZP = YDCST%RG*(PMFUO(JL, JK) + YDECUMF%RMFADVWDD*PMFDO(JL, JK)) / (PAP(JL, JK) - PAP(JL, IM))*PTSPHY*ZADVW(JL)
(  322)             ZU = ZZP*(PUEN(JL, IM) - PUEN(JL, JK))
(  323)             ZV = ZZP*(PVEN(JL, IM) - PVEN(JL, JK))
(  324)             ZDUDT(JL, JK) = (ZDUDT(JL, JK) + PTENU(JL, JK)*YDECUMF%RMFSOLRHS)*PTSPHY + PUEN(JL, JK) - ZU
(  325)             ZDVDT(JL, JK) = (ZDVDT(JL, JK) + PTENV(JL, JK)*YDECUMF%RMFSOLRHS)*PTSPHY + PVEN(JL, JK) - ZV
(  326)           END IF
(  327)         END DO
(  328)       END DO
(  329)       
(  330)       
(  331)       CALL CUBIDIAG_LOKI(KIDIA, KFDIA, KLON, KLEV, KCTOP, LLCUMBAS, ZMFUU, ZB, ZDUDT, ZR1, YDSTACK_L=YLSTACK_L)
(  332)       
(  333)       CALL CUBIDIAG_LOKI(KIDIA, KFDIA, KLON, KLEV, KCTOP, LLCUMBAS, ZMFUU, ZB, ZDVDT, ZR2, YDSTACK_L=YLSTACK_L)
(  334)       ! prepare RP perturbations (MF PEARP)
(  335)       LLPPAR_CUDUV = YDPERTPAR%LPERTPAR .and. YDPERTPAR%LPERT_CUDUV
(  336)       ! prepare SPP perturbations
(  337)       IF (YDSPP_CONFIG%LSPP) THEN
(  338)         IPN1 = YDSPP_CONFIG%PPTR%CUDUDV
(  339)         LLPERT_CUDUDV = IPN1 > 0
(  340)         IF (LLPERT_CUDUDV) THEN






NVFORTRAN (Version     24.5)          03/24/2025  13:20:15      page 7

(  341)           PN1 = YDSPP_CONFIG%SM%PN(IPN1)
(  342)           IPCUDU = PN1%MP
(  343)           IF (PN1%NRF == 1) THEN
(  344)             IPCUDV = IPCUDU
(  345)           ELSE
(  346)             IPCUDV = IPCUDU + 1
(  347)           END IF
(  348)         END IF
(  349)         IPN2 = YDSPP_CONFIG%PPTR%CUDUDVS
(  350)         LLPERT_CUDUDVS = IPN2 > 0
(  351)         IF (LLPERT_CUDUDVS) THEN
(  352)           PN2 = YDSPP_CONFIG%SM%PN(IPN2)
(  353)           IPCUDUS = PN2%MP
(  354)           IF (PN2%NRF == 1) THEN
(  355)             IPCUDVS = IPCUDUS
(  356)           ELSE
(  357)             IPCUDVS = IPCUDUS + 1
(  358)           END IF
(  359)         END IF
(  360)       ELSE
(  361)         LLPERT_CUDUDV = .false.
(  362)         LLPERT_CUDUDVS = .false.
(  363)       END IF
(  364)       
(  365)       
(  366) !$acc loop vector
(  367)       DO JL=KIDIA,KFDIA
(  368)         IF (LLPERT_CUDUDV .or. LLPERT_CUDUDVS .or. LLPPAR_CUDUV) THEN
(  369)           ZMDU = 1.0_JPRB            ! mean      zonal momentum transport pdf
(  370)           ZMDV = 1.0_JPRB            ! mean meridional momentum transport pdf
(  371)           ZLIMN2 = 9.0_JPRB*PN1%SDEV**2            ! limit for norm squared (3 stdev)
(  372)           
(  373)           IF (KTYPE(JL) == 1 .and. (LLPERT_CUDUDV .or. LLPPAR_CUDUV) .or. KTYPE(JL) == 2 .and. (LLPERT_CUDUDVS .or. LLPPAR_C
(  374)           & ) THEN
(  375)             !perturb deep/shallow convection
(  376)             
(  377)             IF (KTYPE(JL) == 1) THEN
(  378)               IF (.not.LLPPAR_CUDUV) THEN
(  379)                 ZXU = PGP2DSPP(JL, IPCUDU)
(  380)                 ZXV = PGP2DSPP(JL, IPCUDV)
(  381)                 ZXU_MAG = PN1%XMAG(1)
(  382)                 ZXV_MAG = PN1%XMAG(2)
(  383)               ELSE
(  384)                 ZXU = YDPERTPAR%CUDU_MOD
(  385)                 ZXV = YDPERTPAR%CUDV_MOD
(  386)               END IF
(  387)             END IF
(  388)             
(  389)             IF (KTYPE(JL) == 2) THEN
(  390)               IF (.not.LLPPAR_CUDUV) THEN
(  391)                 ZXU = PGP2DSPP(JL, IPCUDUS)
(  392)                 ZXV = PGP2DSPP(JL, IPCUDVS)
(  393)                 ZXU_MAG = PN2%XMAG(1)
(  394)                 ZXV_MAG = PN2%XMAG(2)
(  395)               ELSE
(  396)                 ZXU = YDPERTPAR%CUDU_MOD
(  397)                 ZXV = YDPERTPAR%CUDV_MOD
(  398)               END IF






NVFORTRAN (Version     24.5)          03/24/2025  13:20:15      page 8

(  399)             END IF
(  400)             
(  401)             ZN2 = ZXU**2 + ZXV**2
(  402)             IF (ZN2 > ZLIMN2) THEN
(  403)               ZFAC = SQRT(ZLIMN2 / ZN2)
(  404)               ZXU = ZFAC*ZXU
(  405)               ZXV = ZFAC*ZXV
(  406)             END IF
(  407)             IF (.not.LLPPAR_CUDUV) THEN
(  408)               ZRDU = ZMDU + ZXU_MAG*ZXU
(  409)               ZRDV = ZMDV + ZXV_MAG*ZXV
(  410)             ELSE
(  411)               ZRDU = ZMDU + ZXU
(  412)               ZRDV = ZMDV + ZXV
(  413)             END IF
(  414)           ELSE
(  415)             !other convection - unperturbed
(  416)             ZRDU = ZMDU
(  417)             ZRDV = ZMDV
(  418)           END IF
(  419)         END IF
(  420)         
(  421)         
(  422)         ! Compute tendencies
