(   51)     !    *PTENV*        TENDENCY OF V-COMP. OF WIND                    M/S2
(   52)     
(   53)     !            METHOD
(   54)     !            -------
(   55)     !       EXPLICIT UPSTREAM AND IMPLICIT SOLUTION OF VERTICAL ADVECTION
(   56)     !       DEPENDING ON VALUE OF RMFSOLUV:
(   57)     !       0=EXPLICIT 0-1 SEMI-IMPLICIT >=1 IMPLICIT
(   58)     
(   59)     !       FOR EXPLICIT SOLUTION: ONLY ONE SINGLE ITERATION
(   60)     !       FOR IMPLICIT SOLUTION: FIRST IMPLICIT SOLVER, THEN EXPLICIT SOLVER
(   61)     !                              TO CORRECT TENDENCIES BELOW CLOUD BASE
(   62)     
(   63)     !            EXTERNALS
(   64)     !            ---------
(   65)     !            CUBIDIAG
(   66)     
(   67)     !     AUTHOR.
(   68)     !     -------
(   69)     !      M.TIEDTKE         E.C.M.W.F.     7/86 MODIF. 12/89
(   70)     
