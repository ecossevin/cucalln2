(   85) REAL(KIND=JPRB) :: ZALFA, ZFOEEWL, ZFOEEWI
(   86) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(   87) # 88 "./satur.F90"
(   88) !DIR$ VFUNCTION EXPHF
(   89) # 90 "./satur.F90"
(   90) # 1 "./fcttre.func.h"
(    1) ! (C) Copyright 1988- ECMWF.
