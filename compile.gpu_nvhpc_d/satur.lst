(    9) 
(   10) SUBROUTINE SATUR ( YDTHF, YDCST, KIDIA , KFDIA , KLON  , KTDIA , KLEV, LDPHYLIN, &
(   11)  & PAPRSF, PT    , PQSAT , KFLAG)
(   12) 
(   13) !***
(   14) 
(   15) ! **   *SATUR* -  COMPUTES SPECIFIC HUMIDITY AT SATURATION
(   16) 
(   17) !       J.F. MAHFOUF       E.C.M.W.F.     15/05/96
(   18) 
(   19) !       Modified J. HAGUE          13/01/03 MASS Vector Functions
(   20) 
(   21) !       PURPOSE.
(   22) !       --------
(   23) 
(   24) !       SPECIFIC HUMIDITY AT SATURATION IS USED BY THE
(   25) !       DIAGNOSTIC CLOUD SCHEME TO COMPUTE RELATIVE HUMIDITY
(   26) !       AND LIQUID WATER CONTENT
(   27) 
(   28) !       INTERFACE
(   29) !       ---------
(   30) 
(   31) !       THIS ROUTINE IS CALLED FROM *CALLPAR*.
(   32) 
(   33) !       PARAMETER     DESCRIPTION                                 UNITS
(   34) !       ---------     -----------                                 -----
(   35) !       INPUT PARAMETERS (INTEGER):
(   36) 
(   37) !      *KIDIA*        START POINT
(   38) !      *KFDIA*        END POINT
(   39) !      *KLON*         NUMBER OF GRID POINTS PER PACKET
(   40) !      *KTDIA*        START OF THE VERTICAL LOOP
(   41) !      *KLEV*         NUMBER OF LEVELS
(   42) 
(   43) !       INPUT PARAMETERS (REAL):
(   44) 
(   45) !      *PAPRSF*        PRESSURE ON FULL LEVELS                      PA
(   46) !      *PT*            TEMPERATURE AT T-DT                          K
(   47) 
(   48) !       INPUT PARAMETERS (INTEGER):
(   49) 
(   50) !      *KFLAG*         FLAG TO DETECT CALL FROM






NVFORTRAN (Version     24.5)          03/19/2025  06:56:07      page 2

(   51) 
(   52) !                      CONVECTION  KFLAG=1
(   53) !                      OTHER       KFLAG=2
(   54) 
(   55) !       OUTPUT PARAMETER (REAL):
(   56) 
(   57) !      *PQSAT*         SATURATION SPECIFIC HUMIDITY                 KG/KG
(   58) 
(   59) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   60) !-------------------------------------------------------------------------
(   61) 
(   62) USE PARKIND1  ,ONLY : JPIM     ,JPRB
(   63) USE YOMHOOK   ,ONLY : LHOOK,   DR_HOOK, JPHOOK
(   64) 
(   65) USE YOMCST   , ONLY : TCST
(   66) USE YOETHF   , ONLY : TTHF  
(   67) 
(   68) IMPLICIT NONE
(   69) 
(   70) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(   71) TYPE(TCST)        ,INTENT(IN)    :: YDCST
(   72) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(   73) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(   74) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(   75) INTEGER(KIND=JPIM),INTENT(IN)    :: KTDIA 
(   76) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(   77) LOGICAL           ,INTENT(IN)    :: LDPHYLIN
(   78) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAPRSF(KLON,KLEV)
(   79) REAL(KIND=JPRB)   ,INTENT(IN)    :: PT(KLON,KLEV)
(   80) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PQSAT(KLON,KLEV)
(   81) INTEGER(KIND=JPIM),INTENT(IN)    :: KFLAG
(   82) INTEGER(KIND=JPIM) :: JK, JL
(   83) 
(   84) REAL(KIND=JPRB) :: ZCOR, ZEW, ZFOEEW, ZQMAX, ZQS, ZTARG
(   85) REAL(KIND=JPRB) :: ZALFA, ZFOEEWL, ZFOEEWI
(   86) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(   87) 
(   88) !DIR$ VFUNCTION EXPHF
(   89) 
(   90) #include "fcttre.func.h"
(   91) 
(   92) !----------------------------------------------------------------------
(   93) 
(   94) !*    1.           DEFINE CONSTANTS
(   95) !                  ----------------
(   96) 
(   97) IF (LHOOK) CALL DR_HOOK('SATUR',0,ZHOOK_HANDLE)
(   98) ASSOCIATE(RETV=>YDCST%RETV, RTT=>YDCST%RTT, &
(   99)  & R2ES=>YDTHF%R2ES, R3IES=>YDTHF%R3IES, R3LES=>YDTHF%R3LES, R4IES=>YDTHF%R4IES, &
(  100)  & R4LES=>YDTHF%R4LES)
(  101) 
(  102) ZQMAX=0.5_JPRB
(  103) 
(  104) !     *
(  105) !----------------------------------------------------------------------
(  106) 
(  107) !     *    2.           CALCULATE SATURATION SPECIFIC HUMIDITY
(  108) !                       --------------------------------------






NVFORTRAN (Version     24.5)          03/19/2025  06:56:07      page 3

(  109) 
(  110) IF (LDPHYLIN) THEN
(  111)   DO JK=KTDIA,KLEV
(  112)     DO JL=KIDIA, KFDIA
(  113)       ZTARG = PT(JL,JK)
(  114)       ZALFA = FOEALFA(ZTARG)
(  115) 
(  116)       ZFOEEWL = R2ES*EXP(R3LES*(ZTARG-RTT)/(ZTARG-R4LES))
(  117)       ZFOEEWI = R2ES*EXP(R3IES*(ZTARG-RTT)/(ZTARG-R4IES))
(  118)       ZFOEEW = ZALFA*ZFOEEWL+(1.0_JPRB-ZALFA)*ZFOEEWI
(  119) 
(  120)       ZQS    = ZFOEEW/PAPRSF(JL,JK)
(  121)       IF (ZQS > ZQMAX) THEN
(  122)         ZQS=ZQMAX
(  123)       ENDIF
(  124)       ZCOR = 1.0_JPRB/(1.0_JPRB-RETV*ZQS)
(  125)       PQSAT(JL,JK)=ZQS*ZCOR
(  126)     ENDDO
(  127)   ENDDO
(  128) ELSE
(  129) 
(  130)   DO JK=KTDIA,KLEV
(  131)     DO JL=KIDIA, KFDIA
(  132)       IF(KFLAG == 1) THEN
(  133)         ZEW  = FOEEWMCU(PT(JL,JK))
(  134)       ELSE
(  135)         ZEW  = FOEEWM(PT(JL,JK))
(  136)       ENDIF
(  137)       ZQS  = ZEW/PAPRSF(JL,JK)
(  138)       ZQS  = MIN(ZQMAX,ZQS)
(  139)       ZCOR = 1.0_JPRB/(1.0_JPRB-RETV*ZQS)
(  140)       PQSAT(JL,JK)=ZQS*ZCOR
(  141)     ENDDO
(  142)   ENDDO
(  143) 
(  144) ENDIF
(  145) 
(  146) END ASSOCIATE
(  147) IF (LHOOK) CALL DR_HOOK('SATUR',1,ZHOOK_HANDLE)
(  148) END SUBROUTINE SATUR
























