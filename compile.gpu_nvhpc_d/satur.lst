(   58) # 59 "./satur.F90"
(   59) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   60) !-------------------------------------------------------------------------
(   61) # 62 "./satur.F90"
(   62) USE PARKIND1  ,ONLY : JPIM     ,JPRB
(   63) USE YOMHOOK   ,ONLY : LHOOK,   DR_HOOK, JPHOOK
(   64) # 65 "./satur.F90"
(   65) USE YOMCST   , ONLY : TCST
(   66) USE YOETHF   , ONLY : TTHF  
(   67) # 68 "./satur.F90"
(   68) IMPLICIT NONE
(   69) # 70 "./satur.F90"
(   70) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(   71) TYPE(TCST)        ,INTENT(IN)    :: YDCST
(   72) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(   73) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(   74) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(   75) INTEGER(KIND=JPIM),INTENT(IN)    :: KTDIA 
(   76) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(   77) LOGICAL           ,INTENT(IN)    :: LDPHYLIN
(   78) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAPRSF(KLON,KLEV)
(   79) REAL(KIND=JPRB)   ,INTENT(IN)    :: PT(KLON,KLEV)
(   80) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PQSAT(KLON,KLEV)
(   81) INTEGER(KIND=JPIM),INTENT(IN)    :: KFLAG
(   82) INTEGER(KIND=JPIM) :: JK, JL
(   83) # 84 "./satur.F90"
