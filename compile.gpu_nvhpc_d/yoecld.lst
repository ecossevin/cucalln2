(   62) !  NAME     TYPE     PURPOSE
(   63) !  ----  :  ----   : ---------------------------------------------------
(   64) !  RANVA :  REAL     COEFFICIENT FOR ANVIL CLOUDS
(   65) !  RANVB :  REAL     COEFFICIENT FOR ANVIL CLOUDS
(   66) !  RANVH :  REAL     MINIMUM HIGH CLOUD COVER FOR ANVIL CLOUDS
(   67) !  RCCA  :  REAL     COEFFICIENT FOR DIAGNOSTIC OF CONVECTIVE CLOUD
(   68) !  RCCB  :  REAL     COEFFICIENT FOR DIAGNOSTIC OF CONVECTIVE CLOUD
(   69) !  RCCC  :  REAL     MAXIMUM COVER BY CONVECTIVE CLOUD
(   70) !  RCFCT :  REAL     WEIGHTING FACTOR FOR CONVECTIVE CLOUD TOWER
(   71) !  RCLWMR:  REAL     LIQUID WATER MIXING RATIO FOR CONVECTIVE CLOUD
(   72) !  RCSCAL:  REAL     SCALING FACTOR FOR CONVECTIVE RAIN
(   73) !  CETA(NFLEVG) REAL  MODEL REFERENCE ETA-LEVEL
(   74) !  RDECORR_CF:  REAL  DECORR. DEPTH FOR GENERALISED CLOUD OVERLAP (CLOUD FRAC)
(   75) !  RDECORR_CW:  REAL  DECORR. DEPTH FOR GENERALISED CLOUD OVERLAP (CONDENSATE)
(   76) !  RETAHB:  REAL     ETA-LEVEL LIMIT FOR HIGH CLOUDS
(   77) !  RETAMB:  REAL     ETA-LEVEL LIMIT FOR MEDIUM CLOUDS
(   78) !  RLOIA :  REAL     COEFFICIENT FOR LOW CLOUD WHEN NO INVERSION
(   79) !  RLOIB :  REAL     COEFFICIENT FOR LOW CLOUD WHEN INVERSION
(   80) !  RLOIC :  REAL     COEFFICIENT FOR LOW CLOUD WHEN INVERSION
(   81) !  RLOID :  REAL     COEFFICIENT FOR LOW CLOUD WHEN INVERSION
(   82) !  RLONIA:  REAL     COEFFICIENT FOR LOW CLOUD WHEN INVERSION
(   83) !  RLONIB:  REAL     COEFFICIENT FOR LOW CLOUD WHEN NO INVERSION
(   84) !  RRHH  :  REAL     CRITICAL RELATIVE HUMIDITY FOR HIGH CLOUDS
(   85) !  RRHL  :  REAL     CRITICAL RELATIVE HUMIDITY FOR LOW CLOUDS
(   86) !  GAMMAS:  REAL     PROPORTIONALITY FACTOR FOR LIQUID WATER CONTENT
(   87) !  REPSCR:  REAL     MINIMUM CONVECTIVE PRECIPITATION (SECURITY FACTOR)
(   88) !  REPSEC:  REAL     MINIMUM HORIZONTAL CLOUD COVER (SECURITY FACTOR)
(   89) !  LOMEGA:  LOGICAL  SWITCH FOR OMEGA-FILTER ON MIDDLE CLOUD
(   90) !     ------------------------------------------------------------------
(   91) 
(   92) CONTAINS
(   93) 
