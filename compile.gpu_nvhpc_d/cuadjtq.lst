(   10) SUBROUTINE CUADJTQ &
(   11)  & (YDTHF, YDCST, YDEPHLI,KIDIA,    KFDIA,    KLON,    KLEV,     KK,&
(   12)  &  PSP,      PT,       PQ,      LDFLAG,   KCALL,   LDOFLAG)  
(   13) # 14 "./cuadjtq.F90"
(   14) !          PURPOSE.
(   15) !          --------
(   16) !          TO PRODUCE T,Q AND L VALUES FOR CLOUD ASCENT
(   17) # 18 "./cuadjtq.F90"
(   18) !          INTERFACE
(   19) !          ---------
(   20) !          THIS ROUTINE IS CALLED FROM SUBROUTINES:
(   21) !              *COND*     (T AND Q AT CONDENSATION LEVEL)
(   22) !              *CUBASE*   (T AND Q AT CONDENSATION LEVEL)
(   23) !              *CUASC*    (T AND Q AT CLOUD LEVELS)
(   24) !              *CUINI*    (ENVIRONMENTAL T AND QS VALUES AT HALF LEVELS)
(   25) !              *CUSTRAT*  (T AND Q AT CONDENSATION LEVEL)
(   26) !          INPUT ARE UNADJUSTED T AND Q VALUES,
(   27) !          IT RETURNS ADJUSTED VALUES OF T AND Q
(   28) # 29 "./cuadjtq.F90"
(   29) !     PARAMETER     DESCRIPTION                                   UNITS
(   30) !     ---------     -----------                                   -----
(   31) !     INPUT PARAMETERS (INTEGER):
(   32) # 33 "./cuadjtq.F90"
(   33) !    *KIDIA*        START POINT
(   34) !    *KFDIA*        END POINT
(   35) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   36) !    *KLEV*         NUMBER OF LEVELS
(   37) !    *KK*           LEVEL
(   38) !    *KCALL*        DEFINES CALCULATION AS
(   39) !                      KCALL=0  ENV. T AND QS IN*CUINI*
(   40) !                      KCALL=1  CONDENSATION IN UPDRAFTS  (E.G. CUBASE, CUASC)
(   41) !                      KCALL=2  EVAPORATION IN DOWNDRAFTS (E.G. CUDLFS,CUDDRAF)
(   42) # 43 "./cuadjtq.F90"
(   43) !     INPUT PARAMETERS (LOGICAL):
(   44) # 45 "./cuadjtq.F90"
(   45) !    *LDLAND*       LAND-SEA MASK (.TRUE. FOR LAND POINTS)
(   46) # 47 "./cuadjtq.F90"
(   47) !     INPUT PARAMETERS (REAL):
(   48) # 49 "./cuadjtq.F90"
(   49) !    *PSP*          PRESSURE                                        PA
(   50) # 51 "./cuadjtq.F90"
(   51) !     UPDATED PARAMETERS (REAL):
(   52) # 53 "./cuadjtq.F90"
(   53) !    *PT*           TEMPERATURE                                     K
(   54) !    *PQ*           SPECIFIC HUMIDITY                             KG/KG
(   55) # 56 "./cuadjtq.F90"
(   56) !          EXTERNALS   
