(  153)       DO JL=KIDIA,KFDIA
(  154)       IF (LLFLAG(JL)) THEN
(  155)         ZQP    =1.0_JPRB/PSP(JL)
(  156)         ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  157)         ZI=1.0_JPRB/(PT(JL,KK)-R4IES)
(  158) !       ZQSAT=FOEEWMCU(PT(JL,KK))*ZQP
(  159)         ZQSAT=R2ES *(FOEALFCU(PT(JL,KK))*EXP(R3LES*(PT(JL,KK)-RTT)*ZL)+&
(  160)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*EXP(R3IES*(PT(JL,KK)-RTT)*ZI))
(  161)         ZQSAT=ZQSAT*ZQP
(  162)         ZQSAT=MIN(0.5_JPRB,ZQSAT)
(  163)         ZCOR=1.0_JPRB-RETV*ZQSAT
(  164)         ZF=FOEALFCU(PT(JL,KK))*R5ALVCP*ZL**2 +&
(  165)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*R5ALSCP*ZI**2
(  166)         ZCOND=(PQ(JL,KK)*ZCOR**2-ZQSAT*ZCOR)/(ZCOR**2+ZQSAT*ZF)
(  167)         ZCOND=MAX(ZCOND,0.0_JPRB)
(  168)         PT(JL,KK)=PT(JL,KK)+FOELDCPMCU(PT(JL,KK))*ZCOND
(  169)         PQ(JL,KK)=PQ(JL,KK)-ZCOND
(  170)         ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  171)         ZI=1.0_JPRB/(PT(JL,KK)-R4IES)
(  172) !       ZQSAT=FOEEWMCU(PT(JL,KK))*ZQP
(  173)         ZQSAT=R2ES *(FOEALFCU(PT(JL,KK))*EXP(R3LES*(PT(JL,KK)-RTT)*ZL)+&
(  174)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*EXP(R3IES*(PT(JL,KK)-RTT)*ZI))
(  175)         ZQSAT=ZQSAT*ZQP
(  176)         ZQSAT=FMINJ(0.5_JPRB,ZQSAT)
(  177)         ZCOR=1.0_JPRB-RETV*ZQSAT
(  178)         ZF=FOEALFCU(PT(JL,KK))*R5ALVCP*ZL**2 +&
(  179)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*R5ALSCP*ZI**2
