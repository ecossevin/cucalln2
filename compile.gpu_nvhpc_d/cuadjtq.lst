(  137) !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  138) !                  -----------------------------------------------------
(  139) 
(  140)   IF (KCALL == 1 .OR. KCALL == 6 ) THEN
(  141) 
(  142) !   mixed phase saturation
(  143) 
(  144)       LLFLAG(KIDIA:KFDIA) = LDFLAG(KIDIA:KFDIA)
(  145)       IF(KCALL == 6) THEN
(  146)         IF(PRESENT(LDOFLAG)) THEN
(  147)           LLFLAG(KIDIA:KFDIA) = LLFLAG(KIDIA:KFDIA) .AND. .NOT.LDOFLAG(KIDIA:KFDIA)
(  148)         ELSE
(  149)           CALL ABOR1("CUADJTQ: LDOFLAG has to be present when KCALL==6")
(  150)         ENDIF
(  151)       ENDIF
(  152) 
(  153)       DO JL=KIDIA,KFDIA
(  154)       IF (LLFLAG(JL)) THEN
(  155)         ZQP    =1.0_JPRB/PSP(JL)
(  156)         ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  157)         ZI=1.0_JPRB/(PT(JL,KK)-R4IES)
(  158) !       ZQSAT=FOEEWMCU(PT(JL,KK))*ZQP
(  159)         ZQSAT=R2ES *(FOEALFCU(PT(JL,KK))*EXP(R3LES*(PT(JL,KK)-RTT)*ZL)+&
(  160)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*EXP(R3IES*(PT(JL,KK)-RTT)*ZI))
(  161)         ZQSAT=ZQSAT*ZQP
(  162)         ZQSAT=MIN(0.5_JPRB,ZQSAT)
(  163)         ZCOR=1.0_JPRB-RETV*ZQSAT
(  164)         ZF=FOEALFCU(PT(JL,KK))*R5ALVCP*ZL**2 +&
(  165)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*R5ALSCP*ZI**2
(  166)         ZCOND=(PQ(JL,KK)*ZCOR**2-ZQSAT*ZCOR)/(ZCOR**2+ZQSAT*ZF)






NVFORTRAN (Version     24.5)          03/19/2025  06:55:59      page 4

(  167)         ZCOND=MAX(ZCOND,0.0_JPRB)
(  168)         PT(JL,KK)=PT(JL,KK)+FOELDCPMCU(PT(JL,KK))*ZCOND
(  169)         PQ(JL,KK)=PQ(JL,KK)-ZCOND
(  170)         ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  171)         ZI=1.0_JPRB/(PT(JL,KK)-R4IES)
(  172) !       ZQSAT=FOEEWMCU(PT(JL,KK))*ZQP
(  173)         ZQSAT=R2ES *(FOEALFCU(PT(JL,KK))*EXP(R3LES*(PT(JL,KK)-RTT)*ZL)+&
(  174)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*EXP(R3IES*(PT(JL,KK)-RTT)*ZI))
(  175)         ZQSAT=ZQSAT*ZQP
(  176)         ZQSAT=FMINJ(0.5_JPRB,ZQSAT)
(  177)         ZCOR=1.0_JPRB-RETV*ZQSAT
(  178)         ZF=FOEALFCU(PT(JL,KK))*R5ALVCP*ZL**2 +&
(  179)           &(1.0_JPRB-FOEALFCU(PT(JL,KK)))*R5ALSCP*ZI**2
(  180)         ZCOND1=(PQ(JL,KK)*ZCOR**2-ZQSAT*ZCOR)/(ZCOR**2+ZQSAT*ZF)
(  181)         IF(ZCOND ==  0.0_JPRB)ZCOND1=0.0_JPRB
(  182)         PT(JL,KK)=PT(JL,KK)+FOELDCPMCU(PT(JL,KK))*ZCOND1
(  183)         PQ(JL,KK)=PQ(JL,KK)-ZCOND1
(  184)       ENDIF
(  185)       ENDDO
(  186) 
(  187)       IF(KCALL==6) THEN
(  188)   
(  189)         DO JL=KIDIA,KFDIA
(  190)         IF(LDFLAG(JL).AND.LDOFLAG(JL)) THEN
(  191)           ZQP    =1.0_JPRB/PSP(JL)
(  192)           ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  193)           ZQSAT=R2ES *EXP(R3LES*(PT(JL,KK)-RTT)*ZL)
(  194)           ZQSAT=ZQSAT*ZQP
(  195)           ZQSAT=MIN(0.5_JPRB,ZQSAT)
(  196)           ZCOR=1.0_JPRB-RETV*ZQSAT
(  197)           ZF=R5ALVCP*ZL**2
(  198)           ZCOND=(PQ(JL,KK)*ZCOR**2-ZQSAT*ZCOR)/(ZCOR**2+ZQSAT*ZF)
(  199)           ZCOND=MAX(ZCOND,0.0_JPRB)
(  200)           PT(JL,KK)=PT(JL,KK)+RALVDCP*ZCOND
(  201)           PQ(JL,KK)=PQ(JL,KK)-ZCOND
(  202)           ZL=1.0_JPRB/(PT(JL,KK)-R4LES)
(  203)           ZQSAT=R2ES *EXP(R3LES*(PT(JL,KK)-RTT)*ZL)
(  204)           ZQSAT=ZQSAT*ZQP
(  205)           ZQSAT=FMINJ(0.5_JPRB,ZQSAT)
(  206)           ZCOR=1.0_JPRB-RETV*ZQSAT
(  207)           ZF=R5ALVCP*ZL**2
(  208)           ZCOND1=(PQ(JL,KK)*ZCOR**2-ZQSAT*ZCOR)/(ZCOR**2+ZQSAT*ZF)
(  209)           IF(ZCOND ==  0.0_JPRB)ZCOND1=0.0_JPRB
(  210)           PT(JL,KK)=PT(JL,KK)+RALVDCP*ZCOND1
(  211)           PQ(JL,KK)=PQ(JL,KK)-ZCOND1
(  212)         ENDIF
(  213)         ENDDO
(  214)   
(  215)       ENDIF
(  216) 
