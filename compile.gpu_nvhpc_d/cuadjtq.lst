(  346) !     2.           CALCULATE CONDENSATION AND ADJUST T AND Q ACCORDINGLY
(  347) !                  -----------------------------------------------------
(  348) 
(  349)   IF (KCALL == 1 ) THEN
(  350) 
(  351) !DIR$    IVDEP
(  352) !OCL NOVREC
(  353) !DIR$ LOOP_INFO EST_TRIPS(16)
(  354)     DO JL=KIDIA,KFDIA
(  355)       IF(LDFLAG(JL)) THEN
(  356)         ZQP    =1.0_JPRB/PSP(JL)
(  357)         ZTARG=PT(JL,KK)
(  358)         ZOEALFA=0.5_JPRB*(TANH(RLPAL1*(ZTARG-RLPTRC))+1.0_JPRB)
(  359)         ZFOEEWL=R2ES*EXP(R3LES*(ZTARG-RTT)/(ZTARG-R4LES))
(  360)         ZFOEEWI=R2ES*EXP(R3IES*(ZTARG-RTT)/(ZTARG-R4IES))
(  361)         ZQSAT=ZQP    *(ZOEALFA*ZFOEEWL+(1.0_JPRB-ZOEALFA)*ZFOEEWI)
(  362)         Z1S=TANH(RLPAL2*(ZQSAT-ZQMAX))
(  363)         ZQSAT=0.5_JPRB*((1.0_JPRB-Z1S)*ZQSAT+(1.0_JPRB+Z1S)*ZQMAX)
