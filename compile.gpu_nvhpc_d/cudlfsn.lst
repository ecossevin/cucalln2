(    1) SUBROUTINE CUDLFSN &
(    2)  & (YDTHF, YDCST, YDEPHLI, YDECUMF,&
(    3)  & KIDIA,    KFDIA,    KLON,    KLEV,&
(    4)  & KCBOT,    KCTOP,    LDCUM,&
(    5)  & PTENH,    PQENH,    PTEN,     PQSEN,    PGEO,&
(    6)  & PGEOH,    PAPH,     PTU,      PQU,&
(    7)  & PMFUB,    PRFL,&
(    8)  & PTD,      PQD,&
(    9)  & PMFD,     PMFDS,    PMFDQ,    PDMFDP,&
(   10)  & KDTOP,    LDDRAF)  
(   11) 
(   12) !          THIS ROUTINE CALCULATES LEVEL OF FREE SINKING FOR
(   13) !          CUMULUS DOWNDRAFTS AND SPECIFIES T,Q,U AND V VALUES
(   14) 
(   15) !          PURPOSE.
(   16) !          --------
(   17) !          TO PRODUCE LFS-VALUES FOR CUMULUS DOWNDRAFTS
(   18) !          FOR MASSFLUX CUMULUS PARAMETERIZATION
(   19) 
(   20) !          INTERFACE
(   21) !          ---------
(   22) !          THIS ROUTINE IS CALLED FROM *CUMASTR*.
(   23) !          INPUT ARE ENVIRONMENTAL VALUES OF T,Q,U,V,P,PHI
(   24) !          AND UPDRAFT VALUES T,Q,U AND V AND ALSO
(   25) !          CLOUD BASE MASSFLUX AND CU-PRECIPITATION RATE.
(   26) !          IT RETURNS T,Q,U AND V VALUES AND MASSFLUX AT LFS.
(   27) 
(   28) !          METHOD.
(   29) 
(   30) !          CHECK FOR NEGATIVE BUOYANCY OF AIR OF EQUAL PARTS OF
(   31) !          MOIST ENVIRONMENTAL AIR AND CLOUD AIR.
(   32) 
(   33) !     PARAMETER     DESCRIPTION                                   UNITS
(   34) !     ---------     -----------                                   -----
(   35) !     INPUT PARAMETERS (INTEGER):
(   36) 
(   37) !    *KIDIA*        START POINT
(   38) !    *KFDIA*        END POINT
(   39) !    *KLON*         NUMBER OF GRID POINTS PER PACKET
(   40) !    *KLEV*         NUMBER OF LEVELS
(   41) !    *KCBOT*        CLOUD BASE LEVEL
(   42) !    *KCTOP*        CLOUD TOP LEVEL
(   43) 
(   44) !    INPUT PARAMETERS (LOGICAL):
(   45) 
(   46) !    *LDCUM*        FLAG: .TRUE. FOR CONVECTIVE POINTS
(   47) 
(   48) !    INPUT PARAMETERS (REAL):
(   49) 
(   50) !    *PTENH*        ENV. TEMPERATURE (T+1) ON HALF LEVELS          K






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 2

(   51) !    *PQENH*        ENV. SPEC. HUMIDITY (T+1) ON HALF LEVELS     KG/KG
(   52) !    *PTEN*         PROVISIONAL ENVIRONMENT TEMPERATURE (T+1)       K
(   53) !    *PQSEN*        ENVIRONMENT SPEC. SATURATION HUMIDITY (T+1)   KG/KG
(   54) !    *PGEO*         GEOPOTENTIAL                                  M2/S2
(   55) !    *PGEOH*        GEOPOTENTIAL ON HALF LEVELS                  M2/S2
(   56) !    *PAPH*         PROVISIONAL PRESSURE ON HALF LEVELS           PA
(   57) !    *PTU*          TEMPERATURE IN UPDRAFTS                        K
(   58) !    *PQU*          SPEC. HUMIDITY IN UPDRAFTS                   KG/KG
(   59) !    *PMFUB*        MASSFLUX IN UPDRAFTS AT CLOUD BASE           KG/(M2*S)
(   60) 
(   61) !    UPDATED PARAMETERS (REAL):
(   62) 
(   63) !    *PRFL*         PRECIPITATION RATE                           KG/(M2*S)
(   64) 
(   65) !    OUTPUT PARAMETERS (REAL):
(   66) 
(   67) !    *PTD*          TEMPERATURE IN DOWNDRAFTS                      K
(   68) !    *PQD*          SPEC. HUMIDITY IN DOWNDRAFTS                 KG/KG
(   69) !    *PMFD*         MASSFLUX IN DOWNDRAFTS                       KG/(M2*S)
(   70) !    *PMFDS*        FLUX OF DRY STATIC ENERGY IN DOWNDRAFTS       J/(M2*S)
(   71) !    *PMFDQ*        FLUX OF SPEC. HUMIDITY IN DOWNDRAFTS         KG/(M2*S)
(   72) !    *PDMFDP*       FLUX DIFFERENCE OF PRECIP. IN DOWNDRAFTS     KG/(M2*S)
(   73) 
(   74) !    OUTPUT PARAMETERS (INTEGER):
(   75) 
(   76) !    *KDTOP*        TOP LEVEL OF DOWNDRAFTS
(   77) 
(   78) !    OUTPUT PARAMETERS (LOGICAL):
(   79) 
(   80) !    *LDDRAF*       .TRUE. IF DOWNDRAFTS EXIST
(   81) 
(   82) !          EXTERNALS
(   83) !          ---------
(   84) !          *CUADJTQ* FOR CALCULATING WET BULB T AND Q AT LFS
(   85) 
(   86) !     AUTHOR.
(   87) !     -------
(   88) !      M.TIEDTKE         E.C.M.W.F.    12/86 MODIF. 12/89
(   89) 
(   90) !     MODIFICATIONS.
(   91) !     --------------
(   92) !      M.Hamrud      01-Oct-2003 CY28 Cleaning
(   93) !      P. Lopez      20-Jun-2007 CY32R2 Bug correction in latent heat when LPHYLIN=T.
(   94) !     R. El Khatib 22-Jun-2022 A contribution to simplify phasing after the refactoring of YOMCLI/YOMCST/YOETHF.
(   95) !----------------------------------------------------------------------
(   96) 
(   97) USE PARKIND1  ,ONLY : JPIM     ,JPRB
(   98) USE YOMHOOK   ,ONLY : LHOOK,   DR_HOOK, JPHOOK
(   99) 
(  100) USE YOMCST   , ONLY : TCST
(  101) USE YOETHF   , ONLY : TTHF  
(  102) USE YOECUMF  , ONLY : TECUMF
(  103) USE YOEPHLI  , ONLY : TEPHLI
(  104) 
(  105) IMPLICIT NONE
(  106) 
(  107) TYPE(TTHF)        ,INTENT(IN)    :: YDTHF
(  108) TYPE(TCST)        ,INTENT(IN)    :: YDCST






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 3

(  109) TYPE(TECUMF)      ,INTENT(IN)    :: YDECUMF
(  110) TYPE(TEPHLI)      ,INTENT(IN)    :: YDEPHLI
(  111) INTEGER(KIND=JPIM),INTENT(IN)    :: KLON 
(  112) INTEGER(KIND=JPIM),INTENT(IN)    :: KLEV 
(  113) INTEGER(KIND=JPIM),INTENT(IN)    :: KIDIA 
(  114) INTEGER(KIND=JPIM),INTENT(IN)    :: KFDIA 
(  115) INTEGER(KIND=JPIM),INTENT(IN)    :: KCBOT(KLON)
(  116) INTEGER(KIND=JPIM),INTENT(IN)    :: KCTOP(KLON)
(  117) LOGICAL           ,INTENT(IN)    :: LDCUM(KLON)
(  118) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTENH(KLON,KLEV) 
(  119) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQENH(KLON,KLEV) 
(  120) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTEN(KLON,KLEV) 
(  121) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQSEN(KLON,KLEV) 
(  122) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEO(KLON,KLEV) 
(  123) REAL(KIND=JPRB)   ,INTENT(IN)    :: PGEOH(KLON,KLEV+1) 
(  124) REAL(KIND=JPRB)   ,INTENT(IN)    :: PAPH(KLON,KLEV+1) 
(  125) REAL(KIND=JPRB)   ,INTENT(IN)    :: PTU(KLON,KLEV) 
(  126) REAL(KIND=JPRB)   ,INTENT(IN)    :: PQU(KLON,KLEV) 
(  127) REAL(KIND=JPRB)   ,INTENT(IN)    :: PMFUB(KLON) 
(  128) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PRFL(KLON) 
(  129) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PTD(KLON,KLEV) 
(  130) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PQD(KLON,KLEV) 
(  131) REAL(KIND=JPRB)   ,INTENT(INOUT) :: PMFD(KLON,KLEV) 
(  132) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PMFDS(KLON,KLEV) 
(  133) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PMFDQ(KLON,KLEV) 
(  134) REAL(KIND=JPRB)   ,INTENT(OUT)   :: PDMFDP(KLON,KLEV) 
(  135) INTEGER(KIND=JPIM),INTENT(OUT)   :: KDTOP(KLON) 
(  136) LOGICAL           ,INTENT(OUT)   :: LDDRAF(KLON) 
(  137) INTEGER(KIND=JPIM) ::            IKHSMIN(KLON)
(  138) REAL(KIND=JPRB) ::     ZTENWB(KLON,KLEV),      ZQENWB(KLON,KLEV),&
(  139)  & ZCOND(KLON),            ZPH(KLON),&
(  140)  & ZHSMIN(KLON)  
(  141) LOGICAL ::  LLO2(KLON)
(  142) 
(  143) INTEGER(KIND=JPIM) :: IK, IKE, IS, JK, JL
(  144) 
(  145) REAL(KIND=JPRB) :: ZBUO, ZHSK, ZMFTOP, ZOEALFA,&
(  146)  & ZOELHM, ZQTEST, ZTARG, ZTTEST  
(  147) REAL(KIND=JPHOOK) :: ZHOOK_HANDLE
(  148) 
(  149) #include "cuadjtq.intfb.h"
(  150) 
(  151) #include "fcttre.func.h"
(  152) !----------------------------------------------------------------------
(  153) 
(  154) !     1.           SET DEFAULT VALUES FOR DOWNDRAFTS
(  155) !                  ---------------------------------
(  156) 
(  157) IF (LHOOK) CALL DR_HOOK('CUDLFSN',0,ZHOOK_HANDLE)
(  158) ASSOCIATE(LMFDD=>YDECUMF%LMFDD, RMFDEPS=>YDECUMF%RMFDEPS, &
(  159)  & RCPD=>YDCST%RCPD, RETV=>YDCST%RETV, RLSTT=>YDCST%RLSTT, RLVTT=>YDCST%RLVTT, &
(  160)  & LPHYLIN=>YDEPHLI%LPHYLIN, RLPTRC=>YDEPHLI%RLPTRC)
(  161) DO JL=KIDIA,KFDIA
(  162)   LDDRAF(JL)=.FALSE.
(  163)   KDTOP(JL)=KLEV+1
(  164)   IKHSMIN(JL)=KLEV+1
(  165)   ZHSMIN(JL)=1.E8_JPRB
(  166) ENDDO






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 4

(  167) 
(  168) !orig IF(.NOT.LMFDD) GO TO 300
(  169) IF(LMFDD) THEN
(  170) 
(  171) !----------------------------------------------------------------------
(  172) 
(  173) !     2.           DETERMINE LEVEL OF FREE SINKING:
(  174) !                  DOWNDRAFTS SHALL START AT MODEL LEVEL OF MINIMUM
(  175) !                  OF SATURATION MOIST STATIC ENERGY OR BELOW
(  176) !                  RESPECTIVELY
(  177) 
(  178) !                  FOR EVERY POINT AND PROCEED AS FOLLOWS:
(  179) 
(  180) !                    (1) DETERMINE LEVEL OF MINIMUM OF HS
(  181) !                    (2) DETERMINE WET BULB ENVIRONMENTAL T AND Q
(  182) !                    (3) DO MIXING WITH CUMULUS CLOUD AIR
(  183) !                    (4) CHECK FOR NEGATIVE BUOYANCY
(  184) !                    (5) IF BUOYANCY>0 REPEAT (2) TO (4) FOR NEXT
(  185) !                        LEVEL BELOW
(  186) 
(  187) !                  THE ASSUMPTION IS THAT AIR OF DOWNDRAFTS IS MIXTURE
(  188) !                  OF 50% CLOUD AIR + 50% ENVIRONMENTAL AIR AT WET BULB
(  189) !                  TEMPERATURE (I.E. WHICH BECAME SATURATED DUE TO
(  190) !                  EVAPORATION OF RAIN AND CLOUD WATER)
(  191) !                  ----------------------------------------------------
(  192) 
(  193)   DO JK=3,KLEV-2
(  194) 
(  195)     IF (LPHYLIN) THEN
(  196) 
(  197)       DO JL=KIDIA,KFDIA
(  198)         ZTARG=PTEN(JL,JK)
(  199)         ZOEALFA=MIN(1.0_JPRB,0.545_JPRB*(TANH(0.17_JPRB*(ZTARG-RLPTRC))+1.0_JPRB))
(  200)         ZOELHM =ZOEALFA*RLVTT+(1.0_JPRB-ZOEALFA)*RLSTT
(  201)         ZHSK=RCPD*PTEN(JL,JK)+PGEO(JL,JK)+ZOELHM*PQSEN(JL,JK)
(  202)         IF(ZHSK < ZHSMIN(JL)) THEN
(  203)           ZHSMIN(JL)=ZHSK
(  204)           IKHSMIN(JL)=JK
(  205)         ENDIF
(  206)       ENDDO
(  207) 
(  208)     ELSE
(  209) 
(  210)       DO JL=KIDIA,KFDIA
(  211)         ZHSK=RCPD*PTEN(JL,JK)+PGEO(JL,JK)+FOELHMCU(PTEN(JL,JK))*PQSEN(JL,JK)
(  212)         IF(ZHSK < ZHSMIN(JL)) THEN
(  213)           ZHSMIN(JL)=ZHSK
(  214)           IKHSMIN(JL)=JK
(  215)         ENDIF
(  216)       ENDDO
(  217) 
(  218)     ENDIF
(  219) 
(  220)   ENDDO
(  221)   IKE=KLEV-3
(  222)   DO JK=3,IKE
(  223) 
(  224) !     2.1          CALCULATE WET-BULB TEMPERATURE AND MOISTURE






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 5

(  225) !                  FOR ENVIRONMENTAL AIR IN *CUADJTQ*
(  226) !                  -------------------------------------------
(  227) 
(  228)     IS=0
(  229)     DO JL=KIDIA,KFDIA
(  230)       ZTENWB(JL,JK)=PTENH(JL,JK)
(  231)       ZQENWB(JL,JK)=PQENH(JL,JK)
(  232)       ZPH(JL)=PAPH(JL,JK)
(  233)       LLO2(JL)=LDCUM(JL).AND.PRFL(JL) > 0.0_JPRB.AND..NOT.LDDRAF(JL).AND.&
(  234)        & (JK < KCBOT(JL).AND.JK > KCTOP(JL)).AND.&
(  235)        & JK >= IKHSMIN(JL)  
(  236)       IF(LLO2(JL))THEN
(  237)         IS=IS+1
(  238)       ENDIF
(  239)     ENDDO
(  240) !orig   IF(IS.EQ.0) GO TO 290
(  241)     IF(IS == 0) CYCLE
(  242) 
(  243)     IK=JK
(  244)     !$loki inline
(  245)     CALL CUADJTQ &
(  246)      & ( YDTHF, YDCST, YDEPHLI,  KIDIA,    KFDIA,    KLON,     KLEV,     IK,&
(  247)      &   ZPH,      ZTENWB,   ZQENWB,   LLO2,     KCALL=2)  
(  248) 
(  249) !     2.2          DO MIXING OF CUMULUS AND ENVIRONMENTAL AIR
(  250) !                  AND CHECK FOR NEGATIVE BUOYANCY.
(  251) !                  THEN SET VALUES FOR DOWNDRAFT AT LFS.
(  252) !                  ----------------------------------------
(  253) 
(  254) !DIR$ IVDEP
(  255) !OCL NOVREC
(  256)     DO JL=KIDIA,KFDIA
(  257)       IF(LLO2(JL)) THEN
(  258)         ZTTEST=0.5_JPRB*(PTU(JL,JK)+ZTENWB(JL,JK))
(  259)         ZQTEST=0.5_JPRB*(PQU(JL,JK)+ZQENWB(JL,JK))
(  260)         ZBUO=ZTTEST*(1.0_JPRB+RETV  *ZQTEST)-&
(  261)          & PTENH(JL,JK)*(1.0_JPRB+RETV  *PQENH(JL,JK))  
(  262)         ZCOND(JL)=PQENH(JL,JK)-ZQENWB(JL,JK)
(  263)         ZMFTOP=-RMFDEPS*PMFUB(JL)
(  264)         IF(ZBUO < 0.0_JPRB.AND.PRFL(JL) > 10._JPRB*ZMFTOP*ZCOND(JL)) THEN
(  265)           KDTOP(JL)=JK
(  266)           LDDRAF(JL)=.TRUE.
(  267)           PTD(JL,JK)=ZTTEST
(  268)           PQD(JL,JK)=ZQTEST
(  269)           PMFD(JL,JK)=ZMFTOP
(  270)           PMFDS(JL,JK)=PMFD(JL,JK)*(RCPD*PTD(JL,JK)+PGEOH(JL,JK))
(  271)           PMFDQ(JL,JK)=PMFD(JL,JK)*PQD(JL,JK)
(  272)           PDMFDP(JL,JK-1)=-0.5_JPRB*PMFD(JL,JK)*ZCOND(JL)
(  273)           PRFL(JL)=PRFL(JL)+PDMFDP(JL,JK-1)
(  274)         ENDIF
(  275)       ENDIF
(  276)     ENDDO
(  277) 
(  278) ! 290   continue
(  279)   ENDDO
(  280) 
(  281) !300  CONTINUE
(  282) ENDIF






NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 6

(  283) 
(  284) END ASSOCIATE
(  285) IF (LHOOK) CALL DR_HOOK('CUDLFSN',1,ZHOOK_HANDLE)
(  286) END SUBROUTINE CUDLFSN




























































NVFORTRAN (Version     24.5)          03/19/2025  06:56:03      page 7

