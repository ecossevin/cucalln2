(  208) subroutine define_spp_arpege( sm, nulout )
(  209) 
(  210) #include "abor1.intfb.h"
(  211)   type(spp_model), intent(inout) :: sm
(  212)   integer(kind=jpim),intent(in)  :: nulout
(  213)   integer(kind=jpim) :: indef
(  214) 
(  215)   sm%version = "SPP for ARPEGE physics, v0.1"
(  216)   write(nulout,*) "****************************************"
(  217)   write(nulout,*) "define "//sm%version
(  218)   write(nulout,*) "****************************************"
(  219) 
(  220)   !
(  221)   !   set global default values for SPP configuration
(  222)   !
(  223)   sm%tau=259.2E3_jprb ! 72h;  decorrelation time (s)
(  224)   sm%sdev=1.0_jprb






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 5

(  225)   sm%xlcor = 2000.E3_jprb  ! 2000km; (m)
(  226) 
(  227)   sm%kseed_off = 2**8
(  228)   ! . . .
(  229) 
(  230)   !
(  231)   !   allocate arrays
(  232)   !
(  233)   call allocate_spp_model( sm, 20 )
(  234)   sm%defined_perts = cp_undefined
(  235) 
(  236)   !
(  237)   !  implement perturbations
(  238)   !  to be filled
(  239)   !
(  240) 
(  241)   indef = count(sm%defined_perts /= cp_undefined )
(  242)   if (indef /= sm%ndef ) then
(  243)     call abor1('Inconsistency in terms of the number of defined perturbations.')
(  244)   endif
(  245)   write(nulout,*) "There are ",sm%ndef," possible perturbations"
(  246)   !
(  247)   !   inherit global settings
(  248)   !
(  249)   sm%pndef(1:sm%ndef)%tau    = sm%tau
(  250)   sm%pndef(1:sm%ndef)%sdev   = sm%sdev
(  251)   sm%pndef(1:sm%ndef)%xlcor  = sm%xlcor
(  252) 
(  253) 
(  254) end subroutine define_spp_arpege
