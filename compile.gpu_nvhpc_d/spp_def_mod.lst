(  256) subroutine define_spp_ifs( sm, nulout  )
(  257)   !
(  258)   !   For a science reference see
(  259)   !       Ollinaho et al. (2017), https://doi.org/10.1002/qj.3926
(  260)   !       Lang et al. (2021) https://doi.org/10.1002/qj.3978
(  261) 
(  262) #include "abor1.intfb.h"
(  263) 
(  264)   type(spp_model), intent(inout) :: sm
(  265)   integer(kind=jpim),intent(in)  :: nulout
(  266)   integer(kind=jpim) :: indef
(  267) 
(  268)   sm%version = "SPP for IFS physics"
(  269)   write(nulout,*) "****************************************"
(  270)   write(nulout,*) "define "//sm%version
(  271)   write(nulout,*) "****************************************"
(  272) 
(  273)   !
(  274)   !   set global default values for SPP configuration
(  275)   !
(  276)   sm%tau=259.2E3_jprb ! 72h;  decorrelation time (s)
(  277)   sm%sdev=1.0_jprb
(  278)   sm%xlcor = 1000.E3_jprb  ! 2000km; (m)
(  279) 
(  280)   sm%kseed_off = 2**8
(  281)   !
(  282)   !   allocate arrays






NVFORTRAN (Version     24.5)          03/19/2025  06:54:27      page 6

(  283)   !
(  284)   call allocate_spp_model( sm, 36 )
(  285)   sm%defined_perts = cp_undefined
(  286)   !
(  287)   !  implement perturbations
(  288)   !
(  289)   !
(  290)   call implement_spp_pertn( sm, 'CFM'       , [0.78_jprb,0.33_jprb] , knseed_off =[0], ln1=.true.) ! amplitudes for [land, o
(  291)   call implement_spp_pertn( sm, 'CFM1'      , [0.65_jprb,0.26_jprb] , cd_rf_pert_label='CFM' , ln1=.true.)
(  292)   call implement_spp_pertn( sm, 'CFM2'      , [0.78_jprb,0.33_jprb] , cd_rf_pert_label='CFM' , ln1=.false.)
(  293)   call implement_spp_pertn( sm, 'CFM3'      , [0.78_jprb,0.33_jprb] , cd_rf_pert_label='CFM' , ln1=.false.)
(  294)   call implement_spp_pertn( sm, 'RKAP'      , [0.26_jprb] , knseed_off =[2**30 + 2**15], ln1=.false.)
(  295)   call implement_spp_pertn( sm, 'RKAP1'     , [0.065_jprb], cd_rf_pert_label='RKAP', ln1=.true.)
(  296)   call implement_spp_pertn( sm, 'RKAP2'     , [0.26_jprb] , cd_rf_pert_label='RKAP', ln1=.false.)
(  297)   call implement_spp_pertn( sm, 'RKAP3'     , [0.26_jprb] , cd_rf_pert_label='RKAP', ln1=.false.)
(  298)   call implement_spp_pertn( sm, 'TOFDC'     , [0.78_jprb] , knseed_off = [2** 8], ln1=.true. )
(  299)   call implement_spp_pertn( sm, 'HSDT'      , [0.52_jprb] , knseed_off = [2** 9], ln1=.true. )
(  300)   call implement_spp_pertn( sm, 'VDEXC'     , [1.04_jprb] , knseed_off = [2**10], ln1=.true. )
(  301)   call implement_spp_pertn( sm, 'ENTRORG'   , [0.39_jprb] , knseed_off = [2**11] , ln1=.true.)
(  302)   call implement_spp_pertn( sm, 'ENTSHALP'  , [0.39_jprb] , knseed_off = [2**12] , ln1=.true.)
(  303)   call implement_spp_pertn( sm, 'ENTSTPC1'  , [0.39_jprb] , knseed_off = [2**30 + 2**12], ln1=.true.)
(  304)   call implement_spp_pertn( sm, 'DETRPEN'   , [0.39_jprb] , knseed_off = [2**13] , ln1=.true.)
(  305)   call implement_spp_pertn( sm, 'RPRCON'    , [0.52_jprb] , knseed_off = [2**14] , ln1=.true.)
(  306)   call implement_spp_pertn( sm, 'RTAU'      , [0.78_jprb] , knseed_off = [2**15] , ln1=.true.)
(  307)   call implement_spp_pertn( sm, 'CUDUDV'    , [0.122_jprb, 0.122_jprb] , knseed_off = [2**23] , kidistr=0)
(  308)   call implement_spp_pertn( sm, 'CUDUDVS'   , [0.133_jprb, 0.133_jprb] , knseed_off = [2**24] , kidistr=0)
(  309)   call implement_spp_pertn( sm, 'RAMID'     , [0.13_jprb] , knseed_off = [2**16] , ln1=.true.)
(  310)   call implement_spp_pertn( sm, 'RCLDIFF'   , [1.04_jprb] , knseed_off = [2**17] , ln1=.true.)
(  311)   call implement_spp_pertn( sm, 'RCLCRIT'   , [1.04_jprb, 1.04_jprb] , knseed_off = [2**18] , ln1=.true.) ! land, sea
(  312)   call implement_spp_pertn( sm, 'RLCRITSNOW', [0.78_jprb] , knseed_off = [2**19] , ln1=.true.)
(  313)   call implement_spp_pertn( sm, 'RAINEVAP'  , [0.65_jprb] , knseed_off = [2**30] , ln1=.true.)
(  314)   call implement_spp_pertn( sm, 'SNOWSUBLIM', [0.65_jprb] , knseed_off = [2**30 + 2**8] , ln1=.true.)
(  315)   call implement_spp_pertn( sm, 'CLOUDINHOM', [0.3_jprb,0.3_jprb] , knseed_off = [2**30 + 2**10, 2**30 + 2**11]&
(  316)        , ln1=.true., knrf=2) ! autoconversion, accretion
(  317)   call implement_spp_pertn( sm, 'QSATVERVEL', [0.39_jprb] , knseed_off = [2**30 + 2**9] , ln1=.true.)
(  318)   call implement_spp_pertn( sm, 'ZDECORR'   , [0.78_jprb] , knseed_off = [2**20] , ln1=.true., radgrid=.true.)
(  319)   call implement_spp_pertn( sm, 'ZSIGQCW'   , [0.52_jprb] , knseed_off = [2**21] , ln1=.true., radgrid=.true.)
(  320)   call implement_spp_pertn( sm, 'ZRADEFFL'  , [0.78_jprb] , knseed_off = [2**22] , ln1=.true., radgrid=.true.) ! liquid phas
(  321)   call implement_spp_pertn( sm, 'ZRADEFFI'  , [0.78_jprb] , ln1=.true., radgrid=.true., cd_rf_pert_label='ZRADEFFL') ! ice p
(  322)   call implement_spp_pertn( sm, 'PHR'       , [0.044_jprb,0.064_jprb, 0.064_jprb, 0.034_jprb], &
(  323)        & knseed_off = [2**28,2**29] , knrf=2, ln1=.false.)  !four different values for LW_ST/ LW_TR/  SW_ST/ SW_TR
(  324)   call implement_spp_pertn( sm, 'ZHS_VDAERO', [1.04_jprb] , knseed_off = [2**25] , ln1=.true., radgrid=.true.)
(  325)   call implement_spp_pertn( sm, 'DELTA_AERO', [0.78_jprb] , knseed_off = [2**26] , ln1=.true., radgrid=.true.)
(  326) 
(  327)   indef = count(sm%defined_perts /= cp_undefined )
(  328)   if (indef /= sm%ndef ) then
(  329)     call abor1('Inconsistency in terms of the number of defined perturbations.')
(  330)   endif
(  331)   write(nulout,*) "There are ",sm%ndef," possible perturbations"
(  332) end subroutine define_spp_ifs
