(   37) SUBROUTINE SAVE_SPP_MODEL (KLUN, YD)
(   38) USE UTIL_spp_pert_MOD
(   39) IMPLICIT NONE
(   40) INTEGER, INTENT (IN) :: KLUN
(   41) TYPE (SPP_MODEL), INTENT (IN), TARGET :: YD
(   42) INTEGER :: J1
(   43) WRITE (KLUN) YD%VERSION
(   44) WRITE (KLUN) YD%NMAX
(   45) WRITE (KLUN) YD%DEFINED_PERTS
(   46) WRITE (KLUN) YD%ACTIVE_PERTS
(   47) WRITE (KLUN) YD%NDEF
(   48) WRITE (KLUN) YD%NACT
(   49) WRITE (KLUN) YD%NRFTOTAL
(   50) WRITE (KLUN) YD%NRFTOTAL_RADGRID






NVFORTRAN (Version     24.5)          03/19/2025  06:54:48      page 2

(   51) WRITE (KLUN) YD%NSEED_OFF
(   52) DO J1 = LBOUND (YD%PNDEF, 1), UBOUND (YD%PNDEF, 1)
(   53)   CALL SAVE_spp_pert (KLUN, YD%PNDEF (J1))
(   54) ENDDO
(   55) DO J1 = LBOUND (YD%PN, 1), UBOUND (YD%PN, 1)
(   56)   CALL SAVE_spp_pert (KLUN, YD%PN (J1))
(   57) ENDDO
(   58) WRITE (KLUN) YD%TAU
(   59) WRITE (KLUN) YD%XLCOR
(   60) WRITE (KLUN) YD%SDEV
(   61) WRITE (KLUN) YD%KSEED_OFF
(   62) END SUBROUTINE
