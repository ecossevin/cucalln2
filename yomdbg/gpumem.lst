      1 # 1 "gpumem.F90"
      2 SUBROUTINE GPUMEMSTAT (CDFILE, KLINE, CDMESS)
      3 
      4 USE FIELD_STATISTICS_MODULE
      5 USE YOMMP0, ONLY : MYPROC
      6 
      7 IMPLICIT NONE
      8 
      9 CHARACTER (LEN=*) :: CDFILE
     10 INTEGER           :: KLINE
     11 CHARACTER (LEN=*) :: CDMESS
     12 
     13 INTEGER*8 :: ISIZE_SMI
     14 INTEGER*8 :: ISIZE_ACC
     15 INTEGER*8 :: IALLOCATED, IDELETED
     16 
     17 LOGICAL, SAVE :: LLFIRST = .TRUE.
     18 
     19 COMMON /GPUMEMCOM/ NMETADATA
     20 INTEGER*8 :: NMETADATA
     21 INTEGER*8, PARAMETER :: MB = 1024 * 1024
     22 
     23 INTEGER*8 :: ISIZE (8)
     24 CHARACTER*20 :: CLABEL (8)
     25 CHARACTER*32 :: CLENV
     26 CHARACTER*50 :: CLLOCATION
     27 
     28 INTEGER :: I
     29 
     30 CALL GETENV ('GPUMEM', CLENV)
     31 
     32 IF (CLENV /= '1') RETURN
     33 
     34 FIELD_STATISTICS_ENABLE = .TRUE.
     35 
     36 
     37 IF (LLFIRST) THEN
     38   CLABEL (1) = "METADATA"
     39   CLABEL (2) = "FIELDAPI CUR"
     40   CLABEL (3) = "FIELDAPI MAX"
     41   CLABEL (4) = "TOTAL"
     42   CLABEL (5) = "SMI"
     43   CLABEL (6) = "ACC"
     44   CLABEL (7) = "ALLOCATED"
     45   CLABEL (8) = "DELETED"
     46 
     47   WRITE (0, '(" # GPU = ",A50)', ADVANCE='NO') "LOCATION"
     48 
     49   DO I = 1, 8
     50     WRITE (0, '(A20)', ADVANCE='NO') TRIM (CLABEL (I))
     51   ENDDO
     52 
     53   WRITE (0, '(" # ",A)') " COMMENT "
     54 
     55   LLFIRST = .FALSE.
     56 ENDIF
     57 

Page 2           Source Listing                  MEMFMT
2024-09-10 10:13                                 gpumem.F90

     58 IF (MYPROC == 1) THEN
     59   CALL NVIDIA_SMI (ISIZE_SMI)
     60 ELSE
     61   ISIZE_SMI = 0
     62 ENDIF
     63 
     64 CALL NVIDIA_FREE_MEMORY (ISIZE_ACC)
     65 CALL NVIDIA_PRESENT_DUMP (IALLOCATED, IDELETED)
     66 
     67 ISIZE = [NMETADATA, FIELD_STATISTICS%MEMORY_DEVICE_CUR, FIELD_STATISTICS%MEMORY_DEVICE_MAX, &
     68       &  NMETADATA+FIELD_STATISTICS%MEMORY_DEVICE_CUR, ISIZE_SMI * MB, ISIZE_ACC,           &
     69       &  IALLOCATED, IDELETED]
     70 
     71 WRITE (CLLOCATION, '(I0)') KLINE
     72 CLLOCATION = TRIM (CDFILE)//':'//TRIM (CLLOCATION)
     73 
     74 WRITE (0, '("   GPU = ",A50)', ADVANCE='NO') CLLOCATION
     75 
     76 DO I = 1, 8
     77   WRITE (0, '(A20)', ADVANCE='NO') MEMFMT (ISIZE (I))
     78 ENDDO
     79 
     80 WRITE (0, '(" # ",A)') CDMESS
     81 
     82 
     83 CONTAINS
     84 
     85 CHARACTER*20 FUNCTION MEMFMT (KSIZE)
     86 
     87 INTEGER*8 :: KSIZE
     88 INTEGER*8 :: ISIZE
     89 
     90 ISIZE = KSIZE / MB
     91 
     92 WRITE (MEMFMT, '(I20)') ISIZE
     93 
     94 MEMFMT = ADJUSTR (MEMFMT)
     95 
     96 END FUNCTION

