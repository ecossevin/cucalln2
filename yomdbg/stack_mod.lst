    124 
    125 SUBROUTINE STACK_FINAL (SELF)
    126 
    127 CLASS (STACK_DATA) :: SELF
    128 
    129 IF (ASSOCIATED (SELF%ZDATA4)) THEN
    130 !$acc exit data detach (SELF%ZDATA4)
    131   CALL DEV_DEALLOCATE (SELF%ZDATA4, MAP_DEVPTR=.TRUE.)
    132 ENDIF
    133 
    134 IF (ASSOCIATED (SELF%ZDATA8)) THEN
    135 !$acc exit data detach (SELF%ZDATA8)
    136   CALL DEV_DEALLOCATE (SELF%ZDATA8, MAP_DEVPTR=.TRUE.)
    137 ENDIF
    138 
    139 !$acc exit data delete (SELF)
    140 
    141 END SUBROUTINE


