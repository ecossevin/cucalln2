     95 
     96 SUBROUTINE STACK_INIT (SELF, KPROMA, KFLEVG, KGPBLKS, KSIZE4, KSIZE8)
     97 
     98 CLASS (STACK_DATA) :: SELF
     99 INTEGER (KIND=JPIM), INTENT (IN) :: KPROMA, KFLEVG, KGPBLKS
    100 INTEGER (KIND=JPIM), INTENT (IN), OPTIONAL :: KSIZE4, KSIZE8
    101 
    102 SELF%IALIGN = 8 
    103 
    104 IF (PRESENT (KSIZE4)) THEN
    105 IF (KSIZE4 > 0) CALL DEV_ALLOCATE_DIM (SELF%ZDATA4, UBOUNDS=[KPROMA,KFLEVG,KSIZE4,KGPBLKS], MAP_DEVPTR=.TRUE.)
    106 ENDIF
    107 
    108 IF (PRESENT (KSIZE8)) THEN
    109 IF (KSIZE8 > 0) CALL DEV_ALLOCATE_DIM (SELF%ZDATA8, UBOUNDS=[KPROMA,KFLEVG,KSIZE8,KGPBLKS], MAP_DEVPTR=.TRUE.)
    110 ENDIF
    111 
    112 !$acc enter data create (SELF)
    113 !$acc update device (SELF)
    114 
    115 IF (ASSOCIATED (SELF%ZDATA4)) THEN
    116 !$acc enter data attach (SELF%ZDATA4)
    117 ENDIF
    118 
    119 IF (ASSOCIATED (SELF%ZDATA8)) THEN
    120 !$acc enter data attach (SELF%ZDATA8)
    121 ENDIF
    122 
    123 END SUBROUTINE

