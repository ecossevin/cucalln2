     76 SUBROUTINE STACK_INIT_OPTS (SELF, YDPARALLEL_OPTS, YDGEOMETRY)
     77 
     78 USE GEOMETRY_MOD, ONLY : GEOMETRY
     79 
     80 CLASS (STACK_DATA) :: SELF
     81 TYPE (PARALLEL_OPTS), INTENT (IN) :: YDPARALLEL_OPTS
     82 TYPE (GEOMETRY)     , INTENT (IN) :: YDGEOMETRY
     83 
     84 INTEGER :: IGPBLKS
     85 
     86 IGPBLKS = MIN (YDGEOMETRY%YRDIM%NGPBLKS,YDPARALLEL_OPTS%NBLOMA)
     87 
     88 CALL SELF%INIT (YDGEOMETRY%YRDIM%NPROMA,             &
     89               & YDGEOMETRY%YRDIMV%NFLEVG,            &
     90               & IGPBLKS,                             &
     91               & KSIZE4=YDPARALLEL_OPTS%ISTACKSIZE4,  &
     92               & KSIZE8=YDPARALLEL_OPTS%ISTACKSIZE8)
     93 
     94 END SUBROUTINE

