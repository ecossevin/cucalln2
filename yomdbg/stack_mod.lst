    187 
    188 SUBROUTINE GETLVAR (CDNAME, CDVALUE, LDVALUE, LDDEFAULT)
    189 
    190 CHARACTER (LEN=*),   INTENT (IN)    :: CDNAME
    191 CHARACTER (LEN=*),   INTENT (INOUT) :: CDVALUE
    192 LOGICAL,             INTENT (INOUT) :: LDVALUE
    193 LOGICAL, OPTIONAL,   INTENT (INOUT) :: LDDEFAULT
    194 
    195 CHARACTER*20 :: CLNAME
    196 
    197 CDVALUE = ''
    198 
    199 CALL GETENV (TRIM (CDNAME), CDVALUE)
    200 
    201 IF (TRIM (CDVALUE) /= '' .AND. TRIM (CDVALUE) /= '0') THEN
    202   LDVALUE = .TRUE.
    203 ELSEIF (PRESENT (LDDEFAULT)) THEN
    204   LDVALUE = LDDEFAULT
    205 ENDIF
    206 
    207 CLNAME = CDNAME
    208 
    209 WRITE (NULOUT, '(A20," = ",L1)') CLNAME, LDVALUE
    210 
    211 END SUBROUTINE


