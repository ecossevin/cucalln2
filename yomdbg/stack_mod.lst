    143 SUBROUTINE PARALLEL_OPTS_INIT (SELF)
    144 
    145 USE YOMLUN , ONLY : NULOUT
    146 
    147 CLASS (PARALLEL_OPTS) :: SELF
    148 
    149 CALL GETIVAR ('CLSTACKSIZE4'      , SELF%CLSTACKSIZE4      , SELF%ISTACKSIZE4                             )
    150 CALL GETIVAR ('CLSTACKSIZE8'      , SELF%CLSTACKSIZE8      , SELF%ISTACKSIZE8                             )
    151 CALL GETIVAR ('CLBLOMA'           , SELF%CLBLOMA           , SELF%NBLOMA                                  )
    152 CALL GETLVAR ('PARALLEL'          , SELF%CLPARALLEL        , SELF%LLPARALLEL                              )
    153 CALL GETLVAR ('PERSISTENT'        , SELF%CLPERSISTENT      , SELF%LLPERSISTENT      , SELF%LLPARALLEL     )
    154 CALL GETLVAR ('SLCOMMACC'         , SELF%CLSLCOMMACC       , SELF%LLSLCOMMACC                             )
    155 CALL GETLVAR ('SLEXTPOLACC'       , SELF%CLSLEXTPOLACC     , SELF%LLSLEXTPOLACC                           )
    156 CALL GETLVAR ('CLHOST'            , SELF%CLHOST            , SELF%LLHOST                                  )
    157 CALL GETLVAR ('CLHOST_CPG_DRV'    , SELF%CLHOST_CPG_DRV    , SELF%LLHOST_CPG_DRV    , SELF%LLHOST         )
    158 CALL GETLVAR ('CLHOST_LAPINEA_DRV', SELF%CLHOST_LAPINEA_DRV, SELF%LLHOST_LAPINEA_DRV, SELF%LLHOST         )
    159 CALL GETLVAR ('CLHOST_LAPINEB_DRV', SELF%CLHOST_LAPINEB_DRV, SELF%LLHOST_LAPINEB_DRV, SELF%LLHOST         )
    160 CALL GETLVAR ('CLHOST_CPGLAG_DRV' , SELF%CLHOST_CPGLAG_DRV , SELF%LLHOST_CPGLAG_DRV , SELF%LLHOST         )
    161 CALL GETLVAR ('CLLEGACY_SCAN2M'   , SELF%CLLEGACY_SCAN2M   , SELF%LLLEGACY_SCAN2M                         )
    162 CALL GETLVAR ('CLSPNORM'          , SELF%CLSPNORM          , SELF%LLSPNORM          , SELF%LLLEGACY_SCAN2M)
    163 
    164 CONTAINS
    165 
    166 SUBROUTINE GETIVAR (CDNAME, CDVALUE, KVALUE)
    167 
    168 CHARACTER (LEN=*),   INTENT (IN)    :: CDNAME
    169 CHARACTER (LEN=*),   INTENT (INOUT) :: CDVALUE
    170 INTEGER (KIND=JPIM), INTENT (INOUT) :: KVALUE
    171 
    172 CHARACTER*20 :: CLNAME
    173 
    174 CDVALUE = ''
    175 
    176 CALL GETENV (TRIM (CDNAME), CDVALUE)
    177 
    178 IF (TRIM (CDVALUE) /= '') THEN
    179   READ (CDVALUE, *) KVALUE
    180 ENDIF
    181 
    182 CLNAME = CDNAME
    183 
    184 WRITE (NULOUT, '(A20," = ",I0)') CLNAME, KVALUE
    185 
    186 END SUBROUTINE

