    401 SUBROUTINE PCRC2DEV (CDF, KL, P, CDMESS)
    402 
    403 CHARACTER (LEN=*) :: CDF
    404 INTEGER :: KL
    405 REAL (KIND=JPRB), INTENT (IN) :: P (:,:)
    406 CHARACTER (LEN=*) :: CDMESS
    407 REAL (KIND=JPRB), ALLOCATABLE :: Z (:,:)
    408 
    409 INTEGER :: ILUN
    410 INTEGER*8 :: ICRC8, ILEN8, ICRC8_DEV
    411 
    412 ILUN = 20
    413 
    414 ICRC8 = 0
    415 ILEN8 = SIZE (P) * KIND (P)
    416 
    417 ALLOCATE (Z, MOLD=P)
    418 
    419 !$acc kernels copyout (Z) deviceptr (P)
    420 Z = P
    421 !$acc end kernels
    422 
    423 ICRC8_DEV = 0
    424 
    425 CALL CRC64 (Z, ILEN8, ICRC8_DEV)
    426 
    427 WRITE (ILUN, '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8_DEV
    428 WRITE (0,    '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8_DEV
    429 
    430 
    431 CALL FLUSH (ILUN)
    432 CALL FLUSH (0)
    433 
    434 END SUBROUTINE

