    157 
    158 SUBROUTINE PCRCPROM2 (CDF, KL, P, CDMESS)
    159 
    160 CHARACTER (LEN=*) :: CDF
    161 INTEGER :: KL
    162 REAL (KIND=JPRB), INTENT (IN) :: P (:,:)
    163 CHARACTER (LEN=*) :: CDMESS
    164 
    165 INTEGER :: IBL, NPROMA, IE
    166 
    167 REAL (KIND=JPRB) :: Z (NGPTOT)
    168 
    169 Z = 0.
    170 
    171 NPROMA = SIZE (P, 1)
    172 
    173 DO IBL = 1, SIZE (P, 2)
    174   IE = MIN (IBL*NPROMA, NGPTOT) - (IBL-1)*NPROMA
    175   Z (1+(IBL-1)*NPROMA:MIN (IBL*NPROMA, NGPTOT)) = P (1:IE,IBL)
    176 ENDDO
    177 
    178 CALL PCRC (CDF, KL, Z, CDMESS)
    179 
    180 
    181 END SUBROUTINE


ENTRY POINTS

  Name                            
                                  
 yomdbg_mp_pcrcprom2_             

