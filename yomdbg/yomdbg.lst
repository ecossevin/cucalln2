    531 SUBROUTINE PCRC4 (CDF, KL, P, CDMESS)
    532 
    533 CHARACTER (LEN=*) :: CDF
    534 INTEGER :: KL
    535 REAL (KIND=JPRB), INTENT (IN) :: P (:,:,:,:)
    536 CHARACTER (LEN=*) :: CDMESS
    537 REAL (KIND=JPRB), ALLOCATABLE :: Z (:,:,:,:)
    538 
    539 INTEGER :: ILUN
    540 INTEGER*8 :: ICRC8, ILEN8, ICRC8_DEV
    541 LOGICAL :: LLPRESENT
    542 
    543 ILUN = 20
    544 
    545 ICRC8 = 0
    546 ILEN8 = SIZE (P) * KIND (P)
    547 
    548 CALL CRC64 (P, ILEN8, ICRC8)
    549 
    550 LLPRESENT = .FALSE.
    551 # 559
    552 
    553 
    554 IF (LLPRESENT) THEN
    555 
    556   ALLOCATE (Z, MOLD=P)
    557 
    558 !$acc kernels copyout (Z)
    559   Z = P
    560 !$acc end kernels
    561 
    562   ICRC8_DEV = 0
    563   CALL CRC64 (Z, ILEN8, ICRC8_DEV)
    564 
    565   WRITE (ILUN, '(A,":",I6.6," ",A," ",Z16.16," "Z16.16," ",L1)') CDF, KL, CDMESS, ICRC8, ICRC8_DEV, ICRC8 == ICRC8_DEV
    566   WRITE (0,    '(A,":",I6.6," ",A," ",Z16.16," "Z16.16," ",L1)') CDF, KL, CDMESS, ICRC8, ICRC8_DEV, ICRC8 == ICRC8_DEV
    567 
    568 ELSE
    569   WRITE (ILUN, '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8
    570   WRITE (0,    '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8
    571 ENDIF
    572 
    573 CALL FLUSH (ILUN)
    574 CALL FLUSH (0)
    575 
    576 END SUBROUTINE

