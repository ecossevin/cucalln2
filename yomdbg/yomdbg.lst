    255 SUBROUTINE PCRCI1 (CDF, KL, K, CDMESS)
    256 
    257 CHARACTER (LEN=*) :: CDF
    258 INTEGER :: KL
    259 INTEGER (KIND=JPIM), INTENT (IN) :: K (:)
    260 CHARACTER (LEN=*) :: CDMESS
