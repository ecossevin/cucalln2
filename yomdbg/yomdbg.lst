    140 SUBROUTINE PNAN (CDF, KL, P, CDMESS)
    141 
    142 CHARACTER (LEN=*) :: CDF
    143 INTEGER :: KL
    144 REAL (KIND=JPRB), INTENT (IN) :: P (:)
    145 CHARACTER (LEN=*) :: CDMESS
    146 
    147 INTEGER :: ILUN
    148 
    149 IF (.NOT. LLDBG) RETURN
    150 
    151 ILUN = 0
    152 
    153 WRITE (ILUN, '(A,":",I6.6," ",A," ",I16)') CDF, KL, CDMESS, COUNT (ISNAN (P))
    154 CALL FLUSH (ILUN)
    155 
    156 END SUBROUTINE


