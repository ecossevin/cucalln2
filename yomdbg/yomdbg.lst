    354 
    355 SUBROUTINE PCRC1 (CDF, KL, P, CDMESS)
    356 
    357 CHARACTER (LEN=*) :: CDF
    358 INTEGER :: KL
    359 REAL (KIND=JPRB), INTENT (IN) :: P (:)
    360 CHARACTER (LEN=*) :: CDMESS
    361 REAL (KIND=JPRB), ALLOCATABLE :: Z (:)
    362 
    363 INTEGER :: ILUN
    364 INTEGER*8 :: ICRC8, ILEN8, ICRC8_DEV
    365 LOGICAL :: LLPRESENT
    366 
    367 ILUN = 20
    368 
    369 ICRC8 = 0
    370 ILEN8 = SIZE (P) * KIND (P)
    371 
    372 CALL CRC64 (P, ILEN8, ICRC8)
    373 
    374 LLPRESENT = .FALSE.
    375 # 380
    376 
    377 
    378 IF (LLPRESENT) THEN
    379 
    380   ALLOCATE (Z, MOLD=P)
    381 
    382 !$acc kernels copyout (Z)
    383   Z = P
    384 !$acc end kernels
    385 
    386   ICRC8_DEV = 0
    387   CALL CRC64 (Z, ILEN8, ICRC8_DEV)
    388 
    389   WRITE (ILUN, '(A,":",I6.6," ",A," ",Z16.16," "Z16.16," ",L1)') CDF, KL, CDMESS, ICRC8, ICRC8_DEV, ICRC8 == ICRC8_DEV
    390   WRITE (0,    '(A,":",I6.6," ",A," ",Z16.16," "Z16.16," ",L1)') CDF, KL, CDMESS, ICRC8, ICRC8_DEV, ICRC8 == ICRC8_DEV
    391 ELSE
    392   WRITE (ILUN, '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8
    393   WRITE (0,    '(A,":",I6.6," ",A," ",Z16.16)') CDF, KL, CDMESS, ICRC8
    394 ENDIF
    395 
    396 CALL FLUSH (ILUN)
    397 CALL FLUSH (0)
    398 
    399 END SUBROUTINE

